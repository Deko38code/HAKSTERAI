---
import Layout from '../layouts/Layout.astro';
---

<Layout title="haksterAi Labs">
  <section class="relative min-h-screen flex flex-col items-center px-6 pt-28 pb-16 overflow-hidden">

    <!-- Background grid -->
    <div
      class="pointer-events-none absolute inset-0"
      style="background-image: linear-gradient(rgba(124,58,237,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(124,58,237,0.04) 1px, transparent 1px); background-size: 40px 40px;"
    ></div>

    <!-- Glow blob -->
    <div
      class="pointer-events-none absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full opacity-20"
      style="background: radial-gradient(circle, #7c3aed 0%, transparent 70%);"
    ></div>

    <!-- Content -->
    <div class="relative z-10 flex flex-col items-center text-center max-w-5xl mx-auto w-full gap-8">

      <!-- Intro with logo backdrop -->
      <div class="relative flex flex-col items-center gap-8 px-2 py-8 md:px-8 md:py-12">
        <img
          src="/logo.png"
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute left-1/2 top-0 -z-10 w-[min(92vw,680px)] -translate-x-1/2 opacity-20 blur-[1px] saturate-125"
        />
        <div class="pointer-events-none absolute left-1/2 top-6 -z-10 h-[min(72vw,520px)] w-[min(92vw,680px)] -translate-x-1/2 bg-gradient-to-b from-transparent via-[#06070d]/55 to-[#0a0a0f]"></div>

        <!-- Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-[#7c3aed]/50 bg-[#080911]/70 px-5 py-2.5 backdrop-blur-md shadow-lg shadow-[#7c3aed]/10">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#a855f7] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#7c3aed]"></span>
          </span>
          <span class="text-sm font-semibold tracking-widest text-[#a855f7] uppercase">hakster</span>
          <span class="text-xs text-[#64748b] border-l border-[#7c3aed]/30 pl-2">labs · verified tools</span>
        </div>

        <!-- Heading -->
        <h1 class="text-5xl md:text-7xl font-bold leading-tight tracking-tight">
          <span class="text-[#f8fafc] drop-shadow-[0_2px_18px_rgba(0,0,0,0.85)]">The agent</span><br />
          <span class="bg-gradient-to-r from-[#38bdf8] via-[#a855f7] to-[#c084fc] bg-clip-text text-transparent drop-shadow-[0_2px_18px_rgba(0,0,0,0.85)]">
            workspace.
          </span>
        </h1>

        <p class="max-w-2xl text-lg md:text-xl text-[#cbd5e1] leading-relaxed drop-shadow-[0_2px_14px_rgba(0,0,0,0.9)]">
          Verified local tools, live terminals, and research agents — all running in your browser, powered by local AI.
        </p>
      </div>

      <!-- Lab cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 w-full mt-6">

        <!-- Hack Lab Workspace -->
        <a href="/hack" class="group relative rounded-2xl border border-[#1e1e2e] bg-[#0d0d14] p-6 hover:border-[#7c3aed]/50 transition-all hover:shadow-lg hover:shadow-[#7c3aed]/10 hover:-translate-y-0.5">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-[#7c3aed]/10 border border-[#7c3aed]/20 text-2xl">🛠️</div>
            <div>
              <h3 class="text-[#e2e8f0] font-bold text-lg">Hack Lab Workspace</h3>
              <span class="text-xs text-[#64748b]">Verified Local Commands</span>
            </div>
          </div>
          <p class="text-sm text-[#64748b] leading-relaxed mb-4">
            Tool cards are enabled only when the matching executable exists on this machine. Missing or example-only cards stay blocked.
          </p>
          <div class="flex flex-wrap gap-1.5">
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#7c3aed]/10 text-[#a855f7] border border-[#7c3aed]/20">DISCOVER</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#7c3aed]/10 text-[#a855f7] border border-[#7c3aed]/20">VERIFY</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#7c3aed]/10 text-[#a855f7] border border-[#7c3aed]/20">REPORT</span>
          </div>
          <div class="mt-4 text-[#a855f7] text-sm font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
            Launch <span>→</span>
          </div>
        </a>

        <!-- Telegram Mini App -->
        <a href="https://t.me/Haksterbotbot" target="_blank" rel="noopener" class="group relative rounded-2xl border border-[#1e1e2e] bg-[#0d0d14] p-6 hover:border-[#229ED9]/50 transition-all hover:shadow-lg hover:shadow-[#229ED9]/10 hover:-translate-y-0.5">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-[#229ED9]/10 border border-[#229ED9]/20 text-2xl">✈️</div>
            <div>
              <h3 class="text-[#e2e8f0] font-bold text-lg">Telegram Mini App</h3>
              <span class="text-xs text-[#64748b]">6-bot fleet · signed native auth</span>
            </div>
          </div>
          <p class="text-sm text-[#64748b] leading-relaxed mb-4">
            Chat, subscribe, and get build/health alerts straight from Telegram — command, coder, recon, debugger, uptime, and system-health bots, all tied to your haksterAi account.
          </p>
          <div class="flex flex-wrap gap-1.5">
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#229ED9]/10 text-[#67c1eb] border border-[#229ED9]/20">/ask</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#229ED9]/10 text-[#67c1eb] border border-[#229ED9]/20">/subscribe</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#229ED9]/10 text-[#67c1eb] border border-[#229ED9]/20">LIVE</span>
          </div>
          <div class="mt-4 text-[#67c1eb] text-sm font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
            Open in Telegram <span>→</span>
          </div>
        </a>

        <!-- Build / Chat -->
        <a href="/build" class="group relative rounded-2xl border border-[#1e1e2e] bg-[#0d0d14] p-6 hover:border-[#00ff88]/50 transition-all hover:shadow-lg hover:shadow-[#00ff88]/10 hover:-translate-y-0.5">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-[#00ff88]/10 border border-[#00ff88]/20 text-2xl">💬</div>
            <div>
              <h3 class="text-[#e2e8f0] font-bold text-lg">AI Chat</h3>
              <span class="text-xs text-[#64748b]">Coding & Research Agent</span>
            </div>
          </div>
          <p class="text-sm text-[#64748b] leading-relaxed mb-4">
            Full agentic chat with file, shell, and sub-agent tools. Build apps, debug code, research vulnerabilities, and automate tasks.
          </p>
          <div class="flex flex-wrap gap-1.5">
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#00ff88]/10 text-[#00ff88] border border-[#00ff88]/20">CODE</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#00ff88]/10 text-[#00ff88] border border-[#00ff88]/20">SHELL</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#00ff88]/10 text-[#00ff88] border border-[#00ff88]/20">SEARCH</span>
          </div>
          <div class="mt-4 text-[#00ff88] text-sm font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
            Open <span>→</span>
          </div>
        </a>

        <!-- Terminal -->
        <a href="/terminal" class="group relative rounded-2xl border border-[#1e1e2e] bg-[#0d0d14] p-6 hover:border-[#ffd700]/50 transition-all hover:shadow-lg hover:shadow-[#ffd700]/10 hover:-translate-y-0.5">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-[#ffd700]/10 border border-[#ffd700]/20 text-2xl">⌨️</div>
            <div>
              <h3 class="text-[#e2e8f0] font-bold text-lg">Terminal</h3>
              <span class="text-xs text-[#64748b]">Live Shell Access</span>
            </div>
          </div>
          <p class="text-sm text-[#64748b] leading-relaxed mb-4">
            Real xterm.js terminal with full shell access. Run nmap, sqlmap, gobuster, and any tool directly from the browser.
          </p>
          <div class="flex flex-wrap gap-1.5">
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#ffd700]/10 text-[#ffd700] border border-[#ffd700]/20">SHELL</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#ffd700]/10 text-[#ffd700] border border-[#ffd700]/20">XTerm</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#ffd700]/10 text-[#ffd700] border border-[#ffd700]/20">LIVE</span>
          </div>
          <div class="mt-4 text-[#ffd700] text-sm font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
            Connect <span>→</span>
          </div>
        </a>

        <!-- Dashboard -->
        <a href="/dashboard" class="group relative rounded-2xl border border-[#1e1e2e] bg-[#0d0d14] p-6 hover:border-[#00bfff]/50 transition-all hover:shadow-lg hover:shadow-[#00bfff]/10 hover:-translate-y-0.5">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-[#00bfff]/10 border border-[#00bfff]/20 text-2xl">📊</div>
            <div>
              <h3 class="text-[#e2e8f0] font-bold text-lg">Dashboard</h3>
              <span class="text-xs text-[#64748b]">System Monitor</span>
            </div>
          </div>
          <p class="text-sm text-[#64748b] leading-relaxed mb-4">
            Monitor sessions, models, providers, memory, and system health. Track agent runs and tool usage in real time.
          </p>
          <div class="flex flex-wrap gap-1.5">
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#00bfff]/10 text-[#00bfff] border border-[#00bfff]/20">MONITOR</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#00bfff]/10 text-[#00bfff] border border-[#00bfff]/20">SESSIONS</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#00bfff]/10 text-[#00bfff] border border-[#00bfff]/20">HEALTH</span>
          </div>
          <div class="mt-4 text-[#00bfff] text-sm font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
            View <span>→</span>
          </div>
        </a>

        <!-- TUI -->
        <a href="/tui" class="group relative rounded-2xl border border-[#1e1e2e] bg-[#0d0d14] p-6 hover:border-[#ff6bff]/50 transition-all hover:shadow-lg hover:shadow-[#ff6bff]/10 hover:-translate-y-0.5">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-[#ff6bff]/10 border border-[#ff6bff]/20 text-2xl">🖥️</div>
            <div>
              <h3 class="text-[#e2e8f0] font-bold text-lg">TUI</h3>
              <span class="text-xs text-[#64748b]">Terminal UI Mode</span>
            </div>
          </div>
          <p class="text-sm text-[#64748b] leading-relaxed mb-4">
            Full-screen terminal user interface. Navigate agents, sessions, and verified tools in a fast command workspace.
          </p>
          <div class="flex flex-wrap gap-1.5">
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#ff6bff]/10 text-[#ff6bff] border border-[#ff6bff]/20">TUI</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#ff6bff]/10 text-[#ff6bff] border border-[#ff6bff]/20">FULLSCREEN</span>
          </div>
          <div class="mt-4 text-[#ff6bff] text-sm font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
            Enter <span>→</span>
          </div>
        </a>

        <!-- Messages -->
        <a href="/messages" class="group relative rounded-2xl border border-[#1e1e2e] bg-[#0d0d14] p-6 hover:border-[#22d3ee]/50 transition-all hover:shadow-lg hover:shadow-[#22d3ee]/10 hover:-translate-y-0.5">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-[#22d3ee]/10 border border-[#22d3ee]/20 text-2xl">📨</div>
            <div>
              <h3 class="text-[#e2e8f0] font-bold text-lg">Messages</h3>
              <span class="text-xs text-[#64748b]">Session History</span>
            </div>
          </div>
          <p class="text-sm text-[#64748b] leading-relaxed mb-4">
            Browse saved conversation sessions, replay agent interactions, and export findings from past engagements.
          </p>
          <div class="flex flex-wrap gap-1.5">
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#22d3ee]/10 text-[#22d3ee] border border-[#22d3ee]/20">HISTORY</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#22d3ee]/10 text-[#22d3ee] border border-[#22d3ee]/20">EXPORT</span>
          </div>
          <div class="mt-4 text-[#22d3ee] text-sm font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
            Browse <span>→</span>
          </div>
        </a>

      </div>

      <!-- Security Learning Resources -->
      <div class="w-full mt-16">

        <div class="text-center mb-10">
          <h2 class="text-3xl md:text-4xl font-bold text-[#e2e8f0] mb-3">Security Learning Resources</h2>
          <p class="text-[#64748b] text-base max-w-2xl mx-auto">Curated links across 3 categories — learn, practice, and research defensive security workflows.</p>
        </div>

        <!-- Category 1: Hands-On Practice Platforms -->
        <div class="mb-10">
          <h3 class="text-lg font-bold text-[#7c3aed] mb-4 flex items-center gap-2">
            <span class="text-xl">🎯</span> Hands-On Practice Platforms
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
            <a href="https://tryhackme.com" target="_blank" rel="noopener" class="group flex flex-col gap-1 rounded-xl border border-[#1e1e2e] bg-[#0d0d14] p-4 hover:border-[#7c3aed]/50 transition-all hover:-translate-y-0.5">
              <span class="font-semibold text-[#e2e8f0] text-sm group-hover:text-[#a855f7] transition-colors">TryHackMe</span>
              <span class="text-xs text-[#64748b]">Beginner-to-pro labs & guided paths</span>
            </a>
            <a href="https://www.hackthebox.com" target="_blank" rel="noopener" class="group flex flex-col gap-1 rounded-xl border border-[#1e1e2e] bg-[#0d0d14] p-4 hover:border-[#7c3aed]/50 transition-all hover:-translate-y-0.5">
              <span class="font-semibold text-[#e2e8f0] text-sm group-hover:text-[#a855f7] transition-colors">Hack The Box</span>
              <span class="text-xs text-[#64748b]">Live machines, challenges, pro labs</span>
            </a>
            <a href="https://portswigger.net/web-security" target="_blank" rel="noopener" class="group flex flex-col gap-1 rounded-xl border border-[#1e1e2e] bg-[#0d0d14] p-4 hover:border-[#7c3aed]/50 transition-all hover:-translate-y-0.5">
              <span class="font-semibold text-[#e2e8f0] text-sm group-hover:text-[#a855f7] transition-colors">PortSwigger Academy</span>
              <span class="text-xs text-[#64748b]">Free web security labs + Burp Suite</span>
            </a>
            <a href="https://www.vulnhub.com" target="_blank" rel="noopener" class="group flex flex-col gap-1 rounded-xl border border-[#1e1e2e] bg-[#0d0d14] p-4 hover:border-[#7c3aed]/50 transition-all hover:-translate-y-0.5">
              <span class="font-semibold text-[#e2e8f0] text-sm group-hover:text-[#a855f7] transition-colors">VulnHub</span>
              <span class="text-xs text-[#64748b]">Downloadable vulnerable VMs</span>
            </a>
            <a href="https://www.offensive-security.com/labs/" target="_blank" rel="noopener" class="group flex flex-col gap-1 rounded-xl border border-[#1e1e2e] bg-[#0d0d14] p-4 hover:border-[#7c3aed]/50 transition-all hover:-translate-y-0.5">
              <span class="font-semibold text-[#e2e8f0] text-sm group-hover:text-[#a855f7] transition-colors">OffSec Proving Grounds</span>
              <span class="text-xs text-[#64748b]">OSCP-style practice machines</span>
            </a>
            <a href="https://ctftime.org" target="_blank" rel="noopener" class="group flex flex-col gap-1 rounded-xl border border-[#1e1e2e] bg-[#0d0d14] p-4 hover:border-[#7c3aed]/50 transition-all hover:-translate-y-0.5">
              <span class="font-semibold text-[#e2e8f0] text-sm group-hover:text-[#a855f7] transition-colors">CTFtime</span>
              <span class="text-xs text-[#64748b]">Global CTF event tracker & archives</span>
            </a>
            <a href="https://picoctf.org" target="_blank" rel="noopener" class="group flex flex-col gap-1 rounded-xl border border-[#1e1e2e] bg-[#0d0d14] p-4 hover:border-[#7c3aed]/50 transition-all hover:-translate-y-0.5">
              <span class="font-semibold text-[#e2e8f0] text-sm group-hover:text-[#a855f7] transition-colors">picoCTF</span>
              <span class="text-xs text-[#64748b]">Beginner-friendly CTF challenges</span>
            </a>
            <a href="https://overthewire.org" target="_blank" rel="noopener" class="group flex flex-col gap-1 rounded-xl border border-[#1e1e2e] bg-[#0d0d14] p-4 hover:border-[#7c3aed]/50 transition-all hover:-translate-y-0.5">
              <span class="font-semibold text-[#e2e8f0] text-sm group-hover:text-[#a855f7] transition-colors">OverTheWire</span>
              <span class="text-xs text-[#64748b]">Wargames: Bandit, Natas, Leviathan</span>
            </a>
            <a href="https://www.hackthissite.org" target="_blank" rel="noopener" class="group flex flex-col gap-1 rounded-xl border border-[#1e1e2e] bg-[#0d0d14] p-4 hover:border-[#7c3aed]/50 transition-all hover:-translate-y-0.5">
              <span class="font-semibold text-[#e2e8f0] text-sm group-hover:text-[#a855f7] transition-colors">HackThisSite</span>
              <span class="text-xs text-[#64748b]">Mission-based security challenges</span>
            </a>
            <a href="https://pentesterlab.com" target="_blank" rel="noopener" class="group flex flex-col gap-1 rounded-xl border border-[#1e1e2e] bg-[#0d0d14] p-4 hover:border-[#7c3aed]/50 transition-all hover:-translate-y-0.5">
              <span class="font-semibold text-[#e2e8f0] text-sm group-hover:text-[#a855f7] transition-colors">PentesterLab</span>
              <span class="text-xs text-[#64748b]">Structured security exercises</span>
            </a>
          </div>
        </div>

        <!-- Category 2: Commands & Cheat Sheets -->
        <div class="mb-10">
          <h3 class="text-lg font-bold text-[#00ff88] mb-4 flex items-center gap-2">
            <span class="text-xl">🛠️</span> Commands & Cheat Sheets
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
            <a href="https://nmap.org" target="_blank" rel="noopener" class="group flex flex-col gap-1 rounded-xl border border-[#1e1e2e] bg-[#0d0d14] p-4 hover:border-[#00ff88]/50 transition-all hover:-translate-y-0.5">
              <span class="font-semibold text-[#e2e8f0] text-sm group-hover:text-[#00ff88] transition-colors">Nmap</span>
              <span class="text-xs text-[#64748b]">Network discovery & auditing</span>
            </a>
            <a href="https://www.metasploit.com" target="_blank" rel="noopener" class="group flex flex-col gap-1 rounded-xl border border-[#1e1e2e] bg-[#0d0d14] p-4 hover:border-[#00ff88]/50 transition-all hover:-translate-y-0.5">
              <span class="font-semibold text-[#e2e8f0] text-sm group-hover:text-[#00ff88] transition-colors">Metasploit</span>
              <span class="text-xs text-[#64748b]">Security validation framework</span>
            </a>
            <a href="https://owasp.org/www-project-top-ten/" target="_blank" rel="noopener" class="group flex flex-col gap-1 rounded-xl border border-[#1e1e2e] bg-[#0d0d14] p-4 hover:border-[#00ff88]/50 transition-all hover:-translate-y-0.5">
              <span class="font-semibold text-[#e2e8f0] text-sm group-hover:text-[#00ff88] transition-colors">OWASP Top 10</span>
              <span class="text-xs text-[#64748b]">Critical web app security risks</span>
            </a>
            <a href="https://github.com/swisskyrepo/PayloadsAllTheThings" target="_blank" rel="noopener" class="group flex flex-col gap-1 rounded-xl border border-[#1e1e2e] bg-[#0d0d14] p-4 hover:border-[#00ff88]/50 transition-all hover:-translate-y-0.5">
              <span class="font-semibold text-[#e2e8f0] text-sm group-hover:text-[#00ff88] transition-colors">PayloadsAllTheThings</span>
              <span class="text-xs text-[#64748b]">Attack payloads & bypass cheat sheet</span>
            </a>
            <a href="https://gtfobins.github.io" target="_blank" rel="noopener" class="group flex flex-col gap-1 rounded-xl border border-[#1e1e2e] bg-[#0d0d14] p-4 hover:border-[#00ff88]/50 transition-all hover:-translate-y-0.5">
              <span class="font-semibold text-[#e2e8f0] text-sm group-hover:text-[#00ff88] transition-colors">GTFOBins</span>
              <span class="text-xs text-[#64748b]">Unix binary privilege escalation</span>
            </a>
            <a href="https://lolbas-project.github.io" target="_blank" rel="noopener" class="group flex flex-col gap-1 rounded-xl border border-[#1e1e2e] bg-[#0d0d14] p-4 hover:border-[#00ff88]/50 transition-all hover:-translate-y-0.5">
              <span class="font-semibold text-[#e2e8f0] text-sm group-hover:text-[#00ff88] transition-colors">LOLBAS</span>
              <span class="text-xs text-[#64748b]">Windows living-off-the-land binaries</span>
            </a>
            <a href="https://github.com/carlospolop/PEASS-ng" target="_blank" rel="noopener" class="group flex flex-col gap-1 rounded-xl border border-[#1e1e2e] bg-[#0d0d14] p-4 hover:border-[#00ff88]/50 transition-all hover:-translate-y-0.5">
              <span class="font-semibold text-[#e2e8f0] text-sm group-hover:text-[#00ff88] transition-colors">LinPEAS / WinPEAS</span>
