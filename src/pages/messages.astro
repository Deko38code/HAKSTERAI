---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Messages">
  <div class="max-w-4xl mx-auto p-4">
    <h1 class="text-2xl font-bold mb-4 text-[#e2e8f0]">All Messages</h1>
    <div id="messages-list" class="space-y-4"></div>
  </div>
  <script type="module">
    async function loadMessages() {
      const resp = await fetch('/api/messages?limit=200');
      const data = await resp.json();
      const container = document.getElementById('messages-list');
      container.innerHTML = '';
      data.messages.forEach(msg => {
        const el = document.createElement('div');
        el.className = 'p-3 rounded bg-[#111118] border border-[#1e1e2e] text-[#e2e8f0]';
        el.innerHTML = `
          <div class="text-xs text-[#64748b] mb-1">Session: ${msg.session_id} | Role: ${msg.role} | ${new Date(msg.created_at * 1000).toLocaleString()}</div>
          <div class="whitespace-pre-wrap">${msg.content}</div>
        `;
        container.appendChild(el);
      });
    }
    loadMessages();
  </script>
</Layout>
