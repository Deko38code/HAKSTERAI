        resetDangerFeedback();
      }

      function showDangerOverlay({ kind, reason, command, diff }) {
        if (!dangerOverlay) return;
        _dangerCommand = command || '';
        dangerKindEl.textContent = kind || 'danger';
        dangerReasonEl.textContent = reason || 'The agent wants to run a risky command.';
        dangerCmdEl.textContent = command || '(unknown)';
        if (diff && diff.trim()) {
          dangerDiffEl.innerHTML = escapeHtml(diff).replace(/^\+/gm, '<span class="d-add">$&</span>').replace(/^-/gm, '<span class="d-del">$&</span>').replace(/^@@/gm, '<span class="d-hnk">$&</span>');
          dangerDiffWrap.style.display = 'block';
        } else {
