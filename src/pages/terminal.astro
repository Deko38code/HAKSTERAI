          </div>
        </div>
        <div style="display:flex;gap:10px;padding:12px 16px;border-top:1px solid rgba(255,255,255,0.08);background:#0e0e16;">
          <button id="danger-once" style="flex:1;padding:10px 12px;border:0;border-radius:8px;background:#ff3b3b;color:#fff;font-weight:700;cursor:pointer;transition:transform .12s,box-shadow .12s;">One time (y)</button>
          <button id="danger-session" style="flex:1;padding:10px 12px;border:0;border-radius:8px;background:#b45309;color:#fff;font-weight:600;cursor:pointer;transition:transform .12s,box-shadow .12s;">This session</button>
          <button id="danger-allowlist" style="flex:1;padding:10px 12px;border:0;border-radius:8px;background:#7c3aed;color:#fff;font-weight:600;cursor:pointer;transition:transform .12s,box-shadow .12s;">Allow list</button>
          <button id="danger-deny" style="flex:1;padding:10px 12px;border:0;border-radius:8px;background:#23232e;color:#c7c7d6;font-weight:600;cursor:pointer;transition:transform .12s,box-shadow .12s;">Deny (n)</button>
        </div>
        <div id="danger-feedback" style="display:none;padding:8px 16px;text-align:center;font-size:12px;font-weight:600;letter-spacing:0.04em;color:#e2e8f0;background:#141420;border-top:1px solid rgba(255,255,255,0.08);"></div>
      </div>
    </div>
    <style>
      #danger-diff .d-add{color:#7ee787;} #danger-diff .d-del{color:#ff7b72;} #danger-diff .d-hnk{color:#6b7080;}
    </style>

    <!-- ── Resume-session overlay (crush's native prompt → clickable popup) ── -->
    <div id="resume-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.62);backdrop-filter:blur(4px);z-index:9999;align-items:center;justify-content:center;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;">
      <div style="max-width:560px;width:88vw;display:flex;flex-direction:column;background:#0b0b12;border:1px solid #7c3aed;border-radius:12px;box-shadow:0 18px 60px rgba(0,0,0,0.6);overflow:hidden;">
        <div style="display:flex;align-items:center;gap:10px;padding:12px 16px;background:linear-gradient(90deg,rgba(124,58,237,0.18),transparent);border-bottom:1px solid rgba(124,58,237,0.35);">
          <span style="font-size:20px;">↻</span>
          <span style="color:#a78bfa;font-weight:700;letter-spacing:0.04em;">RESUME SESSION</span>
        </div>
        <div style="padding:14px 16px;color:#c7c7d6;font-size:13px;">
          <div style="margin-bottom:10px;">A saved session was found on disk.</div>
          <div style="display:flex;gap:8px;margin-bottom:6px;"><span style="color:#6b7080;width:150px;">Messages saved:</span><span id="resume-msgs" style="color:#e2e8f0;font-weight:600;"></span></div>
          <div style="display:flex;gap:8px;"><span style="color:#6b7080;width:150px;">Last user message:</span><span id="resume-last" style="color:#e2e8f0;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"></span></div>
        </div>
        <div style="display:flex;gap:10px;padding:12px 16px;border-top:1px solid rgba(255,255,255,0.08);background:#0e0e16;">
          <button id="resume-resume" style="flex:1;padding:11px 12px;border:0;border-radius:8px;background:#16a34a;color:#fff;font-weight:700;cursor:pointer;transition:transform .12s,box-shadow .12s;">Resume (y)</button>
          <button id="resume-fresh" style="flex:1;padding:11px 12px;border:0;border-radius:8px;background:#dc2626;color:#fff;font-weight:600;cursor:pointer;transition:transform .12s,box-shadow .12s;">Fresh (n)</button>
          <button id="resume-clear" style="flex:1;padding:11px 12px;border:0;border-radius:8px;background:#7c3aed;color:#fff;font-weight:600;cursor:pointer;transition:transform .12s,box-shadow .12s;">Clear (c)</button>
        </div>
        <div id="resume-feedback" style="display:none;padding:8px 16px;text-align:center;font-size:12px;font-weight:600;letter-spacing:0.04em;color:#e2e8f0;background:#141420;border-top:1px solid rgba(255,255,255,0.08);"></div>
      </div>
    </div>

    <!-- ── "/" command palette — Commands / Models / Skills / Memories / Agents / All ── -->
    <div id="cmd-palette" style="display:none;position:fixed;inset:0;z-index:10000;align-items:flex-start;justify-content:center;background:rgba(0,0,0,0.55);backdrop-filter:blur(3px);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;padding-top:10vh;">
      <div style="width:94vw;max-width:720px;max-height:76vh;display:flex;flex-direction:column;background:#0b0b12;border:1px solid #3b3b4a;border-radius:12px;box-shadow:0 18px 60px rgba(0,0,0,0.6);overflow:hidden;">
        <div style="display:flex;align-items:center;gap:10px;padding:12px 14px;border-bottom:1px solid rgba(255,255,255,0.08);background:#0e0e16;">
          <span style="color:#a78bfa;">⌘</span>
          <span style="color:#e7e7f0;font-weight:700;letter-spacing:0.03em;">Menu</span>
          <span style="margin-left:auto;color:#6b7080;font-size:11px;">↑↓ navigate · ⏎ select · esc close · / open</span>
        </div>
        <div id="cmd-palette-tabs" style="display:flex;gap:6px;padding:8px 12px;flex-wrap:wrap;border-bottom:1px solid rgba(255,255,255,0.05);"></div>
        <input id="cmd-palette-filter" type="text" placeholder="Filter…  (/status, /model, glm-5.2, nmap, memory…) " style="margin:10px 14px;padding:9px 12px;background:#000;color:#e7e7f0;border:1px solid #2a2a38;border-radius:8px;font-size:13px;outline:none;" autocomplete="off" spellcheck="false" />
        <div id="cmd-palette-list" style="flex:1;overflow:auto;padding:0 8px 10px;"></div>
      </div>
    </div>
  </body>
</html>
