      // ── Dangerous-command approval overlay (crush-style) ─────────────────
      const dangerOverlay = document.getElementById('danger-overlay');
      const dangerCmdEl = document.getElementById('danger-command');
      const dangerReasonEl = document.getElementById('danger-reason');
      const dangerKindEl = document.getElementById('danger-kind');
      const dangerDiffWrap = document.getElementById('danger-diff-wrap');
      const dangerDiffEl = document.getElementById('danger-diff');
      let _dangerSeenSig = null;
      let _dangerCommand = '';

      function sendPtyInput(data) {
        try {
          const t = window.__crushTermals && window.__crushTermals['crush-main'];
