      // ── "/" command palette — Commands / Models / Skills / Memories / Agents / All ──
      const SLASH_COMMANDS = [
        { cmd: '/status',   desc: 'health & provider grid' },
        { cmd: '/memory',   desc: 'persistent facts' },
        { cmd: '/help',     desc: 'command matrix' },
        { cmd: '/clear',    desc: 'clear output buffer' },
        { cmd: '/skills',   desc: 'list available skills' },
        { cmd: '/tools',    desc: 'list agent tools' },
        { cmd: '/models',   desc: 'list models' },
        { cmd: '/sessions', desc: 'list saved sessions' },
        { cmd: '/consolidate', desc: 'consolidate memory now' },
        { cmd: '/model',    desc: 'switch model' },
        { cmd: '/exit',     desc: 'exit the agent' },
      ];
      const AGENT_COMMANDS = [
        { cmd: 'team fix "describe bug"', desc: 'run an agent team fix workflow' },
        { cmd: 'agent "one-shot task"',   desc: 'one-shot non-interactive agent' },
        { cmd: 'sub_agent: spawn parallel sub-agents', desc: 'delegate via the sub_agent tool' },
        { cmd: 'spawn_agent: delegate a single sub-task', desc: 'delegate via spawn_agent tool' },
      ];
      const palette = document.getElementById('cmd-palette');
      const paletteList = document.getElementById('cmd-palette-list');
      const paletteFilter = document.getElementById('cmd-palette-filter');
      const paletteTabs = document.getElementById('cmd-palette-tabs');
      let _palItems = [];     // {kind, cat, label, desc?, cmd?, provider?, model?, name?}
      let _palIdx = 0; let _palCat = 'all';
      let _palLoaded = { skills: false, models: false, memories: false };

      function sendPtyInputData(d) {
        try { const t = window.__crushTerminals && window.__crushTerminals['crush-main'];
