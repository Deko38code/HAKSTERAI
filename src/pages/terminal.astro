      const dangerFeedbackEl = document.getElementById('danger-feedback');
      const dangerBtns = {
        once: document.getElementById('danger-once'),
        session: document.getElementById('danger-session'),
        allowlist: document.getElementById('danger-allowlist'),
        deny: document.getElementById('danger-deny'),
      };
      let _dangerChoosing = false;
      function resetDangerFeedback() {
        _dangerChoosing = false;
        if (dangerFeedbackEl) { dangerFeedbackEl.style.display = 'none'; dangerFeedbackEl.textContent = ''; }
