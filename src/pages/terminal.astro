      }
      function loadPalModels() {
        if (_palLoaded.models) return; _palLoaded.models = true;
        fetch('/api/providers').then(r => r.json()).then(async (data) => {
          const providers = (data && (data.providers || data)) || [];
          for (const p of (Array.isArray(providers) ? providers : Object.values(providers))) {
            const pid = p.id || p.name || p;
            try { const md = await fetch('/api/providers/' + encodeURIComponent(pid) + '/models').then(r => r.json()).catch(() => ({}));
              const models = (md && (md.models || md.data)) || [];
              for (const m of models.slice(0, 40)) { const mn = typeof m === 'string' ? m : (m.id || m.name || m.model);
                _palItems.push({ cat: 'model', kind: 'model', provider: pid, model: mn, label: pid + ' / ' + mn, desc: 'switch model' }); }
