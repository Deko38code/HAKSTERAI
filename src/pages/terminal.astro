      function openPalette() {
        if (!palette) return;
        _palItems = [];
        SLASH_COMMANDS.forEach(c => _palItems.push({ cat: 'cmd', kind: 'cmd', cmd: c.cmd, desc: c.desc, label: c.cmd }));
        AGENT_COMMANDS.forEach(c => _palItems.push({ cat: 'agent', kind: 'agent', cmd: c.cmd, desc: c.desc, label: c.cmd }));
