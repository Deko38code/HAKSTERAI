          dangerFeedbackEl.style.display = 'block';
        }
      }

      // Detect the CLI danger/sudo box in PTY output and surface it as an overlay.
      function detectDangerPrompt(raw) {
        const text = stripAnsi(raw).replace(/\r/g, '\n');
        if (!/DANGEROUS COMMAND|SUDO PASSWORD REQUIRED|Approval needed|requires user confirmation|Approve this\?/i.test(text)) return;
        // Extract command line: "Command: $ <cmd>"
        let command = '';
        const cmdMatch = text.match(/Command:\s*\$\s*([^\n]+)/i) || text.match(/Reason:\s*([^\n]+)/i);
        if (cmdMatch) command = cmdMatch[1].trim();
        const isSudo = /SUDO PASSWORD REQUIRED|^\s*sudo\b/im.test(text);
        const reason = (text.match(/Reason:\s*([^\n]+)/i) || [])[1] || '';
        // de-dupe: only show once per unique command
        const sig = command + '|' + (isSudo ? 'sudo' : 'cmd');
        if (sig === _dangerSeenSig) return;
        _dangerSeenSig = sig;
        // If the PTY output already includes a diff (apply_patch/edit_file), surface it
        let diff = '';
        const diffMatch = text.match(/(?:^|\n)((?:@@ -.* \+.* @@|--- .*\n\+\+\+ .*|[+-][^+\-].*)(?:[\s\S]*?))(?=\n\n|Approve|\$ )/);
        if (diffMatch) diff = diffMatch[1].slice(0, 4000);
