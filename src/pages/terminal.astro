          <pre id="danger-command" style="margin:0;padding:10px 12px;background:#000;color:#ff8a8a;border-radius:8px;overflow:auto;white-space:pre-wrap;word-break:break-all;font-size:13px;max-height:180px;"></pre>
          <div id="danger-diff-wrap" style="display:none;margin-top:10px;">
            <div style="color:#6b7080;font-size:11px;margin-bottom:4px;">Compare</div>
