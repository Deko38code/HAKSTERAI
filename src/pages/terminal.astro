    </script>

    <!-- ── Dangerous-command approval overlay (crush-style) ───────────────── -->
    <div id="danger-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.62);backdrop-filter:blur(4px);z-index:9999;align-items:center;justify-content:center;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;">
      <div style="max-width:760px;width:90vw;max-height:82vh;display:flex;flex-direction:column;background:#0b0b12;border:1px solid #ff3b3b;border-radius:12px;box-shadow:0 18px 60px rgba(0,0,0,0.6);overflow:hidden;">
        <div style="display:flex;align-items:center;gap:10px;padding:12px 16px;background:linear-gradient(90deg,rgba(255,59,59,0.18),transparent);border-bottom:1px solid rgba(255,59,59,0.35);">
          <span style="font-size:20px;">🔑</span>
