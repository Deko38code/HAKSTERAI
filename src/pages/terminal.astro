      }
      function applyModelSelection(provider, model) {
        const provSel = document.getElementById('sb-provider'); const modSel = document.getElementById('sb-model');
        if (provSel) { provSel.value = provider; provSel.dispatchEvent(new Event('change')); }
        const setModel = () => { if (modSel) { if (Array.from(modSel.options).some(o => o.value === model)) { modSel.value = model; modSel.dispatchEvent(new Event('change')); } else { fetch('/api/crush/config', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ provider, model }) }).catch(() => {}); } } };
        if (modSel && Array.from(modSel.options).some(o => o.value === model)) setModel(); else setTimeout(setModel, 350);
      }
      const CATS = [['all','All'],['cmd','Commands'],['model','Models'],['skill','Skills'],['mem','Memories'],['agent','Agents']];
      function renderTabs() {
        paletteTabs.innerHTML = CATS.map(([id,label]) => {
          const sel = id === _palCat;
          return '<button data-cat="' + id + '" style="padding:5px 10px;border:0;border-radius:6px;cursor:pointer;font-size:12px;background:' + (sel ? 'rgba(167,139,250,0.25)' : '#1a1a24') + ';color:' + (sel ? '#fff' : '#9aa0b4') + ';border:1px solid ' + (sel ? '#a78bfa' : '#2a2a38') + ';">' + label + '</button>';
        }).join('');
        paletteTabs.querySelectorAll('[data-cat]').forEach(b => b.addEventListener('click', () => { _palCat = b.dataset.cat; _palIdx = 0; renderTabs(); renderPalette(); }));
      }
      function visibleItems() {
        const q = (paletteFilter.value || '').trim().toLowerCase();
        return _palItems.filter(it => (_palCat === 'all' || it.cat === _palCat) && (!q || it.label.toLowerCase().includes(q) || (it.desc || '').toLowerCase().includes(q)));
