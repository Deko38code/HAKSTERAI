          const bg = sel ? 'background:rgba(167,139,250,0.18);border-left:3px solid #a78bfa;' : 'border-left:3px solid transparent;';
          const tag = it.cat === 'model' ? '<span style="margin-left:auto;color:#a78bfa;font-size:10px;">model</span>'
                   : it.cat === 'skill' ? '<span style="margin-left:auto;color:#7ee787;font-size:10px;">skill</span>'
                   : it.cat === 'mem' ? '<span style="margin-left:auto;color:#fbbf24;font-size:10px;">memory</span>'
                   : it.cat === 'agent' ? '<span style="margin-left:auto;color:#38bdf8;font-size:10px;">agent</span>'
                   : '<span style="margin-left:auto;color:#6b7080;font-size:10px;">cmd</span>';
          const left = it.cat === 'model' ? '<span style="color:#6b7080;font-size:11px;min-width:90px;">' + escapeHtml(it.provider || '') + '</span><span style="color:' + (sel ? '#fff' : '#c7c7d6') + ';font-weight:' + (sel ? '600' : '400') + ';">' + escapeHtml(it.model) + '</span>'
                    : it.cat === 'skill' ? '<span style="color:#7ee787;font-weight:600;min-width:160px;">' + escapeHtml(it.name) + '</span><span style="color:#6b7080;font-size:12px;">' + escapeHtml((it.path || '').replace('/home/ghost','~')) + '</span>'
                    : it.cat === 'mem' ? '<span style="color:#fbbf24;font-weight:600;min-width:140px;">' + escapeHtml(it.label) + '</span><span style="color:#9aa0b4;font-size:12px;">' + escapeHtml((it.value || '').slice(0, 60)) + '</span>'
                    : '<span style="color:#7ee787;font-weight:600;min-width:160px;">' + escapeHtml(it.cmd) + '</span><span style="color:#6b7080;font-size:12px;">' + escapeHtml(it.desc || '') + '</span>';
