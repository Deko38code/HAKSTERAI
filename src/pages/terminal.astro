      document.getElementById('resume-resume')?.addEventListener('click', () => resumeChoose('y'));
      document.getElementById('resume-fresh')?.addEventListener('click', () => resumeChoose('n'));
      document.getElementById('resume-clear')?.addEventListener('click', () => resumeChoose('c'));
