      }
      checkpointList.innerHTML = cps.map(cp => {
        const date = new Date(cp.savedAt).toLocaleString();
        const msgCount = cp.messages.length;
        return `<div class="rounded-lg border border-[#333] bg-[#1a1a1a] px-3 py-2 hover:border-[#7c3aed]/40 transition group">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-medium text-white/80 truncate flex-1">${cp.title || 'Untitled'}</span>
            <span class="text-[9px] text-white/30 ml-2">${date}</span>
          </div>
          <div class="text-[10px] text-white/40 mb-2">${msgCount} messages · ${cp.model || 'unknown'}</div>
          <div class="flex gap-1.5">
            <button class="cp-restore text-[10px] rounded border border-[#333] hover:border-[#7c3aed]/50 px-2 py-1 text-white/60 hover:text-white transition" data-cp-id="${cp.id}">↩ Restore</button>
            <button class="cp-delete text-[10px] rounded border border-[#333] hover:border-[#ef4444]/50 px-2 py-1 text-white/40 hover:text-[#ef4444] transition" data-cp-id="${cp.id}">🗑 Delete</button>
          </div>
        </div>`;
      }).join('');
      checkpointList.querySelectorAll('.cp-restore').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.cpId!;
          const cps = loadCheckpoints();
          const cp = cps.find(c => c.id === id);
          if (!cp) return;
          // Create a new conversation from the checkpoint
          const newConv: Conversation = { id: `hack-${Date.now()}-${Math.random().toString(36).slice(2,7)}`, title: `${cp.title} (restored)`, messages: [...cp.messages], model: cp.model || currentModel, created: Date.now() };
          const convs = loadConversations(); convs.unshift(newConv); saveConversations(convs); setActiveId(newConv.id);
          renderMessages(newConv.messages); showMessagesView(); renderHistoryList();
          checkpointPanel.classList.add('hidden');
        });
      });
      checkpointList.querySelectorAll('.cp-delete').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.cpId!;
          const cps = loadCheckpoints().filter(c => c.id !== id);
          saveCheckpoints(cps); renderCheckpoints();
        });
      });
    }
    function saveCheckpointNow() {
      const activeId = getActiveId();
      const convs = loadConversations();
      const conv = convs.find(c => c.id === activeId);
      if (!conv || conv.messages.length === 0) { alert('No active conversation to checkpoint.'); return; }
      const cp: Checkpoint = { id: `cp-${Date.now()}`, convId: conv.id, title: conv.title, messages: [...conv.messages], model: conv.model, savedAt: Date.now() };
      const cps = loadCheckpoints(); cps.unshift(cp); saveCheckpoints(cps); renderCheckpoints();
    }
    checkpointBtn.addEventListener('click', () => { checkpointPanel.classList.toggle('hidden'); renderCheckpoints(); });
    closeCheckpointPanel.addEventListener('click', () => checkpointPanel.classList.add('hidden'));
