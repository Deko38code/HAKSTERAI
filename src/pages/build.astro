---
import Layout from '../layouts/Layout.astro';
---
<link rel="stylesheet" href="/css/xterm.css" />
<script is:inline src="/js/xterm.js"></script>
<script is:inline src="/js/addon-fit.js"></script>

<Layout title="haksterAi — Chat">
  <section id="hacker-chat" class="h-dvh min-h-0 flex flex-row bg-[#141414] text-white overflow-hidden">

    <!-- LEFT SIDEBAR -->
    <aside id="sidebar" class="chat-side-grid hidden md:flex flex-col w-64 min-w-[256px] border-r border-[#333] bg-[#111] relative z-10 transition-all duration-300 fixed md:relative inset-y-0 left-0 z-40 md:z-10">
      <div class="flex items-center justify-between px-4 py-3 border-b border-[#333]">
        <a href="/" class="flex items-center gap-2">
          <img src="/logo-32.png" alt="haksterAi" class="h-6 w-6 rounded" />
          <span class="text-[#e2e8f0] font-bold text-sm tracking-tight">hakster<span class="text-[#7c3aed]">Ai</span></span>
        </a>
        <button id="collapse-sidebar-btn" class="text-white/40 hover:text-white transition" title="Collapse sidebar">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7"/></svg>
        </button>
      </div>

      <div class="px-3 pt-3">
        <button id="new-hack-btn" class="w-full flex items-center justify-center gap-2 rounded-xl border border-[#333] bg-[#1a1a1a] px-4 py-2.5 text-sm font-medium text-white hover:bg-[#222] hover:border-[#444] transition">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          New Chat
        </button>
      </div>

      <div class="px-3 pt-3">
        <button id="settings-toggle" class="w-full flex items-center justify-between text-xs font-semibold uppercase tracking-[0.14em] text-white/40 hover:text-white/60 transition py-1">
          <span>Settings</span>
          <svg id="settings-chevron" class="h-3 w-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/></svg>
        </button>
        <div id="settings-panel" class="overflow-hidden transition-all duration-200" style="max-height:0;opacity:0;">
          <div class="pt-2 pb-1 space-y-2">
            <select id="sidebar-model-select" class="w-full rounded-lg border border-[#333] bg-[#1a1a1a] px-2 py-1.5 text-xs text-white/80 outline-none focus:border-[#7c3aed]/50 backdrop-blur">
              <option value="">Loading models...</option>
            </select>
            <select id="sidebar-project-select" class="w-full rounded-lg border border-[#333] bg-[#1a1a1a] px-2 py-1.5 text-xs text-white/80 outline-none focus:border-[#7c3aed]/50 backdrop-blur" title="Active project for agent tool calls">
              <option value="">Session workspace</option>
            </select>
            <div id="sidebar-project-path" class="truncate text-[10px] text-white/30">Project: session workspace</div>
            <div class="flex items-center gap-2 rounded-lg border border-[#333] bg-[#1a1a1a] px-2 py-1.5 text-xs text-[#999]">
              <span id="sidebar-fc-dot" class="h-2 w-2 rounded-full bg-yellow-300"></span>
              <span id="sidebar-fc-text">Checking agents...</span>
            </div>
            <div id="sidebar-token-counter" class="text-[10px] text-white/30">Tokens: 0</div>
            <!-- Account section -->
            <div class="pt-2 border-t border-[#333] space-y-2">
              <div class="text-[9px] font-semibold uppercase tracking-[0.14em] text-white/30">Account</div>
              <div id="sidebar-account-info" class="hidden rounded-lg border border-[#333] bg-[#1a1a1a] px-2.5 py-2 space-y-1.5">
                <div class="flex items-center gap-2">
                  <img id="sidebar-account-avatar" class="h-6 w-6 rounded-full" alt="" />
                  <div class="min-w-0 flex-1">
                    <div id="sidebar-account-name" class="text-xs font-medium text-white/80 truncate">—</div>
                    <div id="sidebar-account-email" class="text-[10px] text-white/40 truncate">—</div>
                  </div>
                </div>
                <div class="flex items-center gap-2 text-[10px] text-white/40">
                  <span id="sidebar-account-role" class="rounded bg-[#7c3aed]/20 px-1.5 py-0.5 text-[#a855f7]">user</span>
                  <span id="sidebar-account-plan" class="rounded bg-[#333] px-1.5 py-0.5">free</span>
                </div>
                <div id="sidebar-account-apikey" class="rounded-lg bg-[#0a0a0f] border border-[#333] px-2 py-1.5 text-[10px] font-mono text-white/40 break-all cursor-pointer hover:text-white/70 transition" title="Click to copy API key">—</div>
                <div id="sidebar-account-usage" class="text-[10px] text-white/40 text-center">Loading usage…</div>
                <div id="sidebar-referral-card" class="hidden rounded-lg border border-[#333] bg-[#0a0a0f] px-2 py-2 space-y-1.5">
                  <div class="flex items-center justify-between gap-2">
                    <span class="text-[9px] font-semibold uppercase tracking-[0.14em] text-white/30">Referral</span>
                    <span id="sidebar-token-balance" class="rounded bg-[#7c3aed]/20 px-1.5 py-0.5 text-[10px] font-bold text-[#a855f7]">0 tokens</span>
                  </div>
                  <button id="sidebar-referral-link" type="button" class="w-full rounded-md border border-[#1e1e2e] bg-[#111118] px-2 py-1.5 text-left text-[10px] font-mono text-white/45 hover:text-white/80 hover:border-[#7c3aed]/40 transition truncate" title="Click to copy referral link">Loading referral link...</button>
                  <div id="sidebar-referral-meta" class="text-[10px] text-white/35">Earn tokens when a friend signs up.</div>
                </div>
                <button id="sidebar-account-logout" class="w-full flex items-center justify-center gap-1.5 rounded-lg border border-[#ef4444]/30 bg-[#ef4444]/10 hover:bg-[#ef4444]/20 text-[#ef4444] text-xs font-semibold py-1.5 transition">
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                  Sign Out
                </button>
              </div>
              <div id="sidebar-account-signin" class="rounded-lg border border-[#333] bg-[#1a1a1a] px-2.5 py-2">
                <div class="text-[10px] text-white/40 mb-1.5">Not signed in</div>
                <button id="settings-google-fallback" class="w-full flex items-center justify-center gap-2 rounded-lg border border-[#333] bg-[#1a1a1a] px-3 py-2 text-xs text-white/70 hover:bg-[#252525] hover:border-[#555] transition">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                  Sign in with Google
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between px-4 pt-4 pb-1">
        <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-white/40">History</span>
        <button id="history-gear" class="text-white/30 hover:text-white/60 transition" title="History settings">
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </button>
      </div>

      <div id="history-list" class="flex-1 overflow-y-auto px-2 space-y-0.5 sidebar-scroll"></div>

      <div class="border-t border-[#333] px-3 py-2.5">
        <div id="sidebar-google-signin" class="mb-2" style="display:none;"></div>
        <!-- Fallback sidebar Google button -->
        <button id="sidebar-google-fallback" class="w-full flex items-center justify-center gap-2 rounded-lg border border-[#333] bg-[#1a1a1a] px-3 py-2 text-xs text-white/70 hover:bg-[#252525] hover:border-[#555] transition mb-2">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
          Sign in with Google
        </button>
        <div id="sidebar-google-badge" class="hidden items-center gap-2 rounded-lg border border-[#333] bg-[#1a1a1a] px-2 py-1.5 mb-2">
          <img id="sidebar-google-avatar" class="h-4 w-4 rounded-full" alt="" />
          <span id="sidebar-google-name" class="text-xs text-white/70 truncate">—</span>
          <button id="sidebar-google-logout" class="ml-auto text-[10px] text-white/30 hover:text-[#ef4444] transition">Logout</button>
        </div>
        <div class="flex items-center justify-between">
          <a href="/" class="flex items-center gap-1.5 text-white/30 hover:text-white/60 transition text-xs">
            <img src="/logo-32.png" alt="" class="h-3.5 w-3.5 rounded" />haksterAi
          </a>
          <button id="clear-history-btn" class="text-[10px] text-white/20 hover:text-[#ef4444] transition uppercase tracking-wider">Clear History</button>
        </div>
      </div>
    </aside>

    <!-- Collapsed sidebar toggle -->
    <button id="expand-sidebar-btn" class="hidden absolute left-0 top-3 z-20 bg-[#1a1a1a] border border-[#333] border-l-0 rounded-r-lg px-2 py-1.5 text-white/40 hover:text-white transition" title="Expand sidebar">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7"/></svg>
    </button>

    <!-- Mobile sidebar overlay backdrop -->
    <div id="sidebar-backdrop" class="md:hidden hidden fixed inset-0 bg-black/60 z-30"></div>

    <!-- Mobile sidebar toggle + logout -->
    <div class="md:hidden absolute left-3 top-3 z-20 flex items-center gap-2">
      <button id="mobile-sidebar-btn" class="flex items-center justify-center w-9 h-9 rounded-lg border border-[#333] bg-[#1a1a1a] text-white/60 hover:text-white transition" title="Open menu">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div class="flex flex-col items-start">
        <span class="text-[8px] uppercase tracking-wider text-[#ef4444]/60 mb-0.5 pl-0.5">Logout</span>
        <button id="mobile-chat-logout" class="flex items-center justify-center gap-1 h-9 px-3 rounded-lg border border-[#ef4444]/30 bg-[#ef4444]/10 text-[#ef4444] text-xs font-semibold hover:bg-[#ef4444]/20 transition" title="Sign out">
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          Sign Out
        </button>
      </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="relative flex-1 flex flex-col min-w-0 overflow-hidden">
      <button type="button" id="chat-fullscreen-btn" class="chat-fullscreen-btn" title="Fullscreen chat" aria-label="Fullscreen chat" aria-pressed="false">
        <svg class="fullscreen-enter h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 3H3v5m13-5h5v5M8 21H3v-5m18 0v5h-5"/>
        </svg>
        <svg class="fullscreen-exit hidden h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v6H3m12-6v6h6M9 21v-6H3m12 6v-6h6"/>
        </svg>
      </button>
      <!-- Messages Area -->
      <div id="messages-area" class="hidden relative flex-1 overflow-y-auto px-2 sm:px-4 lg:px-6 pt-4 pb-24 chat-grid-bg">
        <div class="chat-ink-frame w-full">
          <span class="ink-corner-tr"></span><span class="ink-corner-bl"></span>
          <div id="messages-container" class="space-y-4"></div>
        </div>
      </div>

      <!-- Hero area -->
      <div id="hero-area" class="relative flex-1 flex flex-col items-center justify-center px-4 sm:px-6 w-full">
        <div class="mb-6 flex items-center gap-2">
          <a href="/" class="flex items-center gap-2">
            <img src="/logo-32.png" alt="haksterAi" class="h-8 w-8 rounded" />
            <span class="text-white font-bold text-xl tracking-tight">hakster<span class="text-[#999]">Ai</span></span>
          </a>
        </div>
        <h1 id="hero-heading" class="text-balance text-center text-4xl font-bold leading-[1.05] tracking-normal text-white sm:text-5xl lg:text-6xl mb-8">What will you build today?</h1>
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2 rounded-full border border-[#333] bg-[#1a1a1a] px-3 py-1.5 text-xs text-[#999]">
            <span id="fc-dot" class="h-2 w-2 rounded-full bg-yellow-300"></span>
            <span id="fc-status">Checking agents...</span>
          </div>
          <select id="model-select" class="rounded-full border border-[#333] bg-[#1a1a1a] px-3 py-1.5 text-xs text-white outline-none focus:border-[#555] cursor-pointer">
            <option value="">Loading models...</option>
          </select>
        </div>
        <!-- Google Sign-In -->
        <div id="google-auth-area" class="mt-6 flex items-center gap-3">
          <div id="google-signin-btn" style="display:none;"></div>
          <!-- Fallback custom button (shown if GSI doesn't render) -->
          <button id="google-fallback-btn" class="flex items-center gap-2 rounded-full border border-[#333] bg-[#1a1a1a] px-4 py-2 text-sm text-white/80 hover:bg-[#252525] hover:border-[#555] transition cursor-pointer">
            <svg class="h-4 w-4" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
            Sign in with Google
          </button>
          <div id="google-user-badge" class="hidden flex items-center gap-2 rounded-full border border-[#333] bg-[#1a1a1a] px-3 py-1.5 text-xs text-white/80">
            <img id="google-user-avatar" class="h-5 w-5 rounded-full" alt="" />
            <span id="google-user-name">—</span>
          </div>
        </div>
      </div>

      <!-- Legacy output panel -->
      <div id="output-panel" class="hidden relative flex-1 overflow-y-auto px-2 sm:px-4 lg:px-6 pt-4 pb-24 chat-grid-bg">
        <div class="agent-output-frame w-full">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-mono text-white/30">Output</span>
            <button id="clear-output" class="text-[10px] text-white/20 hover:text-white/40 transition">Clear</button>
          </div>
          <div id="output-area" class="font-mono text-sm whitespace-pre-wrap leading-relaxed"></div>
        </div>
      </div>

      <!-- Chat composer -->
      <form id="chat-form" class="relative z-10 w-full px-2 sm:px-4 lg:px-6 pb-4">
        <div id="composer" class="rounded-[22px] border border-[#333] bg-[#1a1a1a] py-3 shadow-[0_12px_32px_rgba(0,0,0,0.02)] overflow-hidden">
          <div class="overflow-y-auto pl-4 pr-2">
            <textarea id="chat-input" rows="3" placeholder="Ask haksterAi to search, scrape, build, or analyze..." class="min-h-[28px] w-full resize-none border-0 bg-transparent p-0 pt-[1px] text-base leading-6 text-white outline-none placeholder:text-[#999]"></textarea>
          </div>
          <div id="attachment-strip" class="hidden flex flex-wrap gap-2 px-4 pb-2"></div>
          <div class="px-3 flex gap-2 items-center min-w-0 pt-1">
            <input id="image-upload-input" type="file" accept="image/*" multiple class="hidden" />
            <button type="button" id="attach-image-btn" class="composer-btn" title="Attach image files"><svg class="h-[15px] w-[15px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21.44 11.05-8.49 8.49a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 1 1-2.83-2.83l8.49-8.48"/></svg></button>
            <button type="button" id="firecrawl-btn" class="composer-btn" title="Search &amp; scrape with Firecrawl"><svg class="h-[15px] w-[15px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.3-4.3"/></svg></button>
            <button type="button" id="mode-btn" class="composer-pill"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg><span id="mode-label">Agent</span></button>
            <button type="button" id="thinking-btn" class="composer-pill active" title="Toggle thinking aloud (Shift+Tab)"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-1.068.304-2.112.876-3.036l-.548-.547z"/></svg><span id="thinking-label">Think</span></button>
            <button type="button" id="scrape-btn" class="composer-btn" title="Scrape a URL"><svg class="h-[15px] w-[15px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2a3 3 0 0 0-3 3v1H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-5V5a3 3 0 0 0-3-3zm0 2a1 1 0 0 0-1 1v1h2V5a1 1 0 0 0-1-1zM9 9h6v2H9V9z"/></svg></button>
            <button type="button" id="shell-btn" class="composer-btn" title="Run a shell command"><svg class="h-[15px] w-[15px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m7 9 3 3-3 3m5 0h5"/><rect x="2" y="4" width="20" height="16" rx="2" stroke-width="2"/></svg></button>
