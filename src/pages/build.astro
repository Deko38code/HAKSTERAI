      }
      availableVoices = window.speechSynthesis.getVoices();
      const savedVoice = localStorage.getItem('hakster-voice-name') || '';
      voiceSelect.innerHTML = '<option value="">System default</option>';
      availableVoices.forEach((voice) => {
