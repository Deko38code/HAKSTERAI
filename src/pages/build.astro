    async function initGoogleButton() {
      try {
        const res = await fetch(`${API}/api/auth/google/client-id`);
        const data = await res.json();
        if (!data.configured) return;

        // Check for existing session
        const storedToken = localStorage.getItem('hakster_google_token');
