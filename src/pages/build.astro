    const CHECKPOINT_KEY = 'hakster-hack-checkpoints';

    interface Checkpoint { id: string; convId: string; title: string; messages: Message[]; model: string; savedAt: number; }
    function loadCheckpoints(): Checkpoint[] {
      try { return JSON.parse(localStorage.getItem(CHECKPOINT_KEY) || '[]'); } catch { return []; }
    }
    function saveCheckpoints(cps: Checkpoint[]) { localStorage.setItem(CHECKPOINT_KEY, JSON.stringify(cps)); }
    function renderCheckpoints() {
      const cps = loadCheckpoints();
      checkpointCount.textContent = String(cps.length);
      if (cps.length === 0) {
        checkpointList.innerHTML = '<div class="text-xs text-white/30 text-center py-6">No checkpoints saved.<br>Click the bookmark icon to save the current conversation state.</div>';
