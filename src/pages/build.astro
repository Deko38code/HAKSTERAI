              <span>Starter — $9.99/mo</span><span style="font-size:12px;opacity:0.8;">More usage</span>
            </button>
            <button data-plan="enterprise" data-price="enterprise_monthly" style="background:#111118;color:#fbbf24;border:1px solid rgba(251,191,36,0.35);border-radius:10px;padding:16px 20px;font-size:15px;font-weight:bold;cursor:pointer;display:flex;justify-content:space-between;align-items:center;">
              <span>Enterprise — $100/mo</span><span style="font-size:12px;opacity:0.8;">Team</span>
            </button>
          </div>
          <div id="upgrade-modal-error" style="color:#ef4444;font-size:13px;text-align:center;margin-top:12px;min-height:18px;"></div>
          <button id="upgrade-modal-close" style="width:100%;margin-top:16px;background:none;border:none;color:#64748b;font-size:13px;cursor:pointer;">Maybe later</button>
        </div>
      `;
      document.body.appendChild(overlay);

      const errorEl = overlay.querySelector('#upgrade-modal-error');
      const closeBtn = overlay.querySelector('#upgrade-modal-close');
      closeBtn.addEventListener('click', () => overlay.remove());
      overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.remove(); });

      overlay.querySelectorAll('button[data-plan]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const token = localStorage.getItem('hakster_google_token');
          if (!token) {
            overlay.remove();
            window.location.href = '/?signin=1&redirect=/build';
            return;
          }
          const planId = btn.dataset.plan;
          const priceCatalogId = btn.dataset.price;
          errorEl.textContent = 'Redirecting to Stripe...';
          errorEl.style.color = '#a855f7';
          try {
            // Fetch pricing to get the stripePriceId
            const priceRes = await fetch(`${API}/api/pricing`);
            const catalog = await priceRes.json();
            let stripePriceId = null;
            for (const plan of catalog.plans) {
              if (plan.id === planId) {
                for (const price of plan.prices) {
                  if (price.id === priceCatalogId) { stripePriceId = price.stripePriceId; break; }
                }
              }
            }
            if (!stripePriceId) { errorEl.textContent = 'Plan not configured yet. Check back soon.'; errorEl.style.color = '#ef4444'; return; }
            const res = await fetch(`${API}/api/stripe/checkout`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'x-api-key': token },
              body: JSON.stringify({ priceId: stripePriceId, planId }),
            });
            const data = await res.json();
            if (data.url) window.location.href = data.url;
            else { errorEl.textContent = data.error || 'Checkout failed'; errorEl.style.color = '#ef4444'; }
          } catch (e) {
            errorEl.textContent = 'Network error — try again';
            errorEl.style.color = '#ef4444';
          }
        });
      });
    }

    async function loadReferralCard() {
      const token = localStorage.getItem('hakster_google_token');
      const card = document.getElementById('sidebar-referral-card');
      const linkBtn = document.getElementById('sidebar-referral-link') as HTMLButtonElement | null;
      const tokenEl = document.getElementById('sidebar-token-balance');
      const metaEl = document.getElementById('sidebar-referral-meta');
      if (!token || !card || !linkBtn) return;
      try {
        const res = await fetch(`${API}/api/referrals`, { headers: { 'x-api-key': token } });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to load referrals');
        card.classList.remove('hidden');
        if (tokenEl) tokenEl.textContent = `${(data.tokenBalance || 0).toLocaleString()} tokens`;
        linkBtn.textContent = data.referralLink || 'Referral link unavailable';
        linkBtn.dataset.link = data.referralLink || '';
        if (metaEl) metaEl.textContent = `${data.totalReferrals || 0} referrals · +${(data.rewardTokens || 0).toLocaleString()} tokens per friend`;
      } catch {
        card.classList.add('hidden');
      }
    }

    // Logout — shared handler for both logout buttons
    function googleLogout() {
      localStorage.removeItem('hakster_google_token');
      localStorage.removeItem('hakster_google_user');
      localStorage.removeItem('hakster_user_data');
      localStorage.removeItem('hakster_last_activity');
      googleToken = null;
      googleUser = null;
      if (window.google && window.google.accounts && window.google.accounts.id) {
        window.google.accounts.id.disableAutoSelect();
      }
      location.reload();
    }

    document.getElementById('sidebar-google-logout')?.addEventListener('click', googleLogout);
    document.getElementById('sidebar-account-logout')?.addEventListener('click', googleLogout);
    document.getElementById('mobile-chat-logout')?.addEventListener('click', googleLogout);

    // Fallback Google buttons — use redirect-based OAuth flow
    function triggerGoogleRedirect() {
      const ref = getReferralCodeFromStorage();
      window.location.href = `${API}/api/auth/google/redirect${ref ? `?ref=${encodeURIComponent(ref)}` : ''}`;
    }
    document.getElementById('google-fallback-btn')?.addEventListener('click', triggerGoogleRedirect);
    document.getElementById('sidebar-google-fallback')?.addEventListener('click', triggerGoogleRedirect);
    document.getElementById('settings-google-fallback')?.addEventListener('click', triggerGoogleRedirect);

    // Check for OAuth callback result in URL
    function checkGoogleCallback() {
      const params = new URLSearchParams(window.location.search);
      const googleAuth = params.get('google_auth');
      const googleError = params.get('google_error');
      if (googleAuth) {
        let handled = false;
        try {
          const data = JSON.parse(decodeURIComponent(googleAuth));
          if (data.ok) {
            googleToken = data.apiKey;
            googleUser = data.user;
            localStorage.setItem('hakster_google_token', googleToken!);
            localStorage.setItem('hakster_google_user', JSON.stringify(data.user));
            localStorage.setItem('hakster_user_data', JSON.stringify({ id: data.user.id || '', name: data.user.username || data.user.email || 'User', email: data.user.email || '', picture: data.user.picture || '' }));
            localStorage.removeItem('hakster_referral_code');
            (window as any).haksterSessionTouch?.();
            showGoogleUserBadge(data.user);
            handled = true;
            const postAuthRedirect = sessionStorage.getItem('hakster_post_auth_redirect');
            if (postAuthRedirect) {
              sessionStorage.removeItem('hakster_post_auth_redirect');
              window.location.href = postAuthRedirect;
              return;
            }
          } else {
            console.error('Google auth callback returned ok:false', data);
          }
        } catch (e) {
          console.error('Failed to parse google_auth payload — token was NOT stored:', e);
        }
        // Only strip the URL once we've actually stored the token. Stripping
        // it unconditionally (previous behavior) erased the only evidence a
        // login was in progress whenever parsing failed or data.ok was
        // false — Layout.astro's auth-gate script then saw neither a token
        // nor the google_auth param on the very next check and immediately
        // redirected to '/', which looked like "sign-in just sends me home"
        // even though the OAuth round-trip itself had succeeded.
        if (handled) {
          window.history.replaceState({}, '', window.location.pathname);
        }
      }
      if (googleError) {
        console.error('Google auth error:', googleError);
        window.history.replaceState({}, '', window.location.pathname);
      }
    }
    checkGoogleCallback();

    // Check for Stripe checkout redirect result (?checkout=success|cancelled&plan=X).
    // The checkout success_url lands back here with no visible confirmation and a
    // stale cached plan badge unless we surface it and re-fetch the account.
    function showCheckoutBanner(text, color) {
      const banner = document.createElement('div');
      banner.textContent = text;
      banner.style.cssText = `position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:9999;background:${color};color:#fff;padding:12px 20px;border-radius:10px;font-size:14px;font-weight:600;box-shadow:0 8px 24px rgba(0,0,0,0.4);`;
      document.body.appendChild(banner);
      setTimeout(() => banner.remove(), 5000);
    }
    async function checkStripeCheckoutResult() {
      const params = new URLSearchParams(window.location.search);
      const checkout = params.get('checkout');
      if (!checkout) return;
      const plan = params.get('plan');
      window.history.replaceState({}, '', window.location.pathname);
      if (checkout === 'success') {
        showCheckoutBanner(`✓ Payment successful${plan ? ' — ' + plan + ' plan activated' : ''}`, '#16a34a');
        const token = localStorage.getItem('hakster_google_token');
        if (token) {
          try {
            const res = await fetch(`${API}/api/auth/me`, { headers: { 'Authorization': `Bearer ${token}` } });
            const data = await res.json();
            if (data.user) {
              const accountPlan = document.getElementById('sidebar-account-plan') as HTMLSpanElement | null;
              if (accountPlan) accountPlan.textContent = data.user.plan || 'free';
            }
          } catch {}
        }
      } else if (checkout === 'cancelled') {
        showCheckoutBanner('Checkout cancelled', '#374151');
      }
    }

    document.getElementById('sidebar-referral-link')?.addEventListener('click', async (event) => {
      const btn = event.currentTarget as HTMLButtonElement;
      const link = btn.dataset.link || btn.textContent || '';
      if (!link) return;
      try {
        await navigator.clipboard.writeText(link);
        const original = btn.textContent;
        btn.textContent = 'Copied referral link';
        setTimeout(() => { btn.textContent = original; }, 1600);
      } catch {}
    });

    // Click API key to copy
    document.getElementById('sidebar-account-apikey')?.addEventListener('click', async () => {
      if (!googleToken) return;
      try {
        await navigator.clipboard.writeText(googleToken);
        const el = document.getElementById('sidebar-account-apikey');
        if (el) { const t = el.textContent; el.textContent = '✓ Copied!'; setTimeout(() => { if (el) el.textContent = t; }, 1500); }
      } catch {}
    });

    // ── Telegram Mini App auto-login ──────────────────────────────────
    // Google OAuth is blocked by Google itself inside Telegram's in-app
    // browser (disallowed_useragent) — when this page is opened from a bot's
    // menu button (@Haksterbotbot etc.), skip Google entirely and use
    // Telegram's own signed initData instead. Reuses the same storage keys
    // checkGoogleCallback() writes, so the rest of the app doesn't care which
    // login path was used.
    async function checkTelegramMiniApp() {
      try {
        const tg = (window as any).Telegram?.WebApp;
        if (!tg || !tg.initData) return; // not opened inside Telegram
        tg.ready();
        if (localStorage.getItem('hakster_google_token')) return; // already signed in
        const res = await fetch(`${API}/api/auth/telegram/webapp`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ initData: tg.initData }),
        });
        const data = await res.json();
        if (!data.ok) { console.error('Telegram Mini App login failed:', data.error); return; }
        googleToken = data.apiKey;
        googleUser = data.user;
        localStorage.setItem('hakster_google_token', googleToken!);
        localStorage.setItem('hakster_google_user', JSON.stringify(data.user));
        localStorage.setItem('hakster_user_data', JSON.stringify({ id: data.user.id || '', name: data.user.displayName || data.user.username || 'User', email: data.user.email || '', picture: data.user.picture || '' }));
        (window as any).haksterSessionTouch?.();
        showGoogleUserBadge(data.user);
      } catch (e) { console.error('Telegram Mini App login error:', e); }
    }

    initGoogleButton(); // Check for existing Google session
    checkGoogleCallback(); // Handle OAuth redirect result
    checkTelegramMiniApp(); // Handle Telegram Mini App auto-login (no-op outside Telegram)
    checkStripeCheckoutResult(); // Handle Stripe checkout redirect result

    // ===== Init =====
    loadModels(); loadProjects(); loadCapabilities(); renderHistoryList();
    const initActiveId = getActiveId();
    if (initActiveId) {
      const conv = loadConversations().find(c => c.id === initActiveId);
      if (conv && conv.messages.length > 0) { renderMessages(conv.messages); showMessagesView(); }
    }
  </script>
</Layout>
