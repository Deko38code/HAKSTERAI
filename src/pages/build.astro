    async function handleGoogleCredential(response: any) {
      const credential = response.credential;
      if (!credential) return;
      // Collect device info for tracking
      const device = {
        deviceType: /Mobi|Android/i.test(navigator.userAgent) ? 'mobile' : 'desktop',
        osName: navigator.platform || 'unknown',
        browser: navigator.userAgent.match(/(Chrome|Firefox|Safari|Edge|Opera)\/?[\s\d.]+/i)?.[0]?.split('/')[0] || 'unknown',
        screenSize: `${screen.width}x${screen.height}`,
        language: navigator.language || '',
        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || '',
      };
      try {
        const res = await fetch(`${API}/api/auth/google`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ credential, device, referralCode: getReferralCodeFromStorage() }),
        });
        const data = await res.json();
        if (data.ok) {
          googleToken = data.apiKey;
          googleUser = data.user;
          localStorage.setItem('hakster_google_token', googleToken!);
          localStorage.setItem('hakster_google_user', JSON.stringify(data.user));
          localStorage.setItem('hakster_user_data', JSON.stringify({ id: data.user.id || '', name: data.user.username || data.user.email || 'User', email: data.user.email || '', picture: data.user.picture || '' }));
          localStorage.removeItem('hakster_referral_code');
          (window as any).haksterSessionTouch?.();
          showGoogleUserBadge(data.user);
        }
      } catch (e) {
        console.error('Google auth failed:', e);
      }
    }

    function showGoogleUserBadge(user: any) {
      // Hero area badge
      const badge = document.getElementById('google-user-badge');
      const nameEl = document.getElementById('google-user-name') as HTMLSpanElement;
      const avatarEl = document.getElementById('google-user-avatar') as HTMLImageElement;
      if (badge && nameEl) {
        nameEl.textContent = user.username || user.email || 'User';
        if (avatarEl && user.picture) avatarEl.src = user.picture;
        badge.classList.remove('hidden');
        badge.classList.add('flex');
      }
      // Sidebar badge (bottom)
      const sidebarBadge = document.getElementById('sidebar-google-badge');
      const sidebarName = document.getElementById('sidebar-google-name') as HTMLSpanElement;
      const sidebarAvatar = document.getElementById('sidebar-google-avatar') as HTMLImageElement;
      if (sidebarBadge && sidebarName) {
        sidebarName.textContent = user.username || user.email || 'User';
        if (sidebarAvatar && user.picture) sidebarAvatar.src = user.picture;
        sidebarBadge.classList.remove('hidden');
        sidebarBadge.classList.add('flex');
      }
      // Settings panel account info
      const accountInfo = document.getElementById('sidebar-account-info');
      const accountSignin = document.getElementById('sidebar-account-signin');
      const accountName = document.getElementById('sidebar-account-name') as HTMLSpanElement;
      const accountEmail = document.getElementById('sidebar-account-email') as HTMLSpanElement;
      const accountAvatar = document.getElementById('sidebar-account-avatar') as HTMLImageElement;
      const accountRole = document.getElementById('sidebar-account-role') as HTMLSpanElement;
      const accountPlan = document.getElementById('sidebar-account-plan') as HTMLSpanElement;
      const accountKey = document.getElementById('sidebar-account-apikey') as HTMLDivElement;
      if (accountInfo && accountSignin) {
        accountInfo.classList.remove('hidden');
        accountSignin.classList.add('hidden');
        if (accountName) accountName.textContent = user.username || user.email || 'User';
        if (accountEmail) accountEmail.textContent = user.email || '—';
        if (accountAvatar && user.picture) accountAvatar.src = user.picture;
        if (accountRole) accountRole.textContent = user.role || 'user';
        if (accountPlan) accountPlan.textContent = user.plan || 'free';
        if (accountKey && googleToken) {
          const short = googleToken.slice(0, 12) + '...' + googleToken.slice(-4);
          accountKey.textContent = short;
          accountKey.title = 'Click to copy full API key';
        }
      }
      // Hide all sign-in buttons (both GSI placeholders and fallback buttons)
      ['google-signin-btn', 'sidebar-google-signin', 'sidebar-settings-google-btn',
       'google-fallback-btn', 'sidebar-google-fallback', 'settings-google-fallback'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.display = 'none';
      });
      // Load usage stats
      loadUsageStats();
      loadReferralCard();
    }

    // Fetch and display usage stats
    async function loadUsageStats() {
      const token = localStorage.getItem('hakster_google_token');
      if (!token) return;
      try {
        const res = await fetch(`${API}/api/usage`, { headers: { 'x-api-key': token } });
        const data = await res.json();
        const el = document.getElementById('sidebar-account-usage');
        if (!el) return;
        if (data.remaining === -1) {
          el.textContent = `✦ Unlimited · ${(data.tokenBalance || 0).toLocaleString()} tokens`;
          el.style.color = '#a855f7';
        } else if (data.limitEnabled) {
          el.textContent = `${data.remaining}/${data.limit} free uses left`;
          el.style.color = data.remaining <= 1 ? '#ef4444' : '#64748b';
        } else {
          el.textContent = `${data.used} uses · ${data.plan} plan`;
          el.style.color = '#64748b';
        }
      } catch {}
    }

    async function loadReferralCard() {
      const token = localStorage.getItem('hakster_google_token');
      const card = document.getElementById('sidebar-referral-card');
      const linkBtn = document.getElementById('sidebar-referral-link') as HTMLButtonElement | null;
      const tokenEl = document.getElementById('sidebar-token-balance');
      const metaEl = document.getElementById('sidebar-referral-meta');
      if (!token || !card || !linkBtn) return;
      try {
        const res = await fetch(`${API}/api/referrals`, { headers: { 'x-api-key': token } });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to load referrals');
        card.classList.remove('hidden');
        if (tokenEl) tokenEl.textContent = `${(data.tokenBalance || 0).toLocaleString()} tokens`;
        linkBtn.textContent = data.referralLink || 'Referral link unavailable';
        linkBtn.dataset.link = data.referralLink || '';
        if (metaEl) metaEl.textContent = `${data.totalReferrals || 0} referrals · +${(data.rewardTokens || 0).toLocaleString()} tokens per friend`;
      } catch {
        card.classList.add('hidden');
      }
    }

    // Logout — shared handler for both logout buttons
    function googleLogout() {
      localStorage.removeItem('hakster_google_token');
      localStorage.removeItem('hakster_google_user');
      localStorage.removeItem('hakster_user_data');
      localStorage.removeItem('hakster_last_activity');
      googleToken = null;
      googleUser = null;
      if (window.google && window.google.accounts && window.google.accounts.id) {
        window.google.accounts.id.disableAutoSelect();
      }
      location.reload();
    }

    document.getElementById('sidebar-google-logout')?.addEventListener('click', googleLogout);
    document.getElementById('sidebar-account-logout')?.addEventListener('click', googleLogout);
    document.getElementById('mobile-chat-logout')?.addEventListener('click', googleLogout);

    // Fallback Google buttons — use redirect-based OAuth flow
    function triggerGoogleRedirect() {
      const ref = getReferralCodeFromStorage();
      window.location.href = `${API}/api/auth/google/redirect${ref ? `?ref=${encodeURIComponent(ref)}` : ''}`;
    }
    document.getElementById('google-fallback-btn')?.addEventListener('click', triggerGoogleRedirect);
    document.getElementById('sidebar-google-fallback')?.addEventListener('click', triggerGoogleRedirect);
    document.getElementById('settings-google-fallback')?.addEventListener('click', triggerGoogleRedirect);

    // Check for OAuth callback result in URL
    function checkGoogleCallback() {
      const params = new URLSearchParams(window.location.search);
      const googleAuth = params.get('google_auth');
      const googleError = params.get('google_error');
      if (googleAuth) {
        try {
          const data = JSON.parse(decodeURIComponent(googleAuth));
          if (data.ok) {
            googleToken = data.apiKey;
            googleUser = data.user;
            localStorage.setItem('hakster_google_token', googleToken!);
            localStorage.setItem('hakster_google_user', JSON.stringify(data.user));
            localStorage.setItem('hakster_user_data', JSON.stringify({ id: data.user.id || '', name: data.user.username || data.user.email || 'User', email: data.user.email || '', picture: data.user.picture || '' }));
            localStorage.removeItem('hakster_referral_code');
            (window as any).haksterSessionTouch?.();
            showGoogleUserBadge(data.user);
            const postAuthRedirect = sessionStorage.getItem('hakster_post_auth_redirect');
            if (postAuthRedirect) {
              sessionStorage.removeItem('hakster_post_auth_redirect');
              window.location.href = postAuthRedirect;
              return;
            }
          }
        } catch {}
        // Clean URL
        window.history.replaceState({}, '', window.location.pathname);
      }
      if (googleError) {
        console.error('Google auth error:', googleError);
        window.history.replaceState({}, '', window.location.pathname);
      }
    }
    checkGoogleCallback();

    document.getElementById('sidebar-referral-link')?.addEventListener('click', async (event) => {
      const btn = event.currentTarget as HTMLButtonElement;
      const link = btn.dataset.link || btn.textContent || '';
      if (!link) return;
      try {
        await navigator.clipboard.writeText(link);
        const original = btn.textContent;
        btn.textContent = 'Copied referral link';
        setTimeout(() => { btn.textContent = original; }, 1600);
      } catch {}
    });

    // Click API key to copy
    document.getElementById('sidebar-account-apikey')?.addEventListener('click', async () => {
      if (!googleToken) return;
      try {
        await navigator.clipboard.writeText(googleToken);
        const el = document.getElementById('sidebar-account-apikey');
        if (el) { const t = el.textContent; el.textContent = '✓ Copied!'; setTimeout(() => { if (el) el.textContent = t; }, 1500); }
      } catch {}
    });

    initGoogleButton(); // Check for existing Google session
    checkGoogleCallback(); // Handle OAuth redirect result

    // ===== Init =====
    loadModels(); loadProjects(); loadCapabilities(); renderHistoryList();
    const initActiveId = getActiveId();
    if (initActiveId) {
      const conv = loadConversations().find(c => c.id === initActiveId);
      if (conv && conv.messages.length > 0) { renderMessages(conv.messages); showMessagesView(); }
    }
  </script>
</Layout>
