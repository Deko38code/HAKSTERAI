    function cleanSpeechText(text: string) {
      return text
        .replace(/```[\s\S]*?```/g, ' code block omitted. ')
        .replace(/`([^`]+)`/g, '$1')
        .replace(/https?:\/\/\S+/g, ' link ')
        .replace(/\s+/g, ' ')
        .trim()
        .slice(0, 4000);
    }

    function speakText(text: string) {
      if (!voiceEnabled || !('speechSynthesis' in window)) return;
      const clean = cleanSpeechText(text);
      if (!clean) return;
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(clean);
      const selected = availableVoices.find(v => v.name === voiceSelect.value);
      if (selected) utterance.voice = selected;
      utterance.rate = Number(voiceRate.value || 1);
      utterance.pitch = Number(voicePitch.value || 1);
      utterance.onstart = () => setVoiceStatus('Speaking agent reply...');
      utterance.onend = () => setVoiceStatus('Voice ready.');
      utterance.onerror = () => setVoiceStatus('Voice playback stopped.');
      window.speechSynthesis.speak(utterance);
    }

    function updateVoiceButtons() {
      voiceOutputBtn.classList.toggle('active', voiceEnabled);
      if (voiceOutputLabel) voiceOutputLabel.textContent = voiceEnabled ? 'Voice on' : 'Voice';
      voiceInputBtn.classList.toggle('active', listening);
      if (voiceInputLabel) voiceInputLabel.textContent = listening ? 'Listening' : 'Mic';
    }

    function setupSpeechRecognition() {
      const SpeechRecognitionCtor = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
      if (!SpeechRecognitionCtor) {
        voiceInputBtn.classList.add('disabled');
        setVoiceStatus('Speech recognition is not supported in this browser.');
        return;
      }
      recognition = new SpeechRecognitionCtor();
      recognition.continuous = true;
      recognition.interimResults = true;
      recognition.lang = navigator.language || 'en-US';
      let finalTranscript = '';
      recognition.onstart = () => {
        listening = true;
        finalTranscript = '';
        setVoiceStatus('Listening...');
        updateVoiceButtons();
      };
      recognition.onresult = (event: any) => {
        let interim = '';
        for (let i = event.resultIndex; i < event.results.length; i++) {
          const transcript = event.results[i][0]?.transcript || '';
          if (event.results[i].isFinal) finalTranscript += transcript;
          else interim += transcript;
        }
        const base = chatInput.value.replace(/\s*\[listening:.*?\]\s*$/i, '').trim();
        chatInput.value = `${base}${base && (finalTranscript || interim) ? ' ' : ''}${finalTranscript}${interim ? ` [listening: ${interim.trim()}]` : ''}`.trimStart();
        setReadyState();
      };
      recognition.onerror = (event: any) => {
        setVoiceStatus(`Mic error: ${event.error || 'unknown'}`);
      };
      recognition.onend = () => {
        listening = false;
        chatInput.value = chatInput.value.replace(/\s*\[listening:.*?\]\s*$/i, '').trim();
        setReadyState();
        updateVoiceButtons();
        setVoiceStatus('Mic ready.');
      };
    }

