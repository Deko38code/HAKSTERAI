  <style is:global>
    /* ── Chat-style minimal composer buttons ── */
    .composer-btn { display: inline-flex; align-items: center; justify-content: center; border-radius: 9999px; border: none; background: transparent; padding: 0; width: 32px; height: 32px; min-width: 0; color: #fff; cursor: pointer; transition: background 0.15s; flex-shrink: 0; }
    .composer-btn:hover { background: #222; }
    .composer-btn:active { background: #333; }
    .composer-pill { display: inline-flex; align-items: center; gap: 0.375rem; border-radius: 8px; border: none; background: #222; padding: 0 8px; height: 28px; font-size: 12px; font-weight: 500; color: #fff; cursor: pointer; transition: background 0.15s; flex-shrink: 0; }
    .composer-pill:hover { background: #333; }
    .composer-pill.active { background: #7c3aed; color: #fff; }
    .send-btn { display: inline-flex; align-items: center; justify-content: center; border-radius: 9999px; padding: 0; width: 32px; height: 32px; min-width: 0; background: #fff; color: #000; border: none; cursor: pointer; transition: opacity 0.15s; flex-shrink: 0; }
    .send-btn:disabled { pointer-events: none; opacity: 0.3; }
    .send-btn:hover { opacity: 0.9; }
    .send-btn .send-spinner { display: none; animation: sendSpin 1s linear infinite; }
    .send-btn.busy svg:first-child { display: none; }
    .send-btn.busy .send-spinner { display: block; }
    @keyframes sendSpin { to { transform: rotate(360deg); } }
    .send-status { display: inline-flex; align-items: center; gap: 0.4rem; margin: 0 0.5rem 0.35rem; font-size: 11px; font-weight: 500; color: #a78bfa; }
    .send-status.hidden { display: none; }
    .send-status-dot { width: 7px; height: 7px; border-radius: 9999px; background: #a78bfa; }
    .send-status.spinning .send-status-dot { animation: pulseDot 1.2s ease-in-out infinite; }
    @keyframes pulseDot { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(1.35); } }
    /* Codex-CLI-style pulsing color status text — the label itself breathes through
       a small color cycle while work is in progress, instead of staying a flat purple. */
    .send-status.spinning .send-status-text { animation: statusColorPulse 2.4s ease-in-out infinite; }
    @keyframes statusColorPulse {
      0%   { color: #a78bfa; }
      35%  { color: #f0abfc; }
      65%  { color: #7dd3fc; }
      100% { color: #a78bfa; }
    }
    .chat-fullscreen-btn {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      z-index: 25;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 0.75rem;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(17,17,17,0.78);
      color: rgba(255,255,255,0.58);
      backdrop-filter: blur(12px);
      transition: color 0.15s, border-color 0.15s, background 0.15s, transform 0.15s;
    }
    .chat-fullscreen-btn:hover {
      color: #fff;
      border-color: rgba(124,58,237,0.45);
      background: rgba(124,58,237,0.16);
    }
    .chat-fullscreen-btn:active { transform: scale(0.96); }
    #hacker-chat.chat-fullscreen-fallback {
      position: fixed;
      inset: 0;
      z-index: 9999;
      height: 100dvh;
      width: 100vw;
    }
    #messages-area,
    #output-panel {
      min-height: 0;
      scroll-behavior: smooth;
      overscroll-behavior: contain;
    }
    .output-user { color: #c084fc; }
    .output-error { color: #ff7b7b; }
    .output-result { color: #f1f5f9; }
    .output-thinking { color: #38bdf8; opacity: 0.9; }
    /* Message styles moved to Ink & grid section below */
    .bubble-action { display: inline-flex; align-items: center; justify-content: center; gap: 0.2rem; border-radius: 9999px; border: 1px solid rgba(0,255,255,0.2); background: rgba(0,255,255,0.06); padding: 0.18rem 0.48rem; font-size: 0.58rem; color: #00ffff; transition: all 0.15s; cursor: pointer; }
    .bubble-action:hover { color: #ffffff; border-color: rgba(0,255,255,0.55); background: rgba(0,255,255,0.15); }
    .bubble-action.copied { color: #34d399; border-color: rgba(52,211,153,0.4); background: rgba(52,211,153,0.08); }
    .bubble-action svg { width: 9px; height: 9px; flex-shrink: 0; }
    .bubble-action .copy-label, .bubble-action span { font-size: 0.55rem; }
    /* ── Separator between bubble header (label + actions) and body ── TIGHT: widgets sit right on top of output */
    .msg-bubble > div:first-child {
      padding-bottom: 0.25rem;
      margin-bottom: 0.25rem;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .msg-bubble > div:first-child .bubble-action { opacity: 0.85; }
    .msg-bubble > div:first-child:hover .bubble-action { opacity: 1; }
    /* The message body gets minimal top separation — widgets are tight on top */
    .msg-bubble .msg-body { padding-top: 0.15rem; margin-top: 0; }
    /* Script bubbles — tui-code-block needs minimal top spacing so copy/paste widgets sit right on top of code output */
    .msg-script > div:first-child { padding-bottom: 0.25rem; margin-bottom: 0.15rem; border-bottom: 1px solid rgba(16,185,129,0.12); }
    .msg-script .tui-code-block { margin-top: 0; }
    /* Bubble header wraps label and actions with proper flex layout */
    .bubble-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap; }
    .bubble-actions { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; justify-content: flex-end; }
    .code-block-wrapper { position: relative; }
    .code-block-wrapper .code-copy-btn { position: absolute; top: 6px; right: 6px; opacity: 0; transition: opacity 0.15s; }
    .code-block-wrapper:hover .code-copy-btn { opacity: 1; }
    .attachment-chip { display: inline-flex; align-items: center; gap: 0.5rem; max-width: 220px; border-radius: 0.75rem; border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.04); padding: 0.35rem 0.5rem; }

    /* ── TUI Code Block Styling ── */
    .tui-code-block {
      position: relative;
      border-radius: 0.5rem;
      border: 1px solid rgba(56,189,248,0.22);
      background:
        linear-gradient(90deg, rgba(56,189,248,0.06) 0 3px, transparent 3px),
        rgba(2,6,16,0.96);
      overflow: hidden;
      margin: 1.15rem 0;
      box-shadow: 0 0 0 1px rgba(124,58,237,0.12) inset, 0 10px 28px rgba(0,0,0,0.24);
    }
    .tui-code-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.45rem 0.75rem;
      background: linear-gradient(90deg, rgba(56,189,248,0.12), rgba(124,58,237,0.1));
      border-bottom: 1px solid rgba(56,189,248,0.18);
    }
    .tui-code-lang { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #7dd3fc; font-family: 'JetBrains Mono', 'Fira Code', monospace; }
    .tui-code-copy { display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.6rem; color: rgba(255,255,255,0.35); cursor: pointer; transition: color 0.15s; }
    .tui-code-copy:hover { color: #fff; }
    .tui-code-copy.copied { color: #34d399; }
    .tui-code-copy svg { width: 10px; height: 10px; }
    .tui-code-download { display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.6rem; color: rgba(255,255,255,0.3); cursor: pointer; transition: color 0.15s; }
    .tui-code-download:hover { color: #7c3aed; }
    .tui-code-download.copied { color: #34d399; }
    .tui-code-download svg { width: 10px; height: 10px; }
    .tui-code-body {
      padding: 0;
      overflow: auto;
      background:
        linear-gradient(90deg, rgba(8,13,25,0.96) 0 3.1rem, rgba(56,189,248,0.14) 3.1rem 3.16rem, transparent 3.16rem),
        repeating-linear-gradient(to bottom, transparent 0 1.5em, rgba(56,189,248,0.15) 1.5em 3em);
    }
    .tui-code-body pre { margin: 0; padding: 0.75rem 0.9rem 0.85rem 0; font-size: 0.8rem; line-height: 1.5; font-family: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace; white-space: pre; color: #edf2f7; text-shadow: 0 0 8px rgba(56,189,248,0.08); }
    .tui-code-body pre .ln { display: inline-block; width: 2.7rem; color: rgba(125,211,252,0.7); text-align: right; padding-right: 0.7rem; user-select: none; margin-right: 0.65rem; border-right: 1px solid rgba(56,189,248,0.12); }
    .tui-code-body pre code { color: #edf2f7; }
    /* Inline code */
    .msg-body code:not(pre code) { background: rgba(124,58,237,0.12); border: 1px solid rgba(124,58,237,0.2); border-radius: 0.25rem; padding: 0.1rem 0.35rem; font-size: 0.85em; font-family: 'JetBrains Mono', 'Fira Code', monospace; color: #d8b4fe; }
    .msg-body { line-height: 1.65; word-break: break-word; color: #e5e7eb; }
    .msg-body p { margin: 0.25rem 0; }
    .msg-body ul, .msg-body ol { margin: 0.25rem 0; padding-left: 1.25rem; }
    .msg-body li { margin: 0.1rem 0; }
    .msg-body strong { color: #fff; font-weight: 600; }
    .msg-body a { color: #60a5fa; text-decoration: underline; text-underline-offset: 2px; text-decoration-color: rgba(96,165,250,0.4); transition: text-decoration-color 0.15s, color 0.15s; }
    .msg-body a:hover { color: #93c5fd; text-decoration-color: #60a5fa; }
    /* Web search result links — highlighted with background tint + bold underline so users can see what the agent found */
    .msg-search a { color: #fbbf24; text-decoration: underline; text-decoration-color: #fbbf24; text-underline-offset: 3px; text-decoration-thickness: 2px; font-weight: 600; background: rgba(251,191,36,0.1); padding: 0.05rem 0.3rem; border-radius: 0.25rem; transition: all 0.15s; }
    .msg-search a:hover { color: #fcd34d; text-decoration-color: #fcd34d; background: rgba(251,191,36,0.2); opacity: 0.95; }
    .msg-search .search-url { color: #fbbf24; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 2px; text-decoration-color: rgba(251,191,36,0.6); word-break: break-all; font-size: 0.85em; background: rgba(251,191,36,0.08); padding: 0.05rem 0.25rem; border-radius: 0.2rem; }
    /* ── Search result entries — highlighted + underlined links ── */
    .search-result-entry { padding: 0.3rem 0.5rem; margin: 0.2rem 0; border-radius: 0.4rem; background: rgba(251,191,36,0.06); border-left: 2px solid rgba(251,191,36,0.3); transition: background 0.15s; }
    .search-result-entry:hover { background: rgba(251,191,36,0.12); }
    .search-emoji { font-size: 0.9em; margin-right: 0.15rem; }
    .search-result-link { color: #fbbf24 !important; text-decoration: underline !important; text-underline-offset: 2px; text-decoration-thickness: 1.5px; text-decoration-color: #fbbf24 !important; font-weight: 600 !important; word-break: break-all; background: rgba(251,191,36,0.1); padding: 0.05rem 0.25rem; border-radius: 0.2rem; transition: all 0.15s; }
    .search-result-link:hover { color: #fcd34d !important; text-decoration-color: #fcd34d !important; background: rgba(251,191,36,0.2) !important; }
    .search-result-url { display: block; color: #fbbf24 !important; text-decoration: underline !important; text-underline-offset: 2px; text-decoration-thickness: 1.5px; text-decoration-color: #fbbf24 !important; font-weight: 600 !important; word-break: break-all; font-size: 0.85em; background: rgba(251,191,36,0.1); padding: 0.15rem 0.35rem; border-radius: 0.3rem; margin: 0.15rem 0; transition: all 0.15s; }
    .search-result-url:hover { color: #fcd34d !important; text-decoration-color: #fcd34d !important; background: rgba(251,191,36,0.2) !important; }
    .search-result-header { font-weight: 700; color: #fcd34d; font-size: 0.85rem; margin-bottom: 0.3rem; padding: 0.2rem 0; border-bottom: 1px solid rgba(251,191,36,0.15); }
    .attachment-chip img { height: 2.25rem; width: 2.25rem; object-fit: cover; border-radius: 0.5rem; }
    .attachment-chip span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.75rem; color: rgba(255,255,255,0.7); }
    .attachment-chip button { flex: 0 0 auto; color: rgba(255,255,255,0.35); transition: color 0.15s; }
    .attachment-chip button:hover { color: #fff; }
    .history-item { transition: all 0.12s; }
    .history-item:hover { background: rgba(255,255,255,0.04); }
    .history-item.active { background: rgba(124,58,237,0.12); border-color: rgba(124,58,237,0.3); }
    .sidebar-scroll { overflow: auto; scrollbar-color: #7c3aed transparent; scrollbar-width: thin; }
    .sidebar-scroll::-webkit-scrollbar { width: 8px; height: 8px; }
    .sidebar-scroll::-webkit-scrollbar-track { background: transparent; }
    .sidebar-scroll::-webkit-scrollbar-thumb { background: rgba(124,58,237,0.45); border-radius: 999px; }
    .sidebar-scroll::-webkit-scrollbar-thumb:hover { background: rgba(124,58,237,0.85); }
    .sidebar-scroll::-webkit-scrollbar-corner { background: transparent; }

    /* ── Ink & grid layout around chats ── */
    /* Faint blueprint grid behind the message stream */
    .chat-grid-bg {
      position: relative;
      background-color: #101010;
      background-image:
        linear-gradient(to right, rgba(56,189,248,0.16) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(56,189,248,0.16) 1px, transparent 1px),
        linear-gradient(to right, rgba(124,58,237,0.11) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(124,58,237,0.11) 1px, transparent 1px),
        linear-gradient(to right, rgba(255,255,255,0.055) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255,255,255,0.055) 1px, transparent 1px),
        radial-gradient(circle at top center, rgba(56,189,248,0.08), transparent 48%);
      background-size: 96px 96px, 96px 96px, 48px 48px, 48px 48px, 24px 24px, 24px 24px, 100% 100%;
      background-position: -1px -1px, -1px -1px, -1px -1px, -1px -1px, -1px -1px, -1px -1px, 0 0;
    }
    .chat-grid-bg::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image: url('/logo.png');
      background-repeat: no-repeat;
      background-position: center 18%;
      background-size: min(92vw, 980px) auto;
      opacity: 0.18;
      mix-blend-mode: screen;
      filter: saturate(1.18) blur(0.5px);
      z-index: 0;
    }
    .chat-grid-bg::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(circle at center 20%, transparent 0 22%, rgba(16,16,16,0.72) 58%, rgba(16,16,16,0.9) 100%);
      z-index: 0;
    }
    .chat-grid-bg > * {
      position: relative;
      z-index: 1;
    }
    .chat-side-grid {
      overflow: hidden;
      background:
        linear-gradient(to right, rgba(56,189,248,0.2) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(56,189,248,0.2) 1px, transparent 1px),
        linear-gradient(to right, rgba(124,58,237,0.13) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(124,58,237,0.13) 1px, transparent 1px),
        radial-gradient(circle at top right, rgba(56,189,248,0.2), transparent 48%),
        rgba(8,10,18,0.96);
      background-size: 32px 32px, 32px 32px, 16px 16px, 16px 16px, 100% 100%, 100% 100%;
      box-shadow: 0 0 0 1px rgba(56,189,248,0.12) inset, 0 18px 38px rgba(0,0,0,0.42);
    }
    .chat-side-grid::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image: url('/logo.png');
      background-repeat: no-repeat;
      background-position: center;
      background-size: min(92%, 340px) auto;
      opacity: 0.13;
      mix-blend-mode: screen;
      filter: saturate(1.2) blur(0.5px);
      z-index: 0;
    }
    .chat-side-grid::after {
