    function updateProjectPathLabel() {
      if (!sidebarProjectPath) return;
      sidebarProjectPath.textContent = activeProjectCwd ? `Project: ${activeProjectCwd}` : 'Project: session workspace';
      sidebarProjectPath.title = activeProjectCwd || 'Session workspace';
    }

    async function loadProjects() {
      if (!sidebarProjectSelect) return;
      const previous = activeProjectCwd;
      sidebarProjectSelect.innerHTML = '';
      const fallback = document.createElement('option');
      fallback.value = '';
      fallback.textContent = 'Session workspace';
      sidebarProjectSelect.appendChild(fallback);
      try {
        const res = await fetch(`${API}/api/machine-context`);
        if (res.ok) {
          const data = await res.json();
          const seen = new Set<string>();
          (data.folders || []).forEach((folder: any) => {
            const folderPath = String(folder?.path || '');
            if (!folderPath || seen.has(folderPath)) return;
            seen.add(folderPath);
            const opt = document.createElement('option');
            opt.value = folderPath;
            opt.textContent = folder?.label ? `${folder.label} — ${folderPath}` : folderPath;
            sidebarProjectSelect.appendChild(opt);
          });
        }
      } catch {}
      if (previous && [...sidebarProjectSelect.options].some(opt => opt.value === previous)) {
        sidebarProjectSelect.value = previous;
      } else if (previous) {
        activeProjectCwd = '';
        localStorage.removeItem('hakster-active-project-cwd');
      }
      updateProjectPathLabel();
    }

    sidebarProjectSelect?.addEventListener('change', () => {
      activeProjectCwd = sidebarProjectSelect.value;
      if (activeProjectCwd) localStorage.setItem('hakster-active-project-cwd', activeProjectCwd);
      else localStorage.removeItem('hakster-active-project-cwd');
      updateProjectPathLabel();
    });

    function isCerebrasModel(model: any) {
      const id = typeof model === 'string' ? model : `${model?.id || ''} ${model?.name || ''}`;
      return /cerebras/i.test(id);
    }

    async function loadModels() {
      let models: string[] = [...FALLBACK_MODELS];
      // Use codex fallbacks when codex provider is active
      if (currentProvider === 'codex') models = [...CODEX_FALLBACK_MODELS];
      if (currentProvider === 'nous') models = [...NOUS_FALLBACK_MODELS];
      try {
        const dashboardRes = await fetch(`${API}/api/dashboard`);
        if (dashboardRes.ok) {
          const dashboard = await dashboardRes.json();
          currentProvider = dashboard.crush?.provider || currentProvider;
          currentModel = dashboard.crush?.model || currentModel;
        }
        const modelsRes = await fetch(`${API}/api/providers/${encodeURIComponent(currentProvider)}/models`);
        if (modelsRes.ok) {
          const data = await modelsRes.json();
          const loaded = (data.models || [])
            .filter((model: any) => !isCerebrasModel(model))
            .map((model: any) => model.id || model.name || model)
            .filter(Boolean);
          if (loaded.length) models = loaded;
        }
      } catch {}
      models = models.filter((model: string) => !/cerebras/i.test(model));
      if (currentModel && !/cerebras/i.test(currentModel) && !models.includes(currentModel)) models.unshift(currentModel);
      const populate = (sel: HTMLSelectElement) => {
        sel.innerHTML = '';
        models.forEach((m: string) => { const opt = document.createElement('option'); opt.value = m; opt.textContent = m; sel.appendChild(opt); });
        if (currentModel && models.includes(currentModel)) sel.value = currentModel;
        else if (models.includes('gpt-oss:120b-cloud')) sel.value = 'gpt-oss:120b-cloud';
      };
      populate(modelSelect); populate(sidebarModelSelect);
      currentModel = modelSelect.value;
      const syncModel = async (model: string) => {
        if (!model || /cerebras/i.test(model)) return;
        currentModel = model; modelSelect.value = model; sidebarModelSelect.value = model;
        try {
          await fetch(`${API}/api/crush/config`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ provider: currentProvider, model }),
          });
        } catch {}
      };
      modelSelect.addEventListener('change', () => syncModel(modelSelect.value));
      sidebarModelSelect.addEventListener('change', () => syncModel(sidebarModelSelect.value));
    }

    async function loadCapabilities() {
      try {
        const dashRes = await fetch(`${API}/api/dashboard`); const dash = await dashRes.json();
        const capRes = await fetch(`${API}/api/agent/capabilities`); const caps = await capRes.json();
        const fcOk = caps.firecrawl && caps.firecrawl.keyCount > 0;
        const statusModel = dash.crush?.model || currentModel;
        const statusProvider = dash.crush?.provider || currentProvider;
        const statusText = `${statusProvider}/${statusModel} · Firecrawl ${fcOk ? '✓' : 'missing'}`;
        const dotClass = fcOk ? 'h-2 w-2 rounded-full bg-emerald-400' : 'h-2 w-2 rounded-full bg-yellow-300';
        fcDot.className = dotClass; fcStatus.textContent = statusText;
        sidebarFcDot.className = dotClass; sidebarFcText.textContent = statusText;
      } catch {
        const errText = 'Agent offline'; fcDot.className = 'h-2 w-2 rounded-full bg-red-400'; fcStatus.textContent = errText;
        sidebarFcDot.className = 'h-2 w-2 rounded-full bg-red-400'; sidebarFcText.textContent = errText;
      }
    }

    // ===== UI Helpers =====
    function setReadyState() { sendBtn.disabled = (!chatInput.value.trim() && pendingImages.length === 0) || busy; }
    function renderAttachments() {
      const strip = document.getElementById('attachment-strip')!;
      strip.innerHTML = '';
      if (pendingImages.length === 0) { strip.classList.add('hidden'); return; }
      strip.classList.remove('hidden');
      pendingImages.forEach((img, idx) => {
        const chip = document.createElement('div');
        chip.className = 'attachment-chip';
        chip.innerHTML = `<img src="${img.dataUrl}" alt="" /><span title="${escapeHtml(img.name)}">${escapeHtml(img.name)}</span><button type="button" aria-label="Remove attachment">×</button>`;
        chip.querySelector('button')!.addEventListener('click', () => {
          pendingImages.splice(idx, 1);
          renderAttachments();
          setReadyState();
        });
        strip.appendChild(chip);
      });
    }
    function fileToDataUrl(file: File): Promise<string> {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result || ''));
        reader.onerror = () => reject(reader.error || new Error('Could not read image'));
        reader.readAsDataURL(file);
      });
    }
    async function attachFiles(files: FileList | File[]) {
      const imageFiles = Array.from(files).filter(file => file.type.startsWith('image/')).slice(0, 6);
      for (const file of imageFiles) pendingImages.push({ name: file.name, dataUrl: await fileToDataUrl(file) });
      renderAttachments();
      setReadyState();
    }
    function appendOutput(text: string, cls = 'result') {
      outputPanel.classList.remove('hidden');
      const line = document.createElement('div'); line.className = `output-${cls}`; line.textContent = text;
      outputArea.appendChild(line);
      scrollPanelToBottom(outputPanel, true);
    }

    function persistVoiceSettings() {
      localStorage.setItem('hakster-voice-enabled', voiceEnabled ? '1' : '0');
      localStorage.setItem('hakster-voice-name', voiceSelect.value || '');
      localStorage.setItem('hakster-voice-rate', voiceRate.value || '1');
      localStorage.setItem('hakster-voice-pitch', voicePitch.value || '1');
    }

    function setVoiceStatus(text: string) {
      voiceStatus.textContent = text;
    }

    function populateVoices() {
      if (!('speechSynthesis' in window)) {
        voiceOutputBtn.classList.add('disabled');
        if (voiceOutputLabel) voiceOutputLabel.textContent = 'No voice';
        setVoiceStatus('Speech output is not supported in this browser.');
        return;
      }
      availableVoices = window.speechSynthesis.getVoices();
      const savedVoice = localStorage.getItem('hakster-voice-name') || '';
      voiceSelect.innerHTML = '<option value="">System default</option>';
      availableVoices.forEach((voice) => {
        const opt = document.createElement('option');
        opt.value = voice.name;
        opt.textContent = `${voice.name}${voice.lang ? ` (${voice.lang})` : ''}`;
        voiceSelect.appendChild(opt);
      });
      if (savedVoice && availableVoices.some(v => v.name === savedVoice)) voiceSelect.value = savedVoice;
    }

    function cleanSpeechText(text: string) {
      return text
        .replace(/```[\s\S]*?```/g, ' code block omitted. ')
        .replace(/`([^`]+)`/g, '$1')
        .replace(/https?:\/\/\S+/g, ' link ')
        .replace(/\s+/g, ' ')
        .trim()
        .slice(0, 4000);
    }

    function speakText(text: string) {
      if (!voiceEnabled || !('speechSynthesis' in window)) return;
      const clean = cleanSpeechText(text);
      if (!clean) return;
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(clean);
      const selected = availableVoices.find(v => v.name === voiceSelect.value);
      if (selected) utterance.voice = selected;
      utterance.rate = Number(voiceRate.value || 1);
      utterance.pitch = Number(voicePitch.value || 1);
      utterance.onstart = () => setVoiceStatus('Speaking agent reply...');
      utterance.onend = () => setVoiceStatus('Voice ready.');
      utterance.onerror = () => setVoiceStatus('Voice playback stopped.');
      window.speechSynthesis.speak(utterance);
    }

    function updateVoiceButtons() {
      voiceOutputBtn.classList.toggle('active', voiceEnabled);
      if (voiceOutputLabel) voiceOutputLabel.textContent = voiceEnabled ? 'Voice on' : 'Voice';
