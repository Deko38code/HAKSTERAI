    async function sendMessage(prompt: string) {
      const attachedImages = [...pendingImages];
      const userPrompt = prompt || (attachedImages.length ? 'Analyze the attached image(s) and help me with them.' : '');
      setBusyState(true); chatInput.disabled = true; if (sendState) sendState.textContent = 'Running';
      const model = currentModel || modelSelect.value || 'glm-5.2:cloud';
      let activeId = getActiveId(); let convs = loadConversations(); let conv = convs.find(c => c.id === activeId);
      if (!conv) { conv = createConversation(userPrompt, model); activeId = conv.id; }
      else if (conv.messages.length === 0) { updateConversationTitle(conv.id, userPrompt); }
      else { sendClientContext(conv.id); } // update device context on existing session (user may have switched devices)
      showMessagesView();
      const userMsg: Message = { role: 'user', content: attachedImages.length ? `${userPrompt}\n\n[${attachedImages.length} image attachment${attachedImages.length === 1 ? '' : 's'}]` : userPrompt };
      conv.messages.push(userMsg); saveConversation(conv); addMessageBubble(userMsg); renderHistoryList();
      const endpoint = agentMode ? `${API}/api/agent/run` : `${API}/api/chat`;
      const authHeaders: Record<string,string> = { 'Content-Type': 'application/json' };
      const gtoken = localStorage.getItem('hakster_google_token');
      if (gtoken) authHeaders['x-api-key'] = gtoken;
      let fileCreatedThisStream = false;
      let assistantContent = '';
      try {
        if (agentMode) {
          const allMessages = conv.messages.map(m => ({ role: m.role === 'user' ? 'user' : 'assistant', content: m.content }));
          if (attachedImages.length > 0) {
            allMessages[allMessages.length - 1].content = [
              { type: 'text', text: userPrompt },
              ...attachedImages.map(img => ({ type: 'image_url', image_url: { url: img.dataUrl } })),
            ];
          }
          const outboundMessages = attachedImages.length > 0
            ? [allMessages[allMessages.length - 1]]
            : allMessages.slice(-20);
          const res = await fetch(endpoint, {
            method: 'POST', headers: authHeaders,
            body: JSON.stringify({ provider: currentProvider, model, sessionId: conv.id, stream: true,
              approvalMode: 'full-auto',
              thinking: true,
              cwd: activeProjectCwd || undefined,
              messages: [{ role: 'system', content: IMAGE_INSTRUCTION }, ...outboundMessages] }),
          });
          if (!res.ok || !res.body) {
            const errData = await res.json().catch(() => ({}));
            throw { status: res.status, message: errData.error || `Agent request failed (${res.status})` };
          }
          const assistantMsg: Message = { role: 'assistant', content: '' };
          conv.messages.push(assistantMsg); saveConversation(conv);
          addMessageBubble({ role: 'assistant', content: '...' });
          const reader = res.body.getReader(); const decoder = new TextDecoder(); let buffer = '';
          const lastBubble = messagesContainer.querySelector('.msg-assistant:last-child .msg-body') as HTMLElement;
          if (lastBubble) lastBubble.textContent = '';
          const scriptOutputs = new Map<string, { el: HTMLElement; msg: Message; rawEl?: HTMLElement | null; pending?: string; raf?: number | null }>();
          const webOutputs = new Map<string, Message>();
          setAgentLoopStatus(lastBubble, 'Thinking...');
          const _saveConvDebounced = (() => {
            let timer: any = null;
            return (conv: Conversation) => {
              if (timer) return;
              timer = setTimeout(() => {
                timer = null;
                saveConversation(conv);
              }, 400);
            };
          })();
          const _scrollThrottle = (() => {
            let queued = false;
            return () => {
              if (queued) return;
              queued = true;
              requestAnimationFrame(() => { queued = false; maybeScroll(); });
            };
          })();
          const flushScriptOutput = (entry: { el: HTMLElement; msg: Message; rawEl?: HTMLElement | null; pending?: string; raf?: number | null; isFinal?: boolean }) => {
            entry.raf = null;
            const next = entry.pending || '';
            entry.pending = '';
            if (next) entry.msg.content += next;
            if (entry.msg.content.length > 12000) {
              entry.msg.content = `${entry.msg.content.slice(0, 12000)}\n... (output truncated in chat)`;
              entry.pending = '';
            }
            if (!entry.rawEl) entry.rawEl = entry.el.closest('.msg-bubble')?.querySelector('.script-raw') as HTMLElement | null;
            if (entry.rawEl) entry.rawEl.textContent = entry.msg.content;
            // Throttle HTML re-render: only re-render on final flush or every ~150ms
            const now = Date.now();
            if (entry.isFinal || !entry._lastRender || now - entry._lastRender > 150) {
              entry._lastRender = now;
              entry.el.innerHTML = renderScriptLines(entry.msg.content);
            }
            if (entry.isFinal) saveConversation(conv);
            else _saveConvDebounced(conv);
            _scrollThrottle();
          };
          let tokenCount = 0;
          let renderTimer: any = null;
          while (true) {
            const { done, value } = await reader.read(); if (done) break;
            buffer += decoder.decode(value, { stream: true }); const lines = buffer.split('\n'); buffer = lines.pop() || '';
            for (const line of lines) {
              if (!line.startsWith('data: ')) continue; const raw = line.slice(6).trim(); if (!raw) continue;
              try {
                const event = JSON.parse(raw);
                if (event.type === 'content' || event.type === 'delta') {
                  if (lastBubble) lastBubble.textContent += event.content || '';
                  assistantMsg.content += event.content || ''; tokenCount++;
                  // NOTE: do NOT call setThinkingFinished here — it resets thinking
                  // accumulation state and does synchronous DOM writes.  Only
                  // thinking_end / done events should finalise thinking.
                  // Debounced code block re-render — only when we detect a closing fence
                  if (assistantMsg.content.includes('```')) {
                    if (renderTimer) clearTimeout(renderTimer);
                    renderTimer = setTimeout(() => {
                      if (lastBubble) {
                        lastBubble.innerHTML = renderCodeBlocks(assistantMsg.content);
                        attachCodeCopyHandlers(lastBubble.parentElement || lastBubble as HTMLElement);
                        _scrollThrottle();
                      }
                    }, 300);
                  }
                  _scrollThrottle();
                } else if (event.type === 'thinking_start') {
                  // Reset accumulation state for a new thinking session
                  _thinkAccumulated = '';
                  _thinkLatestPhrase = '';
                  _thinkChunkBuf = '';
                  if (_thinkRafPending) {
                    _thinkRafPending = false;
                  }
                  const bar = document.getElementById('thinking-bar');
                  if (bar) {
                    bar.classList.remove('thinking-bar-hidden');
                    const barText = bar.querySelector('.thinking-bar-text') as HTMLElement | null;
                    if (barText) barText.textContent = 'Thinking...';
                  }
                } else if (event.type === 'thinking' || event.type === 'thought') {
                  setAgentLoopStatus(lastBubble, 'Reasoning...');
                  appendThinking(lastBubble, event.content || event.message || '');
                } else if (event.type === 'thinking_end') {
                  setThinkingFinished(lastBubble);
                } else if (event.type === 'tool_call_start') {
                  const toolName = event.tool_name || '';
                  const args = event.tool_args || {};
                  // Build a readable label for what the tool is doing
                  const argHint = args.path || args.file || args.command || args.query || args.url || args.search || args.name || '';
                  const shortHint = argHint ? `: ${String(argHint).replace(/^\/home\/ghost\/haksterAi\//, '').slice(0, 60)}` : '';
                  const toolLabel = toolName ? `${toolName}${shortHint}` : 'Using tool';
                  setAgentLoopStatus(lastBubble, toolLabel);
                  setLiveStatus(`⚙ ${toolLabel}`);
                  if (toolName === 'web_search' || toolName === 'firecrawl_scrape') {
                    const target = args.query || args.url || args.search || JSON.stringify(args);
                    const msg: Message = {
                      role: 'search',
                      content: toolName === 'web_search'
                        ? `Searching web: ${target}`
                        : `Scraping page: ${target}`,
                    };
                    webOutputs.set(event.tool_call_id || `${toolName}-${Date.now()}`, msg);
                    conv.messages.push(msg); saveConversation(conv); addMessageBubble(msg);
                  } else if (toolName && toolName !== 'exec_shell') {
                    // Show every other tool call as a Claude Code/Copilot-style work
                    // item chip (running → ✓/✗ badge, click to expand the result) —
                    // covers file ops, generate_image, and anything else the agent calls.
                    const icon = toolName.startsWith('read') || toolName === 'list_dir' || toolName === 'search_files' ? '👁' :
                                 toolName.startsWith('write') || toolName === 'edit_file' || toolName.includes('patch') ? '✏️' :
                                 toolName === 'generate_image' ? '🎨' : '🔧';
                    appendToolWork(lastBubble, icon, toolName, argHint, event.tool_call_id || '');
                  }
                } else if (event.type === 'tool_call') {
                  setAgentLoopStatus(lastBubble, 'Calling tool');
                  setLiveStatus('⚙ Calling tool...');
                  appendThinking(lastBubble, `⚡ ${event.toolCall?.function?.name || event.name || 'tool'}`);
                } else if (event.type === 'shell_start') {
                  const cmdShort = (event.command || '').slice(0, 60);
                  setAgentLoopStatus(lastBubble, event.command ? `$ ${cmdShort}` : 'Running shell');
                  setLiveStatus(`⚡ $ ${cmdShort || 'shell command'}`);
                  const key = event.tool_call_id || `shell-${Date.now()}`;
                  const el = addScriptBubble(event.command || '', event.cwd || '');
                  const msg: Message = { role: 'script', content: el.textContent || '' };
                  conv.messages.push(msg); saveConversation(conv);
                  scriptOutputs.set(key, { el, msg });
                } else if (event.type === 'shell_data') {
                  const key = event.tool_call_id || '';
                  let entry = scriptOutputs.get(key);
                  if (!entry) {
                    const el = addScriptBubble('', '');
                    const msg: Message = { role: 'script', content: el.textContent || '' };
                    conv.messages.push(msg); saveConversation(conv);
                    entry = { el, msg };
                    scriptOutputs.set(key, entry);
                  }
                  const prefix = event.stream === 'stderr' ? '[stderr] ' : '';
                  entry.pending = `${entry.pending || ''}${prefix}${event.data || ''}`;
                  if (!entry.raf) entry.raf = requestAnimationFrame(() => flushScriptOutput(entry));
                } else if (event.type === 'shell_end') {
                  const exitOk = (event.exit_code ?? 0) === 0;
                  setAgentLoopStatus(lastBubble, `Shell ${exitOk ? '✓' : '✗'} (exit ${event.exit_code ?? '?'})`);
                  setLiveStatus(exitOk ? '✓ Shell done' : `✗ Shell exit ${event.exit_code ?? '?'}`);
                  const entry = scriptOutputs.get(event.tool_call_id || '');
                  if (entry) {
                    if (entry.raf) cancelAnimationFrame(entry.raf);
                    entry.isFinal = true;
                    flushScriptOutput(entry);
                    const rawEl = entry.el.closest('.msg-bubble')?.querySelector('.script-raw') as HTMLElement;
                    const exitLine = `\n[exit ${event.exit_code ?? '?'}]`;
                    entry.msg.content += exitLine;
                    if (rawEl) rawEl.textContent += exitLine;
                    entry.el.innerHTML = renderScriptLines(entry.msg.content);
                    saveConversation(conv);
                  }
                } else if (event.type === 'shell_error') {
                  setAgentLoopStatus(lastBubble, 'Shell error');
                  setLiveStatus('✗ Shell error');
                  const entry = scriptOutputs.get(event.tool_call_id || '');
                  if (entry) {
                    if (entry.raf) cancelAnimationFrame(entry.raf);
                    entry.isFinal = true;
                    flushScriptOutput(entry);
                    const rawEl = entry.el.closest('.msg-bubble')?.querySelector('.script-raw') as HTMLElement;
                    const errLine = `\n[error] ${event.error || 'Script failed'}`;
                    entry.msg.content += errLine;
                    if (rawEl) rawEl.textContent += errLine;
                    entry.el.innerHTML = renderScriptLines(entry.msg.content);
                    saveConversation(conv);
                  } else {
                    addMessageBubble({ role: 'script', content: `[error] ${event.error || 'Script failed'}` });
                  }
                } else if (event.type === 'tool_result' || event.type === 'tool_call_result') {
                  const resultToolName = event.tool_name || '';
                  const okResult = !/^error/i.test(String(event.result || event.tool_result || '').trim());
                  setAgentLoopStatus(lastBubble, resultToolName ? `${okResult ? '✓' : '✗'} ${resultToolName}` : (okResult ? '✓ Tool done' : '✗ Tool failed'));
                  setLiveStatus(resultToolName ? `${okResult ? '✓' : '✗'} ${resultToolName} done` : '✓ Tool done');
                  const toolResult = event.result || event.tool_result || '';
                  const webMsg = webOutputs.get(event.tool_call_id || '');
                  if (webMsg) {
                    webMsg.content += `\n\n${toolResult.slice(0, 1200)}`;
                    saveConversation(conv);
                    renderMessages(conv.messages);
                  } else if (finishToolWork(event.tool_call_id || '', okResult, toolResult)) {
                    // Matched an inline work-item chip — result now lives in its
                    // click-to-expand detail panel, nothing else to render.
                  } else if (!scriptOutputs.has(event.tool_call_id || '')) {
                    addMessageBubble({ role: 'assistant', content: `→ ${toolResult.slice(0, 500)}` });
                  }
                } else if (event.type === 'file_created') {
                  // Agent wrote/edited a file — show a download button in chat
                  fileCreatedThisStream = true;
                  const filePath = event.path || '';
                  const fileName = filePath.split('/').pop() || 'file';
                  const downloadUrl = `${API}/api/fs/download?path=${encodeURIComponent(filePath)}`;
                  const fileMsg: Message = { role: 'assistant', content: `📄 Created: ${fileName}`, url: downloadUrl };
                  conv.messages.push(fileMsg); saveConversation(conv);
                  addMessageBubble(fileMsg);
                } else if (event.type === 'image') {
                  // Close out the generate_image work-item chip (if any) with a thumbnail,
                  // then render the full-size image as its own prominent bubble.
                  finishToolWork(event.tool_call_id || '', true, '', event.url);
                  const imgMsg: Message = { role: 'image', content: '', url: event.url, prompt: event.prompt || '' };
                  conv.messages.push(imgMsg); saveConversation(conv); addMessageBubble(imgMsg);
                } else if (event.type === 'needs_confirmation') {
                  const confirmMsg: Message = { role: 'confirmation', content: `⚠️ ${event.reason || 'Dangerous command requires approval'}`, command: event.command || '', toolCallId: event.tool_call_id || '', sessionId: conv.id };
                  conv.messages.push(confirmMsg); saveConversation(conv); addMessageBubble(confirmMsg);
                } else if (event.type === 'phase') {
                  const phase = String(event.phase || '').toLowerCase();
                  const phaseLabels: Record<string, string> = {
                    think: '🧠 Thinking...',
                    plan: '📋 Planning...',
                    act: '⚙ Running tools...',
                    observe: '👁 Reviewing results...',
                    reflect: '🔄 Adjusting approach...',
                    consolidate: '💾 Saving notes...',
                  };
                  const phaseStatus = phaseLabels[phase] || `${phase}...`;
                  setAgentLoopStatus(lastBubble, phaseStatus);
                  setLiveStatus(phaseStatus);
                } else if (event.type === 'done') {
                  setAgentLoopStatus(lastBubble, '✅ Done', true);
                  setLiveStatus('✅ Done');
                  setThinkingFinished(lastBubble);
                  document.getElementById('thinking-bar')?.classList.add('thinking-bar-hidden');
                } else if (event.type === 'max_turns') {
                  setAgentLoopStatus(lastBubble, 'Stopped at turn limit', true);
                  setLiveStatus('⏹ Turn limit reached');
                  setThinkingFinished(lastBubble);
                  document.getElementById('thinking-bar')?.classList.add('thinking-bar-hidden');
                } else if (event.type === 'loop_detected') {
                  setAgentLoopStatus(lastBubble, event.message || 'Loop stopped', true);
                  setLiveStatus('⏹ Loop stopped');
                  setThinkingFinished(lastBubble);
                  document.getElementById('thinking-bar')?.classList.add('thinking-bar-hidden');
                } else if (event.type === 'error') {
                  const errText = event.error || event.message || 'Unknown error';
                  document.getElementById('thinking-bar')?.classList.add('thinking-bar-hidden');
                  // Skip aborted streams and duplicate errors; suppress non-critical errors if a file was already downloaded
                  if (errText && !errText.includes('aborted') && !conv.messages.some(m => m.content === `Error: ${errText}`)) {
                    if (!fileCreatedThisStream || errText.includes('limit') || errText.includes('timed out')) {
                      addMessageBubble({ role: 'assistant', content: `Error: ${errText}` });
                    }
                  }
                } else if (event.content) {
                  if (lastBubble) lastBubble.textContent += event.content;
                  assistantMsg.content += event.content; tokenCount++;
                  setThinkingFinished(lastBubble);
                }
                _scrollThrottle();
              } catch {}
            }
          }
          setThinkingFinished(lastBubble);
          assistantMsg.content = lastBubble?.textContent || assistantMsg.content;
          assistantContent = assistantMsg.content;
          // Final code block render pass — re-render with full content
          if (lastBubble && assistantMsg.content.includes('```')) {
            lastBubble.innerHTML = renderCodeBlocks(assistantMsg.content);
            attachCodeCopyHandlers(lastBubble.parentElement || lastBubble as HTMLElement);
          }
          maybeScroll();
          saveConversation(conv); totalTokens += tokenCount; sidebarTokenCounter.textContent = `Tokens: ${totalTokens}`;
        } else {
          const allMessages = conv.messages.map(m => ({ role: m.role === 'user' ? 'user' : 'assistant', content: m.content }));
          const res = await fetch(endpoint, {
            method: 'POST', headers: authHeaders,
            body: JSON.stringify({ provider: currentProvider, model, sessionId: conv.id, cwd: activeProjectCwd || undefined, messages: [{ role: 'system', content: IMAGE_INSTRUCTION }, ...allMessages.slice(-20)] }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Chat request failed');
          const content = data.content || data.message || data.result || JSON.stringify(data, null, 2);
          const reply: Message = { role: 'assistant', content };
          conv.messages.push(reply); saveConversation(conv); addMessageBubble(reply);
        }
      } catch (err: any) {
        // Don't show error if the stream already delivered results (file download, content, etc.)
        const hadResults = assistantContent.trim().length > 0 || fileCreatedThisStream;
        if (!hadResults || err.message?.includes('limit')) {
          let errorContent = `Error: ${err.message || String(err)}`;
          if (err.status === 402 || (err.message && err.message.includes('limit'))) {
            errorContent = '⚠️ **Free usage limit reached**\n\nFree users get 10 commands/questions. **Upgrade to a paid plan for unlimited access.**\n\n→ Click an option below to subscribe via Stripe.';
            // Show upgrade modal
            showUpgradeModal();
          }
          const errMsg: Message = { role: 'assistant', content: errorContent };
          conv.messages.push(errMsg); saveConversation(conv); addMessageBubble(errMsg);
        }
      } finally {
        setBusyState(false); if (sendState) sendState.textContent = 'Ready'; chatInput.disabled = false; chatInput.value = '';
        pendingImages = []; renderAttachments();
        setReadyState(); renderHistoryList();
      }
    }

