    // ===== Autopilot =====
    const autopilotBtn = document.getElementById('autopilot-btn') as HTMLButtonElement;
    let autopilotActive = false;
    let autopilotTimer: any = null;
    let autopilotStep = 0;

    function setAutopilotVisual(active: boolean) {
      autopilotActive = active;
      if (active) {
        autopilotBtn.style.background = '#7c3aed';
        autopilotBtn.style.color = '#fff';
        autopilotBtn.title = 'Autopilot ON — click to stop';
      } else {
        autopilotBtn.style.background = '';
        autopilotBtn.style.color = '';
        autopilotBtn.title = 'Toggle autopilot mode';
      }
    }

    function autopilotNext() {
      if (!autopilotActive || busy) return;
      autopilotStep++;
      const prompts = [
        'Continue working on the task. Pick up where you left off and proceed with the next logical step.',
        'Review what you have done so far, identify any issues or gaps, and fix them.',
        'Verify the current state of the work. Run any necessary checks or tests, then proceed to the next step.',
        'Summarize the current progress in 2-3 sentences, then continue with the next phase of work.',
        'Apply any remaining improvements or optimizations you can think of to complete the task.',
      ];
      const prompt = prompts[autopilotStep % prompts.length];
      sendMessage(prompt);
    }

    function startAutopilot() {
      setAutopilotVisual(true);
      autopilotStep = 0;
      // Kick off immediately
      autopilotNext();
    }

    function stopAutopilot() {
      setAutopilotVisual(false);
      if (autopilotTimer) { clearTimeout(autopilotTimer); autopilotTimer = null; }
    }

    autopilotBtn.addEventListener('click', () => {
      if (autopilotActive) { stopAutopilot(); }
