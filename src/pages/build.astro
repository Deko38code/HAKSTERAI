    generateImageBtn.addEventListener('click', async () => {
      const prompt = imagePromptInput.value.trim(); if (!prompt) return;
      generateImageBtn.disabled = true; generateImageBtn.textContent = 'Generating...';
      imageStatus.classList.remove('hidden'); imageStatus.textContent = 'Creating your image...'; imageResult.classList.add('hidden');
      const model = imageModelSelect.value; const size = imageSizeSelect.value;
      const quality = (document.querySelector('input[name="image-quality"]:checked') as HTMLInputElement)?.value || 'hd';
      const provider = ['dall-e-3', 'gpt-image-1'].includes(model) ? 'openai' : 'pollinations';
      try {
        const res = await fetch(`${API}/api/images/generate`, {
          method: 'POST', headers: { 'Content-Type': 'application/json', ...(localStorage.getItem('hakster_google_token') ? { 'x-api-key': localStorage.getItem('hakster_google_token')! } : {}) },
          body: JSON.stringify({ provider, model, prompt, size, quality }),
        });
        const data = await res.json(); if (!res.ok) throw new Error(data.error || 'Image generation failed');
        if (data.images && data.images[0]) {
          const img = data.images[0];
          if (img.b64_json) {
            const mime = img.mime_type || 'image/png';
            const dataUrl = `data:${mime};base64,${img.b64_json}`;
            imageResultImg.src = dataUrl; imageResultDownload.href = dataUrl;
            imageResultInfo.textContent = `${data.provider || provider} · ${model} · ${size} · ${quality} · ${img.revised_prompt ? 'Revised prompt' : 'Original prompt'}`;
          } else if (img.url) {
            imageResultImg.src = img.url; imageResultDownload.href = img.url;
            imageResultInfo.textContent = `${data.provider || provider} · ${model} · ${size} · ${quality}`;
          }
          imageResult.classList.remove('hidden'); imageStatus.textContent = `Done in ${data.latency || '?'}ms`;
        } else { throw new Error('No image returned'); }
      } catch (err: any) {
        imageStatus.textContent = `Error: ${err.message || String(err)}`; imageStatus.style.color = '#ef4444';
      } finally { generateImageBtn.disabled = false; generateImageBtn.textContent = 'Generate Image'; }
    });

