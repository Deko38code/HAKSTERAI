    // ── Memory Bank ──
    let memEntries: {key:string; value:string; category:string; created_at:number}[] = [];
    let compactNextAt: number | null = null;
    let compactInterval: number = 5 * 60 * 1000; // 5 min default

    async function loadMemoryBank() {
      try {
        const res = await fetch(`${API}/api/memory`);
        const data = await res.json();
        memEntries = data.entries || data.memories || [];
        renderMemEntries();
        updateMemContextBar();
      } catch { memEntries = []; renderMemEntries(); }
    }
    function renderMemEntries() {
      memEntryCount.textContent = `${memEntries.length} entries`;
      if (memEntries.length === 0) { memEntriesList.innerHTML = '<div class="text-xs text-white/30 text-center py-8">No memories stored yet</div>'; return; }
      memEntriesList.innerHTML = memEntries.map(m => `
        <div class="rounded-lg border border-[#333] bg-[#111] px-3 py-2 hover:border-[#7c3aed]/30 transition group">
          <div class="flex items-center justify-between gap-2 mb-0.5">
            <span class="text-[10px] font-mono font-semibold text-[#a855f7] truncate">${escapeHtml(m.key)}</span>
            <button class="mem-delete opacity-0 group-hover:opacity-100 transition text-white/30 hover:text-red-400 text-[10px]" data-key="${escapeHtml(m.key)}">✕</button>
          </div>
          <div class="text-xs text-white/60 leading-relaxed break-words">${escapeHtml(m.value)}</div>
        </div>`).join('');
      memEntriesList.querySelectorAll('.mem-delete').forEach(btn => {
        btn.addEventListener('click', async () => {
          const key = (btn as HTMLElement).dataset.key || '';
          try { await fetch(`${API}/api/memory/${encodeURIComponent(key)}`, { method: 'DELETE' }); loadMemoryBank(); } catch {}
        });
      });
    }
    function updateMemContextBar() {
      const chars = memEntries.reduce((sum, m) => sum + (m.value?.length || 0), 0);
      const maxChars = 50000;
      const pct = Math.min(100, Math.round((chars / maxChars) * 100));
      memContextBar.style.width = pct + '%';
      memContextPct.textContent = pct + '%';
      // Autocompact triggers when context > 80%
      if (pct > 80) { memAcDot.className = 'h-2 w-2 rounded-full bg-orange-400 animate-pulse'; memAcStatus.textContent = 'Compacting...'; }
      else if (pct > 60) { memAcDot.className = 'h-2 w-2 rounded-full bg-yellow-400'; memAcStatus.textContent = 'Watching'; }
      else { memAcDot.className = 'h-2 w-2 rounded-full bg-green-400'; memAcStatus.textContent = 'Idle'; }
      updateCompactClock();
    }
    function updateCompactClock() {
      if (!compactNextAt) { memAcClock.textContent = '--:--'; return; }
      const remaining = Math.max(0, compactNextAt - Date.now());
      const mins = Math.floor(remaining / 60000);
      const secs = Math.floor((remaining % 60000) / 1000);
      memAcClock.textContent = `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`;
    }
    memAddBtn.addEventListener('click', async () => {
      const key = memAddKey.value.trim(); const value = memAddValue.value.trim();
      if (!key || !value) return;
      try {
        await fetch(`${API}/api/memory`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ key, value, category: 'context' }) });
        memAddKey.value = ''; memAddValue.value = ''; loadMemoryBank();
      } catch {}
    });
    memoryBtn.addEventListener('click', () => { loadMemoryBank(); memoryBankModal.classList.remove('hidden'); });
    closeMemoryBank.addEventListener('click', () => memoryBankModal.classList.add('hidden'));
    memoryBankModal.addEventListener('click', (e) => { if (e.target === memoryBankModal) memoryBankModal.classList.add('hidden'); });

    // ── Autocompact Clock (runs every 5 min, triggers compact at threshold) ──
    async function triggerAutocompact() {
      const chars = memEntries.reduce((s, m) => s + (m.value?.length || 0), 0);
      if (chars < 30000) { compactNextAt = Date.now() + compactInterval; return; }
      memAcDot.className = 'h-2 w-2 rounded-full bg-orange-400 animate-pulse'; memAcStatus.textContent = 'Compacting...';
      try {
        await fetch(`${API}/api/memory/compact`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
        loadMemoryBank();
      } catch {}
      memAcStatus.textContent = 'Idle'; memAcDot.className = 'h-2 w-2 rounded-full bg-green-400';
      compactNextAt = Date.now() + compactInterval;
    }
    compactNextAt = Date.now() + compactInterval;
    setInterval(() => { updateCompactClock(); }, 1000);
    setInterval(() => { triggerAutocompact(); }, compactInterval);

    // ── Todo Grid ──
