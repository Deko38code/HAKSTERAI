      color: #e5e7eb;
    }
    @media (max-width: 640px) {
      .chat-ink-frame { padding: 12px 8px 10px; }
      .chat-ink-frame::before, .chat-ink-frame::after,
      .chat-ink-frame > .ink-corner-tr, .chat-ink-frame > .ink-corner-bl { width: 16px; height: 16px; }
    }
    /* ── Skill review cards ── */
    .skill-card { user-select: none; }
    .skill-checkbox { flex-shrink: 0; }

    /* ── Todo grid rows ── */
    .todo-row { user-select: none; }

    /* ── Memory entry cards ── */
    .mem-entry { transition: border-color 0.15s; }
    .mem-entry:hover { border-color: rgba(124,58,237,0.3); }
  </style>

  <script>
    const API = location.port === '4321' ? 'http://localhost:3579' : '';
    const chatForm = document.getElementById('chat-form')!;
    const chatInput = document.getElementById('chat-input') as HTMLTextAreaElement;
    const sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
    const sendState = document.getElementById('send-state') as HTMLElement | null;
    const outputPanel = document.getElementById('output-panel')!;
    const outputArea = document.getElementById('output-area')!;
    const clearBtn = document.getElementById('clear-output')!;
    const modelSelect = document.getElementById('model-select') as HTMLSelectElement;
    const sidebarModelSelect = document.getElementById('sidebar-model-select') as HTMLSelectElement;
    const sidebarProjectSelect = document.getElementById('sidebar-project-select') as HTMLSelectElement | null;
    const sidebarProjectPath = document.getElementById('sidebar-project-path') as HTMLElement | null;
    const fcDot = document.getElementById('fc-dot')!;
    const fcStatus = document.getElementById('fc-status')!;
    const sidebarFcDot = document.getElementById('sidebar-fc-dot')!;
    const sidebarFcText = document.getElementById('sidebar-fc-text')!;
    const sidebarTokenCounter = document.getElementById('sidebar-token-counter')!;
    const modeBtn = document.getElementById('mode-btn')!;
    const modeLabel = document.getElementById('mode-label')!;
    const thinkingBtn = document.getElementById('thinking-btn') as HTMLButtonElement | null;
    const thinkingLabel = document.getElementById('thinking-label') as HTMLElement | null;
    const askBtn = document.getElementById('ask-btn') as HTMLButtonElement | null;
    const askDropdown = document.getElementById('ask-dropdown')!;
    const voiceInputBtn = document.getElementById('voice-input-btn') as HTMLButtonElement;
    const voiceInputLabel = document.getElementById('voice-input-label') as HTMLElement | null;
    const voiceOutputBtn = document.getElementById('voice-output-btn') as HTMLButtonElement;
    const voiceOutputLabel = document.getElementById('voice-output-label') as HTMLElement | null;
    const voicePanel = document.getElementById('voice-panel')!;
    const voiceSelect = document.getElementById('voice-select') as HTMLSelectElement;
    const voiceRate = document.getElementById('voice-rate') as HTMLInputElement;
    const voicePitch = document.getElementById('voice-pitch') as HTMLInputElement;
    const voiceStatus = document.getElementById('voice-status')!;
    const stopVoiceBtn = document.getElementById('stop-voice-btn')!;
    const heroArea = document.getElementById('hero-area')!;
    const messagesArea = document.getElementById('messages-area')!;
    const messagesContainer = document.getElementById('messages-container')!;
    const hackerChat = document.getElementById('hacker-chat')!;
    const chatFullscreenBtn = document.getElementById('chat-fullscreen-btn') as HTMLButtonElement | null;

    // ── Skill Review, Memory Bank, Todo Grid ──
    const skillsBtn = document.getElementById('skills-btn')!;
    const skillReviewModal = document.getElementById('skill-review-modal')!;
    const closeSkillReview = document.getElementById('close-skill-review')!;
    const skillReviewGrid = document.getElementById('skill-review-grid')!;
    const skillCount = document.getElementById('skill-count')!;
    const skillSelectAll = document.getElementById('skill-select-all')!;
    const skillStartWork = document.getElementById('skill-start-work')!;
    const memoryBtn = document.getElementById('memory-btn')!;
    const memoryBankModal = document.getElementById('memory-bank-modal')!;
    const closeMemoryBank = document.getElementById('close-memory-bank')!;
    const memEntriesList = document.getElementById('mem-entries-list')!;
    const memEntryCount = document.getElementById('mem-entry-count')!;
    const memContextBar = document.getElementById('mem-context-bar')!;
    const memContextPct = document.getElementById('mem-context-pct')!;
    const memAcDot = document.getElementById('mem-ac-dot')!;
    const memAcStatus = document.getElementById('mem-ac-status')!;
    const memAcClock = document.getElementById('mem-ac-clock')!;
    const memAddKey = document.getElementById('mem-add-key') as HTMLInputElement;
    const memAddValue = document.getElementById('mem-add-value') as HTMLInputElement;
    const memAddBtn = document.getElementById('mem-add-btn')!;
    const todoBtn = document.getElementById('todo-btn')!;
    const todoGridPanel = document.getElementById('todo-grid-panel')!;
    const closeTodoGrid = document.getElementById('close-todo-grid')!;
    const todoGridItems = document.getElementById('todo-grid-items')!;
    const todoGridCount = document.getElementById('todo-grid-count')!;
    const todoGridInput = document.getElementById('todo-grid-input') as HTMLInputElement;
    const todoGridAdd = document.getElementById('todo-grid-add')!;

    // ── Agent Skills Roster (mirrors Copilot CLI skill model) ──
    interface SkillCard { id: string; name: string; icon: string; desc: string; enabled: boolean; }
    const AGENT_SKILLS: SkillCard[] = [
      { id: 'coding', name: 'Coding', icon: '⌨️', desc: 'Read, edit, write files & fix bugs', enabled: true },
      { id: 'shell', name: 'Shell', icon: '🖥️', desc: 'Run shell commands, builds, tests', enabled: true },
      { id: 'patch', name: 'Patch', icon: '🩹', desc: 'Precise file edits with verification', enabled: true },
      { id: 'iptv', name: 'IPTV', icon: '📺', desc: 'M3U, Xtream, Stalker, EPG streams', enabled: false },
      { id: 'movie-servers', name: 'Movie Servers', icon: '🎬', desc: 'vidsrc/devsrc, CineVault, proxies', enabled: false },
      { id: 'cloud-ops', name: 'Cloud Ops', icon: '☁️', desc: 'PM2, systemd, ports, health checks', enabled: true },
      { id: 'pentest', name: 'Pentest', icon: '🎯', desc: 'Guardian security scanning & recon', enabled: false },
      { id: 'firecrawl', name: 'Firecrawl', icon: '🔥', desc: 'Web search, scrape & extract', enabled: true },
      { id: 'image-gen', name: 'Image Gen', icon: '🎨', desc: 'DALL-E image generation inline', enabled: true },
      { id: 'memory', name: 'Memory', icon: '🧠', desc: 'Persistent context across sessions', enabled: true },
    ];
    let activeSkills = new Set(AGENT_SKILLS.filter(s => s.enabled).map(s => s.id));

    function setChatFullscreenState(active: boolean) {
      if (!chatFullscreenBtn) return;
      chatFullscreenBtn.setAttribute('aria-pressed', active ? 'true' : 'false');
      chatFullscreenBtn.title = active ? 'Exit fullscreen chat' : 'Fullscreen chat';
      chatFullscreenBtn.setAttribute('aria-label', chatFullscreenBtn.title);
      chatFullscreenBtn.querySelector('.fullscreen-enter')?.classList.toggle('hidden', active);
      chatFullscreenBtn.querySelector('.fullscreen-exit')?.classList.toggle('hidden', !active);
      setTimeout(() => {
        maybeScroll(outputPanel.classList.contains('hidden') ? messagesArea : outputPanel);
      }, 80);
    }

    function isChatFullscreen() {
      return document.fullscreenElement === hackerChat || hackerChat.classList.contains('chat-fullscreen-fallback');
    }

    chatFullscreenBtn?.addEventListener('click', async () => {
      try {
        if (document.fullscreenElement === hackerChat) {
          await document.exitFullscreen();
          return;
        }
        if (document.fullscreenElement) {
          await document.exitFullscreen();
        }
        if (hackerChat.requestFullscreen) {
          await hackerChat.requestFullscreen();
        } else {
          hackerChat.classList.toggle('chat-fullscreen-fallback');
          setChatFullscreenState(isChatFullscreen());
        }
      } catch {
        hackerChat.classList.toggle('chat-fullscreen-fallback');
        setChatFullscreenState(isChatFullscreen());
      }
    });

    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement) hackerChat.classList.remove('chat-fullscreen-fallback');
      setChatFullscreenState(isChatFullscreen());
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && hackerChat.classList.contains('chat-fullscreen-fallback')) {
        hackerChat.classList.remove('chat-fullscreen-fallback');
        setChatFullscreenState(false);
      }
    });

    function renderSkillGrid() {
      skillReviewGrid.innerHTML = AGENT_SKILLS.map(s => `
        <label class="skill-card flex items-start gap-2.5 rounded-xl border px-3 py-2.5 cursor-pointer transition-all ${s.enabled ? 'border-[#7c3aed]/40 bg-[#7c3aed]/8' : 'border-[#333] bg-[#111]'} hover:border-[#7c3aed]/30" data-skill="${s.id}">
          <input type="checkbox" class="skill-checkbox mt-0.5 accent-[#7c3aed]" ${s.enabled ? 'checked' : ''} />
          <div class="min-w-0">
            <div class="flex items-center gap-1.5 text-xs font-semibold text-white">${s.icon} ${s.name}</div>
            <div class="text-[10px] text-white/40 leading-tight mt-0.5">${s.desc}</div>
          </div>
        </label>`).join('');
      skillReviewGrid.querySelectorAll('.skill-card').forEach(card => {
        const cb = card.querySelector('.skill-checkbox') as HTMLInputElement;
        cb.addEventListener('change', () => {
          const id = (card as HTMLElement).dataset.skill!;
          if (cb.checked) { activeSkills.add(id); card.classList.add('border-[#7c3aed]/40','bg-[#7c3aed]/8'); card.classList.remove('border-[#333]','bg-[#111]'); }
          else { activeSkills.delete(id); card.classList.remove('border-[#7c3aed]/40','bg-[#7c3aed]/8'); card.classList.add('border-[#333]','bg-[#111]'); }
          skillCount.textContent = String(activeSkills.size);
        });
      });
      skillCount.textContent = String(activeSkills.size);
    }
    skillsBtn.addEventListener('click', () => { renderSkillGrid(); skillReviewModal.classList.remove('hidden'); });
    closeSkillReview.addEventListener('click', () => skillReviewModal.classList.add('hidden'));
    skillReviewModal.addEventListener('click', (e) => { if (e.target === skillReviewModal) skillReviewModal.classList.add('hidden'); });
    skillSelectAll.addEventListener('click', () => {
      const allOn = activeSkills.size === AGENT_SKILLS.length;
      AGENT_SKILLS.forEach(s => { if (allOn) activeSkills.delete(s.id); else activeSkills.add(s.id); s.enabled = !allOn; });
      renderSkillGrid();
    });
    skillStartWork.addEventListener('click', () => {
      skillReviewModal.classList.add('hidden');
      const skillList = AGENT_SKILLS.filter(s => activeSkills.has(s.id)).map(s => s.name).join(', ');
      chatInput.value = `[Skills active: ${skillList}]\n\n`;
      setReadyState(); chatInput.focus();
    });

    // ── Memory Bank ──
    let memEntries: {key:string; value:string; category:string; created_at:number}[] = [];
    let compactNextAt: number | null = null;
    let compactInterval: number = 5 * 60 * 1000; // 5 min default

    async function loadMemoryBank() {
      try {
        const res = await fetch(`${API}/api/memory`);
        const data = await res.json();
        memEntries = data.entries || data.memories || [];
        renderMemEntries();
        updateMemContextBar();
      } catch { memEntries = []; renderMemEntries(); }
    }
    function renderMemEntries() {
      memEntryCount.textContent = `${memEntries.length} entries`;
      if (memEntries.length === 0) { memEntriesList.innerHTML = '<div class="text-xs text-white/30 text-center py-8">No memories stored yet</div>'; return; }
      memEntriesList.innerHTML = memEntries.map(m => `
        <div class="rounded-lg border border-[#333] bg-[#111] px-3 py-2 hover:border-[#7c3aed]/30 transition group">
          <div class="flex items-center justify-between gap-2 mb-0.5">
            <span class="text-[10px] font-mono font-semibold text-[#a855f7] truncate">${escapeHtml(m.key)}</span>
            <button class="mem-delete opacity-0 group-hover:opacity-100 transition text-white/30 hover:text-red-400 text-[10px]" data-key="${escapeHtml(m.key)}">✕</button>
          </div>
          <div class="text-xs text-white/60 leading-relaxed break-words">${escapeHtml(m.value)}</div>
        </div>`).join('');
      memEntriesList.querySelectorAll('.mem-delete').forEach(btn => {
        btn.addEventListener('click', async () => {
          const key = (btn as HTMLElement).dataset.key || '';
          try { await fetch(`${API}/api/memory/${encodeURIComponent(key)}`, { method: 'DELETE' }); loadMemoryBank(); } catch {}
        });
      });
    }
    function updateMemContextBar() {
      const chars = memEntries.reduce((sum, m) => sum + (m.value?.length || 0), 0);
      const maxChars = 50000;
      const pct = Math.min(100, Math.round((chars / maxChars) * 100));
      memContextBar.style.width = pct + '%';
      memContextPct.textContent = pct + '%';
      // Autocompact triggers when context > 80%
      if (pct > 80) { memAcDot.className = 'h-2 w-2 rounded-full bg-orange-400 animate-pulse'; memAcStatus.textContent = 'Compacting...'; }
      else if (pct > 60) { memAcDot.className = 'h-2 w-2 rounded-full bg-yellow-400'; memAcStatus.textContent = 'Watching'; }
      else { memAcDot.className = 'h-2 w-2 rounded-full bg-green-400'; memAcStatus.textContent = 'Idle'; }
      updateCompactClock();
    }
    function updateCompactClock() {
      if (!compactNextAt) { memAcClock.textContent = '--:--'; return; }
      const remaining = Math.max(0, compactNextAt - Date.now());
      const mins = Math.floor(remaining / 60000);
      const secs = Math.floor((remaining % 60000) / 1000);
      memAcClock.textContent = `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`;
    }
    memAddBtn.addEventListener('click', async () => {
      const key = memAddKey.value.trim(); const value = memAddValue.value.trim();
      if (!key || !value) return;
      try {
        await fetch(`${API}/api/memory`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ key, value, category: 'context' }) });
        memAddKey.value = ''; memAddValue.value = ''; loadMemoryBank();
      } catch {}
    });
    memoryBtn.addEventListener('click', () => { loadMemoryBank(); memoryBankModal.classList.remove('hidden'); });
    closeMemoryBank.addEventListener('click', () => memoryBankModal.classList.add('hidden'));
    memoryBankModal.addEventListener('click', (e) => { if (e.target === memoryBankModal) memoryBankModal.classList.add('hidden'); });

    // ── Autocompact Clock (runs every 5 min, triggers compact at threshold) ──
    async function triggerAutocompact() {
      const chars = memEntries.reduce((s, m) => s + (m.value?.length || 0), 0);
      if (chars < 30000) { compactNextAt = Date.now() + compactInterval; return; }
      memAcDot.className = 'h-2 w-2 rounded-full bg-orange-400 animate-pulse'; memAcStatus.textContent = 'Compacting...';
      try {
        await fetch(`${API}/api/memory/compact`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
        loadMemoryBank();
      } catch {}
      memAcStatus.textContent = 'Idle'; memAcDot.className = 'h-2 w-2 rounded-full bg-green-400';
      compactNextAt = Date.now() + compactInterval;
    }
    compactNextAt = Date.now() + compactInterval;
    setInterval(() => { updateCompactClock(); }, 1000);
    setInterval(() => { triggerAutocompact(); }, compactInterval);

    // ── Todo Grid ──
    interface TodoItem { id: string; text: string; done: boolean; }
    let todoItems: TodoItem[] = [];
    function loadTodos() { try { todoItems = JSON.parse(localStorage.getItem('hakster-todos') || '[]'); } catch { todoItems = []; } renderTodoGrid(); }
    function saveTodos() { localStorage.setItem('hakster-todos', JSON.stringify(todoItems)); }
    function renderTodoGrid() {
      const done = todoItems.filter(t => t.done).length;
      todoGridCount.textContent = `${done}/${todoItems.length}`;
      if (todoItems.length === 0) { todoGridItems.innerHTML = '<div class="text-xs text-white/30 text-center py-6">No active tasks</div>'; return; }
      todoGridItems.innerHTML = todoItems.map(t => `
        <label class="todo-row flex items-center gap-2 rounded-lg border border-[#333] bg-[#1a1a1a] px-2.5 py-2 cursor-pointer hover:border-[#7c3aed]/30 transition ${t.done ? 'opacity-50' : ''}" data-id="${t.id}">
          <input type="checkbox" class="todo-checkbox accent-[#7c3aed]" ${t.done ? 'checked' : ''} />
          <span class="text-xs text-white/70 flex-1 ${t.done ? 'line-through' : ''}">${escapeHtml(t.text)}</span>
          <button class="todo-delete text-white/20 hover:text-red-400 text-[10px] flex-shrink-0" data-id="${t.id}">✕</button>
        </label>`).join('');
      todoGridItems.querySelectorAll('.todo-checkbox').forEach(cb => {
        cb.addEventListener('change', () => {
          const row = cb.closest('.todo-row') as HTMLElement;
          const id = row.dataset.id!;
          const item = todoItems.find(t => t.id === id);
          if (item) { item.done = (cb as HTMLInputElement).checked; saveTodos(); renderTodoGrid(); }
        });
      });
      todoGridItems.querySelectorAll('.todo-delete').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault(); e.stopPropagation();
          const id = (btn as HTMLElement).dataset.id!;
          todoItems = todoItems.filter(t => t.id !== id);
          saveTodos(); renderTodoGrid();
        });
      });
    }
    todoBtn.addEventListener('click', () => { todoGridPanel.classList.toggle('hidden'); });
    closeTodoGrid.addEventListener('click', () => todoGridPanel.classList.add('hidden'));
    todoGridAdd.addEventListener('click', () => {
      const text = todoGridInput.value.trim(); if (!text) return;
      todoItems.push({ id: `todo-${Date.now()}`, text, done: false });
      todoGridInput.value = ''; saveTodos(); renderTodoGrid();
    });
    todoGridInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); todoGridAdd.click(); } });
    loadTodos();

    // ===== Checkpoints =====
    const checkpointBtn = document.getElementById('checkpoint-btn')!;
    const checkpointPanel = document.getElementById('checkpoint-panel')!;
    const closeCheckpointPanel = document.getElementById('close-checkpoint-panel')!;
    const checkpointList = document.getElementById('checkpoint-list')!;
    const checkpointCount = document.getElementById('checkpoint-count')!;
    const saveCheckpointBtn = document.getElementById('save-checkpoint-btn')!;
    const CHECKPOINT_KEY = 'hakster-hack-checkpoints';

    interface Checkpoint { id: string; convId: string; title: string; messages: Message[]; model: string; savedAt: number; }
    function loadCheckpoints(): Checkpoint[] {
      try { return JSON.parse(localStorage.getItem(CHECKPOINT_KEY) || '[]'); } catch { return []; }
    }
    function saveCheckpoints(cps: Checkpoint[]) { localStorage.setItem(CHECKPOINT_KEY, JSON.stringify(cps)); }
    function renderCheckpoints() {
      const cps = loadCheckpoints();
      checkpointCount.textContent = String(cps.length);
      if (cps.length === 0) {
        checkpointList.innerHTML = '<div class="text-xs text-white/30 text-center py-6">No checkpoints saved.<br>Click the bookmark icon to save the current conversation state.</div>';
        return;
      }
      checkpointList.innerHTML = cps.map(cp => {
        const date = new Date(cp.savedAt).toLocaleString();
        const msgCount = cp.messages.length;
        return `<div class="rounded-lg border border-[#333] bg-[#1a1a1a] px-3 py-2 hover:border-[#7c3aed]/40 transition group">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-medium text-white/80 truncate flex-1">${cp.title || 'Untitled'}</span>
            <span class="text-[9px] text-white/30 ml-2">${date}</span>
          </div>
          <div class="text-[10px] text-white/40 mb-2">${msgCount} messages · ${cp.model || 'unknown'}</div>
          <div class="flex gap-1.5">
            <button class="cp-restore text-[10px] rounded border border-[#333] hover:border-[#7c3aed]/50 px-2 py-1 text-white/60 hover:text-white transition" data-cp-id="${cp.id}">↩ Restore</button>
            <button class="cp-delete text-[10px] rounded border border-[#333] hover:border-[#ef4444]/50 px-2 py-1 text-white/40 hover:text-[#ef4444] transition" data-cp-id="${cp.id}">🗑 Delete</button>
          </div>
        </div>`;
      }).join('');
      checkpointList.querySelectorAll('.cp-restore').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.cpId!;
          const cps = loadCheckpoints();
          const cp = cps.find(c => c.id === id);
          if (!cp) return;
          // Create a new conversation from the checkpoint
          const newConv: Conversation = { id: `hack-${Date.now()}-${Math.random().toString(36).slice(2,7)}`, title: `${cp.title} (restored)`, messages: [...cp.messages], model: cp.model || currentModel, created: Date.now() };
          const convs = loadConversations(); convs.unshift(newConv); saveConversations(convs); setActiveId(newConv.id);
          renderMessages(newConv.messages); showMessagesView(); renderHistoryList();
          checkpointPanel.classList.add('hidden');
        });
      });
      checkpointList.querySelectorAll('.cp-delete').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.cpId!;
          const cps = loadCheckpoints().filter(c => c.id !== id);
          saveCheckpoints(cps); renderCheckpoints();
        });
      });
    }
    function saveCheckpointNow() {
      const activeId = getActiveId();
      const convs = loadConversations();
      const conv = convs.find(c => c.id === activeId);
      if (!conv || conv.messages.length === 0) { alert('No active conversation to checkpoint.'); return; }
      const cp: Checkpoint = { id: `cp-${Date.now()}`, convId: conv.id, title: conv.title, messages: [...conv.messages], model: conv.model, savedAt: Date.now() };
      const cps = loadCheckpoints(); cps.unshift(cp); saveCheckpoints(cps); renderCheckpoints();
    }
    checkpointBtn.addEventListener('click', () => { checkpointPanel.classList.toggle('hidden'); renderCheckpoints(); });
    closeCheckpointPanel.addEventListener('click', () => checkpointPanel.classList.add('hidden'));
    saveCheckpointBtn.addEventListener('click', saveCheckpointNow);
    renderCheckpoints();

    // ===== Autopilot =====
    const autopilotBtn = document.getElementById('autopilot-btn') as HTMLButtonElement;
    let autopilotActive = false;
    let autopilotTimer: any = null;
    let autopilotStep = 0;

    function setAutopilotVisual(active: boolean) {
      autopilotActive = active;
      if (active) {
        autopilotBtn.style.background = '#7c3aed';
        autopilotBtn.style.color = '#fff';
        autopilotBtn.title = 'Autopilot ON — click to stop';
      } else {
        autopilotBtn.style.background = '';
        autopilotBtn.style.color = '';
        autopilotBtn.title = 'Toggle autopilot mode';
      }
    }

    function autopilotNext() {
      if (!autopilotActive || busy) return;
      autopilotStep++;
      const prompts = [
        'Continue working on the task. Pick up where you left off and proceed with the next logical step.',
        'Review what you have done so far, identify any issues or gaps, and fix them.',
        'Verify the current state of the work. Run any necessary checks or tests, then proceed to the next step.',
        'Summarize the current progress in 2-3 sentences, then continue with the next phase of work.',
        'Apply any remaining improvements or optimizations you can think of to complete the task.',
      ];
      const prompt = prompts[autopilotStep % prompts.length];
      sendMessage(prompt);
    }

    function startAutopilot() {
      setAutopilotVisual(true);
      autopilotStep = 0;
      // Kick off immediately
      autopilotNext();
    }

    function stopAutopilot() {
      setAutopilotVisual(false);
      if (autopilotTimer) { clearTimeout(autopilotTimer); autopilotTimer = null; }
    }

    autopilotBtn.addEventListener('click', () => {
      if (autopilotActive) { stopAutopilot(); }
      else { startAutopilot(); }
    });

    // ===== Terminal Panel (embedded PTY) =====
    const terminalBtn = document.getElementById('terminal-btn')!;
    const chatTerminalPanel = document.getElementById('chat-terminal-panel')!;
    const closeTerminalPanel = document.getElementById('close-terminal-panel')!;
    const terminalContainer = document.getElementById('terminal-container')!;
    const terminalStatus = document.getElementById('terminal-status')!;
    const terminalReconnectBtn = document.getElementById('terminal-reconnect-btn')!;
    let chatTerm: any = null;
    let chatTermFit: any = null;
    let chatTermWs: WebSocket | null = null;
    let chatTermDecoder: TextDecoder | null = null;
    let chatTermWriteBuf = '';
    let chatTermWriteRaf: number | null = null;

    function getWsBase() {
      const proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
      return `${proto}//${window.location.host}`;
    }

    const EMBEDDED_TERMINAL_ALLOW_KEY = 'hakster:build-terminal-allowed';
    const EMBEDDED_TERMINAL_PATTERNS = [
      /\brm\s+(-rf?|--force|--recursive)/i,
      /\brm\s+.*\//i,
      /\bshutdown\b/i,
      /\breboot\b/i,
      /\bhalt\b/i,
      /\bpoweroff\b/i,
      /\bfdisk\b/i,
      /\bmkfs\b/i,
      /\bdd\s+if=/i,
      /\bformat\b/i,
      /\bchmod\s+(-R\s+)?777/i,
      /\bchown\s+.*root/i,
      /\bkill\s+-9\s+/i,
      /\bkillall\b/i,
      /\bpkill\s+-9/i,
      /\bfuser\s+-k\b/i,
      /\bnpm\s+publish/i,
      /\bgit\s+push\s+.*--force/i,
      /\bgit\s+reset\s+--hard/i,
      /\bgit\s+clean\s+-fd/i,
      /\bdocker\s+(rm|rmi|system\s+prune)/i,
      /\bsystemctl\s+(stop|disable|restart)\s+(ssh|nginx|apache|mysql|postgres)/i,
      /\bsystemctl\s+(mask|daemon-reload)\b/i,
      /\biptables\s+-F/i,
      /\bcurl.*\|\s*(ba)?sh/i,
      /\bwget.*\|\s*(ba)?sh/i,
      /\btruncate\s+-s\s+0\b/i,
      /\bcrontab\s+-r\b/i,
      /\bwipefs\b/i,
      /\bsgdisk\b/i,
    ];

    function htmlEscape(value: string) {
      return value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c));
    }

    function getBuildAllowedCommands(permanent = false): Set<string> {
      const storage = permanent ? localStorage : sessionStorage;
      const key = permanent ? 'hakster:terminal-allowed:always' : EMBEDDED_TERMINAL_ALLOW_KEY;
      try { return new Set(JSON.parse(storage.getItem(key) || '[]')); }
      catch { return new Set(); }
    }

    function isBuildTerminalAllowed(command: string) {
      const cmd = command.trim();
      for (const allowed of [...getBuildAllowedCommands(), ...getBuildAllowedCommands(true)]) {
        if (cmd === allowed || cmd.startsWith(allowed)) return true;
      }
      return false;
    }

    function buildTerminalNeedsAllow(command: string) {
      const cmd = command.trim();
      if (!cmd || isBuildTerminalAllowed(cmd)) return false;
      return EMBEDDED_TERMINAL_PATTERNS.some((pat) => pat.test(cmd));
    }

    function rememberBuildTerminalAllow(command: string, permanent: boolean) {
      const storage = permanent ? localStorage : sessionStorage;
      const key = permanent ? 'hakster:terminal-allowed:always' : EMBEDDED_TERMINAL_ALLOW_KEY;
      let items: string[] = [];
      try { items = JSON.parse(storage.getItem(key) || '[]'); } catch {}
      if (!items.includes(command)) items.push(command);
      storage.setItem(key, JSON.stringify(items));
    }

    function showBuildTerminalAllowPopup(command: string): Promise<'session' | 'always' | 'deny'> {
      return new Promise((resolve) => {
        document.querySelector('.hakster-allow-session-popup')?.remove();
        const wrap = document.createElement('div');
        wrap.className = 'hakster-allow-session-popup';
        wrap.style.cssText = 'position:fixed;inset:0;z-index:2147483647;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;padding:18px;';
        wrap.innerHTML = `
          <div style="width:min(520px,100%);background:#0b0b12;border:1px solid rgba(239,68,68,.45);border-radius:8px;box-shadow:0 24px 80px rgba(0,0,0,.55);padding:16px;font-family:JetBrains Mono,monospace;color:#e5e7eb;">
            <div style="font-weight:800;color:#f87171;font-size:13px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:10px;">Confirm command</div>
            <div style="font-size:12px;color:#cbd5e1;margin-bottom:10px;">This terminal command needs approval before it runs.</div>
            <pre style="white-space:pre-wrap;word-break:break-word;max-height:170px;overflow:auto;background:#050509;border:1px solid #1f2937;border-radius:6px;padding:10px;color:#f8fafc;font-size:12px;margin:0 0 14px;">${htmlEscape(command)}</pre>
            <div style="display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;">
              <button data-choice="deny" style="background:#111827;color:#fca5a5;border:1px solid #374151;border-radius:6px;padding:8px 10px;font-weight:700;cursor:pointer;">Deny</button>
              <button data-choice="always" style="background:#1f2937;color:#fde68a;border:1px solid #4b5563;border-radius:6px;padding:8px 10px;font-weight:700;cursor:pointer;">Always</button>
              <button data-choice="session" style="background:#7c3aed;color:white;border:1px solid #a855f7;border-radius:6px;padding:8px 10px;font-weight:800;cursor:pointer;">Allow this session</button>
            </div>
          </div>`;
        const finish = (choice: 'session' | 'always' | 'deny') => { wrap.remove(); resolve(choice); };
        wrap.addEventListener('click', (e) => {
          const btn = (e.target as HTMLElement).closest('button[data-choice]') as HTMLButtonElement | null;
          if (btn) finish((btn.dataset.choice || 'deny') as 'session' | 'always' | 'deny');
          else if (e.target === wrap) finish('deny');
        });
        document.body.appendChild(wrap);
      });
    }

    async function confirmBuildTerminalCommand(command: string) {
      const cmd = command.trim();
      if (!cmd || !buildTerminalNeedsAllow(cmd)) return true;
      const choice = await showBuildTerminalAllowPopup(cmd);
      if (choice === 'deny') return false;
      const permanent = choice === 'always';
      rememberBuildTerminalAllow(cmd, permanent);
      fetch(`${API}/api/agent/allow`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ command: cmd, permanent, sessionId: getActiveId() || undefined }),
      }).catch(() => {});
      return true;
    }

    let chatTermInputLine = '';
    let chatTermConfirming = false;

    // ── Chat Terminal Scramble/Decode Effect (10-line chunks) ────────
    // Dramatic scramble→decode: lines decode in cascading groups of 10,
    // each pass reveals bigger chunks. 6 passes with glow/spacing fx.
    // Total ~1.5s effect — fast enough to not block, slow enough to see.
    const _CT_SC_CHARS = '▓░▒█⧫⬡アイウ∀∃∂∇◆◈⬢▄▀■▫⯃※✦✧⟐⟑⟒ждлофцшщыъ⬡⬢⬔⬖⬗⬘⬙⬚⟰⟱⟲⟳⟴⟵⟶⟷';
    const _CT_SC_COLORS = ['#7c3aed','#a855f7','#c084fc','#e879f9','#22d3ee','#34d399','#f472b6','#fbbf24','#00ff88','#ff6b6b','#00bfff','#ffd700'];
    const _CT_DECODE_WORDS = ['HAKSTERAI','CRUSH','CONNECT','DECODE','EXEC','AGENT','TERMINAL','SHELL','TASK','NEURAL','PROCESS','RUN','LOAD','SYNC','READY','ONLINE','STREAM','DATA','PARSE','SCAN','INIT','BOOT','LINK','NET','CODE','BUILD','DEPLOY','COMMIT','PUSH','PATCH','MERGE','TEST','DEBUG','TRACE','LOG','PIPE','FORK','THREAD','DAEMON','KERNEL','STACK','HEAP','CACHE','BLOCK','CHAIN','HASH','ENCRYPT','VERIFY','AUTH','SOCKET','PORT','PROXY','ROUTE','BRIDGE','TUNNEL','PROTOCOL','HANDSHAKE','NEGOTIATE','UPGRADE','TRANSFORM','COMPILE','OPTIMIZE','RENDER','PIPELINE','PARALLEL','ASYNC','AWAIT','PROMISE','RESOLVE','YIELD','GENERATOR','ITERATOR','DISPATCH','REDUCE','MAP','FILTER','SORT','SLICE','SPLICE','CONCAT','JOIN','SPLIT','TRIM','REPLACE','SEARCH','MATCH','TEST'];
    let _chatActiveRaf: number|null = null;
    let _chatDecodeShown = false;

    function _ctRandomLine(len: number) {
      let s = '';
      for (let i = 0; i < len; i++) s += _CT_SC_CHARS[Math.floor(Math.random() * _CT_SC_CHARS.length)];
      return s;
    }
    function _ctDecodeLine(len: number) {
      const words: string[] = [];
      let pos = 0;
      while (pos < len) {
        if (Math.random() < 0.35 && len - pos > 8) {
          const word = _CT_DECODE_WORDS[Math.floor(Math.random() * _CT_DECODE_WORDS.length)];
          words.push(word);
          pos += word.length + 1;
        } else {
          const chunk = 2 + Math.floor(Math.random() * 6);
          words.push(_ctRandomLine(Math.min(chunk, len - pos)));
          pos += chunk + 1;
        }
      }
      return words.join(' ').substring(0, len);
    }

    // ── NMS-style decode flash ──────────────────────────────────────
    // Characters rapidly cycle through random symbols, then "lock in"
    // left-to-right like the no-more-secrets (nms) command. 10-line
    // chunks cascade with stagger. Total ~1.6s.
    function showChatDecodeFlash() {
      const container = document.getElementById('terminal-container');
      if (!container || _chatDecodeShown) return;
      _chatDecodeShown = true;
      const old = document.getElementById('chat-decode-overlay');
      if (old) old.remove();
      if (_chatActiveRaf) { cancelAnimationFrame(_chatActiveRaf); _chatActiveRaf = null; }

      const overlay = document.createElement('div');
      overlay.id = 'chat-decode-overlay';
      overlay.style.cssText = 'position:absolute;inset:0;z-index:50;pointer-events:none;overflow:hidden;font-family:JetBrains Mono,monospace;font-size:13px;line-height:1.35;padding:6px 10px;opacity:0;background:rgba(0,0,0,0.92);';
      const panelHeight = container.offsetHeight || 280;
      const numLines = Math.max(Math.floor(panelHeight / 18) - 2, 14);
      const termWidth = container.offsetWidth || 800;
      const charsPerLine = Math.floor((termWidth - 20) / 8);
      const CHUNK_SIZE = 10;
      const SCRAMBLE_MS = 280;
      const LOCKIN_MS = 500;
      const CHUNK_STAGGER = 40;
      const FADE_START = 200;
      const FADE_DURATION = 400;

      const lines: { el: HTMLDivElement; finalText: string; charCount: number; chunkIndex: number }[] = [];
      for (let i = 0; i < numLines; i++) {
        const lineEl = document.createElement('div');
        const charCount = Math.max(charsPerLine - 4, 40) + Math.floor(Math.random() * 12) - 6;
        const finalText = _ctDecodeLine(charCount);
        lineEl.textContent = _ctRandomLine(charCount);
        lineEl.style.color = _CT_SC_COLORS[Math.floor(Math.random() * _CT_SC_COLORS.length)];
        lineEl.style.whiteSpace = 'nowrap';
        lineEl.style.overflow = 'hidden';
        lineEl.style.textShadow = '0 0 8px currentColor';
        overlay.appendChild(lineEl);
        lines.push({ el: lineEl, finalText, charCount, chunkIndex: Math.floor(i / CHUNK_SIZE) });
      }
      container.appendChild(overlay);
      requestAnimationFrame(() => { overlay.style.opacity = '1'; });

      const totalChunks = Math.ceil(numLines / CHUNK_SIZE);
      const startTime = performance.now();

      function frame(now: number) {
        const elapsed = now - startTime;
        const lastLockinEnd = SCRAMBLE_MS + (totalChunks - 1) * CHUNK_STAGGER + LOCKIN_MS;
        const fadeOutStart = lastLockinEnd + FADE_START;
        const fadeOutEnd = fadeOutStart + FADE_DURATION;

        if (elapsed > fadeOutEnd + 100) {
          overlay.remove();
          _chatActiveRaf = null;
          return;
        }

        if (elapsed > fadeOutStart) {
          const fadeProgress = (elapsed - fadeOutStart) / FADE_DURATION;
          overlay.style.opacity = String(Math.max(0, 1 - fadeProgress));
        }

        let allResolved = true;
        for (let i = 0; i < lines.length; i++) {
          const line = lines[i];
          const lineStartLockin = SCRAMBLE_MS + line.chunkIndex * CHUNK_STAGGER;

          if (elapsed < lineStartLockin) {
            line.el.textContent = _ctRandomLine(line.charCount);
            allResolved = false;
          } else {
            const lockinProgress = Math.min(1, (elapsed - lineStartLockin) / LOCKIN_MS);
            const resolvedCount = Math.floor(line.charCount * lockinProgress);
            if (resolvedCount < line.charCount) allResolved = false;

            const resolved = line.finalText.slice(0, resolvedCount);
            const remaining = line.charCount - resolvedCount;
            if (remaining > 0) {
              line.el.textContent = resolved + _ctRandomLine(remaining);
            } else {
              line.el.textContent = line.finalText;
            }

            if (lockinProgress < 0.3) {
              line.el.style.textShadow = '0 0 12px currentColor, 0 0 24px currentColor';
            } else if (lockinProgress < 0.6) {
              line.el.style.textShadow = '0 0 6px currentColor';
            } else if (lockinProgress < 0.9) {
              line.el.style.textShadow = '0 0 2px currentColor';
            } else {
              line.el.style.textShadow = 'none';
            }
          }
        }

        if (allResolved && elapsed >= lastLockinEnd) {
          for (let i = 0; i < lines.length; i++) {
            lines[i].el.textContent = lines[i].finalText;
            lines[i].el.style.textShadow = 'none';
          }
        }

        _chatActiveRaf = requestAnimationFrame(frame);
      }
      _chatActiveRaf = requestAnimationFrame(frame);
    }

    function flushChatTermWrite() {
      chatTermWriteRaf = null;
      if (!chatTerm || !chatTermWriteBuf) return;
      const data = chatTermWriteBuf;
      chatTermWriteBuf = '';
      chatTerm.write(data);
    }

    function enqueueChatTermWrite(data: string) {
      if (!data) return;
      if (!_chatDecodeShown) showChatDecodeFlash();
      chatTermWriteBuf += data;
      if (!chatTermWriteRaf) chatTermWriteRaf = requestAnimationFrame(flushChatTermWrite);
    }

    function initChatTerminal() {
      if (!window.Terminal || !window.FitAddon?.FitAddon) {
        terminalContainer.innerHTML = '<div style="color:#e50914;padding:1rem;font-family:monospace">Terminal libraries not loaded. Visit /terminal first to cache them.</div>';
        return;
      }
      if (chatTerm) return; // already initialized
      chatTerm = new window.Terminal({
        theme: { background: '#0a0a0f', foreground: '#c084fc', cursor: '#7c3aed' },
        fontFamily: 'JetBrains Mono, monospace', fontSize: 13,
        cursorBlink: true, cursorStyle: 'bar', scrollback: 5000,
        allowTransparency: true, convertEol: false,
      });
      chatTermFit = new window.FitAddon.FitAddon();
      chatTerm.loadAddon(chatTermFit);
      chatTerm.open(terminalContainer);
      setTimeout(() => { try { chatTermFit.fit(); } catch {} }, 50);
      chatTerm.writeln('\x1b[1;38;5;177m⚡ haksterAi Chat Terminal\x1b[0m');
      chatTerm.writeln('\x1b[2;38;5;240mConnect to start using the shell.\x1b[0m\r\n');
      chatTerm.onData(async (data: string) => {
        if (!chatTermWs || chatTermWs.readyState !== WebSocket.OPEN) return;
        if (data === '\r') {
          // ── Trigger decode flash on every command typed ──
          _chatDecodeShown = false;
          showChatDecodeFlash();

          const command = chatTermInputLine.trim();
          if (command && buildTerminalNeedsAllow(command) && !chatTermConfirming) {
            chatTermConfirming = true;
            const allowed = await confirmBuildTerminalCommand(command);
            chatTermConfirming = false;
            chatTermInputLine = '';
            chatTermWs.send(JSON.stringify({ type: 'input', data: allowed ? '\r' : '\u0015' }));
            return;
          }
          chatTermInputLine = '';
        } else if (data === '\u007f') {
          chatTermInputLine = chatTermInputLine.slice(0, -1);
        } else if (data === '\u0015' || data === '\u0003') {
          chatTermInputLine = '';
        } else if (!/[\x00-\x08\x0b-\x1f\x7f]/.test(data)) {
          chatTermInputLine = (chatTermInputLine + data).slice(-2000);
        }
        chatTermWs.send(JSON.stringify({ type: 'input', data }));
      });
      chatTerm.onResize((size: any) => {
        if (chatTermWs && chatTermWs.readyState === WebSocket.OPEN) {
          chatTermWs.send(JSON.stringify({ type: 'resize', cols: size.cols, rows: size.rows }));
        }
      });
    }

    function connectChatTerminal() {
      if (!chatTerm) initChatTerminal();
      if (!chatTerm) return;
      if (chatTermWs && chatTermWs.readyState !== WebSocket.CLOSED) return;
      terminalStatus.textContent = 'connecting...';
      terminalStatus.style.color = '#fbbf24';
      const wsUrl = `${getWsBase()}/ws/pty`;
      chatTermWs = new WebSocket(wsUrl);
      chatTermWs.binaryType = 'arraybuffer';
      chatTermDecoder = chatTermDecoder || new TextDecoder('utf-8');
      chatTermWs.onopen = () => {
        terminalStatus.textContent = 'connected';
        terminalStatus.style.color = '#00ff88';
        chatTerm?.writeln('\x1b[1;32m[Connected]\x1b[0m\r\n');
        try { chatTermFit?.fit(); } catch {}
      };
      chatTermWs.onmessage = (ev) => {
        try {
          if (ev.data instanceof ArrayBuffer) {
            enqueueChatTermWrite(chatTermDecoder!.decode(ev.data, { stream: true }));
            return;
          }
          if (ev.data instanceof Blob) {
            ev.data.arrayBuffer().then((buf) => enqueueChatTermWrite(chatTermDecoder!.decode(buf, { stream: true }))).catch(() => {});
            return;
          }
          const msg = JSON.parse(ev.data);
          if (msg.type === 'output' || msg.type === 'data' || msg.type === 'pty') enqueueChatTermWrite(msg.data || '');
          else if (msg.type === 'error') chatTerm?.writeln(`\x1b[31m[Error] ${msg.error}\x1b[0m`);
        } catch {}
      };
      chatTermWs.onclose = () => {
        _chatDecodeShown = false;  // Allow decode flash on reconnect
        terminalStatus.textContent = 'disconnected';
        terminalStatus.style.color = '#64748b';
        chatTerm?.writeln('\r\n\x1b[33m[Disconnected]\x1b[0m');
      };
      chatTermWs.onerror = () => {
        terminalStatus.textContent = 'error';
        terminalStatus.style.color = '#ef4444';
      };
    }

    terminalBtn.addEventListener('click', () => {
      const isHidden = chatTerminalPanel.classList.contains('hidden');
      if (isHidden) {
        chatTerminalPanel.classList.remove('hidden');
        // Resize messages area to make room
        const ma = document.getElementById('messages-area');
        if (ma) ma.style.paddingBottom = '300px';
        setTimeout(() => {
          initChatTerminal();
          connectChatTerminal();
          try { chatTermFit?.fit(); chatTerm?.focus(); } catch {}
        }, 100);
      } else {
        chatTerminalPanel.classList.add('hidden');
        const ma = document.getElementById('messages-area');
        if (ma) ma.style.paddingBottom = '';
      }
    });
    closeTerminalPanel.addEventListener('click', () => {
      chatTerminalPanel.classList.add('hidden');
      const ma = document.getElementById('messages-area');
      if (ma) ma.style.paddingBottom = '';
      if (chatTermWs) { try { chatTermWs.close(); } catch {} }
    });
    terminalReconnectBtn.addEventListener('click', () => {
      if (chatTermWs) { try { chatTermWs.close(); } catch {} }
      setTimeout(connectChatTerminal, 200);
    });
    window.addEventListener('resize', () => { try { chatTermFit?.fit(); } catch {} });

    // ===== Security Review Agent =====
    const pentesterBtn = document.getElementById('pentester-btn')!;
    const pentesterPanel = document.getElementById('pentester-panel')!;
    const closePentesterPanel = document.getElementById('close-pentester-panel')!;
    const pentesterRunBtn = document.getElementById('pentester-run-btn')!;
    const pentesterFpBtn = document.getElementById('pentester-fp-btn')!;
    const pentesterTarget = document.getElementById('pentester-target') as HTMLInputElement;
    const pentesterToolSelect = document.getElementById('pentester-tool-select') as HTMLSelectElement;
    const pentesterOutput = document.getElementById('pentester-output')!;
    const pentesterStatus = document.getElementById('pentester-status')!;

    pentesterBtn.addEventListener('click', () => {
      const isHidden = pentesterPanel.classList.contains('hidden');
      if (isHidden) {
        pentesterPanel.classList.remove('hidden');
        const ma = document.getElementById('messages-area');
        if (ma) ma.style.paddingBottom = '340px';
      } else {
        pentesterPanel.classList.add('hidden');
        const ma = document.getElementById('messages-area');
        if (ma) ma.style.paddingBottom = '';
      }
    });
    closePentesterPanel.addEventListener('click', () => {
      pentesterPanel.classList.add('hidden');
      const ma = document.getElementById('messages-area');
      if (ma) ma.style.paddingBottom = '';
    });

    function scrollPentesterOutput() {
      requestAnimationFrame(() => {
        pentesterOutput.scrollTop = pentesterOutput.scrollHeight;
      });
    }

    pentesterFpBtn.addEventListener('click', async () => {
      pentesterStatus.textContent = 'fingerprinting...';
      pentesterOutput.textContent = 'Fetching device fingerprint...\n';
      scrollPentesterOutput();
      try {
        const res = await fetch(`${API}/api/pentester/fingerprint`);
        const data = await res.json();
        pentesterOutput.textContent = JSON.stringify(data, null, 2);
        scrollPentesterOutput();
        pentesterStatus.textContent = 'fingerprint ready';
      } catch (err: any) {
        pentesterOutput.textContent = `Error: ${err.message}`;
        scrollPentesterOutput();
        pentesterStatus.textContent = 'error';
      }
    });

    pentesterRunBtn.addEventListener('click', async () => {
      const target = pentesterTarget.value.trim();
      if (!target) { pentesterOutput.textContent = 'Please enter a target.'; return; }
      pentesterStatus.textContent = 'running...';
      pentesterRunBtn.disabled = true;
      pentesterOutput.textContent = `🎯 Running security review agent against ${target}...\n\n`;
      scrollPentesterOutput();
      try {
        const res = await fetch(`${API}/api/pentester/run`, {
          method: 'POST', headers: { 'Content-Type': 'application/json', ...(gtoken ? { 'x-api-key': gtoken } : {}) },
          body: JSON.stringify({ target }),
        });
        const data = await res.json();
        if (data.ok) {
          if (data.plan) pentesterOutput.textContent += `📋 Plan:\n${JSON.stringify(data.plan, null, 2)}\n\n`;
          if (data.state) pentesterOutput.textContent += `📊 Final State:\n${JSON.stringify(data.state, null, 2)}\n`;
          scrollPentesterOutput();
          pentesterStatus.textContent = `done (${data.state?.round || 0} rounds)`;
        } else {
          pentesterOutput.textContent += `❌ Error: ${data.error}\n`;
          scrollPentesterOutput();
          pentesterStatus.textContent = 'error';
        }
      } catch (err: any) {
        pentesterOutput.textContent += `❌ Error: ${err.message}\n`;
        scrollPentesterOutput();
        pentesterStatus.textContent = 'error';
      } finally {
        pentesterRunBtn.disabled = false;
      }
    });

    pentesterToolSelect.addEventListener('change', async () => {
      const tool = pentesterToolSelect.value;
      const target = pentesterTarget.value.trim();
      if (!tool || !target) { pentesterToolSelect.value = ''; return; }
      pentesterStatus.textContent = `running ${tool}...`;
      pentesterOutput.textContent = `🔧 ${tool} → ${target}\n\n`;
      scrollPentesterOutput();
      try {
        const res = await fetch(`${API}/api/pentester/scan`, {
          method: 'POST', headers: { 'Content-Type': 'application/json', ...(gtoken ? { 'x-api-key': gtoken } : {}) },
          body: JSON.stringify({ target, tool }),
        });
        const data = await res.json();
        pentesterOutput.textContent += data.output || data.error || 'No output';
        scrollPentesterOutput();
        pentesterStatus.textContent = `${tool} done`;
      } catch (err: any) {
        pentesterOutput.textContent += `Error: ${err.message}`;
        scrollPentesterOutput();
        pentesterStatus.textContent = 'error';
      }
      pentesterToolSelect.value = '';
    });

    // ===== Autopilot hook: after sendMessage completes, schedule next step =====
    const _origSendMessage = sendMessage;
    // We hook via the finally block — patch the busy flag watcher
    const _checkAutopilot = setInterval(() => {
      if (autopilotActive && !busy && !chatInput.value.trim()) {
        if (autopilotTimer) { clearTimeout(autopilotTimer); }
        autopilotTimer = setTimeout(() => {
          if (autopilotActive && !busy) autopilotNext();
        }, 2000);
      }
    }, 3000);

    // ── Smart Autoscroll ──
    // Pauses when user scrolls up, resumes when they scroll back to bottom.
    // A floating arrow button appears when paused.
    let autoScroll = true;
    let scrollArrow: HTMLElement | null = null;

    // Create the floating scroll-to-bottom arrow
    scrollArrow = document.createElement('div');
    scrollArrow.id = 'scroll-arrow';
    scrollArrow.style.cssText = 'position:absolute;bottom:1.25rem;left:50%;transform:translateX(-50%);width:2rem;height:2rem;border-radius:9999px;background:rgba(124,58,237,0.9);border:1px solid rgba(168,85,247,0.5);display:none;align-items:center;justify-content:center;cursor:pointer;z-index:50;transition:opacity 0.2s;box-shadow:0 2px 8px rgba(0,0,0,0.3);';
    scrollArrow.innerHTML = '<svg fill="none" stroke="white" viewBox="0 0 24 24" style="width:14px;height:14px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>';
    messagesArea.parentElement?.appendChild(scrollArrow);

    function activeScrollPanel() {
      return outputPanel.classList.contains('hidden') ? messagesArea : outputPanel;
    }

    function isNearBottom(panel: HTMLElement) {
      return panel.scrollTop + panel.clientHeight >= panel.scrollHeight - 80;
    }

    function scrollPanelToBottom(panel: HTMLElement, force = false) {
      if (!force && !autoScroll) return;
      requestAnimationFrame(() => {
        panel.scrollTop = panel.scrollHeight;
      });
    }

    function updateAutoScroll(panel: HTMLElement) {
      const atBottom = isNearBottom(panel);
      autoScroll = atBottom;
      if (scrollArrow) scrollArrow.style.display = atBottom ? 'none' : 'flex';
    }

    messagesArea.addEventListener('scroll', () => {
      updateAutoScroll(messagesArea);
    });
    outputPanel.addEventListener('scroll', () => {
      updateAutoScroll(outputPanel);
    });
    scrollArrow.addEventListener('click', () => {
      autoScroll = true;
      scrollPanelToBottom(activeScrollPanel(), true);
      if (scrollArrow) scrollArrow.style.display = 'none';
    });

    function maybeScroll(panel: HTMLElement = activeScrollPanel()) { scrollPanelToBottom(panel); }
    const sidebar = document.getElementById('sidebar')!;
    const collapseSidebarBtn = document.getElementById('collapse-sidebar-btn')!;
    const expandSidebarBtn = document.getElementById('expand-sidebar-btn')!;
    const newHackBtn = document.getElementById('new-hack-btn')!;
    const settingsToggle = document.getElementById('settings-toggle')!;
    const settingsPanel = document.getElementById('settings-panel')!;
    const settingsChevron = document.getElementById('settings-chevron')!;
    const historyList = document.getElementById('history-list')!;
    const clearHistoryBtn = document.getElementById('clear-history-btn')!;

    let busy = false;
    const agentMode = true;
    let currentProvider = 'ollama';
    let currentModel = '';
    let totalTokens = 0;
    let activeProjectCwd = localStorage.getItem('hakster-active-project-cwd') || '';
    let pendingImages: UploadedImage[] = [];
    let voiceEnabled = localStorage.getItem('hakster-voice-enabled') === '1';
    let thinkingEnabled = localStorage.getItem('hakster-thinking-enabled') !== 'false';
    let recognition: any = null;
    let listening = false;
    let availableVoices: SpeechSynthesisVoice[] = [];

    // ===== Client Device Detection (comprehensive) =====
    // Collects every available browser/device signal and sends to backend
    async function sendClientContext(sessionId: string) {
      try {
        const nav: any = navigator;
        const ua = nav.userAgent || '';
        const langs = nav.languages || [nav.language || ''];

        // ── Screen info ──
        const screenInfo = {
          screen_width: screen.width || null,
          screen_height: screen.height || null,
          screen_avail_width: screen.availWidth || null,
          screen_avail_height: screen.availHeight || null,
          screen_color_depth: screen.colorDepth || null,
          screen_pixel_depth: screen.pixelDepth || null,
          screen_orientation: screen.orientation?.type || null,
          device_pixel_ratio: window.devicePixelRatio || null,
          viewport_width: window.innerWidth || null,
          viewport_height: window.innerHeight || null,
        };

        // ── Hardware ──
        const hardware = {
          cores: nav.hardwareConcurrency || null,
          memory_gb: nav.deviceMemory || null,
          max_touch_points: nav.maxTouchPoints || 0,
          touch_support: ('ontouchstart' in window) || (nav.maxTouchPoints > 0),
        };

        // ── Network ──
        const connection = nav.connection || nav.mozConnection || nav.webkitConnection || {};
        const network = {
          online: nav.onLine,
          connection_type: connection.effectiveType || null,
          connection_downlink: connection.downlink || null,
          connection_rtt: connection.rtt || null,
          connection_save_data: connection.saveData || false,
        };

        // ── Browser & engine detection ──
        let browser = '', browser_version = '', engine = '', engine_version = '';
        // Order matters: Edge/UAs that contain Chrome must check Edge first
        if (/Edg\//i.test(ua)) { browser = 'Edge'; browser_version = ua.match(/Edg\/([0-9.]+)/)?.[1] || ''; engine = 'Blink'; }
        else if (/OPR\//i.test(ua) || /Opera/i.test(ua)) { browser = 'Opera'; browser_version = ua.match(/OPR\/([0-9.]+)/)?.[1] || ua.match(/Opera\/([0-9.]+)/)?.[1] || ''; engine = 'Blink'; }
        else if (/SamsungBrowser/i.test(ua)) { browser = 'Samsung Internet'; browser_version = ua.match(/SamsungBrowser\/([0-9.]+)/)?.[1] || ''; engine = 'Blink'; }
        else if (/CriOS/i.test(ua)) { browser = 'Chrome iOS'; browser_version = ua.match(/CriOS\/([0-9.]+)/)?.[1] || ''; engine = 'WebKit'; }
        else if (/Chrome/i.test(ua)) { browser = 'Chrome'; browser_version = ua.match(/Chrome\/([0-9.]+)/)?.[1] || ''; engine = 'Blink'; }
        else if (/Firefox/i.test(ua)) { browser = 'Firefox'; browser_version = ua.match(/Firefox\/([0-9.]+)/)?.[1] || ''; engine = 'Gecko'; engine_version = ua.match(/rv:([0-9.]+)/)?.[1] || ''; }
        else if (/FxiOS/i.test(ua)) { browser = 'Firefox iOS'; browser_version = ua.match(/FxiOS\/([0-9.]+)/)?.[1] || ''; engine = 'WebKit'; }
        else if (/Version\/.*Safari/i.test(ua)) { browser = 'Safari'; browser_version = ua.match(/Version\/([0-9.]+)/)?.[1] || ''; engine = 'WebKit'; engine_version = ua.match(/AppleWebKit\/([0-9.]+)/)?.[1] || ''; }
        else if (/Trident/i.test(ua)) { browser = 'IE'; browser_version = ua.match(/rv:([0-9.]+)/)?.[1] || ''; engine = 'Trident'; }
        else if (ua) browser = 'Unknown';

        // ── OS detection (multi-method) ──
        let os_name = '', os_version = '', device_type = '';
        // Method 1: User-Agent Client Hints (modern browsers)
        const uaData = nav.userAgentData;
        if (uaData) {
          const platform = uaData.platform || '';
          if (platform === 'Android') { os_name = 'Android'; device_type = 'mobile'; }
          else if (platform === 'Chrome OS') { os_name = 'ChromeOS'; }
          else if (platform === 'iOS') { os_name = 'iOS'; device_type = 'mobile'; }
          else if (platform === 'macOS') { os_name = 'macOS'; }
          else if (platform === 'Windows') { os_name = 'Windows'; }
          else if (platform === 'Linux') { os_name = 'Linux'; }
          else if (platform) os_name = platform;
          // Get high-entropy OS info
          if (uaData.getHighEntropyValues) {
            try {
              const hev = await uaData.getHighEntropyValues(['platformVersion', 'architecture', 'bitness', 'model', 'fullVersionList']);
              if (hev.platformVersion) os_version = hev.platformVersion;
              if (hev.model) device_type = /phone|mobile/i.test(hev.model) ? 'mobile' : device_type;
            } catch {}
          }
        }
        // Method 2: User-Agent string parsing (fallback)
        if (!os_name) {
          if (/Android/i.test(ua)) { os_name = 'Android'; os_version = ua.match(/Android ([0-9.]+)/)?.[1] || ''; device_type = 'mobile'; }
          else if (/iPhone/i.test(ua)) { os_name = 'iOS'; os_version = (ua.match(/OS ([0-9_]+)/)?.[1] || '').replace(/_/g, '.'); device_type = 'mobile'; }
          else if (/iPad/i.test(ua)) { os_name = 'iPadOS'; os_version = (ua.match(/OS ([0-9_]+)/)?.[1] || '').replace(/_/g, '.'); device_type = 'tablet'; }
          else if (/iPod/i.test(ua)) { os_name = 'iOS'; os_version = (ua.match(/OS ([0-9_]+)/)?.[1] || '').replace(/_/g, '.'); device_type = 'mobile'; }
          else if (/CrOS/i.test(ua)) { os_name = 'ChromeOS'; os_version = ua.match(/CrOS \w+ ([0-9.]+)/)?.[1] || ''; }
          else if (/Windows NT 10/i.test(ua)) { os_name = 'Windows'; os_version = '10/11'; }
          else if (/Windows NT 6\.3/i.test(ua)) { os_name = 'Windows'; os_version = '8.1'; }
          else if (/Windows NT 6\.2/i.test(ua)) { os_name = 'Windows'; os_version = '8'; }
          else if (/Windows NT 6\.1/i.test(ua)) { os_name = 'Windows'; os_version = '7'; }
          else if (/Windows NT/i.test(ua)) { os_name = 'Windows'; }
          else if (/Mac OS X/i.test(ua)) { os_name = 'macOS'; os_version = (ua.match(/Mac OS X ([0-9_.]+)/)?.[1] || '').replace(/_/g, '.'); }
          else if (/Macintosh/i.test(ua)) { os_name = 'macOS'; }
          else if (/Linux/i.test(ua)) { os_name = 'Linux'; }
          else if (/FreeBSD/i.test(ua)) { os_name = 'FreeBSD'; }
          else if (/OpenBSD/i.test(ua)) { os_name = 'OpenBSD'; }
          else if (/X11/i.test(ua)) { os_name = 'Unix'; }
        }
        // Method 3: navigator.platform (legacy)
        const platform = nav.platform || '';

        // ── Device type (multi-signal) ──
        if (!device_type) {
          if (/Mobi|Android|iPhone|iPod/i.test(ua)) device_type = 'mobile';
          else if (/iPad|Tablet|Kindle|Silk/i.test(ua)) device_type = 'tablet';
          else if (/TV|SmartTV|Bravia/i.test(ua)) device_type = 'tv';
          else if (screen.width <= 480 || screen.height <= 480) device_type = 'mobile';
          else if (screen.width <= 1024) device_type = 'tablet';
          else device_type = 'desktop';
        }

        // ── Device model (from UA) ──
        let device_model = '';
        if (os_name === 'Android') { device_model = ua.match(/Android[^;]*;\s*([^)]+)\)/)?.[1]?.trim() || ''; }
        else if (os_name === 'iOS' || os_name === 'iPadOS') { device_model = ua.match(/\((iPhone|iPad|iPod)[^)]*\)/)?.[1] || ''; }

        // ── Bot detection ──
        const is_bot = /bot|crawler|spider|crawling|slurp|baidu|bingpreview|facebookexternalhit|twitterbot|linkedinbot|semrushbot|googlebot/i.test(ua);

        // ── Additional signals ──
        const cookies_enabled = nav.cookieEnabled;
        const do_not_track = nav.doNotTrack;
        const pdf_viewer = nav.pdfViewerEnabled;
        const webdriver = nav.webdriver;
        const gpu = (() => {
          try {
            const c = document.createElement('canvas');
            const gl = c.getContext('webgl') || c.getContext('experimental-webgl');
            if (!gl) return null;
            const dbg = gl.getExtension('WEBGL_debug_renderer_info');
            return dbg ? gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL) : null;
          } catch { return null; }
        })();
        const dark_mode = window.matchMedia?.('(prefers-color-scheme: dark)')?.matches ?? null;
        const reduced_motion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches ?? null;

        const ctx: any = {
          session_id: sessionId,
          user_agent: ua,
          platform,
          os_name, os_version, device_type, device_model,
          browser, browser_version, engine, engine_version,
          language: nav.language || '',
          languages: langs.join(','),
          timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || '',
          timezone_offset: new Date().getTimezoneOffset(),
          ...screenInfo,
          ...hardware,
          ...network,
          cookies_enabled,
          do_not_track,
          pdf_viewer,
          webdriver,
          is_bot,
          gpu,
          dark_mode,
          reduced_motion,
        };
        await fetch(`${API}/api/client-context`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(ctx),
        });
      } catch (e) { /* silent — don't block chat if this fails */ }
    }

    // ===== Conversation History =====
    const CONV_KEY = 'hakster-hack-conversations';
    const ACTIVE_KEY = 'hakster-hack-active-id';
    interface Message { role: 'user' | 'assistant' | 'thinking' | 'image' | 'script' | 'search' | 'confirmation'; content: string; url?: string; prompt?: string; command?: string; toolCallId?: string; sessionId?: string; }
    interface Conversation { id: string; title: string; messages: Message[]; model: string; created: number; }
    interface UploadedImage { name: string; dataUrl: string; }

    function loadConversations(): Conversation[] {
      try {
        const parsed = JSON.parse(localStorage.getItem(CONV_KEY) || '[]');
        if (Array.isArray(parsed)) return parsed;
        localStorage.removeItem(CONV_KEY);
        localStorage.removeItem(ACTIVE_KEY);
        return [];
      } catch { return []; }
    }
    function saveConversations(convs: Conversation[]) { localStorage.setItem(CONV_KEY, JSON.stringify(convs)); }
    function saveConversation(conv: Conversation) {
      const convs = loadConversations();
      const idx = convs.findIndex(c => c.id === conv.id);
      if (idx >= 0) convs[idx] = conv;
      else convs.unshift(conv);
      saveConversations(convs);
    }
    function getActiveId(): string | null { return localStorage.getItem(ACTIVE_KEY); }
    function setActiveId(id: string | null) { if (id) localStorage.setItem(ACTIVE_KEY, id); else localStorage.removeItem(ACTIVE_KEY); }

    function createConversation(title: string, model: string): Conversation {
      const conv: Conversation = { id: `hack-${Date.now()}-${Math.random().toString(36).slice(2,7)}`, title: title.slice(0,60), messages: [], model, created: Date.now() };
      const convs = loadConversations(); convs.unshift(conv); saveConversations(convs); setActiveId(conv.id); 
      sendClientContext(conv.id); // fire-and-forget — tell backend what device we're on
      return conv;
    }
    function updateConversation(id: string, msg: Message) {
      const convs = loadConversations(); const conv = convs.find(c => c.id === id);
      if (conv) { conv.messages.push(msg); saveConversations(convs); }
    }
    function updateConversationTitle(id: string, title: string) {
      const convs = loadConversations(); const conv = convs.find(c => c.id === id);
      if (conv) { conv.title = title.slice(0,60); saveConversations(convs); }
    }

    function renderHistoryList() {
      const convs = loadConversations(); const activeId = getActiveId();
      historyList.innerHTML = '';
      convs.forEach(conv => {
        const item = document.createElement('button');
        item.className = `history-item w-full text-left px-3 py-2 rounded-lg text-sm text-white/60 hover:text-white truncate transition ${conv.id === activeId ? 'active' : ''}`;
        item.textContent = conv.title || 'Untitled'; item.title = conv.title || 'Untitled';
        item.addEventListener('click', () => loadConversation(conv.id));
        historyList.appendChild(item);
      });
    }

    function escapeHtml(s: string) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

    // ── TUI Code Block Renderer ──
    // Parses markdown code fences (```lang ... ```) and inline `code` from message content
    // Returns an HTML string with styled .tui-code-block containers + inline code spans
    function renderCodeBlocks(rawContent: string): string {
      const parts: string[] = [];
      const fenceRegex = /```(\w*)\n?([\s\S]*?)```/g;
      let lastIdx = 0;
      let match;
      while ((match = fenceRegex.exec(rawContent)) !== null) {
        // Text before the fence — parse inline code + basic markdown
        const before = rawContent.slice(lastIdx, match.index);
        parts.push(escapeHtmlWithInline(before));
        const lang = match[1] || 'text';
        const code = match[2].replace(/\n$/, '');
        const langLabel = lang.toUpperCase();
        const codeId = `code-${Math.random().toString(36).slice(2, 9)}`;
        const lines = code.split('\n');
        const lineNumbers = lines.map((_, i) => `<span class="ln">${i + 1}</span>`).join('');
        // We'll store raw code in data attribute for copy; render with line numbers
        const codeHtml = lines.map((line, i) => `<span class="ln">${i + 1}</span>${escapeHtml(line)}`).join('\n');
        const downloadIcon = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:10px;height:10px"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3"/></svg>`;
        parts.push(`<div class="tui-code-block"><div class="tui-code-header"><span class="tui-code-lang">${langLabel}</span><div class="flex items-center gap-2"><span class="tui-code-download" data-code-id="${codeId}" data-lang="${lang}" title="Download as file">${downloadIcon}</span><span class="tui-code-copy" data-code-id="${codeId}"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg><span class="tui-copy-label">Copy</span></span></div></div><div class="tui-code-body"><pre><code id="${codeId}">${codeHtml}</code></pre></div></div>`);
        lastIdx = match.index + match[0].length;
      }
      // Remaining text after last fence
      const after = rawContent.slice(lastIdx);
      if (after) parts.push(escapeHtmlWithInline(after));
      return parts.join('');
    }

    // Escape HTML but preserve inline `code` spans and basic markdown (bold, links, lists)
    function escapeHtmlWithInline(text: string): string {
      if (!text) return '';
      let result = '';
      const inlineCodeRegex = /`([^`\n]+)`/g;
      const boldRegex = /\*\*([^*]+)\*\*/g;
      const linkRegex = /\[([^\]]+)\]\(([^)]+)\)/g;
      // Split by inline code first
      let last = 0; let m;
      while ((m = inlineCodeRegex.exec(text)) !== null) {
        const segment = text.slice(last, m.index);
        result += escapeMarkdownSegment(segment);
        result += `<code>${escapeHtml(m[1])}</code>`;
        last = m.index + m[0].length;
      }
      result += escapeMarkdownSegment(text.slice(last));
      return result;
    }

    function escapeMarkdownSegment(text: string): string {
      let html = escapeHtml(text);
      // Bold
      html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      // Links [text](url)
      html = html.replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
      // Bare URLs — auto-link them so users can click what the agent found
      html = html.replace(/(^|[\s(])(https?:\/\/[^\s<)>]+)/g, '$1<a href="$2" target="_blank" rel="noopener" class="search-url">$2</a>');
      // Line breaks — preserve paragraph spacing
      html = html.replace(/\n\n+/g, '</p><p>');
      html = `<p>${html}</p>`;
      return html;
    }

    // Attach copy handlers to .tui-code-copy elements within a container
    function attachCodeCopyHandlers(container: HTMLElement) {
      const copyIcon = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>`;
      const checkIcon = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`;
      container.querySelectorAll('.tui-code-copy').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const codeId = (btn as HTMLElement).dataset.codeId;
          const codeEl = codeId ? document.getElementById(codeId) : null;
          if (!codeEl) return;
          const text = codeEl.textContent || '';
          try { await navigator.clipboard.writeText(text.replace(/^\d+/gm, '')); } catch {}
          const labelEl = btn.querySelector('.tui-copy-label');
          if (labelEl) { labelEl.textContent = 'Copied!'; btn.classList.add('copied'); btn.querySelector('svg')?.remove(); btn.insertAdjacentHTML('afterbegin', checkIcon); }
          setTimeout(() => { if (labelEl) { labelEl.textContent = 'Copy'; btn.classList.remove('copied'); btn.querySelector('svg')?.remove(); btn.insertAdjacentHTML('afterbegin', copyIcon); } }, 1500);
        });
      });
      container.querySelectorAll('.tui-code-download').forEach((btn) => {
        btn.addEventListener('click', () => {
          const codeId = (btn as HTMLElement).dataset.codeId;
          const lang = (btn as HTMLElement).dataset.lang || 'txt';
          const codeEl = codeId ? document.getElementById(codeId) : null;
          if (!codeEl) return;
          const text = (codeEl.textContent || '').replace(/^\d+/gm, '');
          const ext = lang === 'javascript' ? 'js' : lang === 'typescript' ? 'ts' : lang === 'python' ? 'py' : lang === 'bash' || lang === 'sh' || lang === 'shell' ? 'sh' : lang === 'json' ? 'json' : lang === 'html' ? 'html' : lang === 'css' ? 'css' : lang === 'go' ? 'go' : lang === 'rust' ? 'rs' : lang === 'java' ? 'java' : lang === 'sql' ? 'sql' : 'txt';
          const blob = new Blob([text], { type: 'text/plain' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url; a.download = `snippet-${Date.now()}.${ext}`; a.click();
          URL.revokeObjectURL(url);
          btn.classList.add('copied');
          setTimeout(() => btn.classList.remove('copied'), 1500);
        });
      });
    }

    function renderMessages(messages: Message[]) {
      messagesContainer.innerHTML = '';
      messages.forEach(msg => addMessageBubble(msg));
      maybeScroll();
    }

    function addMessageBubble(msg: Message) {
      if (msg.role === 'image') {
        const bubble = document.createElement('div');
        bubble.className = 'msg-bubble msg-image rounded-xl px-4 py-3';
        bubble.innerHTML = `<div class="text-xs text-white/40 mb-1">${escapeHtml(msg.prompt || 'Generated image')}</div><img src="${msg.url}" alt="${escapeHtml(msg.prompt || 'Image')}" class="rounded-lg max-w-full max-h-96" loading="lazy" /><a href="${msg.url}" download="haksterai-image.png" class="inline-flex items-center gap-1.5 mt-3 px-3 py-1.5 rounded-lg bg-[#7c3aed]/20 border border-[#7c3aed]/30 text-xs font-medium text-[#a855f7] hover:bg-[#7c3aed]/30 hover:border-[#7c3aed]/50 transition">⬇ Download Image</a>`;
        messagesContainer.appendChild(bubble);
      } else {
        const bubble = document.createElement('div');
        const roleClass = msg.role === 'user' ? 'msg-user' : msg.role === 'thinking' ? 'msg-thinking' : msg.role === 'script' ? 'msg-script' : msg.role === 'search' ? 'msg-search' : msg.role === 'confirmation' ? 'msg-confirmation' : 'msg-assistant';
        bubble.className = `msg-bubble ${roleClass} rounded-xl px-4 py-3`;
        const label = msg.role === 'user' ? 'You' : msg.role === 'thinking' ? 'Thinking' : msg.role === 'script' ? 'Script' : msg.role === 'search' ? 'Web' : msg.role === 'confirmation' ? '⚠ Confirm' : 'Assistant';
        const labelColor = msg.role === 'user' ? 'text-[#a855f7]' : msg.role === 'thinking' ? 'text-[#7c3aed]/60' : msg.role === 'script' ? 'text-emerald-300/70' : msg.role === 'search' ? 'text-amber-200/80' : msg.role === 'confirmation' ? 'text-red-400' : 'text-white/40';
        const isAssistant = msg.role === 'assistant';
        const isScript = msg.role === 'script';
        const isConfirmation = msg.role === 'confirmation';
        const bodyClass = isScript ? '' : msg.role === 'search' ? 'msg-body text-xs leading-relaxed' : 'msg-body text-sm leading-relaxed';
        const copyIcon = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>`;
        const pasteIcon = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>`;
        const checkIcon = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`;
        const allowIcon = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
        const denyIcon = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
        const pinIcon = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v2l-2 2v6l3 3H4l3-3V9L5 7V5z"/></svg>`;
        let bodyHtml = '';
        if (isAssistant && msg.url) {
          // File created by agent — show download button
          bodyHtml = `<div class="text-sm text-white/80">${escapeHtml(msg.content)}</div><a href="${msg.url}" download class="inline-flex items-center gap-1 text-xs text-[#7c3aed] hover:text-[#a855f7] mt-2 transition">⬇ Download file</a>`;
        } else if (isAssistant) {
          bodyHtml = renderCodeBlocks(msg.content);
        } else if (isScript) {
          const scriptCodeId = `script-loaded-${Math.random().toString(36).slice(2, 9)}`;
          bodyHtml = `<div class="tui-code-block"><div class="tui-code-header"><span class="tui-code-lang">SHELL</span><span class="tui-code-copy" data-code-id="${scriptCodeId}"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg><span class="tui-copy-label">Copy</span></span></div><div class="tui-code-body"><pre><code id="${scriptCodeId}">${renderScriptLines(msg.content)}</code></pre></div></div>`;
        } else if (isConfirmation) {
          const commandPreview = msg.command ? `<div class="mt-2 rounded-lg bg-[#1a1a1a] border border-[#333] px-3 py-2 text-xs font-mono text-red-300/90 overflow-x-auto">${escapeHtml(msg.command)}</div>` : '';
          bodyHtml = `<div class="text-sm text-white/80">${escapeHtml(msg.content)}</div>${commandPreview}`;
        } else if (msg.role === 'search') {
          bodyHtml = escapeHtmlWithInline(msg.content);
        } else {
          bodyHtml = escapeHtml(msg.content);
        }
        const allowBtn = isConfirmation ? `<button type="button" class="bubble-action" data-action="allow" title="Allow this command for this session">${allowIcon}<span>Allow this session</span></button><button type="button" class="bubble-action" data-action="allow-always" title="Add to permanent allow list">${pinIcon}<span>Always</span></button><button type="button" class="bubble-action" data-action="deny" title="Deny this command">${denyIcon}<span>Deny</span></button>` : '';
        bubble.innerHTML = `<div class="flex items-center justify-between gap-3 mb-1"><div class="text-[10px] font-semibold uppercase tracking-wider ${labelColor}">${label}</div><div class="flex items-center gap-1">${allowBtn}<button type="button" class="bubble-action" data-action="copy" title="Copy message">${copyIcon}<span class="copy-label">Copy</span></button><button type="button" class="bubble-action" data-action="paste" title="Paste into composer">${pasteIcon}<span>Paste</span></button></div></div><div class="${bodyClass}">${bodyHtml}</div>`;
        if (isAssistant || isScript) attachCodeCopyHandlers(bubble);
        const copyBtn = bubble.querySelector('[data-action="copy"]');
        copyBtn?.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(msg.content); } catch {}
          const labelEl = copyBtn.querySelector('.copy-label');
          if (labelEl) { labelEl.textContent = 'Copied!'; copyBtn.classList.add('copied'); copyBtn.querySelector('svg')?.remove(); copyBtn.insertAdjacentHTML('afterbegin', checkIcon); }
          setTimeout(() => { if (labelEl) { labelEl.textContent = 'Copy'; copyBtn.classList.remove('copied'); copyBtn.querySelector('svg')?.remove(); copyBtn.insertAdjacentHTML('afterbegin', copyIcon); } }, 1500);
        });
        bubble.querySelector('[data-action="paste"]')?.addEventListener('click', () => {
          chatInput.value = msg.content;
          setReadyState();
          chatInput.focus();
        });
        // ── Allow/Deny button handlers for confirmation bubbles ──
        bubble.querySelector('[data-action="allow"]')?.addEventListener('click', async () => {
          const btn = bubble.querySelector('[data-action="allow"]') as HTMLElement;
          if (!btn) return;
          btn.innerHTML = `${allowIcon}<span class="copy-label">Allowed ✓</span>`;
          btn.classList.add('copied');
          btn.style.pointerEvents = 'none';
          const denyBtn = bubble.querySelector('[data-action="deny"]') as HTMLElement;
          if (denyBtn) denyBtn.style.display = 'none';
          const alwaysBtn = bubble.querySelector('[data-action="allow-always"]') as HTMLElement;
          if (alwaysBtn) alwaysBtn.style.display = 'none';
          try {
            await fetch(`${API}/api/agent/allow`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ command: msg.command || '', permanent: false, sessionId: msg.sessionId || getActiveId() || undefined }),
            });
          } catch {}
          // Re-trigger the agent so it retries with the command now on the allowlist
          if (!busy) sendMessage(chatInput.value.trim() || `Run the command again: ${msg.command || ''}`);
        });
        bubble.querySelector('[data-action="allow-always"]')?.addEventListener('click', async () => {
          const btn = bubble.querySelector('[data-action="allow-always"]') as HTMLElement;
          if (!btn) return;
          btn.innerHTML = `${pinIcon}<span class="copy-label">Pinned ✓</span>`;
          btn.classList.add('copied');
          btn.style.pointerEvents = 'none';
          const denyBtn = bubble.querySelector('[data-action="deny"]') as HTMLElement;
          if (denyBtn) denyBtn.style.display = 'none';
          const allowBtnEl = bubble.querySelector('[data-action="allow"]') as HTMLElement;
          if (allowBtnEl) allowBtnEl.style.display = 'none';
          try {
            await fetch(`${API}/api/agent/allow`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ command: msg.command || '', permanent: true, sessionId: msg.sessionId || getActiveId() || undefined }),
            });
          } catch {}
          // Re-trigger the agent so it retries with the command now permanently allowed
          if (!busy) sendMessage(chatInput.value.trim() || `Run the command again: ${msg.command || ''}`);
        });
        bubble.querySelector('[data-action="deny"]')?.addEventListener('click', () => {
          const denyBtn = bubble.querySelector('[data-action="deny"]') as HTMLElement;
          const allowBtn = bubble.querySelector('[data-action="allow"]') as HTMLElement;
          const alwaysBtn = bubble.querySelector('[data-action="allow-always"]') as HTMLElement;
          if (denyBtn) { denyBtn.innerHTML = `${denyIcon}<span>Denied ✗</span>`; denyBtn.style.pointerEvents = 'none'; }
          if (allowBtn) allowBtn.style.display = 'none';
          if (alwaysBtn) alwaysBtn.style.display = 'none';
        });
        messagesContainer.appendChild(bubble);
      }
      maybeScroll();
    }

    function renderScriptLines(text: string): string {
      const lines = text.split('\n');
      return lines.map((line, i) => `<span class="ln">${i + 1}</span>${escapeHtml(line)}`).join('\n');
    }

    function addScriptBubble(command: string, cwd: string) {
      const bubble = document.createElement('div');
      bubble.className = 'msg-bubble msg-script rounded-xl px-4 py-3';
      const header = [command ? `$ ${command}` : '$ script', cwd ? `cwd: ${cwd}` : ''].filter(Boolean).join('\n');
      const scriptId = `script-${Math.random().toString(36).slice(2, 9)}`;
      const copyIcon = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>`;
      const pasteIcon = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>`;
      const checkIcon = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`;
      const headerHtml = renderScriptLines(header);
      const downloadIcon = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3"/></svg>`;
      bubble.innerHTML = `<div class="flex items-center justify-between gap-3 mb-1"><div class="text-[10px] font-semibold uppercase tracking-wider text-emerald-300/70">Script</div><div class="flex items-center gap-1"><button type="button" class="bubble-action" data-action="copy" title="Copy script output">${copyIcon}<span class="copy-label">Copy</span></button><button type="button" class="bubble-action" data-action="download" title="Download as file">${downloadIcon}<span>Save</span></button><button type="button" class="bubble-action" data-action="paste" title="Paste into composer">${pasteIcon}<span>Paste</span></button></div></div><div class="tui-code-block"><div class="tui-code-header"><span class="tui-code-lang">SHELL</span><span class="tui-code-copy" data-code-id="${scriptId}"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg><span class="tui-copy-label">Copy</span></span></div><div class="tui-code-body"><pre class="script-output" id="${scriptId}">${headerHtml}\n</pre></div></div>`;
      attachCodeCopyHandlers(bubble);
      const body = bubble.querySelector('.script-output') as HTMLElement;
      const rawBody = document.createElement('div');
      rawBody.style.display = 'none';
      rawBody.className = 'script-raw';
      rawBody.textContent = header + '\n';
      bubble.appendChild(rawBody);
      const copyBtn = bubble.querySelector('[data-action="copy"]');
      copyBtn?.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(rawBody.textContent || ''); } catch {}
        const labelEl = copyBtn.querySelector('.copy-label');
        if (labelEl) { labelEl.textContent = 'Copied!'; copyBtn.classList.add('copied'); copyBtn.querySelector('svg')?.remove(); copyBtn.insertAdjacentHTML('afterbegin', checkIcon); }
        setTimeout(() => { if (labelEl) { labelEl.textContent = 'Copy'; copyBtn.classList.remove('copied'); copyBtn.querySelector('svg')?.remove(); copyBtn.insertAdjacentHTML('afterbegin', copyIcon); } }, 1500);
      });
      bubble.querySelector('[data-action="download"]')?.addEventListener('click', () => {
        const text = rawBody.textContent || '';
        const blob = new Blob([text], { type: 'text/plain' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = `script-${Date.now()}.sh`; a.click();
        URL.revokeObjectURL(url);
        const dlBtn = bubble.querySelector('[data-action="download"]') as HTMLElement;
        if (dlBtn) { dlBtn.classList.add('copied'); const lbl = dlBtn.querySelector('span'); if (lbl) { const prev = lbl.textContent; lbl.textContent = 'Saved ✓'; setTimeout(() => { lbl.textContent = prev; dlBtn.classList.remove('copied'); }, 1500); } }
      });
      bubble.querySelector('[data-action="paste"]')?.addEventListener('click', () => {
        chatInput.value = rawBody.textContent || '';
        setReadyState();
        chatInput.focus();
      });
      messagesContainer.appendChild(bubble);
      messagesArea.scrollTop = messagesArea.scrollHeight;
      return body;
    }

    function refreshScriptLineNumbers(scriptEl: HTMLElement) {
      const raw = (scriptEl.closest('.msg-bubble')?.querySelector('.script-raw') as HTMLElement)?.textContent || scriptEl.textContent || '';
      scriptEl.innerHTML = renderScriptLines(raw);
    }

