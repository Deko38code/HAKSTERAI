    // ===== Terminal Panel (embedded PTY) =====
    const terminalBtn = document.getElementById('terminal-btn')!;
    const chatTerminalPanel = document.getElementById('chat-terminal-panel')!;
    const closeTerminalPanel = document.getElementById('close-terminal-panel')!;
    const terminalContainer = document.getElementById('terminal-container')!;
    const terminalStatus = document.getElementById('terminal-status')!;
    const terminalReconnectBtn = document.getElementById('terminal-reconnect-btn')!;
    let chatTerm: any = null;
    let chatTermFit: any = null;
    let chatTermWs: WebSocket | null = null;
    let chatTermDecoder: TextDecoder | null = null;
    let chatTermWriteBuf = '';
    let chatTermWriteRaf: number | null = null;

    function getWsBase() {
      const proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
      return `${proto}//${window.location.host}`;
    }

    const EMBEDDED_TERMINAL_ALLOW_KEY = 'hakster:build-terminal-allowed';
    const EMBEDDED_TERMINAL_PATTERNS = [
      /\brm\s+(-rf?|--force|--recursive)/i,
      /\brm\s+.*\//i,
      /\bshutdown\b/i,
      /\breboot\b/i,
      /\bhalt\b/i,
      /\bpoweroff\b/i,
      /\bfdisk\b/i,
      /\bmkfs\b/i,
      /\bdd\s+if=/i,
      /\bformat\b/i,
      /\bchmod\s+(-R\s+)?777/i,
      /\bchown\s+.*root/i,
      /\bkill\s+-9\s+/i,
      /\bkillall\b/i,
      /\bpkill\s+-9/i,
      /\bfuser\s+-k\b/i,
      /\bnpm\s+publish/i,
      /\bgit\s+push\s+.*--force/i,
      /\bgit\s+reset\s+--hard/i,
      /\bgit\s+clean\s+-fd/i,
      /\bdocker\s+(rm|rmi|system\s+prune)/i,
      /\bsystemctl\s+(stop|disable|restart)\s+(ssh|nginx|apache|mysql|postgres)/i,
      /\bsystemctl\s+(mask|daemon-reload)\b/i,
      /\biptables\s+-F/i,
      /\bcurl.*\|\s*(ba)?sh/i,
      /\bwget.*\|\s*(ba)?sh/i,
      /\btruncate\s+-s\s+0\b/i,
      /\bcrontab\s+-r\b/i,
      /\bwipefs\b/i,
      /\bsgdisk\b/i,
    ];

    function htmlEscape(value: string) {
      return value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c));
    }

    function getBuildAllowedCommands(permanent = false): Set<string> {
      const storage = permanent ? localStorage : sessionStorage;
      const key = permanent ? 'hakster:terminal-allowed:always' : EMBEDDED_TERMINAL_ALLOW_KEY;
      try { return new Set(JSON.parse(storage.getItem(key) || '[]')); }
      catch { return new Set(); }
    }

    function isBuildTerminalAllowed(command: string) {
      const cmd = command.trim();
      for (const allowed of [...getBuildAllowedCommands(), ...getBuildAllowedCommands(true)]) {
        if (cmd === allowed || cmd.startsWith(allowed)) return true;
      }
      return false;
    }

    function buildTerminalNeedsAllow(command: string) {
      const cmd = command.trim();
      if (!cmd || isBuildTerminalAllowed(cmd)) return false;
      return EMBEDDED_TERMINAL_PATTERNS.some((pat) => pat.test(cmd));
    }

    function rememberBuildTerminalAllow(command: string, permanent: boolean) {
      const storage = permanent ? localStorage : sessionStorage;
      const key = permanent ? 'hakster:terminal-allowed:always' : EMBEDDED_TERMINAL_ALLOW_KEY;
      let items: string[] = [];
      try { items = JSON.parse(storage.getItem(key) || '[]'); } catch {}
      if (!items.includes(command)) items.push(command);
      storage.setItem(key, JSON.stringify(items));
    }

    function showBuildTerminalAllowPopup(command: string): Promise<'session' | 'always' | 'deny'> {
      return new Promise((resolve) => {
        document.querySelector('.hakster-allow-session-popup')?.remove();
        const wrap = document.createElement('div');
        wrap.className = 'hakster-allow-session-popup';
        wrap.style.cssText = 'position:fixed;inset:0;z-index:2147483647;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;padding:18px;';
        wrap.innerHTML = `
          <div style="width:min(520px,100%);background:#0b0b12;border:1px solid rgba(239,68,68,.45);border-radius:8px;box-shadow:0 24px 80px rgba(0,0,0,.55);padding:16px;font-family:JetBrains Mono,monospace;color:#e5e7eb;">
            <div style="font-weight:800;color:#f87171;font-size:13px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:10px;">Confirm command</div>
            <div style="font-size:12px;color:#cbd5e1;margin-bottom:10px;">This terminal command needs approval before it runs.</div>
            <pre style="white-space:pre-wrap;word-break:break-word;max-height:170px;overflow:auto;background:#050509;border:1px solid #1f2937;border-radius:6px;padding:10px;color:#f8fafc;font-size:12px;margin:0 0 14px;">${htmlEscape(command)}</pre>
            <div style="display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;">
              <button data-choice="deny" style="background:#111827;color:#fca5a5;border:1px solid #374151;border-radius:6px;padding:8px 10px;font-weight:700;cursor:pointer;">Deny</button>
              <button data-choice="always" style="background:#1f2937;color:#fde68a;border:1px solid #4b5563;border-radius:6px;padding:8px 10px;font-weight:700;cursor:pointer;">Always</button>
              <button data-choice="session" style="background:#7c3aed;color:white;border:1px solid #a855f7;border-radius:6px;padding:8px 10px;font-weight:800;cursor:pointer;">Allow this session</button>
            </div>
          </div>`;
        const finish = (choice: 'session' | 'always' | 'deny') => { wrap.remove(); resolve(choice); };
        wrap.addEventListener('click', (e) => {
          const btn = (e.target as HTMLElement).closest('button[data-choice]') as HTMLButtonElement | null;
          if (btn) finish((btn.dataset.choice || 'deny') as 'session' | 'always' | 'deny');
          else if (e.target === wrap) finish('deny');
        });
        document.body.appendChild(wrap);
      });
    }

    async function confirmBuildTerminalCommand(command: string) {
      const cmd = command.trim();
      if (!cmd || !buildTerminalNeedsAllow(cmd)) return true;
      const choice = await showBuildTerminalAllowPopup(cmd);
      if (choice === 'deny') return false;
      const permanent = choice === 'always';
      rememberBuildTerminalAllow(cmd, permanent);
      fetch(`${API}/api/agent/allow`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ command: cmd, permanent, sessionId: getActiveId() || undefined }),
      }).catch(() => {});
      return true;
    }

    let chatTermInputLine = '';
    let chatTermConfirming = false;

    // ── Chat Terminal Scramble/Decode Effect (10-line chunks) ────────
    // Dramatic scramble→decode: lines decode in cascading groups of 10,
    // each pass reveals bigger chunks. 6 passes with glow/spacing fx.
    // Total ~1.5s effect — fast enough to not block, slow enough to see.
    const _CT_SC_CHARS = '▓░▒█⧫⬡アイウ∀∃∂∇◆◈⬢▄▀■▫⯃※✦✧⟐⟑⟒ждлофцшщыъ⬡⬢⬔⬖⬗⬘⬙⬚⟰⟱⟲⟳⟴⟵⟶⟷';
    const _CT_SC_COLORS = ['#7c3aed','#a855f7','#c084fc','#e879f9','#22d3ee','#34d399','#f472b6','#fbbf24','#00ff88','#ff6b6b','#00bfff','#ffd700'];
    const _CT_DECODE_WORDS = ['HAKSTERAI','CRUSH','CONNECT','DECODE','EXEC','AGENT','TERMINAL','SHELL','TASK','NEURAL','PROCESS','RUN','LOAD','SYNC','READY','ONLINE','STREAM','DATA','PARSE','SCAN','INIT','BOOT','LINK','NET','CODE','BUILD','DEPLOY','COMMIT','PUSH','PATCH','MERGE','TEST','DEBUG','TRACE','LOG','PIPE','FORK','THREAD','DAEMON','KERNEL','STACK','HEAP','CACHE','BLOCK','CHAIN','HASH','ENCRYPT','VERIFY','AUTH','SOCKET','PORT','PROXY','ROUTE','BRIDGE','TUNNEL','PROTOCOL','HANDSHAKE','NEGOTIATE','UPGRADE','TRANSFORM','COMPILE','OPTIMIZE','RENDER','PIPELINE','PARALLEL','ASYNC','AWAIT','PROMISE','RESOLVE','YIELD','GENERATOR','ITERATOR','DISPATCH','REDUCE','MAP','FILTER','SORT','SLICE','SPLICE','CONCAT','JOIN','SPLIT','TRIM','REPLACE','SEARCH','MATCH','TEST'];
    let _chatActiveRaf: number|null = null;
    let _chatDecodeShown = false;

    function _ctRandomLine(len: number) {
      let s = '';
      for (let i = 0; i < len; i++) s += _CT_SC_CHARS[Math.floor(Math.random() * _CT_SC_CHARS.length)];
      return s;
    }
    function _ctDecodeLine(len: number) {
      const words: string[] = [];
      let pos = 0;
      while (pos < len) {
        if (Math.random() < 0.35 && len - pos > 8) {
          const word = _CT_DECODE_WORDS[Math.floor(Math.random() * _CT_DECODE_WORDS.length)];
          words.push(word);
          pos += word.length + 1;
        } else {
          const chunk = 2 + Math.floor(Math.random() * 6);
          words.push(_ctRandomLine(Math.min(chunk, len - pos)));
          pos += chunk + 1;
        }
      }
      return words.join(' ').substring(0, len);
    }

    // ── NMS-style decode flash ──────────────────────────────────────
    // Characters rapidly cycle through random symbols, then "lock in"
    // left-to-right like the no-more-secrets (nms) command. 10-line
    // chunks cascade with stagger. Total ~1.6s.
    function showChatDecodeFlash() {
      const container = document.getElementById('terminal-container');
      if (!container || _chatDecodeShown) return;
      _chatDecodeShown = true;
      const old = document.getElementById('chat-decode-overlay');
      if (old) old.remove();
      if (_chatActiveRaf) { cancelAnimationFrame(_chatActiveRaf); _chatActiveRaf = null; }

      const overlay = document.createElement('div');
      overlay.id = 'chat-decode-overlay';
      overlay.style.cssText = 'position:absolute;inset:0;z-index:50;pointer-events:none;overflow:hidden;font-family:JetBrains Mono,monospace;font-size:13px;line-height:1.35;padding:6px 10px;opacity:0;background:rgba(0,0,0,0.92);';
      const panelHeight = container.offsetHeight || 280;
      const numLines = Math.max(Math.floor(panelHeight / 18) - 2, 14);
      const termWidth = container.offsetWidth || 800;
      const charsPerLine = Math.floor((termWidth - 20) / 8);
      const CHUNK_SIZE = 10;
      const SCRAMBLE_MS = 280;
      const LOCKIN_MS = 500;
      const CHUNK_STAGGER = 40;
      const FADE_START = 200;
      const FADE_DURATION = 400;

      const lines: { el: HTMLDivElement; finalText: string; charCount: number; chunkIndex: number }[] = [];
      for (let i = 0; i < numLines; i++) {
        const lineEl = document.createElement('div');
        const charCount = Math.max(charsPerLine - 4, 40) + Math.floor(Math.random() * 12) - 6;
        const finalText = _ctDecodeLine(charCount);
        lineEl.textContent = _ctRandomLine(charCount);
        lineEl.style.color = _CT_SC_COLORS[Math.floor(Math.random() * _CT_SC_COLORS.length)];
        lineEl.style.whiteSpace = 'nowrap';
        lineEl.style.overflow = 'hidden';
        lineEl.style.textShadow = '0 0 8px currentColor';
        overlay.appendChild(lineEl);
        lines.push({ el: lineEl, finalText, charCount, chunkIndex: Math.floor(i / CHUNK_SIZE) });
      }
      container.appendChild(overlay);
      requestAnimationFrame(() => { overlay.style.opacity = '1'; });

      const totalChunks = Math.ceil(numLines / CHUNK_SIZE);
      const startTime = performance.now();

      function frame(now: number) {
        const elapsed = now - startTime;
        const lastLockinEnd = SCRAMBLE_MS + (totalChunks - 1) * CHUNK_STAGGER + LOCKIN_MS;
        const fadeOutStart = lastLockinEnd + FADE_START;
        const fadeOutEnd = fadeOutStart + FADE_DURATION;

        if (elapsed > fadeOutEnd + 100) {
          overlay.remove();
          _chatActiveRaf = null;
          return;
        }

        if (elapsed > fadeOutStart) {
          const fadeProgress = (elapsed - fadeOutStart) / FADE_DURATION;
          overlay.style.opacity = String(Math.max(0, 1 - fadeProgress));
        }

        let allResolved = true;
        for (let i = 0; i < lines.length; i++) {
          const line = lines[i];
          const lineStartLockin = SCRAMBLE_MS + line.chunkIndex * CHUNK_STAGGER;

          if (elapsed < lineStartLockin) {
            line.el.textContent = _ctRandomLine(line.charCount);
            allResolved = false;
          } else {
            const lockinProgress = Math.min(1, (elapsed - lineStartLockin) / LOCKIN_MS);
            const resolvedCount = Math.floor(line.charCount * lockinProgress);
            if (resolvedCount < line.charCount) allResolved = false;

            const resolved = line.finalText.slice(0, resolvedCount);
            const remaining = line.charCount - resolvedCount;
            if (remaining > 0) {
              line.el.textContent = resolved + _ctRandomLine(remaining);
            } else {
              line.el.textContent = line.finalText;
            }

            if (lockinProgress < 0.3) {
              line.el.style.textShadow = '0 0 12px currentColor, 0 0 24px currentColor';
            } else if (lockinProgress < 0.6) {
              line.el.style.textShadow = '0 0 6px currentColor';
            } else if (lockinProgress < 0.9) {
              line.el.style.textShadow = '0 0 2px currentColor';
            } else {
              line.el.style.textShadow = 'none';
            }
          }
        }

        if (allResolved && elapsed >= lastLockinEnd) {
          for (let i = 0; i < lines.length; i++) {
            lines[i].el.textContent = lines[i].finalText;
            lines[i].el.style.textShadow = 'none';
          }
        }

        _chatActiveRaf = requestAnimationFrame(frame);
      }
      _chatActiveRaf = requestAnimationFrame(frame);
    }

    function flushChatTermWrite() {
      chatTermWriteRaf = null;
      if (!chatTerm || !chatTermWriteBuf) return;
      const data = chatTermWriteBuf;
      chatTermWriteBuf = '';
      chatTerm.write(data);
      chatTerm.scrollToBottom();
    }

    function enqueueChatTermWrite(data: string) {
      if (!data) return;
      if (!_chatDecodeShown) showChatDecodeFlash();
      chatTermWriteBuf += data;
      if (!chatTermWriteRaf) chatTermWriteRaf = requestAnimationFrame(flushChatTermWrite);
    }

    function initChatTerminal() {
      if (!window.Terminal || !window.FitAddon?.FitAddon) {
        terminalContainer.innerHTML = '<div style="color:#e50914;padding:1rem;font-family:monospace">Terminal libraries not loaded. Visit /terminal first to cache them.</div>';
        return;
      }
      if (chatTerm) return; // already initialized
      chatTerm = new window.Terminal({
        theme: { background: '#0a0a0f', foreground: '#c084fc', cursor: '#7c3aed' },
        fontFamily: 'JetBrains Mono, monospace', fontSize: 13,
        cursorBlink: true, cursorStyle: 'bar', scrollback: 5000,
        allowTransparency: true, convertEol: false,
      });
      chatTermFit = new window.FitAddon.FitAddon();
      chatTerm.loadAddon(chatTermFit);
      chatTerm.open(terminalContainer);
      setTimeout(() => { try { chatTermFit.fit(); } catch {} }, 50);
      chatTerm.writeln('\x1b[1;38;5;177m⚡ haksterAi Chat Terminal\x1b[0m');
      chatTerm.writeln('\x1b[2;38;5;240mConnect to start using the shell.\x1b[0m\r\n');
      chatTerm.onData(async (data: string) => {
        if (!chatTermWs || chatTermWs.readyState !== WebSocket.OPEN) return;
        if (data === '\r') {
          // ── Trigger decode flash on every command typed ──
          _chatDecodeShown = false;
          showChatDecodeFlash();

          const command = chatTermInputLine.trim();
          if (command && buildTerminalNeedsAllow(command) && !chatTermConfirming) {
            chatTermConfirming = true;
            const allowed = await confirmBuildTerminalCommand(command);
            chatTermConfirming = false;
            chatTermInputLine = '';
            chatTermWs.send(JSON.stringify({ type: 'input', data: allowed ? '\r' : '\u0015' }));
            return;
          }
          chatTermInputLine = '';
        } else if (data === '\u007f') {
          chatTermInputLine = chatTermInputLine.slice(0, -1);
        } else if (data === '\u0015' || data === '\u0003') {
          chatTermInputLine = '';
        } else if (!/[\x00-\x08\x0b-\x1f\x7f]/.test(data)) {
          chatTermInputLine = (chatTermInputLine + data).slice(-2000);
        }
        chatTermWs.send(JSON.stringify({ type: 'input', data }));
      });
      chatTerm.onResize((size: any) => {
        if (chatTermWs && chatTermWs.readyState === WebSocket.OPEN) {
          chatTermWs.send(JSON.stringify({ type: 'resize', cols: size.cols, rows: size.rows }));
        }
      });
    }

    function connectChatTerminal() {
      if (!chatTerm) initChatTerminal();
      if (!chatTerm) return;
      if (chatTermWs && chatTermWs.readyState !== WebSocket.CLOSED) return;
      terminalStatus.textContent = 'connecting...';
      terminalStatus.style.color = '#fbbf24';
      const wsUrl = `${getWsBase()}/ws/pty`;
      chatTermWs = new WebSocket(wsUrl);
      chatTermWs.binaryType = 'arraybuffer';
      chatTermDecoder = chatTermDecoder || new TextDecoder('utf-8');
      chatTermWs.onopen = () => {
        terminalStatus.textContent = 'connected';
        terminalStatus.style.color = '#00ff88';
        chatTerm?.writeln('\x1b[1;32m[Connected]\x1b[0m\r\n');
        try { chatTermFit?.fit(); } catch {}
      };
      chatTermWs.onmessage = (ev) => {
        try {
          if (ev.data instanceof ArrayBuffer) {
            enqueueChatTermWrite(chatTermDecoder!.decode(ev.data, { stream: true }));
            return;
          }
          if (ev.data instanceof Blob) {
            ev.data.arrayBuffer().then((buf) => enqueueChatTermWrite(chatTermDecoder!.decode(buf, { stream: true }))).catch(() => {});
            return;
          }
          const msg = JSON.parse(ev.data);
          if (msg.type === 'output' || msg.type === 'data' || msg.type === 'pty') enqueueChatTermWrite(msg.data || '');
          else if (msg.type === 'error') chatTerm?.writeln(`\x1b[31m[Error] ${msg.error}\x1b[0m`);
        } catch {}
      };
      chatTermWs.onclose = () => {
        _chatDecodeShown = false;  // Allow decode flash on reconnect
        terminalStatus.textContent = 'disconnected';
        terminalStatus.style.color = '#64748b';
        chatTerm?.writeln('\r\n\x1b[33m[Disconnected]\x1b[0m');
      };
      chatTermWs.onerror = () => {
        terminalStatus.textContent = 'error';
        terminalStatus.style.color = '#ef4444';
      };
    }

    terminalBtn.addEventListener('click', () => {
