    function isCerebrasModel(model: any) {
      const id = typeof model === 'string' ? model : `${model?.id || ''} ${model?.name || ''}`;
      return /cerebras/i.test(id);
    }

    // Map model IDs to their correct Crush provider
    function providerForModel(model: string): string {
      if (/^openai\//.test(model) || /^google\//.test(model) || /^anthropic\//.test(model) || /^deepseek\/(?!deepseek-v4-flash$)/.test(model)) return 'codex';
      if (/^deepseek\/deepseek-v4-flash$/.test(model) || /^nousresearch\//.test(model) || /^~?anthropic\//.test(model)) return 'nous';
      return 'ollama';
    }

    async function loadModels() {
      let models: string[] = [...FALLBACK_MODELS];
      // Use codex fallbacks when codex provider is active
      if (currentProvider === 'codex') models = [...CODEX_FALLBACK_MODELS];
      if (currentProvider === 'nous') models = [...NOUS_FALLBACK_MODELS];
      try {
        const dashboardRes = await fetch(`${API}/api/dashboard`);
        if (dashboardRes.ok) {
          const dashboard = await dashboardRes.json();
          currentProvider = dashboard.crush?.provider || currentProvider;
          currentModel = dashboard.crush?.model || currentModel;
        }
        const modelsRes = await fetch(`${API}/api/providers/${encodeURIComponent(currentProvider)}/models`);
        if (modelsRes.ok) {
          const data = await modelsRes.json();
          const loaded = (data.models || [])
            .filter((model: any) => !isCerebrasModel(model))
            .map((model: any) => model.id || model.name || model)
            .filter(Boolean);
          if (loaded.length) models = loaded;
        }
      } catch {}
      models = models.filter((model: string) => !/cerebras/i.test(model));
      if (currentModel && !/cerebras/i.test(currentModel) && !models.includes(currentModel)) models.unshift(currentModel);
      const populate = (sel: HTMLSelectElement) => {
        sel.innerHTML = '';
        models.forEach((m: string) => { const opt = document.createElement('option'); opt.value = m; opt.textContent = m; sel.appendChild(opt); });
        if (currentModel && models.includes(currentModel)) sel.value = currentModel;
        else if (models.includes('glm-5.2:cloud')) sel.value = 'glm-5.2:cloud';
        else if (models.includes('gpt-oss:120b-cloud')) sel.value = 'gpt-oss:120b-cloud';
      };
      populate(modelSelect); populate(sidebarModelSelect);
      currentModel = modelSelect.value;
      const syncModel = async (model: string) => {
        if (!model || /cerebras/i.test(model)) return;
        currentModel = model; modelSelect.value = model; sidebarModelSelect.value = model;
        const provider = providerForModel(model);
        currentProvider = provider;
        try {
          await fetch(`${API}/api/crush/config`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ provider, model }),
          });
        } catch {}
      };
      modelSelect.addEventListener('change', () => syncModel(modelSelect.value));
      sidebarModelSelect.addEventListener('change', () => syncModel(sidebarModelSelect.value));
    }

