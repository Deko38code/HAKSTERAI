    async function handleGoogleCredential(response: any) {
      const credential = response.credential;
      if (!credential) return;
      // Collect device info for tracking
      const device = {
        deviceType: /Mobi|Android/i.test(navigator.userAgent) ? 'mobile' : 'desktop',
        osName: navigator.platform || 'unknown',
        browser: navigator.userAgent.match(/(Chrome|Firefox|Safari|Edge|Opera)\/?[\s\d.]+/i)?.[0]?.split('/')[0] || 'unknown',
        screenSize: `${screen.width}x${screen.height}`,
        language: navigator.language || '',
        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || '',
      };
      try {
        const res = await fetch(`${API}/api/auth/google`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ credential, device, referralCode: getReferralCodeFromStorage() }),
        });
        const data = await res.json();
        if (data.ok) {
          googleToken = data.apiKey;
          googleUser = data.user;
          localStorage.setItem('hakster_google_token', googleToken!);
          localStorage.setItem('hakster_google_user', JSON.stringify(data.user));
          localStorage.setItem('hakster_user_data', JSON.stringify({ id: data.user.id || '', name: data.user.username || data.user.email || 'User', email: data.user.email || '', picture: data.user.picture || '' }));
          localStorage.removeItem('hakster_referral_code');
          (window as any).haksterSessionTouch?.();
          showGoogleUserBadge(data.user);
        }
      } catch (e) {
        console.error('Google auth failed:', e);
      }
    }

