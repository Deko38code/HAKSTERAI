      async function load() {
        var status = document.getElementById('pl-status');
        if (!token) { status.textContent = 'Owner sign-in required.'; stopSession(); paintSession(); return; }
        status.textContent = 'Reading live ledgers…';
        try {
          var r = await fetch('/api/admin/profit-live', { headers: { 'x-api-key': token }, cache: 'no-store' });
          var d = await r.json().catch(function () { return {}; });
          if (!r.ok || !d.ok) throw new Error(d.error || ('HTTP ' + r.status));
          render(d);
          status.innerHTML = '<b>LIVE</b> · ' + new Date(d.generatedAt).toLocaleTimeString() + ' · refreshes every 30 s';
        } catch (e) {
          status.textContent = 'Unavailable: ' + (e && e.message ? e.message : 'unknown error');
          // A refused credential is a sign-out; a network blip is not, so only
          // 401/403 stops the session counter.
          if (/HTTP 40[13]/.test(String(e && e.message))) { stopSession(); }
        }
      }

      load();
      setInterval(function () { if (document.visibilityState === 'visible') load(); }, 30000);
    })();
  </script>
</Layout>
