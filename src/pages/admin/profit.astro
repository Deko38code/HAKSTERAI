---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin — Profit | haksterAi">
  <style is:global>
    .pl-wrap{max-width:1180px;margin:0 auto;padding:26px 18px 80px;color:#e2e8f0;}
    .pl-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:6px;}
    .pl-eyebrow{font:600 10.5px/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.16em;text-transform:uppercase;color:#64748b;margin:0 0 8px;}
    .pl-title{font-size:clamp(24px,4vw,34px);font-weight:800;letter-spacing:-.02em;margin:0;}
    .pl-status{font:500 12px/1.5 ui-monospace,monospace;color:#94a3b8;text-align:right;}
    .pl-status b{color:#22c55e;font-weight:700;}
    .pl-note{max-width:70ch;color:#94a3b8;font-size:13px;margin:8px 0 22px;}
    .pl-section{margin-top:26px;}
    .pl-section h2{font-size:13px;letter-spacing:.13em;text-transform:uppercase;color:#94a3b8;font-weight:700;margin:0 0 10px;}
    .pl-wheels{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,190px),1fr));gap:12px;}
    .pl-gainloss{display:grid;grid-template-columns:minmax(150px,190px) minmax(0,1fr);gap:18px;align-items:center;}
    .pl-gainloss svg{width:100%;max-width:170px;height:auto;display:block;margin:auto;}
    .pl-gainloss .pl-row{font-size:13px;}
    .pl-wheel{background:#111118;border:1px solid #1e1e2e;border-radius:14px;padding:14px;display:flex;flex-direction:column;align-items:center;gap:6px;min-width:0;}
    .pl-wheel svg{width:112px;height:112px;}
    .pl-wheel .lbl{font:600 10.5px/1 ui-monospace,monospace;letter-spacing:.11em;text-transform:uppercase;color:#64748b;}
    .pl-wheel .cap{font-size:11.5px;color:#94a3b8;text-align:center;line-height:1.45;}
    .pl-tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,148px),1fr));gap:10px;}
    .pl-tile{background:#111118;border:1px solid #1e1e2e;border-radius:12px;padding:12px 13px;min-width:0;}
    .pl-tile .k{font:600 10px/1 ui-monospace,monospace;letter-spacing:.11em;text-transform:uppercase;color:#64748b;margin:0 0 7px;}
    .pl-tile .v{font:700 22px/1.1 ui-monospace,monospace;color:#f1f5f9;font-variant-numeric:tabular-nums;overflow-wrap:anywhere;}
    .pl-tile .s{font-size:11px;color:#94a3b8;margin-top:5px;line-height:1.4;}
    .pl-tile.money .v{color:#4ade80;}
    .pl-tile.warn .v{color:#fbbf24;}
    .pl-chart{display:flex;align-items:flex-end;gap:4px;height:120px;padding:10px;background:#0b0b12;border:1px solid #1e1e2e;border-radius:12px;overflow:hidden;}
    .pl-bar{flex:1 1 0;min-width:3px;border-radius:3px 3px 0 0;background:linear-gradient(180deg,#a855f7,#6d28d9);position:relative;}
    .pl-bar span{position:absolute;top:-16px;left:50%;transform:translateX(-50%);font:600 9px/1 ui-monospace,monospace;color:#94a3b8;white-space:nowrap;}
    .pl-axis{display:flex;justify-content:space-between;font:500 10px/1 ui-monospace,monospace;color:#475569;margin-top:6px;}
    .pl-grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,330px),1fr));gap:14px;align-items:start;}
    .pl-card{background:#111118;border:1px solid #1e1e2e;border-radius:14px;padding:15px;min-width:0;}
    .pl-card h3{font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;margin:0 0 10px;color:#c4b5fd;}
    .pl-row{display:flex;justify-content:space-between;gap:10px;padding:6px 0;border-bottom:1px solid #171722;font-size:12.5px;}
    .pl-row:last-child{border-bottom:0;}
    .pl-row .k{color:#94a3b8;min-width:0;}
    .pl-row .v{font-family:ui-monospace,monospace;color:#e2e8f0;text-align:right;font-variant-numeric:tabular-nums;}
    .pl-row .v.good{color:#4ade80;}
    .pl-row .v.bad{color:#f87171;}
    .pl-badge{display:inline-block;padding:2px 7px;border-radius:999px;border:1px solid #334155;font:600 10px/1.4 ui-monospace,monospace;letter-spacing:.06em;color:#cbd5e1;}
    .pl-badge.live{border-color:#166534;background:#052e16;color:#4ade80;}
    .pl-badge.off{border-color:#7f1d1d;background:#2b0b0b;color:#fca5a5;}
    .pl-list{font-size:12px;color:#cbd5e1;line-height:1.6;margin:0;padding-left:16px;}
    .pl-empty{font-size:12.5px;color:#64748b;line-height:1.6;}
    .pl-session{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 14px;}
    .pl-session .since{font:700 15px/1.3 ui-monospace,monospace;color:#f1f5f9;font-variant-numeric:tabular-nums;}
    .pl-session .clock{font:700 22px/1.2 ui-monospace,monospace;color:#4ade80;font-variant-numeric:tabular-nums;letter-spacing:.02em;}
    .pl-session .who{font-size:12px;color:#94a3b8;overflow-wrap:anywhere;}
    .pl-foot{margin-top:26px;border-top:1px solid #1e1e2e;padding-top:12px;font-size:11.5px;color:#64748b;line-height:1.7;}
    @media (max-width:480px){
      .pl-wrap{padding:18px 14px 90px;}
      .pl-status{text-align:left;}
      .pl-wheel svg{width:96px;height:96px;}
      .pl-gainloss{grid-template-columns:1fr;}
    }
  </style>

  <div class="pl-wrap">
    <div class="pl-head">
      <div>
        <p class="pl-eyebrow">haksterAi · owner only · accounting</p>
        <h1 class="pl-title">Live profit</h1>
      </div>
      <div class="pl-status" id="pl-status" role="status" aria-live="polite">Loading live numbers…</div>
    </div>
    <section class="pl-section">
      <h2>Locked rate card &middot; live from junkalot.co</h2>
      <div class="pl-card" id="pl-rates">
        <p class="pl-empty">Reading the locked rate card from Junkalot&hellip;</p>
      </div>
    </section>

    <section class="pl-section">
      <h2>Accounts on the meter &middot; measured tokens at the locked rate</h2>
      <div class="pl-card" id="pl-user-meter">
        <p class="pl-empty">Reading each account's measured usage&hellip;</p>
      </div>
    </section>

    <section class="pl-section">
      <h2>Model keys &middot; one id per key, usage measured per key</h2>
      <div class="pl-card" id="pl-key-ledger">
        <p class="pl-empty">Reading the key ledger&hellip;</p>
      </div>
    </section>

    <section class="pl-section">
      <h2>Her usage &middot; which key ran it, and when she is on</h2>
      <div class="pl-card" id="pl-usage-detail">
        <p class="pl-empty">Reading Junkalot's provider split and hourly pattern&hellip;</p>
      </div>
    </section>

    <p class="pl-note">Every number here is read from what actually happened: the HaksterAI payment and usage ledgers on this box, and PhantomIDE's own profit ledger on Parrot. Nothing is estimated into a number that was not measured, nothing is billed, and no plan, model or route is changed by this page.</p>

    <section class="pl-section">
      <h2>Admin session</h2>
      <div class="pl-card pl-session" id="pl-session" role="status" aria-live="polite">
        <p class="pl-empty">Checking whether an admin session is live…</p>
      </div>
    </section>

    <section class="pl-section">
      <h2>Wheels</h2>
      <div class="pl-wheels" id="pl-wheels"></div>
    </section>

    <section class="pl-section">
      <h2>HaksterAI gains and losses · confirmed revenue vs recorded AI cost</h2>
      <div class="pl-card pl-gainloss" id="pl-gainloss">
        <div id="pl-gainloss-chart"><p class="pl-empty">Waiting for ledger data…</p></div>
        <div id="pl-gainloss-rows"></div>
      </div>
      <p class="pl-empty" style="margin-top:8px">Net shown here is revenue minus metered AI cost recorded in the usage ledger. It is not full business profit: SMS, infrastructure, payment fees, taxes, refunds and other expenses are not included unless they are recorded in these ledgers.</p>
    </section>

    <section class="pl-section">
      <h2>Grid</h2>
      <div class="pl-tiles" id="pl-tiles"></div>
    </section>

    <section class="pl-section">
      <h2>HaksterAI tokens by day — last 14 days</h2>
      <div class="pl-chart" id="pl-chart"></div>
      <div class="pl-axis"><span id="pl-axis-lo">—</span><span id="pl-axis-hi">—</span></div>
    </section>

    <section class="pl-section">
      <h2>Both projects live</h2>
      <div class="pl-grid2">
        <div class="pl-card" id="pl-phantom">
          <h3>PhantomIDE · Parrot</h3>
          <p class="pl-empty">Reading PhantomIDE's profit ledger…</p>
        </div>
        <div class="pl-card" id="pl-junkalot">
          <h3>Junkalot · Mr Ed coach</h3>
          <p class="pl-empty">Reading Junkalot's coach usage…</p>
        </div>
      </div>
    </section>

    <section class="pl-section">
      <h2>Junkalot · client value vs the plan — owner record</h2>
      <div class="pl-card" id="pl-client-value">
        <p class="pl-empty">Reading Junkalot&rsquo;s coach usage…</p>
      </div>
    </section>

    <section class="pl-section">
      <h2>Lane budget — when Codex is worth the spend</h2>
      <div class="pl-card" id="pl-lane">
        <p class="pl-empty">Working out the break-even from the measured rows…</p>
      </div>
    </section>

    <section class="pl-section">
      <h2>HaksterAI accounts</h2>
      <div class="pl-card" id="pl-people">
        <p class="pl-empty">Reading accounts…</p>
      </div>
    </section>

    <p class="pl-foot" id="pl-foot">Usage is recorded, never billed. This page is read-only: it never charges an account, changes a plan, or edits a provider configuration. Reading another project's usage file is read-only and does not write into it.</p>
  </div>

  <script is:inline>
    (function () {
      var money = function (cents) {
        return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format((Number(cents) || 0) / 100);
      };
      var compact = function (n) {
        n = Number(n) || 0;
        if (n >= 1e9) return (n / 1e9).toFixed(2) + 'B';
        if (n >= 1e6) return (n / 1e6).toFixed(2) + 'M';
        if (n >= 1e3) return (n / 1e3).toFixed(1) + 'k';
        return String(Math.round(n));
      };
      var pct = function (n) { return (Number(n) || 0).toFixed(1) + '%'; };
      var esc = function (s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      };
      var token = '';
      try { token = localStorage.getItem('hakster_google_token') || localStorage.getItem('hakster_api_key') || ''; } catch (e) {}

      function wheel(value, label, caption, color) {
        var p = Math.max(0, Math.min(100, Number(value) || 0));
        var circ = 2 * Math.PI * 44;
        var dash = (p / 100) * circ;
        return '' +
          '<div class="pl-wheel">' +
            '<svg viewBox="0 0 112 112" role="img" aria-label="' + esc(label) + ' ' + p.toFixed(1) + ' percent">' +
              '<circle cx="56" cy="56" r="44" fill="none" stroke="#1e1e2e" stroke-width="10"></circle>' +
              '<circle cx="56" cy="56" r="44" fill="none" stroke="' + color + '" stroke-width="10" stroke-linecap="round" stroke-dasharray="' + dash.toFixed(1) + ' ' + circ.toFixed(1) + '" transform="rotate(-90 56 56)"></circle>' +
              '<text x="56" y="61" text-anchor="middle" font-family="ui-monospace,monospace" font-size="21" font-weight="700" fill="#f1f5f9">' + (p >= 99.95 ? '100%' : pct(p)) + '</text>' +
            '</svg>' +
            '<div class="lbl">' + esc(label) + '</div>' +
            '<div class="cap">' + esc(caption) + '</div>' +
          '</div>';
      }
      function tile(k, v, s, cls) {
        return '<div class="pl-tile ' + (cls || '') + '"><p class="k">' + esc(k) + '</p><p class="v">' + esc(v) + '</p><div class="s">' + esc(s || '') + '</div></div>';
      }
      function row(k, v, cls) {
        return '<div class="pl-row"><span class="k">' + esc(k) + '</span><span class="v ' + (cls || '') + '">' + esc(v) + '</span></div>';
      }

      // ── Admin session card ─────────────────────────────────────────────
      // Owner (2026-11-21): "if any admin are live make card say active since
      // with counter til logged out or signed out". "Active since" is the
      // server-recorded sign-in time (users.last_login_at); the counter runs on
      // that real start and stops the moment this page sees the sign-out.
      var session = { since: null, timer: null, stoppedAt: null };
      function elapsedLabel(ms) {
        var s = Math.max(0, Math.floor(ms / 1000));
        var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
        return h + 'h ' + String(m).padStart(2, '0') + 'm ' + String(sec).padStart(2, '0') + 's';
      }
      function utcLabel(ms) {
        return new Date(ms).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
      }
      function paintSession() {
        var el = document.getElementById('pl-session');
        if (!el) return;
        if (session.stoppedAt) {
          el.innerHTML = '<h3>Admin session <span class="pl-badge off">SIGNED OUT</span></h3>' +
            '<div class="since">Signed out ' + esc(utcLabel(session.stoppedAt)) + '</div>' +
            '<div class="clock">' + esc(elapsedLabel(session.stoppedAt - session.since)) + '</div>' +
            '<div class="who">Session ran from ' + esc(utcLabel(session.since)) + ' to sign-out. The counter is stopped.</div>';
          return;
        }
        if (!session.since) {
          el.innerHTML = '<h3>Admin session <span class="pl-badge off">NOT LIVE</span></h3>' +
            '<p class="pl-empty">No admin session is signed in, so there is no start time to count from.</p>';
          return;
        }
        el.innerHTML = '<h3>Admin session <span class="pl-badge live">LIVE</span></h3>' +
          '<div class="since">Active since ' + esc(utcLabel(session.since)) + '</div>' +
          '<div class="clock" id="pl-session-clock">' + esc(elapsedLabel(Date.now() - session.since)) + '</div>' +
          '<div class="who">' + esc((window.__plAdmin && window.__plAdmin.email) || 'owner account') + ' · counter runs until sign-out</div>';
      }
      function startSession(signedInAtSec, email) {
        window.__plAdmin = { email: email || null };
        if (!Number(signedInAtSec)) { paintSession(); return; }
        session.since = Number(signedInAtSec) * 1000;
        session.stoppedAt = null;
        if (session.timer) clearInterval(session.timer);
        paintSession();
        session.timer = setInterval(function () {
          var clock = document.getElementById('pl-session-clock');
          if (!clock || !session.since || session.stoppedAt) return;
          clock.textContent = elapsedLabel(Date.now() - session.since);
        }, 1000);
      }
      function stopSession() {
        if (!session.since || session.stoppedAt) return;
        session.stoppedAt = Date.now();
        if (session.timer) { clearInterval(session.timer); session.timer = null; }
        paintSession();
      }
      window.addEventListener('hakster:signout', stopSession);

      function render(d) {
        var h = d.hakster || {};
        var rev = h.revenue || {};
        var use = h.usage || {};
        var phantom = d.phantom;
        var junk = d.junkalot;

        // Real sign-in time from the server row, counted live until sign-out.
        startSession(d.adminSession && d.adminSession.signedInAtSec, d.adminSession && d.adminSession.email);

        // Wheels — every figure derived from measured rows only.
        var collected = Number(rev.allTimeCents) || 0;
        var dupes = Number(rev.excludedDuplicateCents) || 0;
        var aiCostCents = Number(use.costCents) || 0;
        var netAfterAiCents = collected - aiCostCents;
        var costAgainstRevenuePct = collected > 0 ? aiCostCents / collected * 100 : null;
        var revenueAfterAiPct = collected > 0 ? netAfterAiCents / collected * 100 : null;
        var cleanShare = collected + dupes > 0 ? (collected / (collected + dupes)) * 100 : 100;
        var phantomMargin = phantom && phantom.totals ? Number(phantom.totals.marginPct) || 0 : null;
        var costShare = phantom && phantom.totals && Number(phantom.totals.bookedCents) > 0
          ? (Number(phantom.totals.estCostCents) || 0) / Number(phantom.totals.bookedCents) * 100
          : 0;
        document.getElementById('pl-wheels').innerHTML =
          wheel(cleanShare, 'Clean ledger', money(collected) + ' counted · ' + money(dupes) + ' duplicate excluded', '#4ade80') +
          wheel(phantomMargin == null ? 0 : phantomMargin, 'Phantom margin', phantomMargin == null ? 'PhantomIDE ledger not reachable yet' : 'booked vs modelled token cost, ' + (phantom.windowDays || 30) + '-day window', '#a855f7') +
          wheel(phantomMargin == null ? 0 : Math.max(0, 100 - costShare), 'Cost headroom', costShare ? pct(costShare) + ' of booked revenue is modelled token cost' : 'flat plan lanes: no metered token bill', '#22d3ee');

        var chartEl = document.getElementById('pl-gainloss-chart');
        var rowsEl = document.getElementById('pl-gainloss-rows');
        if (collected > 0) {
          var ratio = Math.max(0, Math.min(1, aiCostCents / collected));
          var circumference = 2 * Math.PI * 48;
          var costArc = circumference * ratio;
          var gainArc = circumference - costArc;
          var center = revenueAfterAiPct == null ? '—' : (netAfterAiCents >= 0 ? pct(revenueAfterAiPct) : 'LOSS');
          chartEl.innerHTML = '<svg viewBox="0 0 120 120" role="img" aria-label="Revenue split: ' + esc(pct(Math.min(100, Math.max(0, 100 - ratio * 100)))) + ' remains after recorded AI cost">' +
            '<circle cx="60" cy="60" r="48" fill="none" stroke="#1e1e2e" stroke-width="12"></circle>' +
            '<circle cx="60" cy="60" r="48" fill="none" stroke="#f87171" stroke-width="12" stroke-dasharray="' + costArc.toFixed(1) + ' ' + circumference.toFixed(1) + '" transform="rotate(-90 60 60)"></circle>' +
            '<circle cx="60" cy="60" r="48" fill="none" stroke="#4ade80" stroke-width="12" stroke-dasharray="' + gainArc.toFixed(1) + ' ' + circumference.toFixed(1) + '" stroke-dashoffset="-' + costArc.toFixed(1) + '" transform="rotate(-90 60 60)"></circle>' +
            '<text x="60" y="57" text-anchor="middle" fill="#f1f5f9" font-family="ui-monospace,monospace" font-size="16" font-weight="700">' + esc(center) + '</text>' +
            '<text x="60" y="73" text-anchor="middle" fill="#64748b" font-family="ui-monospace,monospace" font-size="7">AFTER AI COST</text></svg>';
          rowsEl.innerHTML = row('Confirmed revenue · duplicates excluded', money(collected), 'good') +
            row('Recorded metered AI cost', money(aiCostCents), 'bad') +
            row('Net after recorded AI cost', money(netAfterAiCents), netAfterAiCents >= 0 ? 'good' : 'bad') +
            row('Gain / loss against revenue', revenueAfterAiPct == null ? '—' : pct(revenueAfterAiPct), netAfterAiCents >= 0 ? 'good' : 'bad') +
            row('Recorded AI cost share', costAgainstRevenuePct == null ? '—' : pct(costAgainstRevenuePct), aiCostCents <= collected ? 'good' : 'bad') +
            (aiCostCents > collected ? '<p class="pl-empty" style="margin-top:8px;color:#f87171">Recorded AI cost is higher than confirmed revenue by ' + esc(money(aiCostCents - collected)) + '.</p>' : '');
        } else {
          chartEl.innerHTML = '<svg viewBox="0 0 120 120" role="img" aria-label="No confirmed revenue recorded"><circle cx="60" cy="60" r="48" fill="none" stroke="#334155" stroke-width="12"></circle><text x="60" y="57" text-anchor="middle" fill="#94a3b8" font-family="ui-monospace,monospace" font-size="13" font-weight="700">NO DATA</text><text x="60" y="73" text-anchor="middle" fill="#64748b" font-family="ui-monospace,monospace" font-size="7">REVENUE</text></svg>';
          rowsEl.innerHTML = row('Confirmed revenue · duplicates excluded', money(collected)) +
            row('Recorded metered AI cost', money(aiCostCents), aiCostCents ? 'bad' : '') +
            row('Net after recorded AI cost', money(netAfterAiCents), netAfterAiCents < 0 ? 'bad' : '') +
            '<p class="pl-empty" style="margin-top:8px">A revenue percentage is not available until a completed non-duplicate payment is recorded.</p>';
        }

        // Grid
        document.getElementById('pl-tiles').innerHTML =
          tile('Revenue, all time', money(rev.allTimeCents), (rev.payments || 0) + ' completed payment' + (rev.payments === 1 ? '' : 's') + ' · ' + (rev.activeSubs || 0) + ' active subscription' + (rev.activeSubs === 1 ? '' : 's'), 'money') +
          tile('Revenue, 30 days', money(rev.month30Cents), 'from the local payments ledger', 'money') +
          tile('Calls logged', compact(use.calls), (use.firstDay || '—') + ' → ' + (use.lastDay || '—')) +
          tile('Tokens', compact((Number(use.inputTokens) || 0) + (Number(use.outputTokens) || 0)), compact(use.inputTokens) + ' in · ' + compact(use.outputTokens) + ' out') +
          tile('Metered provider cost', money(use.costCents), 'recorded by the usage writer', use.costCents ? 'warn' : 'money') +
          tile('Accounts', compact((h.people && h.people.total) || 0), ((h.people && h.people.plans) || []).map(function (p) { return p.plan + ' ' + p.c; }).join(' · ')) +
          tile('Activity, 7 days', compact((h.people && h.people.activity7d) || 0), 'signed-in actions recorded') +
          tile('Duplicate rows excluded', money(dupes), (rev.excludedDuplicateRows || 0) + ' row(s) flagged duplicate_of', dupes ? 'warn' : '');

        // Chart — 14-day window, zero days drawn as a stub, never invented.
        var byDay = (use.byDay || []);
        var map = {};
        byDay.forEach(function (r) { map[r.day] = r; });
        var days = [];
        var cursor = new Date();
        cursor.setUTCHours(0, 0, 0, 0);
        for (var i = 13; i >= 0; i--) {
          var dt = new Date(cursor.getTime() - i * 86400000);
          var key = dt.toISOString().slice(0, 10);
          days.push({ day: key, calls: (map[key] && Number(map[key].calls)) || 0 });
        }
        var max = Math.max.apply(null, days.map(function (d) { return d.calls; }).concat([1]));
        document.getElementById('pl-chart').innerHTML = days.map(function (d) {
          var height = d.calls ? Math.max(6, (d.calls / max) * 92) : 3;
          var label = d.calls ? '<span>' + d.calls + '</span>' : '';
          return '<div class="pl-bar" style="height:' + height.toFixed(1) + '%;' + (d.calls ? '' : 'background:#1e1e2e;') + '" title="' + d.day + ' · ' + d.calls + ' calls">' + label + '</div>';
        }).join('');
        document.getElementById('pl-axis-lo').textContent = days[0].day;
        document.getElementById('pl-axis-hi').textContent = days[days.length - 1].day;

        // Phantom card
        var ph = document.getElementById('pl-phantom');
        if (phantom && phantom.totals) {
          var t = phantom.totals;
          ph.innerHTML = '<h3>PhantomIDE · Parrot <span class="pl-badge live">LIVE</span></h3>' +
            row('Window', (phantom.windowDays || 30) + ' days') +
            row('Tokens served', compact(t.tokensServed)) +
            row('Calls', compact(t.calls)) +
