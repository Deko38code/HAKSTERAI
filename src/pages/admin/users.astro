---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin — Users | haksterAi">
  <style>
    #pin-screen{position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;
      background:#0a0a0f;}
    .pin-box{text-align:center;padding:40px;border:1px solid #7c3aed;border-radius:16px;
      background:#111118;box-shadow:0 0 40px #7c3aed33,inset 0 0 40px #7c3aed0a;}
    .pin-logo-img{width:56px;height:56px;border-radius:12px;margin:0 auto 8px;display:block;
      filter:drop-shadow(0 0 12px #7c3aed88);}
    .pin-title{font-size:1.1rem;font-weight:700;color:#e2e8f0;letter-spacing:1px;margin-bottom:2px;}
    .pin-sub{color:#94a3b8;font-size:.75rem;margin-bottom:26px;letter-spacing:1.5px;}
    .pin-dots{display:flex;gap:10px;justify-content:center;margin-bottom:22px;}
    .pin-dot{width:13px;height:13px;border-radius:50%;border:2px solid #7c3aed;transition:.08s;background:transparent;}
    .pin-dot.filled{background:#a855f7;box-shadow:0 0 10px #a855f7;}
    .pin-pad{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;width:220px;}
    .pin-btn{padding:16px;border:1px solid #1e1e2e;border-radius:8px;background:#0a0a0f;
      color:#a855f7;font-family:'JetBrains Mono',monospace;font-size:1.1rem;cursor:pointer;
      transition:.08s;}
    .pin-btn:hover{background:#7c3aed22;box-shadow:0 0 15px #7c3aed44;}
    .pin-btn:active{transform:scale(.95);}
    .pin-error{color:#ef4444;font-size:.75rem;margin-top:12px;height:16px;}
    .pin-change{margin-top:14px;font-size:.65rem;color:#64748b;text-decoration:underline;cursor:pointer;}
  </style>

  <div id="pin-screen">
    <div class="pin-box">
      <img src="/logo-192.png" alt="haksterAi" class="pin-logo-img" />
      <div class="pin-title">HAKSTER ADMIN</div>
      <div id="pin-sub" class="pin-sub">ENTER PIN TO ACCESS</div>
      <div class="pin-dots">
        <div class="pin-dot" id="pd0"></div>
        <div class="pin-dot" id="pd1"></div>
        <div class="pin-dot" id="pd2"></div>
        <div class="pin-dot" id="pd3"></div>
        <div class="pin-dot" id="pd4"></div>
        <div class="pin-dot" id="pd5"></div>
      </div>
      <div class="pin-pad">
        <button class="pin-btn" data-pin="1">1</button>
        <button class="pin-btn" data-pin="2">2</button>
        <button class="pin-btn" data-pin="3">3</button>
        <button class="pin-btn" data-pin="4">4</button>
        <button class="pin-btn" data-pin="5">5</button>
        <button class="pin-btn" data-pin="6">6</button>
        <button class="pin-btn" data-pin="7">7</button>
        <button class="pin-btn" data-pin="8">8</button>
        <button class="pin-btn" data-pin="9">9</button>
        <button class="pin-btn" data-pin="clear" style="font-size:.75rem;">CLR</button>
        <button class="pin-btn" data-pin="0">0</button>
        <button class="pin-btn" data-pin="back" style="font-size:.75rem;">⌫</button>
      </div>
      <div class="pin-error" id="pin-error"></div>
      <div class="pin-change" id="pin-change-link">change pin</div>
    </div>
  </div>

  <div id="admin-content" style="display:none;">
  <div class="min-h-screen pt-[80px] pb-12 bg-[#0a0a0f] text-[#e2e8f0] px-4">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">👤 User Admin</h1>
          <p class="text-sm text-[#64748b] mt-1">Emails, IPs, last login, roles and plans.</p>
        </div>
        <div class="flex items-center gap-3">
          <input
            id="search"
            type="text"
            placeholder="Search email, username, IP..."
            class="bg-[#111118] border border-[#1e1e2e] rounded-lg px-3 py-2 text-sm text-[#e2e8f0] placeholder-[#64748b] focus:border-[#7c3aed] focus:outline-none w-full sm:w-64"
          />
          <button
            id="refresh-btn"
            class="bg-[#7c3aed]/20 text-[#7c3aed] hover:bg-[#7c3aed]/30 border border-[#7c3aed]/30 px-3 py-2 rounded-lg text-sm font-medium transition-colors"
          >
            ↻ Refresh
          </button>
        </div>
      </div>

      <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left">
            <thead class="bg-[#1e1e2e] text-xs uppercase text-[#94a3b8]">
              <tr>
                <th class="px-4 py-3 font-semibold">User</th>
                <th class="px-4 py-3 font-semibold">Email</th>
                <th class="px-4 py-3 font-semibold">Role / Plan</th>
                <th class="px-4 py-3 font-semibold">Status</th>
                <th class="px-4 py-3 font-semibold">Last Login</th>
                <th class="px-4 py-3 font-semibold">Last IP</th>
                <th class="px-4 py-3 font-semibold">Recent IPs</th>
                <th class="px-4 py-3 font-semibold">Created</th>
              </tr>
            </thead>
            <tbody id="users-body" class="divide-y divide-[#1e1e2e]">
              <tr>
                <td colspan="8" class="px-4 py-8 text-center text-[#64748b]">Loading users…</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="px-4 py-3 border-t border-[#1e1e2e] flex items-center justify-between text-xs text-[#64748b]">
          <span id="users-count">0 users</span>
          <span id="logs-count">0 access logs</span>
        </div>
      </div>
    </div>
  </div>
  </div>

  <script is:inline>
    // ── PIN PAD (ported from phantom-ide.html, re-themed; no default/bypass PIN,
    // no unauthenticated reset — first run makes you set your own 6-digit PIN) ──
    const PIN_KEY = 'hakster_admin_pin';
    const PIN_SESSION_KEY = 'hakster_admin_pin_session';
    let correctPin = localStorage.getItem(PIN_KEY) || '';
    let pinEntry = '';
    let pinMode = correctPin ? 'unlock' : 'setup_new'; // setup_new|setup_confirm|unlock|change_old|change_new|change_confirm
    let pendingNewPin = '';

    function revealAdmin() {
      document.getElementById('pin-screen').style.display = 'none';
      document.getElementById('admin-content').style.display = '';
      load();
    }

    function updateDots() {
      for (let i = 0; i < 6; i++) {
        const dot = document.getElementById('pd' + i);
        if (dot) dot.classList.toggle('filled', i < pinEntry.length);
      }
    }

    function setSub(text) {
      const el = document.getElementById('pin-sub');
      if (el) el.textContent = text;
    }

    function pinPress(val) {
      const err = document.getElementById('pin-error');
      if (err) err.textContent = '';
      if (val === 'clear') { pinEntry = ''; updateDots(); return; }
      if (val === 'back') { pinEntry = pinEntry.slice(0, -1); updateDots(); return; }
      if (pinEntry.length >= 6) return;
      pinEntry += val;
      updateDots();
      if (pinEntry.length === 6) setTimeout(checkPin, 120);
    }

    function checkPin() {
      const err = document.getElementById('pin-error');
      if (pinEntry.length < 6) return;
      if (pinMode === 'setup_new' || pinMode === 'change_new') {
        pendingNewPin = pinEntry;
        pinMode = pinMode === 'setup_new' ? 'setup_confirm' : 'change_confirm';
        setSub('CONFIRM YOUR PIN');
        pinEntry = ''; updateDots();
      } else if (pinMode === 'setup_confirm' || pinMode === 'change_confirm') {
        if (pinEntry === pendingNewPin) {
          correctPin = pinEntry;
          localStorage.setItem(PIN_KEY, correctPin);
          sessionStorage.setItem(PIN_SESSION_KEY, '1');
          pinMode = 'unlock';
          pinEntry = ''; updateDots();
          revealAdmin();
        } else {
          if (err) err.textContent = '✕ PINs did not match. Try again.';
          pinMode = pinMode === 'setup_confirm' ? 'setup_new' : 'change_new';
          setSub(pinMode === 'setup_new' ? 'SET YOUR 6-DIGIT PIN' : 'ENTER NEW PIN');
          pinEntry = ''; updateDots();
        }
      } else if (pinMode === 'change_old') {
        if (pinEntry === correctPin) {
          pinMode = 'change_new';
          setSub('ENTER NEW PIN');
          pinEntry = ''; updateDots();
        } else {
          if (err) err.textContent = '✕ Wrong current PIN.';
          pinEntry = ''; updateDots();
        }
      } else { // unlock
        if (pinEntry === correctPin) {
          sessionStorage.setItem(PIN_SESSION_KEY, '1');
          revealAdmin();
        } else {
          if (err) err.textContent = '✕ Wrong PIN. Try again.';
          pinEntry = ''; updateDots();
        }
      }
    }

    document.querySelectorAll('.pin-btn').forEach(btn => {
      btn.addEventListener('click', () => pinPress(btn.dataset.pin));
    });

    document.getElementById('pin-change-link')?.addEventListener('click', () => {
      if (!correctPin) return;
      pinEntry = ''; pinMode = 'change_old';
      document.getElementById('pin-error').textContent = '';
      setSub('ENTER CURRENT PIN');
      updateDots();
    });

    document.addEventListener('keydown', e => {
      if (document.getElementById('pin-screen').style.display === 'none') return;
      if (e.key >= '0' && e.key <= '9') { e.preventDefault(); pinPress(e.key); }
      else if (e.key === 'Backspace') { e.preventDefault(); pinPress('back'); }
      else if (e.key === 'Escape' || e.key === 'Delete') { e.preventDefault(); pinPress('clear'); }
    });

    setSub(pinMode === 'setup_new' ? 'SET YOUR 6-DIGIT PIN' : 'ENTER PIN TO ACCESS');
    if (correctPin && sessionStorage.getItem(PIN_SESSION_KEY) === '1') revealAdmin();

    // ── existing admin/users logic below (unchanged) ──
    const API = location.port === '4321' ? 'http://localhost:3579' : '';
    let allUsers = [];
    let logsByUser = {};

    function formatDate(ts) {
      if (!ts) return '—';
      const d = new Date(ts * 1000);
      return d.toLocaleString();
    }

    function escapeHtml(str) {
      if (str == null) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function authHeaders() {
      const token = localStorage.getItem('hakster_google_token');
      return token ? { 'x-api-key': token } : {};
    }

    function renderRows(users) {
      const tbody = document.getElementById('users-body');
      if (!users.length) {
        tbody.innerHTML = `<tr><td colspan="8" class="px-4 py-8 text-center text-[#64748b]">No users found.</td></tr>`;
        document.getElementById('users-count').textContent = '0 users';
        return;
      }

      const rows = users.map(u => {
        const recentIps = (logsByUser[u.id] || [])
          .map(l => l.ip_address)
          .filter(Boolean)
          .filter((ip, i, arr) => arr.indexOf(ip) === i)
          .slice(0, 5);

        const roleClass = u.role === 'admin' ? 'bg-[#7c3aed]/20 text-[#a855f7] border-[#7c3aed]/30' :
                           u.role === 'guest' ? 'bg-[#64748b]/10 text-[#94a3b8] border-[#64748b]/20' :
                           'bg-[#00ff88]/10 text-[#00ff88] border-[#00ff88]/20';

        const statusClass = u.status === 'active' ? 'bg-[#00ff88]/10 text-[#00ff88] border-[#00ff88]/20' :
                             u.status === 'suspended' ? 'bg-[#ffd700]/10 text-[#ffd700] border-[#ffd700]/20' :
                             'bg-[#ef4444]/10 text-[#ef4444] border-[#ef4444]/20';

        const isOwner = ['1234','1235','1236','1237'].includes(u.id);

        return `<tr class="hover:bg-[#1e1e2e]/50 transition-colors ${isOwner ? 'bg-[#7c3aed]/5' : ''}">
          <td class="px-4 py-3 font-medium text-[#e2e8f0]">
            ${isOwner ? '<span title="Owner" class="text-[#ffd700] mr-1">★</span>' : ''}${escapeHtml(u.username)}
            ${isOwner ? '<span class="ml-1 inline-flex items-center px-1.5 py-0.5 rounded text-[10px] border bg-[#ffd700]/10 text-[#ffd700] border-[#ffd700]/30">OWNER</span>' : ''}
          </td>
          <td class="px-4 py-3 text-[#94a3b8]">${escapeHtml(u.email || '—')}</td>
          <td class="px-4 py-3">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs border ${roleClass}">${escapeHtml(u.role)}</span>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs border bg-[#111118] text-[#94a3b8] border-[#1e1e2e] ml-1">${escapeHtml(u.plan)}</span>
          </td>
          <td class="px-4 py-3">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs border ${statusClass}">${escapeHtml(u.status)}</span>
          </td>
          <td class="px-4 py-3 text-[#94a3b8]">${formatDate(u.last_login_at)}</td>
          <td class="px-4 py-3 font-mono text-xs text-[#00bfff]">${escapeHtml(u.last_login_ip || '—')}</td>
          <td class="px-4 py-3">
            ${recentIps.length
              ? `<div class="flex flex-wrap gap-1">${recentIps.map(ip => `<span class="font-mono text-xs bg-[#111118] text-[#64748b] border border-[#1e1e2e] px-1.5 py-0.5 rounded">${escapeHtml(ip)}</span>`).join('')}</div>`
              : '<span class="text-[#64748b]">—</span>'}
          </td>
          <td class="px-4 py-3 text-[#94a3b8]">${formatDate(u.created_at)}</td>
        </tr>`;
      }).join('');

      tbody.innerHTML = rows;
      document.getElementById('users-count').textContent = `${users.length} user${users.length === 1 ? '' : 's'}`;
    }

    async function load() {
      try {
        const headers = authHeaders();
        const [usersRes, logsRes] = await Promise.all([
          fetch(`${API}/api/users`, { headers }),
          fetch(`${API}/api/access-logs?limit=1000`, { headers })
        ]);

        if (!usersRes.ok || !logsRes.ok) {
          document.getElementById('users-body').innerHTML = `<tr><td colspan="8" class="px-4 py-8 text-center text-[#ef4444]">Admin sign-in required.</td></tr>`;
          document.getElementById('users-count').textContent = '0 users';
          document.getElementById('logs-count').textContent = '0 access logs';
          return;
        }

        const usersData = await usersRes.json();
        const logsData = await logsRes.json();

        allUsers = usersData.users || [];

        logsByUser = {};
        (logsData.logs || []).forEach(log => {
          if (!log.user_id) return;
          if (!logsByUser[log.user_id]) logsByUser[log.user_id] = [];
          logsByUser[log.user_id].push(log);
        });

        renderRows(allUsers);
        document.getElementById('logs-count').textContent = `${(logsData.logs || []).length} access logs`;
      } catch (err) {
        console.error(err);
        document.getElementById('users-body').innerHTML = `<tr><td colspan="8" class="px-4 py-8 text-center text-[#ef4444]">Failed to load users.</td></tr>`;
      }
    }

    document.getElementById('search')?.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase();
      const filtered = allUsers.filter(u =>
        (u.username || '').toLowerCase().includes(q) ||
        (u.email || '').toLowerCase().includes(q) ||
        (u.last_login_ip || '').toLowerCase().includes(q) ||
        (u.role || '').toLowerCase().includes(q) ||
        (u.plan || '').toLowerCase().includes(q)
      );
      renderRows(filtered);
    });

    document.getElementById('refresh-btn')?.addEventListener('click', load);

    load();
  </script>
</Layout>
