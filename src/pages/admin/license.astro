    <script is:inline data-cfasync="false">
      document.getElementById('print')?.addEventListener('click', () => window.print());

      // 2026-11-16 (owner): "but we will be able to provide all docummatation
      // alwyas". The owner record can be handed to the client at any time; the
      // text comes from the owner-only document route, never from the site.
      document.getElementById('download')?.addEventListener('click', async () => {
        try {
          const k = localStorage.getItem('hakster_google_token') || localStorage.getItem('hakster_api_key') || '';
          const res = await fetch('/api/admin/license/document', { headers: { 'x-api-key': k }, cache: 'no-store' });
          if (!res.ok) throw new Error('http ' + res.status);
          const text = await res.text();
          const blob = new Blob([text], { type: 'text/markdown;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'haksterai-hosting-licence-2026-11-16.md';
          document.body.appendChild(a);
          a.click();
          a.remove();
          setTimeout(() => URL.revokeObjectURL(url), 2000);
        } catch (err) {
          alert('Could not download the document: ' + ((err && err.message) || 'request failed'));
        }
      });

      const money = (n) => '$' + (Number(n) || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const set = (id, value) => {
        const el = document.getElementById(id);
        if (el) el.textContent = value;
      };
      const key = (() => {
        try { return localStorage.getItem('hakster_google_token') || localStorage.getItem('hakster_api_key') || ''; } catch { return ''; }
      })();
      const labels = {
        'not-started': ['not started', 'ok'], current: ['open', 'ok'], grace: ['grace period', 'warn'],
        locked: ['LOCKED', 'warn'], 'lien-sale': ['LIEN SALE', 'bad'], 'paid-off': ['paid in full', 'ok'], unknown: ['unknown', 'warn'],
      };

      async function read() {
        if (!key) return;
        try {
          const res = await fetch('/api/admin/hosting-locks', { headers: { 'x-api-key': key }, cache: 'no-store' });
          if (!res.ok) throw new Error('http ' + res.status);
          const data = await res.json();
          const c = data && data.clients && data.clients[0];
          if (!c) throw new Error('no client record');
          const g = c.gate;
          const p = c.payoff || {};
          set('readat', String(p.updatedAt || data.at || '').slice(0, 19) + ' UTC');
          set('source', p.source || '');
          if (!g || !g.totalsKnown) {
            document.getElementById('stale').hidden = false;
            set('stale-when', String(p.updatedAt || '').slice(0, 19) || '—');
            set('totals-note', 'ledger unread — no figure shown');
            return;
          }
          document.getElementById('stale').hidden = true;
          set('total', money(g.totalDue));
          set('totals-note', 'live from the invoice ledger · ' + (g.unpaidMonths || 0) + ' month(s) unpaid');
          set('overdue', money(g.overdueTotal));
          set('overdue-note', g.overdueMonths ? g.overdueMonths + ' month(s) past the grace period · ' + (g.daysLate || 0) + ' days late' : 'nothing past the grace period');
          const st = labels[g.state] || [g.state, 'warn'];
          const stateEl = document.getElementById('gate-state');
          if (stateEl) { stateEl.textContent = st[0]; stateEl.className = 'state ' + st[1]; }
          set('gate-note', g.note || '');
          set('rate', money(g.monthlyRate) + ' / month');
          set('start', 'Pay button start: ' + String(g.paymentsStart || '').slice(0, 16).replace('T', ' ') + ' UTC');
          set('due', g.dueAt ? String(g.dueAt).slice(0, 10) : '—');
          set('grace', g.graceEndsAt ? 'grace ends ' + String(g.graceEndsAt).slice(0, 10) : '');
          set('lien', g.lienSaleAt ? String(g.lienSaleAt).slice(0, 10) : '—');
          if (g.lienNoticeRecorded) set('lien', 'notice recorded ' + String(g.lienSaleAt).slice(0, 10));
          set('cure', g.lienNoticeRecorded && g.lienCureDeadlineAt ? 'notice recorded · cure deadline ' + String(g.lienCureDeadlineAt).slice(0, 10) : '');
          set('ver', g.licenceVersion || '—');
          set('balance', money(p.remaining));
          set('balance-note', 'paid ' + money(p.confirmedPaid) + ' of ' + money(p.total) + ' · projected payoff ' + (p.estimatedPayoffMonth || '—'));
        } catch (err) {
          document.getElementById('stale').hidden = false;
          set('totals-note', 'ledger unread — no figure shown');
        }
      }
      read();
      setInterval(read, 30000);
    </script>
