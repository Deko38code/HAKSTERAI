const SUPPORT = 'support@haksterai.com'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="HaksterAI hosting licence and service contract." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" sizes="32x32" href="/haksterai-logo.png" />
    <title>Hosting licence &amp; service contract — HaksterAI</title>
    <style>
      :root { --bg:#07070b; --panel:#101018; --panel-2:#0b0b12; --line:#23233a; --text:#e6e9f0; --muted:#98a2b3; --gold:#d9b34a; --green:#34d399; --amber:#fbbf24; --red:#f87171; --violet:#a78bfa; }
      * { box-sizing: border-box; }
      html, body { margin:0; padding:0; background:var(--bg); color:var(--text); }
      body { font:15px/1.65 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
      a { color: var(--violet); }
      .wrap { max-width: 980px; margin: 0 auto; padding: 28px 20px 80px; }
      header.top { display:flex; flex-wrap:wrap; align-items:center; gap:12px; justify-content:space-between; margin-bottom:22px; }
      .brand { display:flex; align-items:center; gap:10px; font-weight:800; letter-spacing:.4px; }
      .brand img { width:28px; height:28px; border-radius:6px; }
      .badge { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.16em; color:var(--muted); border:1px solid var(--line); border-radius:999px; padding:4px 10px; }
      .actions { display:flex; gap:8px; flex-wrap:wrap; }
      .btn { font:inherit; font-size:12px; font-weight:700; color:var(--text); background:var(--panel); border:1px solid var(--line); border-radius:9px; padding:8px 13px; cursor:pointer; text-decoration:none; display:inline-block; }
      .btn:hover { border-color:#3a3a58; }
      .btn.primary { background:#3a2a6b; border-color:#5b439e; }
      h1 { font-size:clamp(1.5rem,3.4vw,2.1rem); line-height:1.2; margin:8px 0 6px; letter-spacing:-.3px; }
      .sub { color:var(--muted); font-size:13.5px; margin:0 0 22px; }
      .grid { display:grid; gap:14px; grid-template-columns:repeat(auto-fit,minmax(215px,1fr)); }
      .card { background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:16px 16px 14px; }
      .card h2 { font-size:12px; text-transform:uppercase; letter-spacing:.16em; color:var(--muted); margin:0 0 10px; font-weight:700; }
      .big { font-size:clamp(1.7rem,5vw,2.4rem); font-weight:800; line-height:1; font-variant-numeric:tabular-nums; color:var(--gold); }
      .big.red { color:var(--red); font-size:clamp(1.3rem,3.6vw,1.8rem); }
      .state { font-size:1.05rem; font-weight:800; }
      .state.ok { color:var(--green); } .state.warn { color:var(--amber); } .state.bad { color:var(--red); }
      .k { color:var(--muted); font-size:12px; }
      .v { font-variant-numeric:tabular-nums; }
      nav.toc { display:flex; flex-wrap:wrap; align-items:center; gap:6px; margin-top:18px; padding:10px 12px; border:1px solid var(--line); border-radius:12px; background:var(--panel); }
      nav.toc .toc-title { font-size:10px; text-transform:uppercase; letter-spacing:.18em; color:var(--muted); margin-right:4px; }
      nav.toc a { font-size:11px; color:#cbd5e1; text-decoration:none; border:1px solid var(--line); border-radius:999px; padding:3px 9px; line-height:1.5; }
      nav.toc a:hover { border-color:#4c4c72; color:#fff; }
      section.part { background:var(--panel-2); border:1px solid var(--line); border-radius:14px; padding:20px 22px; margin-top:18px; scroll-margin-top:16px; }
      section.part h3 { display:flex; align-items:center; gap:8px; }
      section.part h3 { font-size:13px; letter-spacing:.18em; text-transform:uppercase; color:var(--violet); margin:0 0 12px; }
      section.part h4 { font-size:14px; margin:18px 0 6px; }
      section.part h4:first-of-type { margin-top:0; }
      section.part p, section.part li { font-size:13.5px; color:#d3d8e3; }
      section.part ol, section.part ul { margin:6px 0 6px 20px; padding:0; }
      section.part li { margin:6px 0; }
      nav.pagenav { position:fixed; left:0; right:0; bottom:0; z-index:50; display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:4px; padding:7px 12px; background:#0b0b12ee; border-top:1px solid var(--line); backdrop-filter:blur(8px); }
      nav.pagenav .lbl { font-size:9px; text-transform:uppercase; letter-spacing:.18em; color:var(--muted); margin-right:4px; }
      nav.pagenav a { font-size:11px; line-height:1.6; min-width:22px; text-align:center; color:#cbd5e1; text-decoration:none; border:1px solid var(--line); border-radius:6px; padding:1px 5px; }
      nav.pagenav a:hover { border-color:var(--gold); color:var(--gold); }
      nav.pagenav a.sched { padding:1px 8px; }
      .fine { border-left:3px solid var(--gold); background:#121019; border-radius:0 10px 10px 0; padding:12px 14px; margin-top:14px; }
      .fine p { margin:4px 0; color:#cfd4df; font-size:12.5px; }
      .notice { border:1px solid #5a3b0e; background:#1a1206; color:#f6d894; border-radius:12px; padding:12px 14px; font-size:12.5px; margin-top:16px; }
      .sig { display:grid; gap:16px; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); margin-top:8px; }
      .sig div { border-top:1px solid var(--line); padding-top:8px; font-size:12px; color:var(--muted); }
      .mono { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:12px; }
      table.sched { width:100%; border-collapse:collapse; margin-top:8px; font-size:13px; }
      table.sched th, table.sched td { text-align:left; padding:7px 10px; border-bottom:1px solid var(--line); }
      table.sched th { color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:.14em; }
      footer.foot { margin-top:26px; margin-bottom:46px; padding-bottom:8px; color:#64708a; font-size:11.5px; line-height:1.6; }
      @media print {
        :root { --bg:#fff; --panel:#fff; --panel-2:#fff; --line:#ccc; --text:#111; --muted:#555; --gold:#8a6d1f; --violet:#4b2f8f; }
        body { background:#fff; color:#111; }
        .actions, header.top .btn { display:none; }
        section.part, .card { break-inside:avoid; }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="top">
        <div class="brand">
          <img src="/haksterai-logo.png" alt="" />
          <span>HaksterAI</span>
          <span class="badge">Owner record · client copy supplied on request</span>
        </div>
        <div class="actions">
          <a class="btn" href="/admin/dashboard/">← Dashboard</a>
          <button class="btn" id="download">Download client copy</button>
          <button class="btn primary" id="print">Print / save PDF</button>
        </div>
      </header>

      <h1>Website hosting licence &amp; service contract</h1>
      <p class="sub">
        Version <span class="mono" id="ver">{VERSION}</span> · effective {EFFECTIVE} · HaksterAI (builder and
        hosting provider) and the client named on the account invoice. Support and notices:
        <span class="mono">{SUPPORT}</span>. All amounts are USD.
      </p>

      <div class="grid">
        <div class="card">
          <h2>Total due now</h2>
          <div class="big" id="total">—</div>
          <div class="k" id="totals-note">reading the ledger…</div>
        </div>
        <div class="card">
          <h2>Overdue</h2>
          <div class="big red" id="overdue">—</div>
          <div class="k" id="overdue-note">&nbsp;</div>
        </div>
        <div class="card">
          <h2>Client admin</h2>
          <div class="state" id="gate-state">—</div>
          <div class="k" id="gate-note">&nbsp;</div>
        </div>
        <div class="card">
          <h2>Build balance</h2>
          <div class="big" id="balance">—</div>
          <div class="k" id="balance-note">&nbsp;</div>
        </div>
      </div>

      <div class="grid" style="margin-top:14px">
        <div class="card">
          <h2>Monthly payment</h2>
          <div class="v" id="rate">—</div>
          <div class="k">Due on the 1st (UTC). Payments activate when the Pay button starts.</div>
          <div class="k mono" id="start" style="margin-top:6px">&nbsp;</div>
        </div>
        <div class="card">
          <h2>Due since / grace ends</h2>
          <div class="v" id="due">—</div>
          <div class="k mono" id="grace">&nbsp;</div>
        </div>
        <div class="card">
          <h2>Lien sale notice</h2>
          <div class="v" id="lien">—</div>
          <div class="k mono" id="cure">&nbsp;</div>
        </div>
        <div class="card">
          <h2>Ledger read</h2>
          <div class="v mono" id="readat">—</div>
          <div class="k" id="source">&nbsp;</div>
        </div>
      </div>

      <nav class="toc" aria-label="Contract contents">
        <span class="toc-title">Contents</span>
        <a href="#s1">1 Definitions</a><a href="#s2">2 Scope</a><a href="#s3">3 Balance</a>
        <a href="#s4">4 Payments &amp; lock</a><a href="#s5">5 Lien sale</a><a href="#s6">6 Records</a>
        <a href="#s7">7 Failed payments</a><a href="#s8">8 Licence &amp; IP</a><a href="#s9">9 Service</a>
        <a href="#s10">10 Client duties</a><a href="#s11">11 Data &amp; AI</a><a href="#s12">12 Fees</a>
        <a href="#s13">13 Termination</a><a href="#s14">14 Refusal</a><a href="#s15">15 Liability</a>
        <a href="#s16">16 Law</a><a href="#s17">17 Acceptance</a><a href="#s18">18 General</a>
        <a href="#sched">Schedules</a>
      </nav>

      <div class="notice" id="stale" hidden>
        The payment ledger could not be read just now. No figure on this page is shown rather than a stale or
        estimated one. Last verified read: <span class="mono" id="stale-when">—</span>.
      </div>

      <section class="part" id="s1">
        <h3>1 · Definitions</h3>
        <ul>
          <li><b>Build total</b> — the agreed price of the website build recorded on the account invoice. For the current Junkalot engagement the recorded build total is <b>$15,375.99 USD</b> (build $15,000.00 + portfolio maintenance $375.99).</li>
          <li><b>Confirmed payment</b> — a payment Stripe has confirmed as paid. Pending, failed, reversed and charged-back payments are not confirmed payments.</li>
          <li><b>Build balance</b> — the build total less every confirmed payment. Only confirmed payments reduce it, and no payment is counted twice.</li>
          <li><b>Monthly payment</b> — <b>$249.00 USD</b> per month while the build balance is open, and the care plan fee under section 3.2 after the build is paid in full.</li>
          <li><b>Due date</b> — 00:00 UTC (8:00 am Australian Western Standard Time) on the first day of each month.</li>
          <li><b>Grace period</b> — the <b>7 days</b> after the due date, ending at 00:00 UTC on the eighth day of the month.</li>
          <li><b>Overdue</b> — a payment not confirmed by the end of its grace period.</li>
          <li><b>Outstanding balance</b> — the overdue monthly payments stated in a notice under section 5, excluding any late interest and sale costs. Paying it in full removes that state; a dispute about the amount is dealt with under section 4.9.</li>
          <li><b>Lien sale state</b> — the provider's contractual right under section 5 to resell its own design and code. It is <b>not</b> a retention of title, a security interest, a charge or a mortgage, and the provider acquires no interest in any property of the client.</li>
          <li><b>Admin area</b> — the dashboard where the client edits the site and views bookings and invoices.</li>
          <li><b>Public site</b> — the website the client's visitors see.</li>
          <li><b>Business day</b> — a day other than a Saturday, Sunday or public holiday in Western Australia.</li>
          <li><b>Portfolio record</b> — the provider's per-client record described in section 8.8.</li>
        </ul>
      </section>

      <section class="part" id="s2">
        <h3>2 · Scope</h3>
        <p>The engagement covers the website build described on the invoice, hosting and server capacity for it, booking and email functions, the AI visitor chat and coaching assistant attached to the site, security monitoring, and routine care: software and security updates, backups, monitoring, deploys of reviewed changes, and support by email. Anything outside that list — new pages, new features, new integrations, content writing, migrations to another platform — is a separate, quoted engagement.</p>
      </section>

      <section class="part" id="s3">
        <h3>3 · Build balance and payoff</h3>
        <ol>
          <li>The build balance is repaid by the monthly payment. Each confirmed monthly payment reduces it by the full monthly amount while the balance is open; hosting, care and support for that month are included in the payment.</li>
          <li>When the build balance reaches zero the build is paid in full. The care, hosting and support plan then continues month to month at <b>$249.00 USD</b>. Either party may end it on 30 days' written notice; if the client ends it, hosting and support stop at the end of the notice period and the build is delivered under section 8.9. A change to that rate is a fee change under section 12.</li>
          <li>The projected payoff month is calculated from the current balance at the monthly payment and shown on the account's licence card and invoices page. It changes only when the recorded balance, payments or monthly payment change.</li>
          <li>If the provider records an additional agreed charge, it is added to the build total with the client's written agreement and appears on the invoice record before it is billed.</li>
        </ol>
      </section>

      <section class="part" id="s4">
        <h3>4 · Monthly payment, grace period and admin lock</h3>
        <ol>
          <li>The monthly payment falls due on the due date, beginning when the Pay button activates. If the Pay button activates after the 20th of a month, the first monthly payment falls due on the first day of the following month. The activation date is recorded on the account and shown in the admin area.</li>
          <li>A payment is in its <b>grace period</b> until 00:00 UTC on the eighth day of the month. Inside it the account and the admin area remain fully available and no restriction applies.</li>
          <li>If the payment is still unconfirmed when the grace period ends, the provider may <b>lock the client's admin area</b>. A locked admin area still lets the client sign in, view and export its bookings, invoices, content and customer data; see the amount due, the date it became overdue, the date of any lien sale notice and any cure deadline, and how to dispute the amount; and pay. The lock disables <b>only</b> content editing, publishing and settings changes.</li>
          <li>Access returns when Stripe confirms the payment, and in any event within one business day. If automatic release fails, the provider releases the lock on written request within one business day.</li>
          <li><b>The public site keeps serving throughout.</b> The lock restricts the client's admin access only. It does not stop the website, its hosting, its internet connection or any domain name, and it does not take the site offline or redirect it.</li>
          <li>Before the lock takes effect, the provider emails the account email address at the due date and again when the grace period ends, stating the amount due, when the grace period ends and the consequence. If an automatic notice cannot be sent, the provider sends it manually and records the date; the lock does not take effect before that notice is sent.</li>
          <li>The builder/owner account is exempt from the lock.</li>
          <li>While the admin area is locked, the client may still request an export of its own content and customer data by email; section 11 applies.</li>
          <li><b>No lock, lien sale state, acceleration or late interest applies while</b> (a) Stripe's record shows the payment as processing; (b) the client has notified a dispute about the amount in writing and it is unresolved; or (c) the notice in subsection 6 has not been sent. Where the admin area cannot read the live ledger, it shows "record unavailable" and the last amount Stripe confirmed, clearly labelled, and neither a lock, the lien sale state nor acceleration follows from an unreadable figure.</li>
        </ol>
      </section>

      <section class="part" id="s5">
        <h3>5 · Lien sale state</h3>
        <ol>
          <li>If the payment is still unconfirmed <b>30 days after the grace period ends</b>, or if <b>3 consecutive monthly payments are unconfirmed</b>, the account enters the <b>lien sale state</b>. Where both triggers apply, the earlier governs.</li>
          <li>The provider must send written notice of the lien sale state to the account email address on the day it is recorded, stating the amount claimed, the cure deadline and the consequence in subsection 5. The state begins on the date that notice is sent, and the admin area shows the state and the cure deadline.</li>
          <li>A chargeback or reversal reopens the affected month from the date the provider notifies the client of it, and a fresh grace period under section 4 runs from that notification. No lock, lien sale state or acceleration applies before that grace period ends.</li>
          <li>The client then has <b>30 days from the notice</b> (the <b>cure deadline</b>) to settle the outstanding balance. If the balance is settled by the cure deadline, the lien sale state is removed and the account returns to normal.</li>
          <li>If the balance is not settled by the cure deadline, the provider may sell the finished build — its own design and code created for it — to recover the outstanding balance and reasonable sale costs. <b>The client's brand name, content, images, domain name and customer data are never sold or transferred by that sale without the client's written consent.</b></li>
          <li>Before any sale the provider must: (a) send written notice to the account email address at least <b>30 days before the intended sale date</b>, stating the amount claimed, the sale date and that the client may settle the amount before that date to stop the sale; (b) remove the client's brand, trade marks, content, images and customer data from the build offered for sale, and certify in writing that it has done so. The provider preserves every copy it holds in its records, never deletes it, and the client may request an export at any time; (c) offer the build for sale at a reasonable price for at least 30 days and use reasonable efforts to obtain a fair price; (d) give the client a written account of the sale price, the reasonable sale costs and any surplus within 14 days of settlement, and pay the surplus at the same time.</li>
          <li>A completed sale ends the client's licence to use that build. The client keeps its brand, content, domain name and customer data, and receives an export of them within 10 business days.</li>
          <li>If no sale is completed within <b>6 months</b> of the cure deadline, the right to sell lapses, and the balance remains a debt recoverable in the ordinary way.</li>
          <li>Nothing in this section gives the provider any interest in the client's property, or authorises it to delete the client's data or take the public site offline before a sale is completed.</li>
        </ol>
      </section>

      <section class="part" id="s6">
        <h3>6 · Payments, receipts and records</h3>
        <ul>
          <li>Payments are collected only through the provider's Stripe hosted checkout. The provider never asks for card numbers and never stores card data.</li>
          <li>A receipt is sent only after Stripe confirms the payment. A pending, failed or reversed payment is never described as paid.</li>
          <li>A chargeback or reversal is treated as a payment that was never made, subject to section 5.3.</li>
          <li>Overdue amounts carry interest at the lower of 1.5% per month or the maximum permitted by law, from the end of the grace period until paid, subject to section 4.9.</li>
          <li>The payment ledger, this contract and the account's lock history are kept in the provider's records on haksterai.com and in the account's admin area. They are <b>not</b> published on the client's public website.</li>
          <li>If a displayed figure disagrees with Stripe's record, Stripe's confirmed record governs and the provider corrects the ledger.</li>
        </ul>
      </section>

      <section class="part" id="s7">
        <h3>7 · Failed payments and acceleration</h3>
        <ol>
          <li>If a card is declined the provider may retry, and will email the account email address so another method can be used. A failed retry is not a payment.</li>
          <li>If the build has not been sold by the cure deadline, the whole remaining build balance becomes immediately due on that deadline and the provider may recover it as a debt. Acceleration does not apply while Stripe shows a payment as processing, or while a dispute notified under section 4.9 is unresolved.</li>
        </ol>
      </section>

      <section class="part" id="s8">
        <h3>8 · Licence grant and intellectual property</h3>
        <ol>
          <li>The provider grants the client a non-exclusive licence to use the delivered website, its content and its configured integrations while the account is in good standing and payments under this agreement are being made.</li>
          <li>The client's own brand, text, images and customer data remain the client's.</li>
          <li>The provider's platform code, AI configuration, infrastructure, automation and internal tooling remain the provider's and are not transferred.</li>
          <li><b>On payment in full</b> the provider assigns the client its copyright in the custom design and code created for this build. Third-party, open-source and provider platform components remain under their own licences and are licensed to the client for use with this site.</li>
          <li>Domain names, payment accounts and email services connected for the site remain under the provider's control until the build is paid in full and ownership is transferred in writing, unless the parties agree otherwise in writing.</li>
          <li><b>Platform ownership until paid.</b> The site at <b>junkalot.co</b> runs as part of the provider's platform — <b>HaksterAI (haksterai.com)</b> and <b>PhantomIDE (phantomide.com)</b> — and remains part of that platform, under the provider's name, hosting and control, until the build balance is <b>paid in full</b> or the lien sale state in section 5 applies. The client's licence does not transfer the domain, the hosting or the platform accounts before that point. Ownership of the domain and hosting transfers to the client on payment in full, or earlier if the parties agree in writing.</li>
          <li><b>Proprietary software, always.</b> The website, the platform and everything the provider supplied with it are proprietary software. The client receives a licence to use the delivered build for its own business. It never receives ownership of the platform, a source-code release, a right to resell, sublicense, redistribute, publish or offer the build as a product, template or hosted service to anyone else, or a right to reverse-engineer, decompile, strip attribution from or reuse the platform components to build a competing product. The platform code, AI configuration, infrastructure, automation, internal tooling and the provider's methods remain the provider's proprietary property at all times, before and after payment in full, and are licensed — not sold, not assigned and not open-sourced — to the client. Only the custom design and code for this build is assigned under subsection 4, and that assignment is limited to this site and carries this subsection with it.</li>
          <li><b>Portfolio record.</b> Every site or application the provider builds and delivers — whether sold as a plan, or built through <b>PhantomIDE</b> or <b>HaksterAI</b> — is entered in the provider's client portfolio at delivery, with a stable client ID, an audit ID and record IDs for its licence version, build and invoices. The record holds the live balance and lock state, is kept in the provider's records only, and is available to the client on request. Selling or transferring a build transfers its portfolio record to the new owner's name; it is never renumbered.</li>
          <li>When the build is paid in full, the provider delivers within 30 days a deployable copy of the build (source, assets and configuration), a written list of the provider platform components it depends on, and the terms on which those components continue to be licensed. The client may host the build elsewhere.</li>
        </ol>
      </section>

      <section class="part" id="s9">
        <h3>9 · Service standard</h3>
        <ul>
          <li>The provider maintains the server, deploys, HTTPS and the connected services with reasonable care, and monitors them.</li>
          <li>Availability is best-effort. Third-party providers, networks and the client's own DNS can fail outside the provider's control, and no uptime percentage is promised unless agreed separately in writing.</li>
          <li>Changes are reviewed and deployed by the provider. Automatic updates only ever apply reviewed builds.</li>
          <li>The provider makes reasonable efforts to keep backups and does not delete client work; a specific recovery point is not guaranteed.</li>
          <li>Defects in delivered work reported within 30 days of launch are fixed at no charge. <b>Launch</b> means the later of the date the public site is first served and the date the client accepts this agreement, so accepting an already-live site starts its own 30-day window. New requests are quoted under section 2.</li>
        </ul>
      </section>

      <section class="part" id="s10">
        <h3>10 · Client responsibilities and indemnity</h3>
        <ul>
          <li>Keep the account email address current; receipts, notices and lock warnings are sent to it.</li>
          <li>Supply content, images and customer data the client has the right to use, and keep those rights current.</li>
          <li>Do not use the site for unlawful content or activity, and do not interfere with the server, other accounts or the platform's security.</li>
          <li>Do not share admin credentials; report suspected unauthorised access promptly.</li>
          <li>Each party indemnifies the other against third-party claims to the extent caused by that party's own breach of this agreement, negligence or unlawful conduct — the client for content, images and data it supplied, the provider for content and code it supplied. The indemnity does not extend to the other party's own negligence, wilful misconduct or breach, and is subject to section 15 except for fraud or wilful misconduct.</li>
        </ul>
      </section>

      <section class="part" id="s11">
        <h3>11 · Data, privacy and the AI assistant</h3>
        <ul>
          <li>The client is the controller of its visitors' data. The provider processes it to run the site and the services described in section 2.</li>
          <li>The client may request an export of its content and customer data at any time; the provider supplies it within 10 business days.</li>
          <li><b>The provider never deletes the client's data unless the client asks.</b> Its content, images, customer data, records and the site itself are not deleted at any time — not on non-payment, not when the admin area is locked, not in the lien sale state and not on termination. Data is deleted only when the client asks by email to support@haksterai.com (or another address the provider records for that account), and then only after the provider has confirmed the export and kept the records it must keep for tax, legal or dispute purposes. A sale under section 5 never deletes client data either.</li>
          <li>The provider notifies the client without undue delay after becoming aware of unauthorised access to, or disclosure of, the client's content or customer data, and takes reasonable steps to contain it and to assist the client's own notification obligations.</li>
          <li>AI assistant output can be inaccurate. The client reviews AI output before relying on it or publishing it to its own customers. AI usage is subject to fair use so that one account cannot degrade the service for others.</li>
        </ul>
      </section>

      <section class="part" id="s12">
        <h3>12 · Fees, changes and notices</h3>
        <ul>
          <li>The monthly payment stays at <b>$249.00 USD</b> until a fee change takes effect under this section.</li>
          <li>A fee change needs <b>at least 30 days' written notice</b> to the account email address, applies only to future months, and the client may end the agreement before it takes effect without penalty.</li>
          <li>Notices are given to the account email address and are treated as received on the next business day. The provider's records are the record of what was sent and when.</li>
        </ul>
      </section>

      <section class="part" id="s13">
        <h3>13 · Term, termination and refunds</h3>
        <ul>
          <li>Either party may end the agreement with 30 days' written notice. Amounts due for work already performed and months already served remain payable.</li>
          <li>On termination the public site continues to be served for 30 days after the notice period ends so the client can arrange a transfer, and the provider delivers the client's content and customer data within 10 business days.</li>
          <li>If the provider ends the agreement for its own convenience, it refunds amounts received for work not yet performed and any unused whole months within 14 days.</li>
          <li>Build payments already applied to completed work are not refundable, except where a refund is required by law.</li>
          <li>The provider keeps copies of the site and its records after termination so the client's data is not lost. Retention is not a claim of ownership.</li>
        </ul>
      </section>

      <section class="part" id="s14">
        <h3>14 · Right to refuse service</h3>
        <ol>
          <li>The provider may <b>refuse a new order, build, migration or hosting request at intake for any lawful reason before payment is taken</b>.</li>
          <li>For an existing engagement the provider may suspend or end service only for non-payment dealt with under section 4, unlawful content or activity, abusive conduct, a security compromise, or where continuing would breach a law or a third-party provider's terms. Except in an emergency, the provider gives 7 days' written notice and an opportunity to remedy.</li>
          <li>If the provider declines or ends an engagement after taking payment and the client is not in default, it refunds amounts received for work not yet performed within 14 days and, where payments received exceed the value of the work performed, refunds the difference. The client keeps a licence to use the build as delivered at the date of refusal and receives its content and customer data within 10 business days.</li>
          <li>A refusal is recorded in the provider's records with its date and reason.</li>
        </ol>
      </section>

      <section class="part" id="s15">
        <h3>15 · Liability</h3>
        <ul>
          <li>To the extent permitted by law, the provider is not liable for indirect or consequential loss, lost profit, lost bookings, or loss caused by third-party services, networks or the client's own changes.</li>
          <li>The provider's total liability for any claim is limited to the greater of the amounts the client paid in the three months before the claim, or the amounts the client paid toward the build.</li>
          <li>Nothing excludes a liability that cannot be excluded by law, including consumer guarantees that apply to the client.</li>
          <li>The privacy obligations in section 11 are not limited by this section.</li>
        </ul>
      </section>

      <section class="part" id="s16">
        <h3>16 · Governing law and disputes</h3>
        <ul>
          <li>This agreement is governed by the laws of Western Australia, and the courts of Western Australia have exclusive jurisdiction.</li>
          <li>The parties will attempt to resolve a dispute in good faith for 30 days before starting proceedings. Mediation is a precondition to proceedings.</li>
        </ul>
      </section>

      <section class="part" id="s17">
        <h3>17 · Acceptance and changes</h3>
        <ol>
          <li>The client accepts this version by signing it, or by written confirmation by email that quotes the version number and date. Continued use of the site, or a monthly payment, is not by itself acceptance of a change to sections 4, 5, 7, 8 or 14.</li>
          <li>The provider may change fees, service scope and other non-material terms with at least 30 days' written notice to the account email address, applying only to future months. The client may end the agreement before a change takes effect without penalty. A change to sections 4, 5, 7, 8 or 14 takes effect only with the client's written agreement.</li>
          <li>Each version is recorded with the account, the version number and a UTC timestamp.</li>
        </ol>
      </section>

      <section class="part" id="s18">
        <h3>18 · General</h3>
        <ul>
          <li><b>Entire agreement.</b> This document, its schedules and the invoice record accepted in writing by the client are the whole agreement. An amount in the invoice record governs only to the extent the client accepted that record in writing; otherwise this document governs.</li>
          <li><b>GST and ABN.</b> Amounts are in USD and exclude GST unless an invoice states otherwise. Where GST applies, the invoice is a tax invoice showing the provider's ABN and the GST amount.</li>
          <li><b>Assignment.</b> Neither party may assign this agreement without the other's written consent, except to a successor of the whole business.</li>
          <li><b>Subcontractors.</b> The provider may use hosting, payment and email providers to deliver the service and remains responsible for the parts it controls.</li>
          <li><b>Force majeure.</b> Neither party is liable for delay caused by events outside its reasonable control.</li>
          <li><b>Survival.</b> Sections 5, 6, 8, 10, 11, 13, 15 and 16 survive termination.</li>
          <li><b>Severability and waiver.</b> If a provision is unenforceable the rest continues to apply; a waiver is not effective unless in writing.</li>
        </ul>
      </section>

