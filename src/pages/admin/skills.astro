---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin — Skills & Brain | haksterAi" description="Owner-only editor for HaksterAI agent skills and brain instructions.">
  <main class="mx-auto min-h-screen max-w-7xl px-5 pb-16 pt-28 text-slate-100">
    <nav class="mb-5 text-sm text-slate-500"><a href="/" class="hover:text-violet-300">Home</a><span class="px-2">›</span><span class="text-amber-300">Admin</span><span class="px-2">›</span><span class="text-slate-300">Skills & Brain</span></nav>
    <section class="rounded-3xl border border-violet-300/20 bg-gradient-to-br from-[#17151f] to-[#0c0c12] p-5 sm:p-8">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div><p class="mb-2 text-xs font-bold uppercase tracking-[.25em] text-violet-300">Owner-only controls</p><h1 class="text-3xl font-bold">🧠 Skills & Brain</h1><p class="mt-3 max-w-3xl text-sm leading-6 text-slate-400">Add or update the Markdown instructions HaksterAI can load as skills. Changes are restricted to the project skill library. Existing files receive a verified server backup before they are changed.</p></div>
        <span id="skill-auth" class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs text-slate-400">Verifying owner…</span>
      </div>
      <div class="mt-7 grid gap-5 lg:grid-cols-[minmax(220px,0.8fr)_minmax(0,1.6fr)]">
        <aside class="rounded-2xl border border-white/10 bg-black/20 p-4">
          <div class="mb-3 flex items-center justify-between gap-2"><h2 class="font-semibold">Your skills</h2><button id="skill-new" type="button" disabled class="rounded-lg border border-violet-300/30 px-3 py-1.5 text-xs font-semibold text-violet-200 hover:bg-violet-300/10 disabled:opacity-40">＋ New</button></div>
          <p id="skill-count" class="mb-3 text-xs text-slate-500">Loading…</p>
          <div id="skill-list" class="max-h-[60vh] space-y-1 overflow-y-auto" aria-label="Skill files"></div>
        </aside>
        <section class="rounded-2xl border border-white/10 bg-black/20 p-4 sm:p-5">
          <label for="skill-name" class="mb-2 block text-xs font-semibold uppercase tracking-wider text-slate-400">Skill name</label>
          <div class="flex items-center gap-2"><input id="skill-name" type="text" disabled maxlength="120" placeholder="e.g. research/web-sources" class="min-w-0 flex-1 rounded-xl border border-white/10 bg-[#0a0a0f] px-3 py-2.5 font-mono text-sm text-slate-100 outline-none focus:border-violet-300/50 disabled:opacity-50"/><span class="text-xs text-slate-500">.md</span></div>
          <p class="mt-2 text-xs text-slate-500">Letters, numbers, dashes, underscores, and optional folders.</p>
          <label for="skill-content" class="mb-2 mt-5 block text-xs font-semibold uppercase tracking-wider text-slate-400">Brain / skill instructions</label>
          <textarea id="skill-content" disabled rows="22" spellcheck="false" placeholder="Write clear instructions in Markdown…" class="w-full resize-y rounded-xl border border-white/10 bg-[#0a0a0f] p-4 font-mono text-sm leading-6 text-slate-200 outline-none focus:border-violet-300/50 disabled:opacity-50"></textarea>
          <div class="mt-4 flex flex-wrap items-center gap-3"><button id="skill-save" type="button" disabled class="rounded-xl bg-violet-500 px-5 py-2.5 text-sm font-bold text-white hover:bg-violet-400 disabled:cursor-not-allowed disabled:opacity-40">Save skill</button><span id="skill-status" role="status" aria-live="polite" class="text-sm text-slate-400">Only your owner account can access these controls.</span></div>
        </section>
      </div>
      <p class="mt-5 rounded-xl border border-amber-300/10 bg-amber-300/5 p-3 text-xs leading-5 text-amber-100/70">No delete control is provided. New skills are created as Markdown files, and edits keep dated backups on this server.</p>
    </section>
  </main>
  <script>
    const apiBase = window.location.port === '4321' ? 'http://localhost:3579' : '';
    const token = localStorage.getItem('hakster_google_token') || localStorage.getItem('hakster_api_key') || '';
    const authBadge = document.getElementById('skill-auth')!;
    const list = document.getElementById('skill-list')!;
    const count = document.getElementById('skill-count')!;
    const nameInput = document.getElementById('skill-name') as HTMLInputElement;
    const contentInput = document.getElementById('skill-content') as HTMLTextAreaElement;
    const newButton = document.getElementById('skill-new') as HTMLButtonElement;
    const saveButton = document.getElementById('skill-save') as HTMLButtonElement;
    const status = document.getElementById('skill-status')!;
    let selectedName = '';
    let originalContent = '';
    let skills: Array<{name: string; content: string}> = [];

    function authHeaders(json = false) {
      return { 'x-api-key': token, ...(json ? { 'Content-Type': 'application/json' } : {}) };
    }
    function setEditorEnabled(enabled: boolean) {
      nameInput.disabled = !enabled;
      contentInput.disabled = !enabled;
      saveButton.disabled = !enabled;
      newButton.disabled = !enabled;
    }
    function paintList() {
      list.replaceChildren();
      count.textContent = `${skills.length} skill${skills.length === 1 ? '' : 's'} in your editable library`;
      skills.forEach((skill) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = skill.name;
        button.className = `block w-full truncate rounded-lg px-3 py-2 text-left font-mono text-xs transition ${skill.name === selectedName ? 'bg-violet-400/15 text-violet-200' : 'text-slate-400 hover:bg-white/5 hover:text-slate-100'}`;
        button.addEventListener('click', () => selectSkill(skill.name));
        list.appendChild(button);
      });
      if (!skills.length) {
        const empty = document.createElement('p'); empty.className = 'rounded-lg border border-dashed border-white/10 p-3 text-xs text-slate-500'; empty.textContent = 'No skills yet. Create one with ＋ New.'; list.appendChild(empty);
      }
    }
    function selectSkill(name: string) {
      const skill = skills.find((item) => item.name === name);
      if (!skill) return;
      selectedName = name; originalContent = skill.content;
      nameInput.value = name; nameInput.readOnly = true; contentInput.value = skill.content;
      saveButton.textContent = 'Save changes'; status.textContent = 'Editing an existing skill. A backup will be saved before changes.';
      paintList();
    }
    async function refreshSkills(keepSelection = true) {
      const response = await fetch(apiBase + '/api/admin/skills', { headers: authHeaders(), cache: 'no-store' });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Could not load skills.');
      skills = data.skills || [];
      if (keepSelection && selectedName) selectSkill(selectedName);
      else { selectedName = ''; originalContent = ''; paintList(); }
    }

    (async () => {
      try {
        const ownerResponse = await fetch(apiBase + '/api/auth/me', { headers: authHeaders(), cache: 'no-store' });
        const ownerData = ownerResponse.ok ? await ownerResponse.json() : null;
        if (!ownerData?.user?.is_owner) throw new Error('Only the owner can manage skills.');
        authBadge.textContent = 'Owner verified';
        authBadge.className = 'rounded-full border border-emerald-300/20 bg-emerald-300/10 px-3 py-1.5 text-xs text-emerald-300';
        setEditorEnabled(true);
        await refreshSkills(false);
        status.textContent = 'Select a skill to edit or create a new one.';
      } catch (error: any) {
        authBadge.textContent = 'Locked'; status.textContent = error.message || 'Owner verification failed.';
        count.textContent = 'Owner access required';
      }
    })();

    newButton.addEventListener('click', () => {
      selectedName = ''; originalContent = ''; nameInput.readOnly = false; nameInput.value = ''; contentInput.value = '';
      saveButton.textContent = 'Create skill'; status.textContent = 'New instructions will be added to your editable skill library.';
      paintList(); nameInput.focus();
    });
    saveButton.addEventListener('click', async () => {
      const name = nameInput.value.trim(); const content = contentInput.value;
      if (!name || !content.trim()) { status.textContent = 'Enter a skill name and instructions first.'; return; }
      if (selectedName && content === originalContent) { status.textContent = 'No changes to save.'; return; }
      saveButton.disabled = true; status.textContent = 'Saving…';
      try {
        const creating = !selectedName;
        const response = await fetch(apiBase + '/api/admin/skills', {
          method: creating ? 'POST' : 'PUT', headers: authHeaders(true),
          body: JSON.stringify({ name, content }),
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Could not save skill.');
        selectedName = data.name; nameInput.readOnly = true; originalContent = content;
        await refreshSkills();
        status.textContent = creating ? 'Skill created.' : 'Skill updated. Verified backup saved.';
      } catch (error: any) { status.textContent = error.message || 'Could not save skill.'; }
      finally { saveButton.disabled = false; }
    });
  </script>
</Layout>
