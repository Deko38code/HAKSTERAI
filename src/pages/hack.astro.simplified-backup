---
import CrushTerminal from '../components/CrushTerminal.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hakster Hack Lab</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/logo-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 100%; height: 100%; overflow: hidden; background: #000; font-family: 'JetBrains Mono', monospace; }

      /* ── Layout ── */
      #terminal-root { position: fixed; top: 0; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; }

      /* ── Top nav bar ── */
      #term-nav { height: 32px; min-height: 32px; background: #0a0a0f; border-bottom: 1px solid #1e1e2e; display: flex; align-items: center; justify-content: space-between; padding: 0 12px; z-index: 100; user-select: none; flex-shrink: 0; }
      #term-nav a { color: #64748b; text-decoration: none; font-size: 11px; font-weight: 500; letter-spacing: 0.5px; transition: color 0.2s; }
      #term-nav a:hover { color: #e2e8f0; }
      #term-nav .brand { display: flex; align-items: center; gap: 8px; }
      #term-nav .brand img { width: 18px; height: 18px; border-radius: 3px; }
      #term-nav .brand span { color: #e2e8f0; font-size: 12px; font-weight: 700; }
      #term-nav .brand .ai { color: #7c3aed; }
      #term-nav .links { display: flex; gap: 14px; align-items: center; }
      #term-nav .links .active { color: #7c3aed; font-weight: 700; }

      /* ── Phase bar ── */
      #hack-phase-bar { height: 28px; min-height: 28px; background: #080810; border-bottom: 1px solid #1e1e2e; display: flex; align-items: center; gap: 6px; padding: 0 12px; z-index: 90; user-select: none; flex-shrink: 0; font-size: 10px; overflow-x: auto; scrollbar-width: none; }
      #hack-phase-bar::-webkit-scrollbar { display: none; }
      #hack-phase-bar .phase-label { color: #64748b; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-right: 4px; }
      #hack-phase-bar .phase-btn { flex-shrink: 0; padding: 3px 8px; border-radius: 4px; border: 1px solid transparent; background: transparent; color: #64748b; font-family: inherit; font-size: 10px; font-weight: 700; cursor: pointer; transition: all 0.15s; }
      #hack-phase-bar .phase-btn:hover { color: #e2e8f0; background: #1a1a2e; }
      #hack-phase-bar .phase-btn.active { color: #7c3aed; border-color: #7c3aed60; background: #7c3aed20; text-shadow: 0 0 6px #7c3aed; }
      #hack-phase-bar .phase-btn.completed { color: #34d399; }
      #hack-phase-bar .phase-arrow { color: #1e1e2e; font-size: 10px; }
      #hack-phase-bar .target-info { display: flex; align-items: center; gap: 6px; margin-left: auto; flex-shrink: 0; }
      #hack-phase-bar .target-info span:first-child { color: #64748b; }
      #hack-phase-bar .target-value { color: #22d3ee; max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      #hack-phase-bar .checkpoint-count { color: #ffd700; }

      /* ── Main area: sidebar + terminal ── */
      #term-main { flex: 1; display: flex; min-height: 0; overflow: hidden; }

      /* ── Sidebar ── */
      #term-sidebar {
        width: 300px; min-width: 300px; background: #0d0d14; border-right: 1px solid #1e1e2e;
        display: flex; flex-direction: column; overflow-y: auto; transition: width 0.2s, min-width 0.2s;
        font-family: \'JetBrains Mono\', monospace; font-size: 13px; color: #e2e8f0; z-index: 50;
      }
      #term-sidebar.collapsed { width: 0; min-width: 0; overflow: hidden; border-right: none; }
      #term-sidebar .sb-section { padding: 12px 14px; border-bottom: 1px solid #1e1e2e; }
      #term-sidebar .sb-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #64748b; margin-bottom: 10px; display: flex; align-items: center; gap: 4px; }
      #term-sidebar select { width: 100%; background: #111118; border: 1px solid #1e1e2e; color: #e2e8f0; border-radius: 4px; padding: 6px 10px; font-size: 13px; font-family: inherit; outline: none; cursor: pointer; }
      #term-sidebar select:focus { border-color: #7c3aed; }
      #term-sidebar .sb-btn { display: flex; align-items: center; gap: 6px; width: 100%; padding: 7px 11px; border-radius: 6px; border: 1px solid #1e1e2e; background: #111118; color: #e2e8f0; font-size: 13px; font-family: inherit; cursor: pointer; transition: all 0.15s; }
      #term-sidebar .sb-btn:hover { background: #1a1a2e; border-color: #7c3aed; }
      #term-sidebar .sb-btn.primary { background: #7c3aed; border-color: #7c3aed; color: #fff; }
      #term-sidebar .sb-btn.primary:hover { background: #6d28d9; }
      #term-sidebar .sb-btn.blue { background: #2563eb; border-color: #2563eb; color: #fff; }
      #term-sidebar .sb-btn.blue:hover { background: #1d4ed8; }
      #term-sidebar .sb-btn.gold { background: #ffd700; border-color: #ffd700; color: #000; }
      #term-sidebar .sb-btn.gold:hover { background: #e6c200; }
      #term-sidebar .sb-btn.cyan { background: #22d3ee; border-color: #22d3ee; color: #000; }
      #term-sidebar .sb-btn.cyan:hover { background: #1dbbd4; }
      #term-sidebar .sb-btn.red { background: #ff6b6b; border-color: #ff6b6b; color: #000; }
      #term-sidebar .sb-btn.red:hover { background: #e55c5c; }
      #term-sidebar .sb-btn.small { padding: 5px 9px; font-size: 12px; }
      #term-sidebar .sb-info { color: #64748b; font-size: 12px; }
      #term-sidebar .sb-info span { color: #7c3aed; font-weight: 700; }
      #term-sidebar a { color: #64748b; text-decoration: none; transition: color 0.15s; }
      #term-sidebar a:hover { color: #7c3aed; }

      /* Hack tool buttons inside sidebar */
      #term-sidebar .hack-tool-btn { display: flex; align-items: center; gap: 6px; width: 100%; padding: 6px 10px; border-radius: 5px; border: 1px solid transparent; background: transparent; color: #94a3b8; font-size: 13px; font-family: inherit; text-align: left; cursor: pointer; transition: all 0.15s; margin-bottom: 3px; }
      #term-sidebar .hack-tool-btn:hover { background: #1a1a2e; border-color: #1e1e2e; color: #e2e8f0; }
      #term-sidebar .hack-tool-btn:active { text-shadow: 0 0 8px currentColor; }
      #term-sidebar .hack-tool-btn[data-phase="recon"]:hover { color: #c084fc; }
      #term-sidebar .hack-tool-btn[data-phase="scan"]:hover { color: #ffd700; }
      #term-sidebar .hack-tool-btn[data-phase="exploit"]:hover { color: #ff6b6b; }
      #term-sidebar .hack-tool-btn[data-phase="post"]:hover { color: #7c3aed; }
      #term-sidebar .hack-tool-btn[data-phase="report"]:hover { color: #22d3ee; }
      #term-sidebar .hack-tool-btn[data-kind="shell"] { font-style: italic; color: #64748b; }
      #term-sidebar .hack-tool-btn[data-kind="shell"]:hover { color: #34d399; }
      #term-sidebar .hack-tool-btn .tool-icon { width: 18px; text-align: center; font-size: 13px; }

      /* Phase section header in sidebar */
      #term-sidebar .phase-section { opacity: 0.5; transition: opacity 0.2s; }
      #term-sidebar .phase-section.current { opacity: 1; }
      #term-sidebar .phase-section.completed { opacity: 0.7; }

      /* Target input row */
      #term-sidebar .target-row { display: flex; gap: 4px; margin-bottom: 6px; }
      #term-sidebar .target-row input { flex: 1; background: #111118; border: 1px solid #1e1e2e; color: #e2e8f0; border-radius: 4px; padding: 4px 8px; font-size: 11px; font-family: inherit; outline: none; }
      #term-sidebar .target-row input:focus { border-color: #22d3ee; }

      /* Checkpoint flash */
      #hack-checkpoint-flash { display: none; position: absolute; top: 0; left: 0; right: 0; align-items: center; gap: 6px; padding: 6px 12px; background: #ffd70015; border-bottom: 1px solid #ffd70030; color: #ffd700; font-size: 10px; z-index: 60; }
      #hack-checkpoint-flash.show { display: flex; }

      /* Decode overlay */
      #hack-decode-overlay { position: absolute; inset: 0; z-index: 50; pointer-events: none; overflow: hidden; font-family: 'JetBrains Mono', monospace; font-size: 13px; line-height: 1.3; padding: 4px 8px; opacity: 0; will-change: opacity; background: rgba(2,2,4,0.25); }

      /* ── Sidebar toggle ── */
      #sidebar-toggle-btn {
        display: flex; align-items: center; justify-content: center; width: 20px; min-width: 20px;
        background: #0d0d14; border-right: 1px solid #1e1e2e; cursor: pointer; transition: background 0.15s;
        flex-shrink: 0;
      }
      #sidebar-toggle-btn:hover { background: #1a1a2e; }
      #sidebar-toggle-btn svg { width: 12px; height: 12px; color: #64748b; transition: transform 0.2s, color 0.15s; }
      #sidebar-toggle-btn:hover svg { color: #7c3aed; }
      #sidebar-toggle-btn.open svg { transform: rotate(180deg); }

      /* ── Terminal body ── */
      #term-body { flex: 1; min-width: 0; min-height: 0; position: relative; }

      /* ── Right sidebar (crush tools/info) ── */
      #crush-sidebar {
        width: 240px; min-width: 240px; background: #0d0d14; border-left: 1px solid #1e1e2e;
        display: flex; flex-direction: column; overflow-y: auto; transition: width 0.2s, min-width 0.2s;
        font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #e2e8f0; z-index: 50;
      }
      #crush-sidebar.collapsed { width: 0; min-width: 0; overflow: hidden; border-left: none; }
      #crush-sidebar .cs-section { padding: 10px 12px; border-bottom: 1px solid #1e1e2e; }
      #crush-sidebar .cs-title { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #64748b; margin-bottom: 8px; }
      #crush-sidebar .cs-row { display: flex; justify-content: space-between; align-items: center; padding: 3px 0; }
      #crush-sidebar .cs-label { color: #64748b; }
      #crush-sidebar .cs-value { color: #e2e8f0; font-weight: 600; }
      #crush-sidebar .cs-value.purple { color: #7c3aed; }
      #crush-sidebar .cs-value.green { color: #00ff88; }
      #crush-sidebar .cs-value.gold { color: #fbbf24; }
      #crush-sidebar .cs-value.red { color: #e50914; }
      #crush-sidebar .cs-bar { height: 4px; background: #1e1e2e; border-radius: 2px; margin-top: 4px; overflow: hidden; }
      #crush-sidebar .cs-bar-fill { height: 100%; border-radius: 2px; transition: width 0.4s ease; }
      #crush-sidebar .cs-tool-row { display: flex; align-items: center; gap: 6px; padding: 3px 0; }
      #crush-sidebar .cs-tool-icon { width: 14px; text-align: center; font-size: 12px; }
      #crush-sidebar .cs-tool-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #94a3b8; }
      #crush-sidebar .cs-tool-count { color: #7c3aed; font-weight: 600; min-width: 24px; text-align: right; }
      #crush-sidebar .cs-list { max-height: 190px; overflow-y: auto; padding-right: 2px; }
      #crush-sidebar .cs-list.tall { max-height: 260px; }
      #crush-sidebar .cs-chip-row { display: flex; align-items: center; gap: 6px; padding: 3px 0; min-width: 0; }
      #crush-sidebar .cs-chip-main { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #94a3b8; }
      #crush-sidebar .cs-chip-meta { color: #4b5563; font-size: 9px; white-space: nowrap; }
      #crush-sidebar .cs-empty { color: #4b5563; font-size: 10px; padding: 3px 0; }
      #crush-sidebar .cs-file-row { display: flex; align-items: center; gap: 4px; padding: 2px 0; font-size: 10px; }
      #crush-sidebar .cs-file-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #94a3b8; }
      #crush-sidebar .cs-file-add { color: #00ff88; font-weight: 600; }
      #crush-sidebar .cs-file-del { color: #e50914; font-weight: 600; }
      #crush-sidebar .cs-toggle { display: flex; align-items: center; justify-content: center; width: 20px; min-width: 20px; background: #0d0d14; border-left: 1px solid #1e1e2e; cursor: pointer; transition: background 0.15s; flex-shrink: 0; }
      #crush-sidebar .cs-toggle:hover { background: #1a1a2e; }
      #crush-sidebar .cs-toggle svg { width: 12px; height: 12px; color: #64748b; transition: transform 0.2s, color 0.15s; }
      #crush-sidebar .cs-toggle:hover svg { color: #7c3aed; }
      #crush-sidebar .cs-toggle.open svg { transform: rotate(180deg); }

      /* ── Right sidebar toggle ── */
      .cs-toggle-btn {
        display: flex; align-items: center; justify-content: center; width: 20px; min-width: 20px;
        background: #0d0d14; border-left: 1px solid #1e1e2e; cursor: pointer; transition: background 0.15s;
        flex-shrink: 0;
      }
      .cs-toggle-btn:hover { background: #1a1a2e; }
      .cs-toggle-btn svg { width: 12px; height: 12px; color: #64748b; transition: transform 0.2s, color 0.15s; }
      .cs-toggle-btn:hover svg { color: #7c3aed; }
      .cs-toggle-btn.open svg { transform: rotate(180deg); }

      /* ── Responsive: hide sidebars on small screens ── */
      @media (max-width: 768px) {
        #term-sidebar { position: fixed; top: 60px; left: 0; bottom: 0; z-index: 60; transform: translateX(-100%); transition: transform 0.2s; }
        #term-sidebar.mobile-open { transform: translateX(0); width: 260px; min-width: 260px; }
        #sidebar-toggle-btn { width: 28px; min-width: 28px; }
        #sidebar-overlay { display: none; position: fixed; inset: 0; top: 60px; background: rgba(0,0,0,0.5); z-index: 55; }
        #sidebar-overlay.active { display: block; }
        #crush-sidebar { position: fixed; top: 60px; right: 0; bottom: 0; z-index: 60; transform: translateX(100%); transition: transform 0.2s; }
        #crush-sidebar.mobile-open { transform: translateX(0); width: 260px; min-width: 260px; }
        #hack-phase-bar { top: 32px; }
      }
    </style>
  </head>
  <body>
    <div id="terminal-root">
      <div id="term-nav">
        <div class="brand">
          <a href="/"><img src="/logo-192.png" alt="haksterAi" /></a>
          <a href="/"><span>hakster<span class="ai">Ai</span></span></a>
        </div>
        <div class="links">
          <a href="/hack" class="active">💀 Hack</a>
          <a href="/terminal">⌨️ Terminal</a>
          <a href="/dashboard">📊 Dashboard</a>
        </div>
      </div>

      <!-- Hack phase bar -->
      <div id="hack-phase-bar">
        <span class="phase-label">Phase</span>
        <button class="phase-btn" data-phase="recon" data-step="0">1:RECON</button>
        <span class="phase-arrow">→</span>
        <button class="phase-btn" data-phase="scan" data-step="1">2:SCAN</button>
        <span class="phase-arrow">→</span>
        <button class="phase-btn" data-phase="exploit" data-step="2">3:EXPLOIT</button>
        <span class="phase-arrow">→</span>
        <button class="phase-btn" data-phase="post" data-step="3">4:POST</button>
        <span class="phase-arrow">→</span>
        <button class="phase-btn" data-phase="report" data-step="4">5:REPORT</button>
        <div class="target-info">
          <span>TARGET</span>
          <span class="target-value" id="hack-target-display">—</span>
          <span>│</span>
          <span>CHK</span>
          <span class="checkpoint-count" id="hack-checkpoint-count">0/5</span>
        </div>
      </div>

      <div id="term-main">
        <!-- Sidebar -->
        <aside id="term-sidebar">
          <div class="sb-section">
            <button class="sb-btn primary" onclick="hackNewSession()">⚡ New Session</button>
          </div>
          <div class="sb-section">
            <button class="sb-btn blue" onclick="location.href='/terminal'">⌨️ New Terminal</button>
          </div>
          <div class="sb-section">
            <div class="sb-title">📡 Provider</div>
            <select id="sb-provider">
              <option value="ollama">Ollama (Local)</option>
              <option value="openrouter">OpenRouter</option>
              <option value="anthropic">Anthropic</option>
              <option value="openai">OpenAI</option>
              <option value="hermes">Hermes</option>
              <option value="claude-proxy">Claude Proxy</option>
              <option value="codex">Codex / Nous GPT-5.5</option>
            </select>
          </div>
          <div class="sb-section">
            <div class="sb-title">🤖 Model</div>
            <select id="sb-model">
              <option value="">Loading...</option>
            </select>
          </div>
          <div class="sb-section">
            <div class="sb-title">🎯 Target</div>
            <div class="target-row">
              <input id="hack-target-input" type="text" placeholder="ip / domain / url" autocomplete="off" spellcheck="false" />
            </div>
            <div style="display:flex;gap:4px;margin-bottom:6px;">
              <button class="sb-btn small cyan" onclick="hackSetTargetFromInput()" style="flex:1;">Set</button>
              <button class="sb-btn small red" onclick="hackClearTarget()" style="flex:1;">Clear</button>
            </div>
            <button class="sb-btn gold" onclick="hackSaveCheckpoint()">💾 Save Checkpoint</button>
          </div>
          <div class="sb-section">
            <div class="sb-title">ℹ️ Status</div>
            <div class="sb-info" id="sb-status">● <span>Connecting...</span></div>
            <div class="sb-info" id="sb-model-info" style="margin-top:4px;">Model: <span>—</span></div>
            <div class="sb-info" id="sb-hack-phase" style="margin-top:4px;">Phase: <span>RECON</span></div>
            <div class="sb-info" id="sb-uptime" style="margin-top:4px;">Uptime: <span>—</span></div>
          </div>

          <!-- Recon tools -->
          <div class="sb-section phase-section" data-phase-section="recon">
            <div class="sb-title" style="color:#c084fc;">🔍 1: Recon</div>
            <button class="hack-tool-btn" data-kind="shell" data-phase="recon" data-command="echo '[RECON] Running nmap port scan + service fingerprint...' &amp;&amp; nmap -sV -sC -Pn \${TARGET} || echo 'nmap not installed'">⚡ Port Scan + Fingerprint</button>
            <button class="hack-tool-btn" data-kind="shell" data-phase="recon" data-command="echo '[RECON] Enumerating subdomains...' &amp;&amp; subfinder -d \${TARGET} -silent 2&gt;/dev/null || echo 'subfinder not installed'">⚡ Subdomain Enum</button>
            <button class="hack-tool-btn" data-kind="shell" data-phase="recon" data-command="echo '[RECON] Running theHarvester OSINT leak search...' &amp;&amp; theHarvester -d \${TARGET} -b all -f /tmp/hakster_harvester_\${TARGET} 2&gt;/dev/null || echo 'theHarvester not installed'">⚡ OSINT / Leak Search</button>
            <button class="hack-tool-btn" data-kind="shell" data-phase="recon" data-command="echo '[RECON] Discovering technologies...' &amp;&amp; whatweb -a 3 \${TARGET} 2&gt;/dev/null || echo 'whatweb not installed'">⚡ Tech Discovery</button>
            <button class="hack-tool-btn" data-kind="shell" data-phase="recon" data-command="echo '[RECON] DNS enumeration...' &amp;&amp; dig +short ANY \${TARGET} 2&gt;/dev/null || echo 'dig not installed'">⚡ DNS Enum</button>
            <button class="hack-tool-btn" data-kind="shell" data-phase="recon" data-command="echo '[RECON] Whois lookup...' &amp;&amp; whois \${TARGET} 2&gt;/dev/null || echo 'whois not installed'">⚡ Whois</button>
          </div>

          <div class="sb-section phase-section" data-phase-section="scan">
            <div class="sb-title" style="color:#ffd700;">🎯 2: Vuln Scan</div>
            <button class="hack-tool-btn" data-kind="shell" data-phase="scan" data-command="echo '[SCAN] Running XSS scan with dalfox...' &amp;&amp; dalfox url \${TARGET} --silence 2&gt;/dev/null || echo 'dalfox not installed'">⚡ XSS Hunter</button>
            <button class="hack-tool-btn" data-kind="shell" data-phase="scan" data-command="echo '[SCAN] Running SQLi scan with sqlmap...' &amp;&amp; sqlmap -u \${TARGET} --batch --level=1 --risk=1 2&gt;/dev/null || echo 'sqlmap not installed'">⚡ SQLi Scan</button>
            <button class="hack-tool-btn" data-kind="shell" data-phase="scan" data-command="echo '[SCAN] Fuzzing endpoints for IDOR/broken access...' &amp;&amp; ffuf -w /usr/share/wordlists/dirb/common.txt -u \${TARGET}/FUZZ -mc 200,204,301,302,307,401,403,405,500 -s 2&gt;/dev/null || echo 'ffuf not installed'">⚡ IDOR / Endpoint Fuzz</button>
            <button class="hack-tool-btn" data-kind="shell" data-phase="scan" data-command="echo '[SCAN] Probing SSRF / URL parameters...' &amp;&amp; curl -s -o /dev/null -w 'HTTP %{http_code} | size %{size_download} | time %{time_total}s\n' \${TARGET} &amp;&amp; curl -s -o /dev/null -w 'Internal probe response: %{http_code}\n' -H 'X-Forwarded-For: http://169.254.169.254/' \${TARGET} 2&gt;/dev/null || echo 'curl not installed'">⚡ SSRF Probe</button>
            <button class="hack-tool-btn" data-kind="shell" data-phase="scan" data-command="echo '[SCAN] Running nikto comprehensive scan...' &amp;&amp; nikto -h \${TARGET} 2&gt;/dev/null || echo 'nikto not installed'">⚡ Full Vuln Scan</button>
            <button class="hack-tool-btn" data-kind="shell" data-phase="scan" data-command="echo '[SCAN] Dirsearch / directory brute-force...' &amp;&amp; dirsearch -u \${TARGET} -e php,js,json,txt,bak,sql,zip,tar.gz 2&gt;/dev/null || echo 'dirsearch not installed'">⚡ Dir Brute</button>
          </div>

          <div class="sb-section phase-section" data-phase-section="exploit">
            <div class="sb-title" style="color:#ff6b6b;">💣 3: Exploit</div>
            <button class="hack-tool-btn" data-kind="shell" data-phase="exploit" data-command="echo '[EXPLOIT] Search public exploits for services on \${TARGET}...' &amp;&amp; searchsploit --color \${TARGET} 2&gt;/dev/null || echo 'searchsploit not installed'">⚡ Search Exploits</button>
