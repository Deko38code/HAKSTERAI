---
import Layout from '../layouts/Layout.astro';
---

<Layout title="haksterAi Dashboard">
  <div class="min-h-screen pt-[60px] bg-[#0a0a0f] text-[#e2e8f0] px-4 py-6 max-w-7xl mx-auto">
    <!-- Breadcrumb nav -->
    <nav class="flex items-center gap-2 text-xs text-[#64748b] mb-4">
      <a href="/" class="hover:text-[#7c3aed] transition-colors">🏠 Home</a>
      <span>›</span>
      <span class="text-[#7c3aed] font-medium">📊 Dashboard</span>
    </nav>

    <div class="flex items-center gap-3 mb-6">
      <div class="w-2 h-8 bg-[#7c3aed] rounded-full"></div>
      <h1 class="text-2xl font-bold tracking-tight">📊 Dashboard</h1>
      <span class="text-xs text-[#64748b] bg-[#111118] px-2 py-1 rounded-full border border-[#1e1e2e]" id="status-badge">connecting...</span>
      <a href="/" class="ml-auto text-xs bg-[#111118] text-[#cbd5e1] hover:text-[#7c3aed] hover:bg-[#1e1e2e] px-3 py-1.5 rounded-lg border border-[#1e1e2e] hover:border-[#7c3aed]/40 transition-colors flex items-center gap-1.5">
        🏠 Home
      </a>
      <button
        type="button"
        onclick="window.open('/admin/users','haksterAdminUsers','width=1200,height=800,scrollbars=yes,resizable=yes')"
        class="text-xs bg-[#ef4444]/10 text-[#ef4444] hover:bg-[#ef4444]/20 px-3 py-1.5 rounded-lg border border-[#ef4444]/30 transition-colors flex items-center gap-1.5"
      >
        👤 Users
      </button>
      <!-- Owner-only: same popup pattern as Users. The page itself is owner-gated
           by the server (ADMIN_PAGES + requireOwner) and by the layout nav. -->
      <button
        type="button"
        data-owner-only="true"
        onclick="window.open('/admin/skills','haksterAdminSkills','width=1200,height=800,scrollbars=yes,resizable=yes')"
        class="hidden text-xs bg-[#a855f7]/10 text-[#c084fc] hover:bg-[#a855f7]/20 px-3 py-1.5 rounded-lg border border-[#a855f7]/30 transition-colors items-center gap-1.5"
      >
        🧠 Skills &amp; Brain
      </button>
    </div>

    <!-- Quick nav tabs. Horizontal scroll with a visible bar (data-scroll-hint) so
         the tabs past the right edge are discoverable instead of invisible. -->
    <div class="flex gap-2 mb-6 overflow-x-auto pb-2" data-scroll-hint="x">
      <button onclick="document.getElementById('usage-section').scrollIntoView({behavior:'smooth',block:'start'})" class="text-xs bg-[#111118] text-[#64748b] border border-[#1e1e2e] px-3 py-1.5 rounded-lg hover:bg-[#1e1e2e] transition-colors whitespace-nowrap">📊 Usage &amp; Resets</button>
      <button onclick="document.getElementById('billing-section').scrollIntoView({behavior:'smooth',block:'start'})" class="text-xs bg-[#111118] text-[#64748b] border border-[#1e1e2e] px-3 py-1.5 rounded-lg hover:bg-[#1e1e2e] transition-colors whitespace-nowrap">💰 Payments</button>
      <button onclick="document.getElementById('hakster-section').scrollIntoView({behavior:'smooth',block:'start'})" class="text-xs bg-[#7c3aed]/10 text-[#7c3aed] border border-[#7c3aed]/30 px-3 py-1.5 rounded-lg hover:bg-[#7c3aed]/20 transition-colors whitespace-nowrap">🧠 haksterAi Stats</button>
      <button onclick="document.getElementById('tools-section').scrollIntoView({behavior:'smooth',block:'start'})" class="text-xs bg-[#111118] text-[#64748b] border border-[#1e1e2e] px-3 py-1.5 rounded-lg hover:bg-[#1e1e2e] transition-colors whitespace-nowrap">🔧 Tool Breakdown</button>
      <button onclick="document.getElementById('system-section').scrollIntoView({behavior:'smooth',block:'start'})" class="text-xs bg-[#111118] text-[#64748b] border border-[#1e1e2e] px-3 py-1.5 rounded-lg hover:bg-[#1e1e2e] transition-colors whitespace-nowrap">💻 System Info</button>
 <button onclick="document.getElementById('license-section').scrollIntoView({behavior:'smooth',block:'start'})" class="text-xs bg-[#111118] text-[#64748b] border border-[#1e1e2e] px-3 py-1.5 rounded-lg hover:bg-[#1e1e2e] transition-colors whitespace-nowrap">🔑 Licenses</button>
      <button onclick="document.getElementById('services-section').scrollIntoView({behavior:'smooth',block:'start'})" class="text-xs bg-[#111118] text-[#64748b] border border-[#1e1e2e] px-3 py-1.5 rounded-lg hover:bg-[#1e1e2e] transition-colors whitespace-nowrap">📡 Services</button>
      <button onclick="document.getElementById('providers-section').scrollIntoView({behavior:'smooth',block:'start'})" class="text-xs bg-[#111118] text-[#64748b] border border-[#1e1e2e] px-3 py-1.5 rounded-lg hover:bg-[#1e1e2e] transition-colors whitespace-nowrap">🧪 Providers</button>
      <button onclick="document.getElementById('skills-tools-section').scrollIntoView({behavior:'smooth',block:'start'})" class="text-xs bg-[#111118] text-[#64748b] border border-[#1e1e2e] px-3 py-1.5 rounded-lg hover:bg-[#1e1e2e] transition-colors whitespace-nowrap">🧩 Skills &amp; Tools</button>
    </div>

    <!-- ── Dell Server status strip (owner-only, live) ─────────────────────
         Same four-card shape as the Junkalot console on Parrot, but this reports
         the Dell (ghost-Inspiron-7348) because haksterai.com always runs here.
         Data: owner-only /api/admin/server-status. Read-only, refreshes every 30s. -->
    <section id="server-section" class="mb-6">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-[#7c3aed]">🖥️ Dell Server</span>
        <span class="text-[11px] text-[#64748b]">haksterai.com · ghost-Inspiron-7348</span>
        <span class="ml-auto flex items-center gap-1.5 text-[11px] text-[#64748b]">
          <span id="srv-live-dot" class="inline-block h-1.5 w-1.5 rounded-full bg-[#64748b] transition-colors"></span>
          <span id="srv-live-label">connecting…</span>
          <span id="srv-cache" aria-live="polite"></span>
        </span>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Card 1 — the Dell machine itself -->
        <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl px-4 py-3 hover:border-[#7c3aed]/40 transition-colors">
          <div class="flex items-center justify-between">
            <div class="text-[11px] uppercase tracking-wide text-[#64748b]">Server</div>
            <span id="srv-state-dot" class="inline-block h-2 w-2 rounded-full bg-[#64748b] transition-colors"></span>
          </div>
          <div class="mt-1 flex items-baseline gap-2">
            <span id="srv-state" class="text-sm font-bold text-[#e2e8f0]">Checking…</span>
            <span id="srv-uptime" class="font-mono text-xs text-[#94a3b8]"></span>
          </div>
          <div id="srv-detail" class="mt-0.5 text-[11px] text-[#64748b]">waiting for first check</div>
          <div class="mt-2">
            <div class="flex justify-between text-[10px] text-[#64748b] mb-1"><span>Memory</span><span id="srv-mem-pct">—</span></div>
            <div class="w-full h-1.5 bg-[#1e1e2e] rounded-full overflow-hidden">
              <div id="srv-mem-bar" class="h-full bg-gradient-to-r from-[#7c3aed] to-[#a855f7] rounded-full transition-all duration-500" style="width:0%"></div>
            </div>
          </div>
        </div>
        <!-- Card 2 — public site answering through the tunnel -->
        <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl px-4 py-3 hover:border-[#7c3aed]/40 transition-colors">
          <div class="text-[11px] uppercase tracking-wide text-[#64748b]">Public site</div>
          <div class="mt-1 flex items-baseline gap-2">
            <span id="srv-site-state" class="text-sm font-bold text-[#e2e8f0]">Checking…</span>
            <span id="srv-site-ms" class="font-mono text-xs text-[#94a3b8]"></span>
          </div>
          <div id="srv-site-detail" class="mt-0.5 text-[11px] text-[#64748b]">haksterai.com · checked —</div>
        </div>
        <!-- Card 3 — Cloudflare in front of it -->
        <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl px-4 py-3 hover:border-[#7c3aed]/40 transition-colors">
          <div class="text-[11px] uppercase tracking-wide text-[#64748b]">Cloudflare</div>
          <div class="mt-1 flex items-baseline gap-2">
            <span id="srv-cf-state" class="text-sm font-bold text-[#e2e8f0]">Checking…</span>
          </div>
          <div id="srv-cf-ray" class="mt-0.5 truncate font-mono text-[11px] text-[#64748b]">cf-ray —</div>
        </div>
        <!-- Card 4 — disk and swap health -->
        <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl px-4 py-3 hover:border-[#7c3aed]/40 transition-colors">
          <div class="text-[11px] uppercase tracking-wide text-[#64748b]">Disk &amp; swap</div>
          <div class="mt-1 flex items-baseline gap-2">
            <span id="srv-disk-state" class="text-sm font-bold text-[#e2e8f0]">Checking…</span>
          </div>
          <div id="srv-disk-detail" class="mt-0.5 text-[11px] text-[#64748b]">—</div>
          <div class="mt-2">
            <div class="flex justify-between text-[10px] text-[#64748b] mb-1"><span>Root disk</span><span id="srv-disk-pct">—</span></div>
            <div class="w-full h-1.5 bg-[#1e1e2e] rounded-full overflow-hidden">
              <div id="srv-disk-bar" class="h-full bg-gradient-to-r from-[#00bfff] to-[#00ff88] rounded-full transition-all duration-500" style="width:0%"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Sensor applets — real readings only: CPU busy % from a /proc/stat
           sample, memory from /proc/meminfo, CPU/RAM temperature and fan RPM
           from lm-sensors. A missing sensor shows "no sensor", never a guess. -->
      <div class="grid gap-2 mt-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5" id="sensor-applets">
        <div class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-xl px-3 py-2.5">
          <div class="flex items-center justify-between">
            <span class="text-[10px] uppercase tracking-wider text-[#64748b]">⚙️ CPU</span>
            <span id="app-cpu-state" class="text-[9px] font-bold uppercase tracking-wider text-[#64748b]">—</span>
          </div>
          <div class="mt-1 flex items-baseline gap-1">
            <span id="app-cpu-pct" class="text-lg font-bold text-[#7c3aed]">—</span>
            <span class="text-[10px] text-[#64748b]">busy</span>
          </div>
          <div class="w-full h-1 bg-[#1e1e2e] rounded-full overflow-hidden mt-1.5">
            <div id="app-cpu-bar" class="h-full bg-gradient-to-r from-[#7c3aed] to-[#a855f7] rounded-full transition-all duration-500" style="width:0%"></div>
          </div>
          <div id="app-cpu-detail" class="mt-1 text-[10px] text-[#64748b] truncate">load —</div>
        </div>

        <div class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-xl px-3 py-2.5">
          <div class="flex items-center justify-between">
            <span class="text-[10px] uppercase tracking-wider text-[#64748b]">🧠 RAM</span>
            <span id="app-ram-state" class="text-[9px] font-bold uppercase tracking-wider text-[#64748b]">—</span>
          </div>
          <div class="mt-1 flex items-baseline gap-1">
            <span id="app-ram-pct" class="text-lg font-bold text-[#00bfff]">—</span>
            <span class="text-[10px] text-[#64748b]">used</span>
          </div>
          <div class="w-full h-1 bg-[#1e1e2e] rounded-full overflow-hidden mt-1.5">
            <div id="app-ram-bar" class="h-full bg-gradient-to-r from-[#00bfff] to-[#00ff88] rounded-full transition-all duration-500" style="width:0%"></div>
          </div>
          <div id="app-ram-detail" class="mt-1 text-[10px] text-[#64748b] truncate">—</div>
        </div>

        <div class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-xl px-3 py-2.5">
          <div class="flex items-center justify-between">
            <span class="text-[10px] uppercase tracking-wider text-[#64748b]">🌡️ CPU temp</span>
            <span id="app-cputemp-state" class="text-[9px] font-bold uppercase tracking-wider text-[#64748b]">—</span>
          </div>
          <div class="mt-1 flex items-baseline gap-1">
            <span id="app-cputemp" class="text-lg font-bold text-[#fbbf24]">—</span>
          </div>
          <div class="w-full h-1 bg-[#1e1e2e] rounded-full overflow-hidden mt-1.5">
            <div id="app-cputemp-bar" class="h-full bg-gradient-to-r from-[#fbbf24] to-[#ff4444] rounded-full transition-all duration-500" style="width:0%"></div>
          </div>
          <div id="app-cputemp-detail" class="mt-1 text-[10px] text-[#64748b] truncate">lm-sensors</div>
        </div>

        <div class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-xl px-3 py-2.5">
          <div class="flex items-center justify-between">
            <span class="text-[10px] uppercase tracking-wider text-[#64748b]">🧩 RAM temp</span>
            <span id="app-ramtemp-state" class="text-[9px] font-bold uppercase tracking-wider text-[#64748b]">—</span>
          </div>
          <div class="mt-1 flex items-baseline gap-1">
            <span id="app-ramtemp" class="text-lg font-bold text-[#00ff88]">—</span>
          </div>
          <div class="w-full h-1 bg-[#1e1e2e] rounded-full overflow-hidden mt-1.5">
            <div id="app-ramtemp-bar" class="h-full bg-gradient-to-r from-[#00ff88] to-[#fbbf24] rounded-full transition-all duration-500" style="width:0%"></div>
          </div>
          <div id="app-ramtemp-detail" class="mt-1 text-[10px] text-[#64748b] truncate">SODIMM</div>
        </div>

        <div class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-xl px-3 py-2.5">
          <div class="flex items-center justify-between">
            <span class="text-[10px] uppercase tracking-wider text-[#64748b]">🌀 Fan</span>
            <span id="app-fan-state" class="text-[9px] font-bold uppercase tracking-wider text-[#64748b]">—</span>
          </div>
          <div class="mt-1 flex items-baseline gap-1">
            <span id="app-fan" class="text-lg font-bold text-[#a855f7]">—</span>
          </div>
          <div class="w-full h-1 bg-[#1e1e2e] rounded-full overflow-hidden mt-1.5">
            <div id="app-fan-bar" class="h-full bg-gradient-to-r from-[#a855f7] to-[#00bfff] rounded-full transition-all duration-500" style="width:0%"></div>
          </div>
          <div id="app-fan-detail" class="mt-1 text-[10px] text-[#64748b] truncate">RPM · max 7021</div>
        </div>
      </div>
    </section>


    <!-- ── Stripe CLI bridge (owner + agents) ───────────────
         Read-only CLI console with an allowlist, plus the price tools behind
         "easy price change": create a new price on the plan's Stripe product and
         archive the old one, add an extra price (add-on / yearly), or archive a
         stray price. Every action is logged to stripe_cli_actions and reported
         to the Telegram fleet. Nothing here edits config or .env. -->
    <section id="stripecli-section" class="mb-6">
      <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-4">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="text-xs font-semibold uppercase tracking-wider text-[#635bff]">💳 Stripe CLI</span>
          <span class="text-[11px] text-[#64748b]">owner + agents · read-only console · live prices</span>
          <span id="scli-state" class="text-[10px] font-bold uppercase tracking-wider rounded-full px-2 py-0.5 border border-[#1e1e2e] bg-[#0a0a0f] text-[#64748b]">checking</span>
          <span id="scli-cache" aria-live="polite" class="ml-auto"></span>
        </div>

        <div class="flex flex-wrap items-center gap-2 mb-2">
          <button data-scli="products list --limit 5" type="button" class="scli-cmd text-[11px] bg-[#635bff]/10 text-[#a5a1ff] hover:bg-[#635bff]/20 border border-[#635bff]/30 rounded-lg px-2.5 py-1 transition-colors">products</button>
          <button data-scli="prices list --limit 8" type="button" class="scli-cmd text-[11px] bg-[#635bff]/10 text-[#a5a1ff] hover:bg-[#635bff]/20 border border-[#635bff]/30 rounded-lg px-2.5 py-1 transition-colors">prices</button>
          <button data-scli="subscriptions list --limit 5" type="button" class="scli-cmd text-[11px] bg-[#635bff]/10 text-[#a5a1ff] hover:bg-[#635bff]/20 border border-[#635bff]/30 rounded-lg px-2.5 py-1 transition-colors">subscriptions</button>
          <button data-scli="customers list --limit 5" type="button" class="scli-cmd text-[11px] bg-[#635bff]/10 text-[#a5a1ff] hover:bg-[#635bff]/20 border border-[#635bff]/30 rounded-lg px-2.5 py-1 transition-colors">customers</button>
          <button data-scli="events list --limit 5" type="button" class="scli-cmd text-[11px] bg-[#635bff]/10 text-[#a5a1ff] hover:bg-[#635bff]/20 border border-[#635bff]/30 rounded-lg px-2.5 py-1 transition-colors">events</button>
          <button data-scli="balance retrieve" type="button" class="scli-cmd text-[11px] bg-[#635bff]/10 text-[#a5a1ff] hover:bg-[#635bff]/20 border border-[#635bff]/30 rounded-lg px-2.5 py-1 transition-colors">balance</button>
          <button id="scli-refresh" type="button" class="ml-auto text-[11px] font-semibold bg-[#111118] text-[#94a3b8] hover:bg-[#1e1e2e] border border-[#1e1e2e] rounded-lg px-2.5 py-1 transition-colors">refresh catalog</button>
        </div>

        <div class="grid gap-3 lg:grid-cols-2">
          <div>
            <div id="scli-meta" class="text-[10px] text-[#64748b] mb-1">no command run yet</div>
            <pre id="scli-output" class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg p-3 text-[10px] leading-relaxed text-[#94a3b8] overflow-auto max-h-56 whitespace-pre-wrap">Run a command to see real Stripe output.</pre>
          </div>
          <div>
            <div class="text-[10px] uppercase tracking-wider text-[#64748b] mb-1">Easy price change · add-on · fix</div>
            <div class="flex flex-wrap items-center gap-2">
              <select id="scli-plan" class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg px-2 py-1.5 text-[11px] text-[#e2e8f0]"></select>
              <input id="scli-amount" type="number" min="1" step="1" placeholder="$ / month" class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg px-2 py-1.5 text-[11px] text-[#e2e8f0] w-28" />
              <select id="scli-interval" class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg px-2 py-1.5 text-[11px] text-[#e2e8f0]">
                <option value="month">monthly</option>
                <option value="year">yearly</option>
              </select>
            </div>
            <div class="flex flex-wrap items-center gap-2 mt-2">
              <button id="scli-change" type="button" class="text-[11px] font-semibold bg-[#635bff]/15 text-[#a5a1ff] hover:bg-[#635bff]/25 border border-[#635bff]/40 rounded-lg px-3 py-1.5 transition-colors">Change price</button>
              <button id="scli-add" type="button" class="text-[11px] font-semibold bg-[#00ff88]/10 text-[#00ff88] hover:bg-[#00ff88]/20 border border-[#00ff88]/30 rounded-lg px-3 py-1.5 transition-colors">Add price</button>
              <input id="scli-archive-id" type="text" placeholder="price_… to archive" class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg px-2 py-1.5 text-[11px] text-[#e2e8f0] w-44" />
              <button id="scli-archive" type="button" class="text-[11px] font-semibold bg-[#ff4444]/10 text-[#ff4444] hover:bg-[#ff4444]/20 border border-[#ff4444]/30 rounded-lg px-3 py-1.5 transition-colors">Archive</button>
            </div>
            <div id="scli-result" class="mt-2 text-[11px] text-[#94a3b8]">Prices are read from Stripe, so a change here is live without editing config.</div>
            <div class="mt-3 overflow-x-auto">
              <table class="w-full text-[11px]">
                <thead>
                  <tr class="text-[#64748b] uppercase tracking-wider text-[10px]">
                    <th class="text-left font-medium px-2 py-1">Since last update</th>
                    <th class="text-left font-medium px-2 py-1">Action</th>
                    <th class="text-left font-medium px-2 py-1">Detail</th>
                    <th class="text-left font-medium px-2 py-1">Result</th>
                  </tr>
                </thead>
                <tbody id="scli-rows"></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Dell Auto Agent (read-only security + IP audit) ─────────────────
         Runs automatically on server startup and whenever this panel opens
         (POST /api/admin/autoagent/run trigger=panel — server throttles 60s).
         Nothing is changed: findings only. Login events (timestamp, kind, user,
         IP) are appended to server/data/login-events.jsonl on every run. -->
    <section id="autoagent-section" class="mb-6">
      <div class="flex flex-wrap items-center gap-2 mb-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-[#a855f7]">🤖 Auto Agent</span>
        <span class="text-[11px] text-[#64748b]">security checks · IP audit · read-only</span>
        <span id="aa-state" class="text-[10px] font-bold uppercase tracking-wider rounded-full px-2 py-0.5 border border-[#1e1e2e] bg-[#111118] text-[#64748b]">idle</span>
        <span id="aa-meta" class="text-[11px] text-[#64748b]"></span>
        <button id="aa-run-btn" type="button" class="ml-auto text-[11px] font-semibold bg-[#a855f7]/10 text-[#c084fc] hover:bg-[#a855f7]/20 border border-[#a855f7]/30 rounded-lg px-3 py-1.5 transition-colors disabled:opacity-50">
          Run now
        </button>
      </div>

      <!-- Check chips -->
      <div id="aa-checks" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-7 gap-2 mb-3">
        <div class="bg-[#111118] border border-[#1e1e2e] rounded-lg px-3 py-2 text-[11px] text-[#64748b]">waiting for first run…</div>
      </div>

      <!-- IP audit -->
      <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-4">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="text-xs font-semibold uppercase tracking-wider text-[#7c3aed]">🌐 IP Audit</span>
          <span id="aa-ip-window" class="text-[11px] text-[#64748b]"></span>
          <span id="aa-ip-anoms" class="ml-auto text-[11px] text-[#64748b]"></span>
        </div>
        <div id="aa-ip-stats" class="grid grid-cols-3 sm:grid-cols-6 gap-2 mb-3">
