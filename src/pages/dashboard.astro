    // ── Dell server status strip ──────────────────────────────────────
    // Owner-only feed from /api/admin/server-status. Read-only. A 401/403 just
    // leaves the strip in "sign in" state instead of spamming the console, and
    // a failed fetch greys the live dot rather than showing stale data as live.
    function fmtBytes(bytes) {
      const n = Number(bytes || 0);
      if (!n) return '0 B';
      const units = ['B', 'KB', 'MB', 'GB', 'TB'];
      const i = Math.min(units.length - 1, Math.floor(Math.log(n) / Math.log(1024)));
      return (n / Math.pow(1024, i)).toFixed(i >= 3 ? 1 : 0) + ' ' + units[i];
    }
    function fmtDur(sec) {
      const s = Math.max(0, Number(sec || 0));
      const d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
      return d ? d + 'd ' + h + 'h' : h + 'h ' + m + 'm';
    }
    function setServerLive(ok, label) {
      const dot = document.getElementById('srv-live-dot');
      const text = document.getElementById('srv-live-label');
      if (dot) dot.className = 'inline-block h-1.5 w-1.5 rounded-full transition-colors ' + (ok ? 'bg-[#00ff88]' : 'bg-[#64748b]');
      if (text) text.textContent = label;
    }
    async function loadServerStatus() {
      const cachePill = (state, note) => hkCachePill('srv-cache', state, note);
      try {
        const res = await liveFetch('/api/admin/server-status', { headers: authHeaders() });
        if (res.status === 401 || res.status === 403) { setServerLive(false, 'owner sign-in required'); cachePill('stale', 'signed out'); return; }
        if (!res.ok) throw new Error('server-status ' + res.status);
        const d = await res.json();
        hkCacheSeen('srv-cache', res);

        // 1 — the Dell machine
        const up = document.getElementById('srv-state');
        if (up) { up.textContent = 'Up'; up.className = 'text-sm font-bold text-[#00ff88]'; }
        const dot = document.getElementById('srv-state-dot');
        if (dot) dot.className = 'inline-block h-2 w-2 rounded-full bg-[#00ff88] transition-colors';
        setText('srv-uptime', fmtDur(d.host?.upSec));
        const load = (d.host?.loadavg || []).join(' / ');
        setText('srv-detail', (d.host?.cpus || 0) + ' CPUs · load ' + (load || '—') + ' · ' + (d.host?.hostname || 'dell'));
        const memPct = Number(d.mem?.usedPct || 0);
        setText('srv-mem-pct', memPct + '% · ' + fmtBytes(d.mem?.usedBytes) + ' / ' + fmtBytes(d.mem?.totalBytes));
        setWidth('srv-mem-bar', memPct + '%');

        // 2 — public site
        const site = d.site || {};
        const siteEl = document.getElementById('srv-site-state');
        if (siteEl) {
          siteEl.textContent = site.online ? 'Online · ' + site.status : 'Not answering';
          siteEl.className = 'text-sm font-bold ' + (site.online ? 'text-[#00ff88]' : 'text-[#ff4444]');
        }
        setText('srv-site-ms', site.online ? site.ms + 'ms' : '');
        setText('srv-site-detail', 'haksterai.com · checked ' + (d.checkedAt ? new Date(d.checkedAt).toLocaleTimeString() : '—'));

        // 3 — Cloudflare
        const cfEl = document.getElementById('srv-cf-state');
        if (cfEl) {
          cfEl.textContent = site.viaCloudflare ? 'Carrying traffic' : 'Header not seen';
          cfEl.className = 'text-sm font-bold ' + (site.viaCloudflare ? 'text-[#fbbf24]' : 'text-[#64748b]');
        }
        setText('srv-cf-ray', site.ray || 'cf-ray unavailable');

        // 4 — disk & swap
        const diskEl = document.getElementById('srv-disk-state');
        const diskPct = Number(d.disk?.usedPct || 0);
        if (diskEl) {
          diskEl.textContent = diskPct + '% used';
          diskEl.className = 'text-sm font-bold ' + (diskPct >= 90 ? 'text-[#ff4444]' : diskPct >= 75 ? 'text-[#fbbf24]' : 'text-[#00ff88]');
        }
        setText('srv-disk-detail', fmtBytes(d.disk?.freeBytes) + ' free · swap ' + Number(d.swap?.usedPct || 0) + '% (' + fmtBytes(d.swap?.usedBytes) + ' / ' + fmtBytes(d.swap?.totalBytes) + ')');
        setText('srv-disk-pct', diskPct + '%');
        setWidth('srv-disk-bar', diskPct + '%');

        // Sensor applets — every number here comes from the box: CPU busy % from
        // a /proc/stat sample, memory from /proc/meminfo, temperatures and fan
        // from lm-sensors. Missing hardware shows "no sensor", never a fake value.
        const cpu = d.cpu || {};
        const hw = d.hardware || {};
        const hwMem = hw.mem || {};
        const sens = hw.sensors || {};
        const cpuPct = Number(cpu.busyPct);
        const cpuKnown = Number.isFinite(cpuPct);
        const cpuPill = document.getElementById('app-cpu-state');
        if (cpuPill) {
          cpuPill.textContent = cpuKnown ? (cpuPct >= 85 ? 'hot' : cpuPct >= 60 ? 'busy' : 'ok') : 'no sample';
          cpuPill.className = 'text-[9px] font-bold uppercase tracking-wider ' + (cpuPct >= 85 ? 'text-[#ff4444]' : cpuPct >= 60 ? 'text-[#fbbf24]' : cpuKnown ? 'text-[#00ff88]' : 'text-[#64748b]');
        }
        setText('app-cpu-pct', cpuKnown ? cpuPct + '%' : '—');
        setWidth('app-cpu-bar', cpuKnown ? cpuPct + '%' : '0%');
        setText('app-cpu-detail', 'load ' + ((d.host?.loadavg || []).join(' / ') || '—') + ' · iowait ' + (Number.isFinite(Number(cpu.iowaitPct)) ? cpu.iowaitPct + '%' : '—'));

        const ramPct = Number.isFinite(Number(hwMem.usedPct)) ? Number(hwMem.usedPct) : Number(d.mem?.usedPct || 0);
        const ramPill = document.getElementById('app-ram-state');
        if (ramPill) {
          ramPill.textContent = ramPct >= 85 ? 'high' : ramPct >= 70 ? 'warm' : 'ok';
          ramPill.className = 'text-[9px] font-bold uppercase tracking-wider ' + (ramPct >= 85 ? 'text-[#ff4444]' : ramPct >= 70 ? 'text-[#fbbf24]' : 'text-[#00ff88]');
        }
        setText('app-ram-pct', ramPct + '%');
        setWidth('app-ram-bar', ramPct + '%');
        setText('app-ram-detail', fmtBytes(hwMem.usedBytes ?? d.mem?.usedBytes) + ' / ' + fmtBytes(hwMem.totalBytes ?? d.mem?.totalBytes) + ' · swap ' + Number(hwMem.swap?.usedPct ?? d.swap?.usedPct ?? 0) + '%');

        const tempTone = (c) => (c == null ? 'text-[#64748b]' : c >= 85 ? 'text-[#ff4444]' : c >= 70 ? 'text-[#fbbf24]' : 'text-[#00ff88]');
        const cpuTemp = Number.isFinite(Number(sens.cpuC)) ? Number(sens.cpuC) : null;
        setText('app-cputemp', cpuTemp == null ? 'no sensor' : cpuTemp + '°C');
        const cpuTempEl = document.getElementById('app-cputemp');
        if (cpuTempEl) cpuTempEl.className = 'text-lg font-bold ' + (cpuTemp == null ? 'text-[#64748b]' : tempTone(cpuTemp));
        setWidth('app-cputemp-bar', cpuTemp == null ? '0%' : Math.min(100, Math.round((cpuTemp / 100) * 100)) + '%');
        setText('app-cputemp-detail', (sens.chip || 'lm-sensors') + ' · trip 100°C');

        const ramTemp = Number.isFinite(Number(sens.ramC)) ? Number(sens.ramC) : null;
        setText('app-ramtemp', ramTemp == null ? 'no sensor' : ramTemp + '°C');
        const ramTempEl = document.getElementById('app-ramtemp');
        if (ramTempEl) ramTempEl.className = 'text-lg font-bold ' + (ramTemp == null ? 'text-[#64748b]' : tempTone(ramTemp));
        setWidth('app-ramtemp-bar', ramTemp == null ? '0%' : Math.min(100, Math.round((ramTemp / 100) * 100)) + '%');
        setText('app-ramtemp-detail', 'SODIMM · ambient ' + (Number.isFinite(Number(sens.ambientC)) ? sens.ambientC + '°C' : '—'));

        const fanRpm = Number.isFinite(Number(sens.fanRpm)) ? Number(sens.fanRpm) : null;
        setText('app-fan', fanRpm == null ? 'no sensor' : fanRpm.toLocaleString() + ' RPM');
        const fanEl = document.getElementById('app-fan');
        if (fanEl) fanEl.className = 'text-lg font-bold ' + (fanRpm == null ? 'text-[#64748b]' : fanRpm >= 6000 ? 'text-[#ff4444]' : fanRpm >= 4500 ? 'text-[#fbbf24]' : 'text-[#00ff88]');
        setWidth('app-fan-bar', fanRpm == null ? '0%' : Math.min(100, Math.round((fanRpm / 7021) * 100)) + '%');
        setText('app-fan-detail', 'RPM · max 7021');

        setServerLive(true, 'live · 1s');
      } catch {
        setServerLive(false, 'offline');
        cachePill('stale', 'retrying');
      }
    }

    // ── IP signup guard panel ─────────────────────────────────────────
    // One free account per IP; paid accounts, paid checkouts and owner-allowed
    // IPs are exempt. Owner-only endpoints; every render carries "since last
    // update" times so the panel proves it is live.
    let ipGuardApplying = false;
    function ipGuardDecisionChip(action, code) {
      const blocked = action === 'blocked';
      const label = blocked ? (code === 'ip-blocked' ? 'blocked' : 'refused') : 'allowed';
      return '<span class="text-[10px] font-bold uppercase tracking-wider rounded-full px-2 py-0.5 border ' +
        (blocked ? 'bg-[#ff4444]/10 text-[#ff4444] border-[#ff4444]/30' : 'bg-[#00ff88]/10 text-[#00ff88] border-[#00ff88]/30') +
        '">' + escHtml(label) + '</span>';
    }
    function renderIpGuard(data) {
      const t = data?.totals || {};
      setText('ipg-limit', (data?.freeLimit ?? 1) + ' / IP');
      setText('ipg-ips', fmtNum(t.ipCount ?? 0));
      setText('ipg-multi', fmtNum(t.multiAccountIps ?? 0));
      setText('ipg-blocked', fmtNum(t.blockedIps ?? 0));
      setText('ipg-refused', fmtNum(t.blockedAttempts24h ?? 0));
      setText('ipguard-rule', data?.rule || 'one free account per IP · paid IPs exempt');

      // House vs. real: the owner's own addresses never count as customers.
      const rs = data?.realSignups || null;
      const realEl = document.getElementById('ipguard-real');
      if (realEl) {
        if (!rs) {
          // The field only exists once the server process is running the
          // house-accounts build; until then say exactly that, not "broken".
          realEl.innerHTML = '<span class="text-[#fbbf24]">⏳ server update pending — the split appears once the new API is running (it applies itself when the box is idle)</span>';
        } else if (rs.error) {
          realEl.innerHTML = '<span class="text-[#ff4444]">real-signup state unavailable</span>' +
            ' <span class="text-[#64748b]">' + escHtml(rs.error) + '</span>';
        } else {
          const houseNote = 'house accounts excluded (' + fmtNum(rs.houseCount || 0) + ')';
          const m = rs.milestone;
          if (m) {
            const at = Number(m.at || 0);
            const ago = at ? ' · ' + fmtAgo(Math.max(0, Math.floor(Date.now() / 1000) - at)) : '';
            realEl.innerHTML = '<span class="text-[#00ff88] font-semibold">🎉 First real signup: ' +
              escHtml(m.email || m.username || '—') + '</span>' +
              '<span class="text-[#64748b]"> via ' + escHtml(m.source || 'signup') + ago +
              ' · ' + fmtNum(rs.realCount || 0) + ' real customer(s) · ' + houseNote + '</span>';
          } else {
            realEl.innerHTML = '<span class="text-[#fbbf24] font-semibold">⏳ waiting for the first real signup</span>' +
              '<span class="text-[#64748b]"> — ' + houseNote + ' · ' + fmtNum(rs.realCount || 0) +
              ' non-house account(s) on record, milestone not fired yet</span>';
          }
        }
      }

      const events = Array.isArray(data?.events) ? data.events : [];
      const rows = events.slice(0, 12).map(e => {
        const ago = Number.isFinite(Number(e.seconds_ago)) ? fmtAgo(Number(e.seconds_ago)) : '—';
        return '<tr class="border-t border-[#1e1e2e]/60">' +
          '<td class="px-2 py-1 text-[#94a3b8] whitespace-nowrap">' + escHtml(ago) + '</td>' +
          '<td class="px-2 py-1 font-mono text-[#e2e8f0]">' + escHtml(e.ip || '—') + '</td>' +
          '<td class="px-2 py-1">' + ipGuardDecisionChip(e.action, e.code) + '</td>' +
          '<td class="px-2 py-1 text-[#94a3b8]">' + escHtml(e.source || '—') + '</td>' +
          '<td class="px-2 py-1 text-[#64748b]">' + escHtml((e.detail || e.code || '').slice(0, 90)) + '</td>' +
          '</tr>';
      }).join('');
      hkSetTable('ipguard-rows', rows || '<tr><td colspan="5" class="px-2 py-1 text-[#64748b]">no signups or refusals recorded yet — the guard is armed</td></tr>', events.length > 0);

      const multi = Array.isArray(data?.multi) ? data.multi : [];
      const multiEl = document.getElementById('ipguard-multi-list');
      if (multiEl) {
        multiEl.innerHTML = multi.length
          ? '⚠ multi-account IPs: ' + multi.slice(0, 6).map(m => escHtml(m.ip) + ' (' + Number(m.free || 0) + ' free' + (Number(m.paid || 0) ? ', ' + Number(m.paid) + ' paid' : '') + ')').join(' · ') +
            (multi.length > 6 ? ' …' : '')
          : 'no multi-account IPs right now';
      }
      const blocks = Array.isArray(data?.blocks) ? data.blocks : [];
      const allows = Array.isArray(data?.allows) ? data.allows : [];
      const meta = document.getElementById('ipg-result');
      if (meta && !meta.dataset.hkManual) {
        meta.textContent = (blocks.length ? 'blocked: ' + blocks.slice(0, 3).map(b => b.ip).join(', ') + (blocks.length > 3 ? ' …' : '') : 'no manual blocks') +
          (allows.length ? ' · allowed: ' + allows.slice(0, 2).map(a => a.ip).join(', ') : '');
      }
    }
    async function loadIpGuard() {
      try {
        const res = await liveFetch('/api/admin/ip-guard?limit=25', { headers: authHeaders() });
        if (res.status === 401 || res.status === 403) { hkCachePill('ipguard-cache', 'stale', 'owner only'); return; }
        if (!res.ok) { hkCachePill('ipguard-cache', 'stale', 'http ' + res.status); return; }
        hkCacheSeen('ipguard-cache', res, '1s');
        renderIpGuard(await res.json());
      } catch {
        hkCachePill('ipguard-cache', 'stale', 'retrying');
      }
    }
    async function applyIpGuardAction() {
      if (ipGuardApplying) return;
      const ip = (document.getElementById('ipg-ip')?.value || '').trim();
      const action = document.getElementById('ipg-action')?.value || 'block';
      const reason = (document.getElementById('ipg-reason')?.value || '').trim();
      const hours = Number(document.getElementById('ipg-hours')?.value || 24);
      const out = document.getElementById('ipg-result');
      if (!ip) { if (out) { out.dataset.hkManual = '1'; out.textContent = 'enter an IP first'; } return; }
      if (!confirm((action === 'block' ? 'Block' : 'Allow') + ' new free signups from ' + ip + '?')) return;
      ipGuardApplying = true;
      const btn = document.getElementById('ipg-apply');
      if (btn) btn.disabled = true;
      try {
        const res = await fetch('/api/admin/ip-guard', {
          method: 'POST',
          headers: { ...authHeaders(), 'Content-Type': 'application/json' },
          body: JSON.stringify({ ip, action, reason, hours }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.summary) {
          renderIpGuard(data.summary);
          if (out) { out.dataset.hkManual = '1'; out.textContent = '✅ ' + action + ' applied to ' + ip; }
        } else if (out) {
          out.dataset.hkManual = '1';
          out.textContent = '❌ ' + (data.error || ('http ' + res.status));
        }
      } catch (e) {
        if (out) { out.dataset.hkManual = '1'; out.textContent = '❌ ' + (e.message || 'request failed'); }
      } finally {
        ipGuardApplying = false;
        if (btn) btn.disabled = false;
      }
    }
    const ipgBtn = document.getElementById('ipg-apply');
    if (ipgBtn) ipgBtn.addEventListener('click', applyIpGuardAction);
    // Explicit one-second cadence: the guard is the owner's early-warning panel,
    // so it refreshes every second while the tab is visible (hkLiveEvery is
    // visibility-gated and single-flight, so the cost stays sub-millisecond).
    loadIpGuard();
    window.hkLiveEvery(loadIpGuard, 1000);

    // ── Stripe CLI bridge card ────────────────────────────────────────
    // Read-only console over an allowlist, plus real price tools. Every write
    // asks for confirmation and is verified by re-listing the product's active
    // prices from Stripe before the panel reports success.
    let scliBusy = false;
    let scliPlansLoaded = false;
    function scliSetResult(text, tone) {
      const el = document.getElementById('scli-result');
      if (!el) return;
      el.className = 'mt-2 text-[11px] ' + (tone === 'bad' ? 'text-[#ff4444]' : tone === 'good' ? 'text-[#00ff88]' : 'text-[#94a3b8]');
      el.textContent = text;
    }
    function renderStripeCli(data) {
      const st = data?.status || {};
      const pill = document.getElementById('scli-state');
      if (pill) {
        const ok = st.installed && st.authenticated;
        pill.textContent = !st.installed ? 'not installed' : ok ? (st.mode || 'auth') + ' · ' + (st.version || 'cli') : 'not authenticated';
        pill.className = 'text-[10px] font-bold uppercase tracking-wider rounded-full px-2 py-0.5 border ' +
          (ok ? 'border-[#00ff88]/30 bg-[#00ff88]/10 text-[#00ff88]' : 'border-[#fbbf24]/30 bg-[#fbbf24]/10 text-[#fbbf24]');
      }
      const sel = document.getElementById('scli-plan');
      if (sel && Array.isArray(data?.catalog)) {
        const want = sel.value;
        const options = data.catalog
          .filter(p => p.id !== 'free')
          .map(p => {
            const priced = (p.prices || []).filter(x => x.stripePriceId && Number(x.amount) > 0)
              .map(x => '$' + (Number(x.amount) / 100).toFixed(2) + '/' + (x.billingCycle || 'mo')).join(' · ');
            return '<option value="' + escHtml(p.id) + '">' + escHtml(p.name.replace('HaksterAI ', '')) + (priced ? ' — ' + escHtml(priced) : '') + '</option>';
          }).join('');
        if (options) {
          sel.innerHTML = options;
          if (want) sel.value = want;
          scliPlansLoaded = true;
        }
      }
      const actions = Array.isArray(data?.actions) ? data.actions : [];
      const rows = actions.map(a => {
        const ago = Number.isFinite(Number(a.seconds_ago)) ? fmtAgo(Number(a.seconds_ago)) : '—';
        return '<tr class="border-t border-[#1e1e2e]/60">' +
          '<td class="px-2 py-1 text-[#94a3b8] whitespace-nowrap">' + escHtml(ago) + '</td>' +
          '<td class="px-2 py-1 font-mono text-[#e2e8f0]">' + escHtml(a.action) + '</td>' +
          '<td class="px-2 py-1 text-[#94a3b8]">' + escHtml((a.detail || '').slice(0, 70)) + '</td>' +
          '<td class="px-2 py-1 ' + (a.ok ? 'text-[#00ff88]' : 'text-[#ff4444]') + '">' + escHtml((a.result || '').slice(0, 70)) + '</td>' +
          '</tr>';
      }).join('');
      hkSetTable('scli-rows', rows || '<tr><td colspan="4" class="px-2 py-1 text-[#64748b]">no Stripe actions yet</td></tr>', actions.length > 0);
    }
    async function loadStripeCli(force) {
      try {
        const res = await liveFetch('/api/admin/stripe-cli' + (force ? '?refresh=1' : ''), { headers: authHeaders() });
        if (res.status === 401 || res.status === 403) { hkCachePill('scli-cache', 'stale', 'owner only'); return; }
        if (!res.ok) { hkCachePill('scli-cache', 'stale', 'http ' + res.status); return; }
        hkCacheSeen('scli-cache', res);
        renderStripeCli(await res.json());
      } catch {
        hkCachePill('scli-cache', 'stale', 'retrying');
      }
    }
    async function runStripeCli(args) {
      const out = document.getElementById('scli-output');
      const meta = document.getElementById('scli-meta');
      if (out) out.textContent = 'running stripe ' + args.join(' ') + ' …';
      if (meta) meta.textContent = 'stripe ' + args.join(' ') + ' · in flight';
      try {
        const res = await fetch('/api/admin/stripe-cli/run', {
          method: 'POST',
          headers: { ...authHeaders(), 'Content-Type': 'application/json' },
          body: JSON.stringify({ args }),
        });
        const data = await res.json().catch(() => ({}));
        const stamped = new Date().toISOString().slice(11, 19) + ' UTC';
        if (out) out.textContent = data.ok ? (data.raw || JSON.stringify(data.data, null, 2) || '(no output)') : ('error: ' + (data.error || ('http ' + res.status)) + (data.stderr ? '\n' + data.stderr : ''));
        if (meta) meta.textContent = 'stripe ' + args.join(' ') + ' · ' + (data.ms || 0) + 'ms · checked ' + stamped;
        if (data.actions) renderStripeCli({ actions: data.actions });
      } catch (e) {
        if (out) out.textContent = 'error: ' + (e.message || 'request failed');
      }
    }
    async function stripePriceAction(mode) {
      if (scliBusy) return;
      const planId = document.getElementById('scli-plan')?.value || '';
      const dollars = Number(document.getElementById('scli-amount')?.value || 0);
      const interval = document.getElementById('scli-interval')?.value || 'month';
      if (!planId || !(dollars > 0)) { scliSetResult('pick a plan and enter a positive amount first', 'bad'); return; }
      const cents = Math.round(dollars * 100);
      const verb = mode === 'add' ? 'Add an extra' : 'Change the';
      if (!confirm(verb + ' price for ' + planId + ' to $' + (cents / 100).toFixed(2) + '/' + interval + '?\n\n' +
        (mode === 'add' ? 'Existing prices are kept and the new one is added.' : 'Existing prices on that Stripe product are archived, and the new price is served immediately.'))) return;
      scliBusy = true;
      scliSetResult('creating the Stripe price and verifying it…');
      try {
        const res = await fetch('/api/admin/stripe-cli/price', {
          method: 'POST',
          headers: { ...authHeaders(), 'Content-Type': 'application/json' },
          body: JSON.stringify({ planId, amountCents: cents, interval, mode, confirm: true }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) { scliSetResult('❌ ' + (data.error || ('http ' + res.status)), 'bad'); return; }
        const live = (data.plan?.prices || []).filter(p => p.stripePriceId).map(p => '$' + (Number(p.amount) / 100).toFixed(2) + '/' + p.billingCycle).join(' · ');
        scliSetResult('✅ ' + data.summary + ' · site now serves: ' + (live || 'no paid price'), 'good');
        const meta = document.getElementById('scli-meta');
        if (meta) meta.textContent = 'price verified against Stripe · ' + new Date().toISOString().slice(11, 19) + ' UTC';
        if (data.actions) renderStripeCli({ actions: data.actions });
        if (data.catalog) renderStripeCli({ catalog: data.catalog, actions: data.actions || [] });
        loadStripeCli();
      } catch (e) {
        scliSetResult('❌ ' + (e.message || 'request failed'), 'bad');
      } finally {
        scliBusy = false;
      }
    }
    async function stripeArchiveAction() {
      if (scliBusy) return;
      const priceId = (document.getElementById('scli-archive-id')?.value || '').trim();
      if (!/^price_/.test(priceId)) { scliSetResult('enter a full price_… id to archive', 'bad'); return; }
      if (!confirm('Archive ' + priceId + ' in Stripe? It stops being offered; past payments are untouched.')) return;
      scliBusy = true;
      try {
        const res = await fetch('/api/admin/stripe-cli/archive', {
          method: 'POST',
          headers: { ...authHeaders(), 'Content-Type': 'application/json' },
          body: JSON.stringify({ priceId, confirm: true }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) { scliSetResult('❌ ' + (data.error || ('http ' + res.status)), 'bad'); return; }
        scliSetResult('✅ ' + data.summary, 'good');
        if (data.actions) renderStripeCli({ actions: data.actions });
        loadStripeCli();
      } catch (e) {
        scliSetResult('❌ ' + (e.message || 'request failed'), 'bad');
      } finally {
        scliBusy = false;
      }
    }
    document.querySelectorAll('.scli-cmd').forEach(btn => {
      btn.addEventListener('click', () => runStripeCli(String(btn.dataset.scli || '').split(' ')));
    });
    const scliChange = document.getElementById('scli-change');
    if (scliChange) scliChange.addEventListener('click', () => stripePriceAction('change'));
    const scliAdd = document.getElementById('scli-add');
    if (scliAdd) scliAdd.addEventListener('click', () => stripePriceAction('add'));
    const scliArchiveBtn = document.getElementById('scli-archive');
    if (scliArchiveBtn) scliArchiveBtn.addEventListener('click', stripeArchiveAction);
    const scliRefreshBtn = document.getElementById('scli-refresh');
    if (scliRefreshBtn) scliRefreshBtn.addEventListener('click', async () => {
      scliSetResult('refreshing the price catalog from Stripe…');
      await loadStripeCli(true);
      scliSetResult('catalog refreshed from Stripe', 'good');
    });
    loadStripeCli();
    window.hkLiveEvery(loadStripeCli);

    // ── Dell Auto Agent panel ─────────────────────────────────────────
    // Opens → POST run (trigger=panel, server throttles 60s). Button → POST
    // (trigger=manual, force). Poll → GET state. All owner-only and read-only.
    const AA_STATE_CLASS = {
      pass: 'bg-[#00ff88]/10 text-[#00ff88] border-[#00ff88]/30',
      warn: 'bg-[#fbbf24]/10 text-[#fbbf24] border-[#fbbf24]/30',
      fail: 'bg-[#ff4444]/10 text-[#ff4444] border-[#ff4444]/30',
      info: 'bg-[#00bfff]/10 text-[#00bfff] border-[#00bfff]/30',
    };
    const AA_DOT = { pass: 'bg-[#00ff88]', warn: 'bg-[#fbbf24]', fail: 'bg-[#ff4444]', info: 'bg-[#00bfff]' };
    function renderAutoAgent(r) {
      if (!r) return;
      const badge = document.getElementById('aa-state');
      if (badge) {
        badge.textContent = r.running ? 'running' : (r.state || 'idle');
        badge.className = 'text-[10px] font-bold uppercase tracking-wider rounded-full px-2 py-0.5 border ' + (AA_STATE_CLASS[r.state] || 'border-[#1e1e2e] bg-[#111118] text-[#64748b]');
      }
      const when = r.finishedAt || r.startedAt || '';
      const changed = (r.changed || []).length ? ' · changed: ' + r.changed.join(', ') : '';
      setText('aa-meta', r.trigger ? `${r.trigger} · ${when ? new Date(when).toLocaleTimeString() : '—'} · ${r.durationMs || 0}ms${r.reused ? ' · cached' : ''}${changed}` : (r.history ? 'waiting for first run…' : ''));

      const wrap = document.getElementById('aa-checks');
      if (wrap && Array.isArray(r.checks) && r.checks.length) {
        wrap.innerHTML = r.checks.map((c) => `
          <div class="bg-[#111118] border border-[#1e1e2e] rounded-lg px-3 py-2">
            <div class="flex items-center gap-1.5">
              <span class="inline-block h-1.5 w-1.5 rounded-full ${AA_DOT[c.state] || 'bg-[#64748b]'}"></span>
              <span class="text-[10px] uppercase tracking-wider text-[#64748b]">${escapeHtml(c.label || c.id)}</span>
            </div>
            <div class="mt-0.5 text-[11px] ${c.state === 'fail' ? 'text-[#ff4444]' : c.state === 'warn' ? 'text-[#fbbf24]' : 'text-[#cbd5e1]'}">${escapeHtml(c.detail || '—')}</div>
          </div>`).join('');
      }

      const ip = r.ip || {};
      setText('aa-ip-window', ip.windowHours ? `last ${ip.windowHours}h · ${ip.events || 0} events · ${ip.uniqueIps || 0} IPs` : '');
      setText('aa-ip-fail', String(ip.failures ?? '—'));
      setText('aa-ip-ok', String(ip.successes ?? '—'));
      setText('aa-ip-invalid', String(ip.invalidUsers ?? '—'));
      setText('aa-ip-unique', String(ip.uniqueIps ?? '—'));
      setText('aa-ip-web', String(ip.webIps ?? '—'));
      setText('aa-ip-denied', String((ip.denials || []).length));
      const anomsEl = document.getElementById('aa-ip-anoms');
      if (anomsEl) {
        const fresh = (ip.newAnomalies || []).length;
        anomsEl.textContent = fresh ? `${fresh} new anomal${fresh === 1 ? 'y' : 'ies'}` : `${ip.pendingAnomalies || 0} pending · baseline ${ip.baseline ? ip.baseline.events + ' events' : 'learning'}`;
        anomsEl.className = 'ml-auto text-[11px] ' + (fresh ? 'text-[#fbbf24]' : 'text-[#64748b]');
      }

      const rows = document.getElementById('aa-ip-rows');
      if (rows) {
        const failRows = ip.topFailureIps || [];
        const useRows = failRows.length ? failRows : (ip.successIps || []);
        rows.innerHTML = useRows.length
          ? useRows.slice(0, 6).map((x) => `
            <tr class="border-t border-[#1e1e2e]">
              <td class="px-2 py-1 font-mono text-[#e2e8f0]">${escapeHtml(x.ip)}</td>
              <td class="px-2 py-1 text-[#fbbf24]">${Number(x.count || 0)}</td>
              <td class="px-2 py-1 text-[#94a3b8] truncate max-w-[160px]">${escapeHtml((x.users || []).join(', ') || '—')}</td>
              <td class="px-2 py-1 text-[#64748b] font-mono">${escapeHtml(String(x.lastTs || '').slice(0, 19).replace('T', ' '))}</td>
              <td class="px-2 py-1">${x.public ? '<span class="text-[#ff4444]">public</span>' : '<span class="text-[#64748b]">private/LAN</span>'}</td>
            </tr>`).join('')
          : '<tr><td colspan="5" class="px-2 py-2 text-[#64748b] text-center">No failed logins in the window</td></tr>';
      }

      const anomList = document.getElementById('aa-ip-anoms-list');
      if (anomList) {
        anomList.textContent = (ip.newAnomalies || []).length
          ? '⚠ ' + (ip.newAnomalies || []).map((a) => a.reason || a.title || a.type || JSON.stringify(a)).slice(0, 3).join(' · ')
          : '';
      }
      const logged = document.getElementById('aa-logged');
      if (logged) {
