  <script is:inline data-cfasync="false">
    function fmtNum(n) {
      n = Number(n || 0);
      if (n > 1000000) return (n / 1000000).toFixed(1) + 'M';
      if (n > 1000) return (n / 1000).toFixed(1) + 'K';
      return n.toLocaleString();
    }
    function setText(id, value) {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    }

    // ── live cards: one refresh per second ───────────────────────────────
    // Every card on this page refreshes on a 1s beat. The wrapper makes an
    // in-flight refresh a no-op (a slow endpoint can never stack up requests),
    // pauses every tick while the tab is hidden, and staggers start offsets so
    // ten cards do not all fire in the same millisecond.
    window.hkLiveEvery = window.hkLiveEvery || (function () {
      let seq = 0;
      return function hkLiveEvery(fn, ms) {
        const period = Number(ms) > 0 ? Number(ms) : 1000;
        const offset = (seq++ * 85) % 1000;
        let inflight = false;
        const tick = async () => {
          if (document.visibilityState !== 'visible' || inflight) return;
          inflight = true;
          try { await fn(); } catch (_) {} finally { inflight = false; }
        };
        setTimeout(() => { tick(); setInterval(tick, period); }, offset);
        return tick;
      };
    })();

    // Billing log — every payment the Stripe webhook confirmed, plus new
    // customers, with UTC timestamps so the owner can reconcile against Stripe.
    function renderBilling(billing) {
      if (!billing) return;
      const money = (n, c) => (String(c || 'usd').toUpperCase()) + ' ' + Number(n || 0).toFixed(2);
      const totals = billing.totals || {};
      setText('bill-total', money(totals.amount));
      setText('bill-30d', money(totals.amount30d) + ' · ' + fmtNum(totals.count30d));
      setText('bill-count', fmtNum(totals.count));
      setText('bill-signups', fmtNum(billing.signups7d));
      const rows = (billing.payments || []).map((p) => {
        const ts = p.completed_at || p.created_at;
        const when = ts ? new Date(ts * 1000).toISOString().replace('T', ' ').slice(0, 19) : '—';
        return `<tr class="border-t border-[#1e1e2e]">
          <td class="py-1 pr-2 whitespace-nowrap text-[#94a3b8]">${escHtml(when)}</td>
          <td class="py-1 pr-2 truncate max-w-[200px] text-[#e2e8f0]">${escHtml(p.email || p.username || p.user_id)}</td>
          <td class="py-1 pr-2 text-[#c084fc] whitespace-nowrap">${escHtml(p.plan)}</td>
          <td class="py-1 pr-2 text-[#00ff88] whitespace-nowrap">${escHtml(money(p.amount, p.currency))}</td>
          <td class="py-1 pr-2 text-[#94a3b8] whitespace-nowrap">${escHtml(p.status)}</td>
          <td class="py-1 truncate max-w-[170px] text-[#64748b]" title="${escHtml(p.provider_id || '')}">${escHtml(p.provider_id || '—')}</td>
        </tr>`;
      }).join('');
      const body = document.getElementById('bill-rows');
      if (body) body.innerHTML = rows;
      const empty = document.getElementById('bill-empty');
      if (empty) empty.classList.toggle('hidden', Boolean(rows));
    }
    // Usage & resets — daily / weekly / monthly windows plus per-account plan
    // windows. Every number comes from /api/usage/admin; nothing is estimated.
    function durationUntil(sec) {
      const ms = Number(sec || 0) * 1000 - Date.now();
      if (!Number.isFinite(ms) || ms <= 0) return 'now';
      const mins = Math.floor(ms / 60000);
      const hours = Math.floor(mins / 60);
      const days = Math.floor(hours / 24);
      if (days > 0) return days + 'd ' + (hours % 24) + 'h';
      if (hours > 0) return hours + 'h ' + (mins % 60) + 'm';
      return mins + 'm';
    }
    function utcStamp(sec) {
      if (!sec) return '—';
