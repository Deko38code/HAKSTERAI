<script is:inline>
async function loadLicenses() {
 try {
 const resp = await fetch('/api/admin/licenses');
 const data = await resp.json();
 if (!data.licenses) { document.getElementById('license-table-body').innerHTML = '<tr><td colspan="7" class="text-center text-[#64748b] py-8">No licenses yet</td></tr>'; return; }

 const stats = data.stats || {};
 document.getElementById('lic-total').textContent = stats.total || 0;
 document.getElementById('lic-active').textContent = stats.active || 0;
 document.getElementById('lic-pro').textContent = stats.pro || 0;
 document.getElementById('lic-revenue').textContent = '$' + (stats.revenue || 0).toFixed(2);
 document.getElementById('license-count-badge').textContent = (stats.total || 0) + ' total';

 const tbody = document.getElementById('license-table-body');
 tbody.innerHTML = data.licenses.map(l => `
 <tr class="border-b border-[#1e1e2e]/50 hover:bg-[#0a0a0f]/50">
 <td class="py-2 px-3 font-mono text-xs text-[#22d3ee]">${l.key}</td>
 <td class="py-2 px-3 text-[#94a3b8]">${l.email}</td>
 <td class="py-2 px-3"><span class="text-xs px-2 py-0.5 rounded-full ${l.plan === 'enterprise' ? 'bg-[#fbbf24]/10 text-[#fbbf24]' : l.plan === 'pro' ? 'bg-[#a78bfa]/10 text-[#a78bfa]' : 'bg-[#22d3ee]/10 text-[#22d3ee]'}">${l.plan}</span></td>
 <td class="py-2 px-3 text-[#94a3b8]">${l.machines_used || 0}/${l.max_machines}</td>
 <td class="py-2 px-3">${l.active ? '<span class="text-xs text-green-400">● Active</span>' : '<span class="text-xs text-red-400">● Inactive</span>'}</td>
 <td class="py-2 px-3 text-[#64748b] text-xs">${l.created_at || ''}</td>
 <td class="py-2 px-3">
 ${l.active ? `<button onclick="deactivateLicense('${l.key}')" class="text-xs text-red-400 hover:text-red-300">Deactivate</button>` : '<span class="text-xs text-[#64748b]">—</span>'}
 </td>
 </tr>
 `).join('');
 } catch (e) {
 document.getElementById('license-table-body').innerHTML = '<tr><td colspan="7" class="text-center text-red-400 py-8">Failed to load</td></tr>';
 }
}

async function deactivateLicense(key) {
 if (!confirm('Deactivate license ' + key + '?')) return;
 try {
 await fetch('/api/admin/licenses/deactivate', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ key }) });
 loadLicenses();
 } catch (e) { alert('Failed to deactivate'); }
}

async function generateManualLicense() {
 const email = document.getElementById('manual-email').value.trim();
 const plan = document.getElementById('manual-plan').value;
 if (!email) { alert('Enter an email'); return; }
 try {
 const resp = await fetch('/api/admin/licenses/create', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ email, plan }) });
 const data = await resp.json();
 if (data.key) {
 document.getElementById('manual-key').textContent = data.key;
 document.getElementById('manual-result').classList.remove('hidden');
 loadLicenses();
 } else { alert(data.error || 'Failed to generate'); }
 } catch (e) { alert('Error: ' + e.message); }
}

function copyManualKey() {
 const key = document.getElementById('manual-key').textContent;
 navigator.clipboard.writeText(key);
}

// Load on page load
loadLicenses();
setInterval(loadLicenses, 30000); // refresh every 30s
</script>

</Layout>
