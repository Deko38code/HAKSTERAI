---
import Layout from '../layouts/Layout.astro';
---

<Layout title="haksterAi Dashboard">
  <div class="min-h-screen pt-[60px] bg-[#0a0a0f] text-[#e2e8f0] px-4 py-6 max-w-7xl mx-auto">
    <!-- Breadcrumb nav -->
    <nav class="flex items-center gap-2 text-xs text-[#64748b] mb-4">
      <a href="/" class="hover:text-[#7c3aed] transition-colors">🏠 Home</a>
      <span>›</span>
      <span class="text-[#7c3aed] font-medium">📊 Dashboard</span>
    </nav>

    <div class="flex items-center gap-3 mb-6">
      <div class="w-2 h-8 bg-[#7c3aed] rounded-full"></div>
      <h1 class="text-2xl font-bold tracking-tight">📊 Dashboard</h1>
      <span class="text-xs text-[#64748b] bg-[#111118] px-2 py-1 rounded-full border border-[#1e1e2e]" id="status-badge">connecting...</span>
      <a href="/" class="ml-auto text-xs bg-[#111118] text-[#cbd5e1] hover:text-[#7c3aed] hover:bg-[#1e1e2e] px-3 py-1.5 rounded-lg border border-[#1e1e2e] hover:border-[#7c3aed]/40 transition-colors flex items-center gap-1.5">
        🏠 Home
      </a>
      <a href="/terminal" class="text-xs bg-[#7c3aed]/20 text-[#7c3aed] hover:bg-[#7c3aed]/30 px-3 py-1.5 rounded-lg border border-[#7c3aed]/30 transition-colors flex items-center gap-1.5">
        ⌨️ Open Terminal
      </a>
      <button
        type="button"
        onclick="window.open('/admin/users','haksterAdminUsers','width=1200,height=800,scrollbars=yes,resizable=yes')"
        class="text-xs bg-[#ef4444]/10 text-[#ef4444] hover:bg-[#ef4444]/20 px-3 py-1.5 rounded-lg border border-[#ef4444]/30 transition-colors flex items-center gap-1.5"
      >
        👤 Users
      </button>
    </div>

    <!-- Quick nav tabs -->
    <div class="flex gap-2 mb-6 overflow-x-auto pb-2">
      <button onclick="document.getElementById('hakster-section').scrollIntoView({behavior:'smooth',block:'start'})" class="text-xs bg-[#7c3aed]/10 text-[#7c3aed] border border-[#7c3aed]/30 px-3 py-1.5 rounded-lg hover:bg-[#7c3aed]/20 transition-colors whitespace-nowrap">🧠 haksterAi Stats</button>
      <button onclick="document.getElementById('tools-section').scrollIntoView({behavior:'smooth',block:'start'})" class="text-xs bg-[#111118] text-[#64748b] border border-[#1e1e2e] px-3 py-1.5 rounded-lg hover:bg-[#1e1e2e] transition-colors whitespace-nowrap">🔧 Tool Breakdown</button>
      <button onclick="document.getElementById('system-section').scrollIntoView({behavior:'smooth',block:'start'})" class="text-xs bg-[#111118] text-[#64748b] border border-[#1e1e2e] px-3 py-1.5 rounded-lg hover:bg-[#1e1e2e] transition-colors whitespace-nowrap">💻 System Info</button>
 <button onclick="document.getElementById('license-section').scrollIntoView({behavior:'smooth',block:'start'})" class="text-xs bg-[#111118] text-[#64748b] border border-[#1e1e2e] px-3 py-1.5 rounded-lg hover:bg-[#1e1e2e] transition-colors whitespace-nowrap">🔑 Licenses</button>
      <button onclick="document.getElementById('terminal-section').scrollIntoView({behavior:'smooth',block:'start'})" class="text-xs bg-[#111118] text-[#64748b] border border-[#1e1e2e] px-3 py-1.5 rounded-lg hover:bg-[#1e1e2e] transition-colors whitespace-nowrap">⌨️ Terminal</button>
      <button onclick="document.getElementById('services-section').scrollIntoView({behavior:'smooth',block:'start'})" class="text-xs bg-[#111118] text-[#64748b] border border-[#1e1e2e] px-3 py-1.5 rounded-lg hover:bg-[#1e1e2e] transition-colors whitespace-nowrap">📡 Services</button>
      <button onclick="document.getElementById('providers-section').scrollIntoView({behavior:'smooth',block:'start'})" class="text-xs bg-[#111118] text-[#64748b] border border-[#1e1e2e] px-3 py-1.5 rounded-lg hover:bg-[#1e1e2e] transition-colors whitespace-nowrap">🧪 Providers</button>
      <button onclick="document.getElementById('skills-tools-section').scrollIntoView({behavior:'smooth',block:'start'})" class="text-xs bg-[#111118] text-[#64748b] border border-[#1e1e2e] px-3 py-1.5 rounded-lg hover:bg-[#1e1e2e] transition-colors whitespace-nowrap">🧩 Skills &amp; Tools</button>
    </div>

    <!-- Top Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-6" id="top-stats">
      <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-4 hover:border-[#7c3aed]/40 transition-colors">
        <div class="text-xs text-[#64748b] uppercase tracking-wider mb-1">📨 Requests</div>
        <div class="text-2xl font-bold text-[#7c3aed]" id="stat-requests">—</div>
      </div>
      <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-4 hover:border-[#7c3aed]/40 transition-colors">
        <div class="text-xs text-[#64748b] uppercase tracking-wider mb-1">💬 Output Tokens</div>
        <div class="text-2xl font-bold text-[#00ff88]" id="stat-toolcalls">—</div>
      </div>
      <div class="text-xs text-[#64748b] uppercase tracking-wider mb-1 hidden">Tokens</div>
      <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-4 hover:border-[#7c3aed]/40 transition-colors">
        <div class="text-xs text-[#64748b] uppercase tracking-wider mb-1">🔢 Tokens</div>
        <div class="text-2xl font-bold text-[#ffd700]" id="stat-tokens">—</div>
      </div>
      <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-4 hover:border-[#7c3aed]/40 transition-colors">
        <div class="text-xs text-[#64748b] uppercase tracking-wider mb-1">💬 Sessions</div>
        <div class="text-2xl font-bold text-[#00bfff]" id="stat-sessions">—</div>
      </div>
      <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-4 hover:border-[#7c3aed]/40 transition-colors">
        <div class="text-xs text-[#64748b] uppercase tracking-wider mb-1">✉️ Messages</div>
        <div class="text-2xl font-bold text-[#ff6bff]" id="stat-messages">—</div>
      </div>
      <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-4 hover:border-[#7c3aed]/40 transition-colors">
        <div class="text-xs text-[#64748b] uppercase tracking-wider mb-1">🎨 Artifacts</div>
        <div class="text-2xl font-bold text-[#ff6b6b]" id="stat-artifacts">—</div>
      </div>
    </div>

    <!-- haksterAi Stats Row -->
    <div id="hakster-section" class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3 mb-6">
      <div class="bg-[#111118] border border-[#7c3aed]/30 rounded-xl p-4 hover:border-[#7c3aed]/60 transition-colors col-span-2 sm:col-span-1">
        <div class="text-xs text-[#7c3aed] uppercase tracking-wider mb-1 font-semibold">🧠 haksterAi Sessions</div>
        <div class="text-2xl font-bold text-[#a855f7]" id="crush-sessions">—</div>
      </div>
      <div class="bg-[#111118] border border-[#7c3aed]/30 rounded-xl p-4 hover:border-[#7c3aed]/60 transition-colors">
        <div class="text-xs text-[#7c3aed] uppercase tracking-wider mb-1 font-semibold">🔧 Commands Used</div>
        <div class="text-2xl font-bold text-[#00ff88]" id="crush-tools-used">—</div>
      </div>
      <div class="bg-[#111118] border border-[#7c3aed]/30 rounded-xl p-4 hover:border-[#7c3aed]/60 transition-colors">
        <div class="text-xs text-[#7c3aed] uppercase tracking-wider mb-1 font-semibold">⚡ Unique Commands</div>
        <div class="text-2xl font-bold text-[#ffd700]" id="crush-unique-tools">—</div>
      </div>
      <div class="bg-[#111118] border border-[#7c3aed]/30 rounded-xl p-4 hover:border-[#7c3aed]/60 transition-colors">
        <div class="text-xs text-[#7c3aed] uppercase tracking-wider mb-1 font-semibold">💭 Reasoning</div>
        <div class="text-2xl font-bold text-[#00bfff]" id="crush-reasoning">—</div>
      </div>
      <div class="bg-[#111118] border border-[#7c3aed]/30 rounded-xl p-4 hover:border-[#7c3aed]/60 transition-colors">
        <div class="text-xs text-[#7c3aed] uppercase tracking-wider mb-1 font-semibold">📝 Files</div>
        <div class="text-2xl font-bold text-[#ff6bff]" id="crush-files">—</div>
      </div>
      <div class="bg-[#111118] border border-[#7c3aed]/30 rounded-xl p-4 hover:border-[#7c3aed]/60 transition-colors">
        <div class="text-xs text-[#7c3aed] uppercase tracking-wider mb-1 font-semibold">🪙 Prompt Tokens</div>
        <div class="text-2xl font-bold text-[#ff6b6b]" id="crush-prompt-tokens">—</div>
      </div>
      <div class="bg-[#111118] border border-[#7c3aed]/30 rounded-xl p-4 hover:border-[#7c3aed]/60 transition-colors">
        <div class="text-xs text-[#7c3aed] uppercase tracking-wider mb-1 font-semibold">🧾 Completion Tokens</div>
        <div class="text-2xl font-bold text-[#7c3aed]" id="crush-completion-tokens">—</div>
      </div>
    </div>

    <!-- haksterAi Tool Breakdown -->
    <div id="tools-section" class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-5 mb-6" style="display:none">
      <h2 class="text-sm font-semibold text-[#7c3aed] uppercase tracking-wider mb-4 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.056 2.154-1.056 2.58 0a1.724 1.724 0 002.573 1.066c1.005-.482 2.17.378 1.93 1.448a1.724 1.724 0 001.056 2.573c1.056.426 1.056 2.154 0 2.58a1.724 1.724 0 00-1.066 2.573c.482 1.005-.378 2.17-1.448 1.93a1.724 1.724 0 00-2.573 1.056c-.426 1.056-2.154 1.056-2.58 0a1.724 1.724 0 00-2.573-1.066c-1.005.482-2.17-.378-1.93-1.448a1.724 1.724 0 00-1.056-2.573c-1.056-.426-1.056-2.154 0-2.58a1.724 1.724 0 001.066-2.573c-.482-1.005.378-2.17 1.448-1.93a1.724 1.724 0 002.573-1.056z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        haksterAi Tool Breakdown
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3" id="crush-tools-grid"></div>
    </div>

    <!-- Skills, Tools & Models -->
    <div id="skills-tools-section" class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-5 mb-6">
      <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
        <h2 class="text-sm font-semibold text-[#7c3aed] uppercase tracking-wider flex items-center gap-2">
          🧩 Skills, Tools &amp; Models
        </h2>
        <div class="flex gap-1.5">
          <button onclick="switchStmTab('browse')" data-tab="browse" class="stm-tab text-xs bg-[#7c3aed]/10 text-[#7c3aed] border border-[#7c3aed]/30 px-3 py-1.5 rounded-lg transition-colors">👀 Browse</button>
          <button onclick="switchStmTab('create')" data-tab="create" class="stm-tab text-xs bg-[#111118] text-[#64748b] border border-[#1e1e2e] px-3 py-1.5 rounded-lg transition-colors">➕ Create</button>
        </div>
      </div>

      <!-- Browse panel -->
      <div id="stm-browse-panel" class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div>
          <div class="text-xs text-[#64748b] uppercase tracking-wider mb-2">📚 Skills (<span id="stm-skills-count">0</span>)</div>
          <input id="stm-skills-filter" type="text" placeholder="Filter skills..." class="w-full mb-2 rounded-lg border border-[#1e1e2e] bg-[#0a0a0f] px-2 py-1.5 text-xs text-[#e2e8f0] outline-none focus:border-[#7c3aed]/50" />
          <div id="stm-skills-list" class="space-y-1 max-h-[320px] overflow-auto">
            <div class="text-xs text-[#64748b] text-center py-4">Loading...</div>
          </div>
        </div>
        <div>
          <div class="text-xs text-[#64748b] uppercase tracking-wider mb-2">🔧 Tools (<span id="stm-tools-count">0</span>)</div>
          <input id="stm-tools-filter" type="text" placeholder="Filter tools..." class="w-full mb-2 rounded-lg border border-[#1e1e2e] bg-[#0a0a0f] px-2 py-1.5 text-xs text-[#e2e8f0] outline-none focus:border-[#7c3aed]/50" />
          <div id="stm-tools-list" class="space-y-1 max-h-[320px] overflow-auto">
            <div class="text-xs text-[#64748b] text-center py-4">Loading...</div>
          </div>
        </div>
        <div>
          <div class="text-xs text-[#64748b] uppercase tracking-wider mb-2">🤖 Models</div>
          <select id="stm-browse-provider" class="w-full mb-2 rounded-lg border border-[#1e1e2e] bg-[#0a0a0f] px-2 py-1.5 text-xs text-[#e2e8f0] outline-none focus:border-[#7c3aed]/50">
            <option value="">Select provider...</option>
          </select>
          <div id="stm-models-list" class="space-y-1 max-h-[280px] overflow-auto">
            <div class="text-xs text-[#64748b] text-center py-4">Pick a provider</div>
          </div>
        </div>
      </div>

      <!-- Create panel -->
      <div id="stm-create-panel" class="hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div class="space-y-3">
            <div>
              <label class="block text-xs text-[#64748b] uppercase tracking-wider mb-1">Cluster Name</label>
              <input id="stm-cluster-name" type="text" placeholder="e.g. Recon Squad" class="w-full rounded-lg border border-[#1e1e2e] bg-[#0a0a0f] px-3 py-2 text-sm text-[#e2e8f0] outline-none focus:border-[#7c3aed]/50" />
            </div>
            <div>
              <label class="block text-xs text-[#64748b] uppercase tracking-wider mb-1">Provider</label>
              <select id="stm-create-provider" class="w-full rounded-lg border border-[#1e1e2e] bg-[#0a0a0f] px-3 py-2 text-sm text-[#e2e8f0] outline-none focus:border-[#7c3aed]/50">
                <option value="">Select provider...</option>
              </select>
            </div>
            <div>
              <label class="block text-xs text-[#64748b] uppercase tracking-wider mb-1">Model</label>
              <select id="stm-create-model" class="w-full rounded-lg border border-[#1e1e2e] bg-[#0a0a0f] px-3 py-2 text-sm text-[#e2e8f0] outline-none focus:border-[#7c3aed]/50">
                <option value="">Select provider first...</option>
              </select>
            </div>
            <div>
              <label class="block text-xs text-[#64748b] uppercase tracking-wider mb-1">Notes / Memory Context</label>
              <textarea id="stm-cluster-notes" rows="3" placeholder="Optional context to remember for this cluster..." class="w-full rounded-lg border border-[#1e1e2e] bg-[#0a0a0f] px-3 py-2 text-sm text-[#e2e8f0] outline-none focus:border-[#7c3aed]/50 resize-none"></textarea>
            </div>
          </div>
          <div class="space-y-3">
            <div>
              <label class="block text-xs text-[#64748b] uppercase tracking-wider mb-1">Tools (multi-select)</label>
              <select id="stm-create-tools" multiple size="6" class="w-full rounded-lg border border-[#1e1e2e] bg-[#0a0a0f] px-2 py-2 text-xs text-[#e2e8f0] outline-none focus:border-[#7c3aed]/50"></select>
            </div>
            <div>
              <label class="block text-xs text-[#64748b] uppercase tracking-wider mb-1">Skills (multi-select)</label>
              <select id="stm-create-skills" multiple size="6" class="w-full rounded-lg border border-[#1e1e2e] bg-[#0a0a0f] px-2 py-2 text-xs text-[#e2e8f0] outline-none focus:border-[#7c3aed]/50"></select>
            </div>
          </div>
        </div>
        <div class="flex items-center mt-4">
          <button id="stm-save-cluster" class="rounded-lg bg-[#7c3aed] hover:bg-[#6d28d9] text-white text-sm font-semibold py-2 px-4 transition-all active:scale-95">💾 Save Cluster</button>
          <span id="stm-save-status" class="ml-3 text-xs text-[#64748b]"></span>
        </div>

        <div class="mt-6">
          <div class="text-xs text-[#64748b] uppercase tracking-wider mb-2">📦 Saved Clusters</div>
          <div id="stm-clusters-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <div class="text-xs text-[#64748b] text-center py-4 col-span-full">No clusters yet</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Memory Bank & Autocompact -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">
      <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-5">
        <h2 class="text-sm font-semibold text-[#7c3aed] uppercase tracking-wider mb-4 flex items-center gap-2">🧠 Memory Bank</h2>
        <div class="space-y-2">
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">Total Memories</span><span id="mem-total" class="font-bold text-[#a855f7]">—</span></div>
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">Categories</span><span id="mem-categories" class="text-[#00ff88]">—</span></div>
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">Last Compact</span><span id="mem-last-compact" class="text-xs text-[#ffd700]">—</span></div>
        </div>
        <div class="mt-3">
          <div class="flex justify-between text-xs text-[#64748b] mb-1"><span>📦 Context Usage</span><span id="mem-context-pct">—</span></div>
          <div class="w-full h-2 bg-[#1e1e2e] rounded-full overflow-hidden">
            <div id="mem-context-bar" class="h-full bg-gradient-to-r from-[#00ff88] to-[#ffd700] rounded-full transition-all duration-500" style="width:0%"></div>
          </div>
        </div>
      </div>
      <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-5">
        <h2 class="text-sm font-semibold text-[#7c3aed] uppercase tracking-wider mb-4 flex items-center gap-2">⏰ Autocompact Clock</h2>
        <div class="space-y-2">
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">Next Compact</span><span id="compact-next" class="font-bold text-[#00bfff]">—</span></div>
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">Interval</span><span class="text-[#ffd700]">Every 15 min</span></div>
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">Status</span><span id="compact-status" class="text-[#00ff88]">Idle</span></div>
        </div>
        <button id="compact-now-btn" class="mt-3 w-full rounded-lg bg-[#7c3aed]/20 hover:bg-[#7c3aed]/30 border border-[#7c3aed]/30 text-[#7c3aed] text-sm font-semibold py-2 px-4 transition-all active:scale-95">Compact Now</button>
      </div>
      <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-5">
        <h2 class="text-sm font-semibold text-[#7c3aed] uppercase tracking-wider mb-4 flex items-center gap-2">🛡️ Security Health</h2>
        <div class="space-y-2">
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">Critical</span><span id="sec-critical" class="font-bold text-[#ff4444]">—</span></div>
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">High</span><span id="sec-high" class="text-[#ff6b6b]">—</span></div>
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">Medium</span><span id="sec-medium" class="text-[#ffd700]">—</span></div>
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">Low</span><span id="sec-low" class="text-[#00ff88]">—</span></div>
        </div>
        <a href="/build" class="mt-3 block text-center w-full rounded-lg bg-[#7c3aed]/20 hover:bg-[#7c3aed]/30 border border-[#7c3aed]/30 text-[#7c3aed] text-sm font-semibold py-2 px-4 transition-all">View Full Audit</a>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
      <!-- System Info -->
      <div id="system-section" class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-5">
        <h2 class="text-sm font-semibold text-[#7c3aed] uppercase tracking-wider mb-4 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          💻 System
        </h2>
        <div class="space-y-2" id="system-info">
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">🖥️ Host</span><span id="sys-host">—</span></div>
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">💾 Platform</span><span id="sys-platform">—</span></div>
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">⚡ CPUs</span><span id="sys-cpus">—</span></div>
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">🧠 RAM</span><span id="sys-ram">—</span></div>
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">⏱️ Uptime</span><span id="sys-uptime">—</span></div>
          <!-- Memory bar -->
          <div class="mt-3">
            <div class="flex justify-between text-xs text-[#64748b] mb-1"><span>📊 Memory Usage</span><span id="mem-pct">—</span></div>
            <div class="w-full h-2 bg-[#1e1e2e] rounded-full overflow-hidden">
              <div id="mem-bar" class="h-full bg-gradient-to-r from-[#7c3aed] to-[#a855f7] rounded-full transition-all duration-500" style="width:0%"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- haksterAi Terminal -->
      <div id="terminal-section" class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-5">
        <h2 class="text-sm font-semibold text-[#7c3aed] uppercase tracking-wider mb-4 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          haksterAi Terminal
        </h2>
        <div class="space-y-2" id="crush-info">
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">🤖 Model</span><span id="crush-model" class="text-[#00ff88] font-mono">—</span></div>
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">📡 Provider</span><span id="crush-provider">—</span></div>
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">🏷️ Version</span><span id="crush-version" class="font-mono">—</span></div>
          <div class="flex justify-between text-sm"><span class="text-[#64748b]">🟢 Status</span><span id="crush-status" class="text-[#ffd700]">—</span></div>
        </div>
        <div id="crush-update-banner" class="hidden mt-3 p-3 rounded-lg bg-[#7c3aed]/10 border border-[#7c3aed]/30 text-sm">
          <div class="flex items-center justify-between">
            <div>
              <span class="text-[#7c3aed] font-semibold">haksterAi Update!</span>
              <span id="crush-update-versions" class="text-[#64748b] ml-2"></span>
            </div>
            <a id="crush-update-link" href="#" target="_blank" class="text-xs bg-[#7c3aed] hover:bg-[#6d28d9] text-white px-3 py-1 rounded-full transition-colors">View Release</a>
          </div>
        </div>
        <a href="/terminal" class="mt-4 w-full flex items-center justify-center gap-2 rounded-lg bg-[#7c3aed] hover:bg-[#6d28d9] text-white text-sm font-semibold py-2.5 px-4 transition-all active:scale-95">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          Open Terminal
        </a>
      </div>
    </div>

    <!-- Services & Ports -->
    <div id="services-section" class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-5 mb-6">
      <h2 class="text-sm font-semibold text-[#7c3aed] uppercase tracking-wider mb-4 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>
        Services &amp; Ports 📡
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" id="services-grid">
        <!-- Populated by JS -->
      </div>
    </div>

    <!-- Providers -->
    <div id="providers-section" class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-5 mb-6">
      <h2 class="text-sm font-semibold text-[#7c3aed] uppercase tracking-wider mb-4 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
        🧪 AI Providers
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" id="providers-grid">
        <!-- Populated by JS -->
      </div>
    </div>

    <!-- Provider Breakdown -->
    <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-5 mb-6">
      <h2 class="text-sm font-semibold text-[#7c3aed] uppercase tracking-wider mb-4 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        📊 Requests by Provider
      </h2>
      <div id="provider-breakdown" class="space-y-3">
      </div>
    </div>

    <!-- Token Usage by Google User -->
    <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-5 mb-6">
      <h2 class="text-sm font-semibold text-[#7c3aed] uppercase tracking-wider mb-4 flex items-center gap-2">
        🔢 Token Usage by Google User
      </h2>
      <div id="user-token-breakdown" class="space-y-3"></div>
    </div>

    <!-- Recent Users & Activity Log -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
      <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-5">
        <h2 class="text-sm font-semibold text-[#7c3aed] uppercase tracking-wider mb-4 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          👥 Recent Users
        </h2>
        <div id="recent-users-list" class="space-y-2 max-h-[400px] overflow-auto">
          <div class="text-sm text-[#64748b] text-center py-4">Loading...</div>
        </div>
      </div>
      <div class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-5">
        <h2 class="text-sm font-semibold text-[#7c3aed] uppercase tracking-wider mb-4 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
          📋 Activity Log
        </h2>
        <div id="activity-log-list" class="space-y-1.5 max-h-[400px] overflow-auto">
          <div class="text-sm text-[#64748b] text-center py-4">Loading...</div>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{}}">
    function fmtNum(n) {
      n = Number(n || 0);
      if (n > 1000000) return (n / 1000000).toFixed(1) + 'M';
      if (n > 1000) return (n / 1000).toFixed(1) + 'K';
      return n.toLocaleString();
    }
    function setText(id, value) {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    }
    function setWidth(id, value) {
      const el = document.getElementById(id);
      if (el) el.style.width = value;
    }
    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, (ch) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      }[ch]));
    }
    function liveUrl(path) {
      const sep = path.includes('?') ? '&' : '?';
      return path + sep + '_=' + Date.now();
    }
    function liveFetch(path, options) {
      return fetch(liveUrl(path), {
        cache: 'no-store',
        ...(options || {}),
        headers: {
          'Cache-Control': 'no-cache',
          ...((options && options.headers) || {}),
        },
      });
    }
    function authHeaders() {
      const token = localStorage.getItem('hakster_google_token');
      return token ? { 'x-api-key': token } : {};
    }
    let dashboardSeq = 0;
    let dashboardRefreshTimer = null;
    function queueDashboardRefresh(delay) {
      clearTimeout(dashboardRefreshTimer);
      dashboardRefreshTimer = setTimeout(() => {
        loadDashboard();
        loadMemoryStats();
        loadRecentUsers();
        loadActivityLog();
      }, delay || 250);
    }
    async function loadDashboard() {
      const seq = ++dashboardSeq;
      try {
        const res = await liveFetch('/api/dashboard?live=1&compact=1', { headers: authHeaders() });
        if (res.status === 401 || res.status === 403) {
          window.location.href = res.status === 403 ? '/portal' : '/';
          return;
        }
        if (!res.ok) throw new Error('dashboard status ' + res.status);
        const data = await res.json();
        if (seq !== dashboardSeq) return;

        // Top stats
        setText('stat-requests', Number(data.requests?.total || 0).toLocaleString());
        setText('stat-toolcalls', fmtNum(data.requests?.outputTokens || 0));
        setText('stat-tokens', fmtNum(data.requests?.totalTokens || 0));
        setText('stat-sessions', Number(data.sessions?.total || 0).toLocaleString());
        setText('stat-messages', Number(data.sessions?.messages || 0).toLocaleString());
        setText('stat-artifacts', Number(data.sessions?.artifacts || 0).toLocaleString());

        // haksterAi stats row
        const cs = data.crush?.stats || {};
        setText('crush-sessions', Number(cs.sessions || 0).toLocaleString());
        setText('crush-tools-used', Number(cs.toolCalls || 0).toLocaleString());
        setText('crush-unique-tools', Number(cs.uniqueTools || 0).toLocaleString());
        setText('crush-reasoning', Number(cs.reasoningSteps || 0).toLocaleString());
        setText('crush-files', Number(cs.files || 0).toLocaleString());
        setText('crush-prompt-tokens', fmtNum(cs.promptTokens || 0));
        setText('crush-completion-tokens', fmtNum(cs.completionTokens || 0));

        // haksterAi tool breakdown
        const toolsGrid = document.getElementById('crush-tools-grid');
        const toolsSection = document.getElementById('tools-section');
        const tb = cs.toolBreakdown || {};
        if (Object.keys(tb).length > 0) {
          toolsSection.style.display = '';
          const toolIcons = {
            ls: '📁', write: '✏️', search: '🔍', grep: '🔎', view: '👁️', bash: '💻',
            read: '📖', edit: '✂️', glob: '🌐', web: '🔗', fetch: '⬇️', list: '📋',
            mkdir: '📂', rm: '🗑️', cp: '📋', mv: '➡️', cat: '🐱', head: '🔝',
            tail: '🔚', diff: '🔀', patch: '🩹', sed: '📝', awk: '📊',
            find: '🔎', tree: '🌳', cd: '🚪', pwd: '📍', echo: '📢',
            curl: '🌀', wget: '⬇️', git: '🔀', docker: '🐳', npm: '📦',
            pip: '🐍', make: '🔨', test: '✅', lint: '🧹', format: '✨',
            deploy: '🚀', build: '🏗️', run: '▶️', exec: '⚡', eval: '🧮',
            sql: '🗃️', api: '🌐', http: '📡', ssh: '🔐', scp: '📤',
            chmod: '🔑', chown: '👤', env: '🌿', export: '📦', source: '📥',
            kill: '💀', ps: '📊', top: '📈', df: '💾', du: '📏',
            ping: '🏓', netstat: '🕸️', ss: '🔌', iptables: '🧱',
          };
          const maxCount = Math.max(...Object.values(tb));
          toolsGrid.innerHTML = Object.entries(tb).sort((a,b) => b[1] - a[1]).map(([name, count]) => {
            const icon = toolIcons[name] || '🔧';
            const pct = maxCount > 0 ? (count / maxCount * 100) : 0;
            return `<div class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg p-3">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium flex items-center gap-1.5">${icon} <span class="font-mono text-xs">${name}</span></span>
                <span class="text-xs text-[#7c3aed] font-bold">${count}×</span>
              </div>
              <div class="w-full h-1.5 bg-[#1e1e2e] rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-[#7c3aed] to-[#a855f7] rounded-full" style="width:${pct}%"></div>
              </div>
            </div>`;
          }).join('');
        }

        // System
        setText('sys-host', data.system?.hostname || 'unknown');
        setText('sys-platform', (data.system?.platform || 'unknown') + ' / ' + (data.system?.arch || 'unknown'));
        setText('sys-cpus', Number(data.system?.cpus || 0).toLocaleString() + ' cores');
        const totalGB = ((data.system?.totalMem || 0) / 1024 / 1024 / 1024).toFixed(1);
        const freeGB = ((data.system?.freeMem || 0) / 1024 / 1024 / 1024).toFixed(1);
        const usedGB = (totalGB - freeGB).toFixed(1);
        setText('sys-ram', usedGB + ' / ' + totalGB + ' GB');
        const uptime = data.system?.uptime || 0;
        const uptimeH = Math.floor(uptime / 3600);
        const uptimeM = Math.floor((uptime % 3600) / 60);
        setText('sys-uptime', uptimeH + 'h ' + uptimeM + 'm');
        const memPct = data.system?.totalMem ? ((1 - data.system.freeMem / data.system.totalMem) * 100).toFixed(0) : 0;
        setText('mem-pct', memPct + '%');
        setWidth('mem-bar', memPct + '%');

        // haksterAi
        setText('crush-model', data.crush?.model || 'unknown');
        setText('crush-provider', data.crush?.provider || 'unknown');
        setText('crush-version', data.crush?.version || 'local');
        setText('crush-status', '✓ connected');
        document.getElementById('crush-status').className = 'text-[#00ff88]';
        document.getElementById('status-badge').textContent = 'live';
        document.getElementById('status-badge').className = 'text-xs text-[#00ff88] bg-[#111118] px-2 py-1 rounded-full border border-[#00ff88]/30';

        // Check for haksterAi updates
        liveFetch('/api/crush-update').then(r => r.json()).then(u => {
          document.getElementById('crush-version').textContent = u.currentVersion || '—';
          if (u.needsUpdate) {
            const banner = document.getElementById('crush-update-banner');
            banner.classList.remove('hidden');
            document.getElementById('crush-update-versions').textContent = `${u.currentVersion} → ${u.latestVersion}`;
            document.getElementById('crush-update-link').href = u.releaseUrl || '#';
          }
        }).catch(() => {});

        // Services
        const servicesGrid = document.getElementById('services-grid');
        const knownDescs = {
          3579: 'Main server',
          11434: 'Local LLM',
          80: 'Web server',
          8081: 'Movie server',
          8888: 'IPTV portal',
          9999: 'IPTV SSL',
          4040: 'Tunnel UI',
          20241: 'CF tunnel',
        };
        const services = (data.services || []).map(s => ({
          ...s,
          desc: s.desc || knownDescs[s.port] || (s.process || ''),
        }));
        const seen = new Set();
        const unique = services.filter(s => {
          const key = [s.protocol || 'tcp', s.port, s.pid || s.process || '', s.bind || ''].join(':');
          if (seen.has(key)) return false;
          seen.add(key);
          return true;
        });
        servicesGrid.innerHTML = unique.sort((a,b) => a.port - b.port).map(s => {
          const statusColor = s.status === 'running' ? 'text-[#00ff88]' : 'text-[#ff4444]';
          const statusBg = s.status === 'running' ? 'bg-[#00ff88]/10 border-[#00ff88]/20' : 'bg-[#ff4444]/10 border-[#ff4444]/20';
          const checked = s.checkedAt ? new Date(s.checkedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : 'now';
          const detail = [s.protocol ? s.protocol.toUpperCase() : 'TCP', s.process || '', s.pid ? `pid ${s.pid}` : ''].filter(Boolean).join(' · ');
          const location = s.cwd || s.command || s.desc || '';
          return `<div class="flex items-center justify-between bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg px-4 py-3">
            <div class="min-w-0 pr-3">
              <div class="text-sm font-medium">${escapeHtml(s.name)}</div>
              <div class="text-xs text-[#64748b] truncate">${escapeHtml(detail)}</div>
              <div class="text-[10px] text-[#4b5563] truncate">${escapeHtml(location)}</div>
            </div>
            <div class="flex flex-col items-end gap-1 shrink-0">
              <span class="font-mono text-xs text-[#ffd700]">${escapeHtml(s.bind || ':' + s.port)}</span>
              <span class="text-xs px-2 py-0.5 rounded-full border ${statusBg} ${statusColor}">${s.status}</span>
              <span class="text-[9px] text-[#4b5563]">${checked}</span>
            </div>
          </div>`;
        }).join('');

        // Providers
        const providersGrid = document.getElementById('providers-grid');
        const provIcons = { ollama: '🦙', anthropic: '🤖', openai: '⚡', openrouter: '🌐', hermes: '🔥', 'claude-proxy': '🔮', codex: '🧠', nous: '✨' };
        providersGrid.innerHTML = data.providers.map(p => {
          const icon = provIcons[p.id] || '🧠';
          const isActive = p.id === data.crush.provider;
          const border = isActive ? 'border-[#7c3aed]' : 'border-[#1e1e2e]';
          const badge = isActive ? '<span class="text-[8px] bg-[#7c3aed] text-white px-1.5 py-0.5 rounded-full ml-2">ACTIVE</span>' : '';
          return `<div class="bg-[#0a0a0f] border ${border} rounded-lg px-4 py-3">
            <div class="flex items-center gap-2">
              <span class="text-lg">${icon}</span>
              <span class="text-sm font-medium">${p.name}${badge}</span>
            </div>
            <div class="text-xs text-[#64748b] mt-1 font-mono">${p.defaultModel}</div>
            <div class="text-xs text-[#4b5563] mt-0.5">${p.type}</div>
          </div>`;
        }).join('');

        // Provider breakdown bars
        const breakdown = document.getElementById('provider-breakdown');
        if (data.requests.byProvider && data.requests.byProvider.length > 0) {
          const maxReqs = Math.max(...data.requests.byProvider.map(p => p.requests));
          breakdown.innerHTML = data.requests.byProvider.map(p => {
            const pct = maxReqs > 0 ? (p.requests / maxReqs * 100) : 0;
            const tokens = ((p.inputTokens || 0) + (p.outputTokens || 0));
            const tokenStr = tokens > 1000000 ? (tokens / 1000000).toFixed(1) + 'M' : tokens > 1000 ? (tokens / 1000).toFixed(1) + 'K' : tokens;
            return `<div>
              <div class="flex justify-between text-sm mb-1">
                <span class="font-medium">${p.provider}</span>
                <span class="text-[#64748b]">${p.requests} requests · ${tokenStr} tokens</span>
              </div>
              <div class="w-full h-2 bg-[#1e1e2e] rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-[#7c3aed] to-[#a855f7] rounded-full transition-all duration-500" style="width:${pct}%"></div>
              </div>
            </div>`;
          }).join('');
        } else {
          breakdown.innerHTML = '<div class="text-sm text-[#64748b] text-center py-4">No requests yet — start a chat or run an agent</div>';
        }

        // Token usage by Google user
        const userBreakdown = document.getElementById('user-token-breakdown');
        if (userBreakdown) {
          const rows = data.requests?.byUser || [];
          if (rows.length > 0) {
            const maxTokens = Math.max(...rows.map(u => (u.inputTokens || 0) + (u.outputTokens || 0)), 1);
            userBreakdown.innerHTML = rows.map(u => {
              const total = (u.inputTokens || 0) + (u.outputTokens || 0);
              const pct = Math.max(2, Math.min(100, (total / maxTokens) * 100));
              const label = u.label || 'unknown user';
              const sub = [u.role || 'user', u.plan || 'free'].join(' · ');
              const last = u.lastUsedAt ? new Date(u.lastUsedAt * 1000).toLocaleString() : 'never';
              return `<div>
                <div class="flex justify-between gap-3 text-sm mb-1">
                  <div class="min-w-0">
                    <div class="font-medium truncate">${escapeHtml(label)}</div>
                    <div class="text-[10px] text-[#64748b] truncate">${escapeHtml(sub)} · ${u.requests || 0} runs · ${u.toolCalls || 0} tools · ${escapeHtml(last)}</div>
                  </div>
                  <div class="text-right shrink-0">
                    <div class="text-[#ffd700] font-mono">${fmtNum(total)}</div>
                    <div class="text-[10px] text-[#64748b]">${fmtNum(u.inputTokens || 0)} in / ${fmtNum(u.outputTokens || 0)} out</div>
                  </div>
                </div>
                <div class="w-full h-2 bg-[#1e1e2e] rounded-full overflow-hidden">
                  <div class="h-full bg-gradient-to-r from-[#ffd700] to-[#7c3aed] rounded-full transition-all duration-500" style="width:${pct}%"></div>
                </div>
              </div>`;
            }).join('');
          } else {
            userBreakdown.innerHTML = '<div class="text-sm text-[#64748b] text-center py-4">No Google-linked token usage yet.</div>';
          }
        }

      } catch (err) {
        console.error('Dashboard load failed:', err);
        document.getElementById('status-badge').textContent = 'error';
        document.getElementById('status-badge').className = 'text-xs text-[#ff4444] bg-[#111118] px-2 py-1 rounded-full border border-[#ff4444]/30';
      }
    }

    loadDashboard();
    // Keep counters live. WebSocket events below trigger immediate refreshes.
    setInterval(loadDashboard, 5000);

    // Memory bank stats
    async function loadMemoryStats() {
      try {
        const res = await liveFetch('/api/memory');
        if (!res.ok) throw new Error('memory status ' + res.status);
        const data = await res.json();
        const entries = data.entries || data.memories || [];
        const stats = data.stats || {};
        const total = Number(stats.total ?? entries.length ?? 0);
        setText('mem-total', total.toLocaleString());
        const categoryCount = Array.isArray(stats.byCategory) ? stats.byCategory.length : new Set(entries.map(e => e.category || 'general')).size;
        setText('mem-categories', categoryCount.toLocaleString());
        setText('mem-last-compact', data.lastCompact || 'Never');
        const pct = Math.min(100, Math.round(Number(stats.contextUsagePct ?? (total / 40) * 100)));
        setText('mem-context-pct', pct + '%');
        setWidth('mem-context-bar', pct + '%');
      } catch {
        setText('mem-total', '0');
        setText('mem-categories', '0');
        setText('mem-last-compact', 'Never');
        setText('mem-context-pct', '0%');
        setWidth('mem-context-bar', '0%');
      }
    }
    loadMemoryStats();
    setInterval(loadMemoryStats, 10000);

    // Autocompact clock
    let compactNextTime = null;
    function updateCompactClock() {
      const now = new Date();
      if (!compactNextTime) compactNextTime = new Date(now.getTime() + 15 * 60000);
      const diff = compactNextTime - now;
      if (diff <= 0) {
        compactNextTime = new Date(now.getTime() + 15 * 60000);
        document.getElementById('compact-status').textContent = 'Compacting...';
        document.getElementById('compact-status').className = 'text-[#ffd700]';
        setTimeout(() => {
          document.getElementById('compact-status').textContent = 'Idle';
          document.getElementById('compact-status').className = 'text-[#00ff88]';
        }, 3000);
      }
      const mins = Math.floor(diff / 60000);
      const secs = Math.floor((diff % 60000) / 1000);
      document.getElementById('compact-next').textContent = mins + 'm ' + secs + 's';
    }
    updateCompactClock();
    setInterval(updateCompactClock, 1000);

    document.getElementById('compact-now-btn')?.addEventListener('click', async () => {
      try {
        document.getElementById('compact-status').textContent = 'Compacting...';
        await liveFetch('/api/memory/compact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
        document.getElementById('compact-status').textContent = 'Done!';
        compactNextTime = new Date(new Date().getTime() + 15 * 60000);
        loadMemoryStats();
        setTimeout(() => { document.getElementById('compact-status').textContent = 'Idle'; }, 3000);
      } catch {}
    });

    // Security health summary
    async function loadSecuritySummary() {
      try {
        const res = await liveFetch('/api/health/security');
        if (!res.ok) throw new Error('security status ' + res.status);
        const data = await res.json();
        const counts = data.summary
          ? { critical: data.summary.critical || 0, high: data.summary.high || 0, medium: data.summary.medium || 0, low: data.summary.low || 0 }
          : { critical: 0, high: 0, medium: 0, low: 0 };
        if (!data.summary) {
          for (const f of data.findings || []) counts[f.severity] = (counts[f.severity] || 0) + 1;
        }
        setText('sec-critical', counts.critical || 0);
        setText('sec-high', counts.high || 0);
        setText('sec-medium', counts.medium || 0);
        setText('sec-low', counts.low || 0);
      } catch {
        setText('sec-critical', '0');
        setText('sec-high', '0');
        setText('sec-medium', '0');
        setText('sec-low', '0');
      }
    }
    loadSecuritySummary();
    setInterval(loadSecuritySummary, 60000);

    // Recent users with IP tracking
    async function loadRecentUsers() {
      try {
        const res = await liveFetch('/api/users/recent?limit=20', { headers: authHeaders() });
        const list = document.getElementById('recent-users-list');
        if (!res.ok) {
          list.innerHTML = '<div class="text-sm text-[#64748b] text-center py-4">Admin sign-in required.</div>';
          return;
        }
        const data = await res.json();
        if (!data.users || data.users.length === 0) {
          list.innerHTML = '<div class="text-sm text-[#64748b] text-center py-4">No users yet</div>';
          return;
        }
        list.innerHTML = data.users.map(u => {
          const created = new Date((u.created_at || 0) * 1000);
          const lastLogin = u.last_login_at ? new Date(u.last_login_at * 1000) : null;
          const isNew = (Date.now() / 1000 - (u.created_at || 0)) < 3600;
          const badge = isNew ? '<span class="text-[8px] bg-[#00ff88]/20 text-[#00ff88] px-1.5 py-0.5 rounded-full ml-1">NEW</span>' : '';
          const statusColor = u.status === 'active' ? 'text-[#00ff88]' : 'text-[#ff4444]';
          const deviceInfo = [u.last_device, u.last_os, u.last_browser].filter(Boolean).join(' · ') || '—';
          return `<div class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg p-3 hover:border-[#7c3aed]/30 transition-colors">
            <div class="flex items-center justify-between mb-1">
              <div class="flex items-center gap-2">
                <span class="text-sm font-medium text-white/80">${escapeHtml(u.username)}${badge}</span>
                <span class="text-[8px] ${statusColor} px-1.5 py-0.5 rounded-full bg-[#1e1e2e]">${escapeHtml(u.status)}</span>
              </div>
              <span class="text-[10px] text-[#64748b]">${created.toLocaleDateString()} ${created.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})}</span>
            </div>
            <div class="text-xs text-[#64748b]">${escapeHtml(u.email || '—')}</div>
            <div class="flex items-center justify-between mt-1.5 text-[10px] text-[#4b5563]">
              <span>🌐 ${escapeHtml(u.last_ip || u.last_login_ip || '—')}</span>
              <span>📱 ${escapeHtml(deviceInfo)}</span>
            </div>
            <div class="flex items-center justify-between mt-1 text-[10px] text-[#4b5563]">
              <span>🔑 ${u.login_count || 0} logins</span>
              <span>⏱️ ${lastLogin ? lastLogin.toLocaleDateString() + ' ' + lastLogin.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) : 'Never'}</span>
            </div>
          </div>`;
        }).join('');
      } catch (e) {
        console.error('Recent users load failed:', e);
      }
    }
    loadRecentUsers();
    setInterval(loadRecentUsers, 10000);

    // Activity log
    async function loadActivityLog() {
      try {
        const res = await liveFetch('/api/users/activity?limit=50', { headers: authHeaders() });
        const list = document.getElementById('activity-log-list');
        if (!res.ok) {
          list.innerHTML = '<div class="text-sm text-[#64748b] text-center py-4">Admin sign-in required.</div>';
          return;
        }
        const data = await res.json();
        if (!data.activity || data.activity.length === 0) {
          list.innerHTML = '<div class="text-sm text-[#64748b] text-center py-4">No activity yet</div>';
          return;
        }
        const actionIcons = {
          signup: '🎉', login: '🔓', logout: '🔒', chat_start: '💬',
          tool_use: '🔧', api_call: '🌐', google_auth: '🔐',
        };
        const actionColors = {
          signup: 'text-[#00ff88]', login: 'text-[#00bfff]', logout: 'text-[#ff6b6b]',
          chat_start: 'text-[#a855f7]', tool_use: 'text-[#ffd700]', api_call: 'text-[#64748b]', google_auth: 'text-[#7c3aed]',
        };
        list.innerHTML = data.activity.map(a => {
          const time = new Date((a.created_at || 0) * 1000);
          const icon = actionIcons[a.action] || '📌';
          const color = actionColors[a.action] || 'text-[#64748b]';
          const ip = a.ip_address || '—';
          const device = [a.device_type, a.browser].filter(Boolean).join(' ') || '';
          return `<div class="flex items-start gap-2 text-xs bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg px-3 py-2">
            <span class="${color}">${icon}</span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between">
                <span class="${color} font-medium">${escapeHtml(a.action)}</span>
                <span class="text-[#4b5563] text-[10px]">${time.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})}</span>
              </div>
              <div class="text-[#64748b] text-[10px] truncate">${escapeHtml(a.username || a.email || 'anonymous')} · 🌐 ${escapeHtml(ip)}${device ? ' · 📱 ' + escapeHtml(device) : ''}</div>
            </div>
          </div>`;
        }).join('');
      } catch (e) {
        console.error('Activity log load failed:', e);
      }
    }
    loadActivityLog();
    setInterval(loadActivityLog, 5000);

    function connectDashboardLiveSocket() {
      try {
        const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
        const socket = new WebSocket(proto + '//' + location.host + '/ws');
        socket.addEventListener('open', () => {
          setText('status-badge', 'live');
        });
        socket.addEventListener('message', (event) => {
          let msg = null;
          try { msg = JSON.parse(event.data); } catch { return; }
          if (msg.type === 'notification' || msg.notificationType) queueDashboardRefresh(100);
        });
        socket.addEventListener('close', () => {
          setText('status-badge', 'reconnecting...');
          setTimeout(connectDashboardLiveSocket, 2000);
        });
      } catch {
        setTimeout(connectDashboardLiveSocket, 5000);
      }
    }
    connectDashboardLiveSocket();

    // ── Skills, Tools & Models ────────────────────────────────
    let stmTools = [];
    let stmSkills = [];
    let stmProviders = [];

    function switchStmTab(tab) {
      document.querySelectorAll('.stm-tab').forEach(btn => {
        const active = btn.dataset.tab === tab;
        btn.className = 'stm-tab text-xs px-3 py-1.5 rounded-lg transition-colors border ' + (active
          ? 'bg-[#7c3aed]/10 text-[#7c3aed] border-[#7c3aed]/30'
          : 'bg-[#111118] text-[#64748b] border-[#1e1e2e] hover:bg-[#1e1e2e]');
      });
      document.getElementById('stm-browse-panel').classList.toggle('hidden', tab !== 'browse');
      document.getElementById('stm-create-panel').classList.toggle('hidden', tab !== 'create');
    }
    window.switchStmTab = switchStmTab;

    function renderStmSkillsList(filter) {
      const q = (filter || '').toLowerCase();
      const list = document.getElementById('stm-skills-list');
      const filtered = stmSkills.filter(s => !q || s.name.toLowerCase().includes(q));
      setText('stm-skills-count', stmSkills.length);
      list.innerHTML = filtered.length ? filtered.slice(0, 200).map(s =>
        `<div class="text-xs bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg px-2.5 py-1.5 truncate" title="${escapeHtml(s.path || s.name)}">📄 ${escapeHtml(s.name)}</div>`
      ).join('') : '<div class="text-xs text-[#64748b] text-center py-4">No skills found</div>';
    }

    function renderStmToolsList(filter) {
      const q = (filter || '').toLowerCase();
      const list = document.getElementById('stm-tools-list');
      const filtered = stmTools.filter(t => !q || t.name.toLowerCase().includes(q));
      setText('stm-tools-count', stmTools.length);
      list.innerHTML = filtered.length ? filtered.slice(0, 200).map(t =>
        `<div class="text-xs bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg px-2.5 py-1.5 flex items-center justify-between gap-2">
          <span class="truncate font-mono">🔧 ${escapeHtml(t.name)}</span>
          <span class="text-[9px] text-[#4b5563] shrink-0">${escapeHtml(t.source || '')}</span>
        </div>`
      ).join('') : '<div class="text-xs text-[#64748b] text-center py-4">No tools found</div>';
    }

    async function loadStmModelsFor(providerId, listElId, selectElId) {
      const listEl = listElId ? document.getElementById(listElId) : null;
      const selectEl = selectElId ? document.getElementById(selectElId) : null;
      if (!providerId) {
        if (listEl) listEl.innerHTML = '<div class="text-xs text-[#64748b] text-center py-4">Pick a provider</div>';
        if (selectEl) selectEl.innerHTML = '<option value="">Select provider first...</option>';
        return;
      }
      try {
        const res = await liveFetch(`/api/providers/${encodeURIComponent(providerId)}/models`);
        const data = await res.json();
        const models = data.models || [];
        if (listEl) {
          listEl.innerHTML = models.length ? models.map(m => {
            const id = typeof m === 'string' ? m : (m.id || m.name || '');
            return `<div class="text-xs bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg px-2.5 py-1.5 truncate font-mono">🤖 ${escapeHtml(id)}</div>`;
          }).join('') : '<div class="text-xs text-[#64748b] text-center py-4">No models found</div>';
        }
        if (selectEl) {
          selectEl.innerHTML = models.length ? models.map(m => {
            const id = typeof m === 'string' ? m : (m.id || m.name || '');
            return `<option value="${escapeHtml(id)}">${escapeHtml(id)}</option>`;
          }).join('') : '<option value="">No models found</option>';
        }
      } catch {
        if (listEl) listEl.innerHTML = '<div class="text-xs text-[#ff6b6b] text-center py-4">Failed to load models</div>';
        if (selectEl) selectEl.innerHTML = '<option value="">Failed to load</option>';
      }
    }

    async function loadStmClusters() {
      const list = document.getElementById('stm-clusters-list');
      try {
        const res = await liveFetch('/api/memory?category=general&limit=200');
        const data = await res.json();
        const clusters = (data.memories || []).filter(m => (m.key || '').startsWith('cluster:')).map(m => {
          try { return { key: m.key, ...JSON.parse(m.value) }; } catch { return null; }
        }).filter(Boolean);
        list.innerHTML = clusters.length ? clusters.map(c => `
          <div class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg p-3">
            <div class="flex items-center justify-between mb-1 gap-2">
              <span class="text-sm font-medium truncate">${escapeHtml(c.name || c.key)}</span>
              <button data-key="${escapeHtml(c.key)}" class="stm-delete-cluster text-[#ef4444] hover:text-red-400 text-xs shrink-0">✕</button>
            </div>
            <div class="text-[10px] text-[#64748b] font-mono truncate">${escapeHtml(c.provider || '—')} / ${escapeHtml(c.model || '—')}</div>
            <div class="text-[10px] text-[#4b5563] mt-1">${(c.tools||[]).length} tools · ${(c.skills||[]).length} skills</div>
          </div>
        `).join('') : '<div class="text-xs text-[#64748b] text-center py-4 col-span-full">No clusters yet</div>';
        list.querySelectorAll('.stm-delete-cluster').forEach(btn => {
          btn.addEventListener('click', async () => {
            await liveFetch(`/api/memory/${encodeURIComponent(btn.dataset.key)}`, { method: 'DELETE' });
            loadStmClusters();
          });
        });
      } catch {
        list.innerHTML = '<div class="text-xs text-[#ff6b6b] text-center py-4 col-span-full">Failed to load clusters</div>';
      }
    }

    async function initSkillsToolsModels() {
      try {
        const [skillsRes, dashRes, provRes] = await Promise.all([
          liveFetch('/api/agent/skills'),
          liveFetch('/api/dashboard?live=1&compact=0'),
          liveFetch('/api/providers'),
        ]);
        stmSkills = (await skillsRes.json()).skills || [];
        stmTools = ((await dashRes.json()).agent || {}).tools || [];
        stmProviders = (await provRes.json()).providers || [];
      } catch (e) {
        console.error('Skills/Tools/Models init failed:', e);
      }
      renderStmSkillsList('');
      renderStmToolsList('');

      const provOptions = '<option value="">Select provider...</option>' + stmProviders.map(p => `<option value="${escapeHtml(p.id)}">${escapeHtml(p.name)}</option>`).join('');
      document.getElementById('stm-browse-provider').innerHTML = provOptions;
      document.getElementById('stm-create-provider').innerHTML = provOptions;

      document.getElementById('stm-create-tools').innerHTML = stmTools.map(t => `<option value="${escapeHtml(t.name)}">${escapeHtml(t.name)}</option>`).join('');
      document.getElementById('stm-create-skills').innerHTML = stmSkills.map(s => `<option value="${escapeHtml(s.name)}">${escapeHtml(s.name)}</option>`).join('');

      document.getElementById('stm-skills-filter').addEventListener('input', (e) => renderStmSkillsList(e.target.value));
      document.getElementById('stm-tools-filter').addEventListener('input', (e) => renderStmToolsList(e.target.value));
      document.getElementById('stm-browse-provider').addEventListener('change', (e) => loadStmModelsFor(e.target.value, 'stm-models-list', null));
      document.getElementById('stm-create-provider').addEventListener('change', (e) => loadStmModelsFor(e.target.value, null, 'stm-create-model'));

      document.getElementById('stm-save-cluster').addEventListener('click', async () => {
        const name = document.getElementById('stm-cluster-name').value.trim();
        const status = document.getElementById('stm-save-status');
        if (!name) { status.textContent = 'Name required'; status.className = 'ml-3 text-xs text-[#ff6b6b]'; return; }
        const provider = document.getElementById('stm-create-provider').value;
        const model = document.getElementById('stm-create-model').value;
        const notes = document.getElementById('stm-cluster-notes').value.trim();
        const tools = Array.from(document.getElementById('stm-create-tools').selectedOptions).map(o => o.value);
        const skills = Array.from(document.getElementById('stm-create-skills').selectedOptions).map(o => o.value);
        const key = 'cluster:' + name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        try {
          status.textContent = 'Saving...'; status.className = 'ml-3 text-xs text-[#ffd700]';
          const res = await liveFetch('/api/memory', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              category: 'general',
              key,
              value: JSON.stringify({ name, provider, model, tools, skills, notes }),
              source: 'dashboard',
            }),
          });
          if (!res.ok) throw new Error('save failed');
          status.textContent = 'Saved ✓'; status.className = 'ml-3 text-xs text-[#00ff88]';
          document.getElementById('stm-cluster-name').value = '';
          document.getElementById('stm-cluster-notes').value = '';
          loadStmClusters();
          setTimeout(() => { status.textContent = ''; }, 2500);
        } catch {
          status.textContent = 'Save failed'; status.className = 'ml-3 text-xs text-[#ff6b6b]';
        }
      });

      loadStmClusters();
    }
    initSkillsToolsModels();
  </script>
