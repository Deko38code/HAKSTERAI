    // ── Infrastructure security agents (Codex + DeepSeek) ────────────────
    // Owner-only. Each agent card keeps its last real rundown: a failed poll
    // never blanks the panel, it only marks the pill stale.
    let secAgentsRunning = false;
    function secAgentDot(ok) {
      return '<span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:'
        + (ok ? '#22c55e' : '#ef4444') + ';box-shadow:0 0 8px ' + (ok ? '#22c55e88' : '#ef444488') + '"></span>';
    }
    // Per-agent ask state. Declared before the render functions that read it.
    const secAskPending = { codex: false, deepseek: false };
    function renderSecAgent(a) {
      const when = a.ranAt ? new Date(a.ranAt).toISOString().replace('T', ' ').slice(0, 16) + ' UTC' : 'never';
      const meta = a.ok
        ? escHtml((a.model || a.provider) + ' · ' + (a.ms < 1000 ? a.ms + 'ms' : (a.ms / 1000).toFixed(1) + 's') + ' · ' + when + (a.fallback ? ' · fallback lane' : ''))
        : '<span class="text-[#ef4444]">' + escHtml(a.error || 'failed') + '</span>';
      const body = a.ok
        ? '<div class="text-[11px] leading-relaxed text-[#cbd5e1]" style="white-space:pre-wrap">' + escHtml(a.rundown) + '</div>'
        : '<div class="text-[11px] text-[#64748b]">No rundown yet — this agent has not completed a review.</div>';
      return '<div class="flex items-center justify-between gap-2 mb-1">'
        + '<div class="text-xs font-semibold text-[#e2e8f0] flex items-center gap-2">' + secAgentDot(a.ok) + escHtml(a.label) + '</div>'
        + '<span class="text-[10px] text-[#64748b] text-right truncate">' + escHtml(a.job || '') + '</span>'
        + '</div>'
        + '<div class="text-[10px] text-[#64748b] mb-2 truncate" data-tip="' + escHtml(meta.replace(/<[^>]+>/g, '')) + '">' + meta + '</div>'
        + body;
    }
    function secCheckChip(c) {
      const color = c.state === 'fail' ? '#ef4444' : c.state === 'warn' ? '#ffd700' : c.state === 'info' ? '#00bfff' : '#22c55e';
      return '<span class="text-[10px] px-2 py-1 rounded-full border" style="border-color:' + color + '55;color:' + color + ';background:' + color + '11" title="'
        + escHtml((c.label || c.id) + ' — ' + (c.detail || c.state)) + '">' + escHtml((c.label || c.id) + ' · ' + c.state) + '</span>';
    }
    function renderSecurityAgents(state) {
      if (!state) return;
      const agents = state.agents || [];
      const hasData = agents.some((a) => a.ranAt);
      for (const id of ['codex', 'deepseek']) {
        const a = agents.find((x) => x.id === id);
        if (!a) continue;
        const el = document.getElementById('secagent-' + id);
        if (!el) continue;
        if (!a.ranAt && el.dataset.hkFilled === '1') continue;
        el.innerHTML = renderSecAgent(a);
        el.dataset.hkFilled = a.ranAt ? '1' : '0';
      }
      if (state.sweep) {
        const s = state.sweep;
        const when = s.finishedAt ? new Date(s.finishedAt).toISOString().replace('T', ' ').slice(0, 16) + ' UTC' : '—';
        setText('secagents-sweep', 'sweep ' + String(s.state || '?').toUpperCase() + ' · ' + when + ' · ' + (s.durationMs || 0) + 'ms · ' + ((s.checks || []).length) + ' checks');
        const checks = (s.checks || []).map(secCheckChip).join('');
        if (checks) hkSetTable('secagents-checks', checks, true);
      }
      // Owner questions: rendered from the server so every open dashboard sees
      // the same feed. Kept outside the agent body, so the 1s body re-render can
      // never wipe what is typed in the input bar.
      if (state.asks) {
        for (const id of ['codex', 'deepseek']) {
          if (secAskPending[id]) continue;
          renderSecAskFeed(id, state.asks[id] || []);
        }
      }
      if (state.ranAt) {
        const ok = agents.filter((a) => a.ok).length;
        setText('secagents-note', 'Read-only · ' + ok + '/' + agents.length + ' agents reported · last run ' + new Date(state.ranAt).toISOString().replace('T', ' ').slice(0, 19) + ' UTC · schedule every ' + Math.round((state.scheduleMs || 21600000) / 3600000) + 'h · rundowns also go to the Telegram recon bot.');
      }
      if (hasData) hkCachePill('secagents-cache', 'live');
    }
    async function loadSecurityAgents() {
      try {
        const res = await liveFetch('/api/admin/security-agents', { headers: authHeaders() });
        if (!res.ok) { hkCachePill('secagents-cache', 'stale', 'http ' + res.status); return; }
        hkCacheSeen('secagents-cache', res);
        renderSecurityAgents(await res.json());
      } catch (e) {
        hkCachePill('secagents-cache', 'stale', 'retrying');
      }
    }
    // ── Ask an agent about this box ────────────────────────────────────────
    // The input under each card asks that one agent a question; the server
    // answers from the same read-only sweep + platform map as its rundown. The
    // feed below the input is re-rendered from /api/admin/security-agents on
    // the 1s beat, so it stays live on every open dashboard without touching
    // what is typed in the box.
    function secAskStamp(iso) {
      if (!iso) return '—';
      const d = new Date(iso);
      if (isNaN(d.getTime())) return '—';
      return d.toISOString().replace('T', ' ').slice(0, 19) + ' UTC';
    }
    function secAskSet(id, html) {
      const el = document.getElementById(id);
      if (!el) return;
      const sig = html.length + ':' + html.slice(0, 64) + ':' + html.slice(-64);
      if (el.dataset.hkSig === sig) return;
      el.innerHTML = html;
      el.dataset.hkSig = sig;
    }
    function renderSecAskFeed(agentId, turns) {
      const rows = (turns || []).slice(0, 3).map((t, i) => {
        const stamp = secAskStamp(t.at);
        const meta = t.ok ? (t.ms || 0) + 'ms' : 'failed';
        const head = '<div class="flex items-start justify-between gap-2 text-[10px] text-[#64748b]">'
          + '<span class="truncate">Q · ' + escHtml(t.q || '') + '</span>'
          + '<span class="whitespace-nowrap shrink-0">' + escHtml(stamp) + ' · ' + escHtml(meta)
          + (t.sweepFresh ? ' · fresh sweep' : '') + '</span></div>';
        const body = t.ok
          ? '<div class="mt-1 whitespace-pre-wrap text-[11px] leading-relaxed ' + (i === 0 ? 'text-[#cbd5e1]' : 'text-[#94a3b8]') + '">' + escHtml(t.a || '') + '</div>'
          : '<div class="mt-1 text-[11px] text-[#f87171]">' + escHtml(t.error || 'no answer') + '</div>';
        return '<div class="rounded-lg border border-[#1e1e2e] bg-[#0d0d14] px-3 py-2">' + head + body + '</div>';
      }).join('');
      secAskSet('secask-' + agentId + '-feed', rows
        || '<div class="text-[10px] text-[#475569]">No questions yet — ask what needs fixing.</div>');
    }
    async function askSecurityAgent(agentId) {
      const input = document.getElementById('secask-' + agentId + '-input');
      const btn = document.getElementById('secask-' + agentId + '-send');
      const stateEl = document.getElementById('secask-' + agentId + '-state');
      if (!input || !btn || secAskPending[agentId]) return;
      const question = String(input.value || '').trim();
      if (question.length < 3) {
        if (stateEl) stateEl.textContent = 'type a question first';
        input.focus();
        return;
      }
      secAskPending[agentId] = true;
      btn.disabled = true;
      btn.classList.add('opacity-50');
      if (stateEl) stateEl.textContent = 'thinking… reading the live sweep (can take up to a minute)';
      const t0 = Date.now();
      try {
        const res = await fetch('/api/admin/security-agents/ask', {
          method: 'POST',
          headers: Object.assign({ 'Content-Type': 'application/json' }, authHeaders()),
          body: JSON.stringify({ agent: agentId, question }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || ('http ' + res.status));
        input.value = '';
        if (stateEl) {
          stateEl.textContent = 'answered in ' + Math.max(1, Math.round((data.ms || (Date.now() - t0)) / 1000)) + 's · sweep '
            + String(data.sweepState || '?').toUpperCase() + (data.sweepFresh ? ' · re-run just now' : ' · cached sweep')
            + ' · ' + (data.model || data.provider || '');
        }
      } catch (err) {
        if (stateEl) stateEl.textContent = 'no answer: ' + (err.message || 'request failed');
      } finally {
        secAskPending[agentId] = false;
        btn.disabled = false;
        btn.classList.remove('opacity-50');
        loadSecurityAgents();
      }
    }

    async function runSecurityAgentsNow() {
      const btn = document.getElementById('secagents-run');
      if (!btn || secAgentsRunning) return;
      secAgentsRunning = true;
      const label = btn.textContent;
      btn.textContent = 'Running…';
      btn.disabled = true;
      btn.style.opacity = '0.7';
      setText('secagents-sweep', 'running sweep + agent reviews…');
      try {
        const res = await fetch('/api/admin/security-agents/run', {
          method: 'POST',
          headers: Object.assign({ 'Content-Type': 'application/json' }, authHeaders()),
          body: JSON.stringify({}),
        });
        if (res.ok) renderSecurityAgents(await res.json());
        else hkCachePill('secagents-cache', 'stale', 'http ' + res.status);
      } catch (e) {
        hkCachePill('secagents-cache', 'stale', 'run failed');
      } finally {
        secAgentsRunning = false;
        btn.textContent = label;
        btn.disabled = false;
        btn.style.opacity = '';
      }
    }
    const secAgentsBtn = document.getElementById('secagents-run');
    if (secAgentsBtn) secAgentsBtn.addEventListener('click', runSecurityAgentsNow);
    // ── Anomaly detector (Codex lane) ──────────────────────────────────────
    // The numeric detection is computed on the server from this box's own
    // samples; the model only explains what the numbers found.
    function renderAnomaly(st) {
      if (!st) return;
      const stateEl = document.getElementById('anom-state');
      const anomalies = st.anomalies || [];
      const label = st.learning ? 'learning' : anomalies.length ? 'watch' : 'clear';
      if (stateEl) {
        stateEl.textContent = label;
        stateEl.style.color = st.learning ? '#fbbf24' : anomalies.length ? '#fbbf24' : '#00ff88';
      }
      const when = st.ranAt ? new Date(st.ranAt).toISOString().replace('T', ' ').slice(0, 19) + ' UTC' : 'never';
      setText('anom-meta', (st.baselineSamples || 0) + ' baseline sample(s) from this Dell box · learned from 15-min samples · last scan ' + when
        + (st.newPatterns ? ' · ' + st.newPatterns + ' new pattern(s)' : '') + ' · read-only');

      const findings = anomalies.map((a) => '<div class="rounded-lg border border-[#1e1e2e] bg-[#0d0d14] px-3 py-2">'
        + '<div class="flex items-center justify-between gap-2 text-[10px] text-[#64748b]">'
        + '<span class="truncate">' + escHtml(a.label) + '</span>'
        + '<span class="whitespace-nowrap">' + escHtml((a.z == null ? 'rule' : 'z=' + a.z)) + '</span></div>'
        + '<div class="mt-1 text-[11px] text-[#fbbf24]">' + escHtml(a.message || '') + '</div></div>').join('');
      secAskSet('anom-findings', findings || '<div class="text-[10px] text-[#475569]">Nothing outside the learned range.</div>');

      const patterns = (st.patterns || []).map((pt) => '<div class="rounded-lg border border-[#1e1e2e] bg-[#0d0d14] px-3 py-2">'
        + '<div class="flex items-center justify-between gap-2 text-[10px] text-[#64748b]">'
        + '<span class="truncate">' + escHtml(pt.label || pt.metric) + ' · ' + escHtml(pt.direction || '') + '</span>'
        + '<span class="whitespace-nowrap">seen ' + (pt.count || 1) + '×</span></div>'
        + '<div class="mt-1 text-[10px] text-[#94a3b8]">first ' + escHtml((pt.firstSeen || '').slice(0, 16).replace('T', ' '))
        + ' · last ' + escHtml((pt.lastSeen || '').slice(0, 16).replace('T', ' ')) + '</div></div>').join('');
      secAskSet('anom-patterns', patterns || '<div class="text-[10px] text-[#475569]">No patterns learned yet.</div>');

      const as = st.assessment;
      setText('anom-answer', as && as.ok ? as.text : '');
      setText('anom-error', as && !as.ok ? 'codex lane: ' + (as.error || 'no answer') : '');
    }
    async function loadAnomaly() {
      try {
        const res = await liveFetch('/api/admin/anomaly', { headers: authHeaders() });
        if (!res.ok) { setText('anom-state', 'http ' + res.status); return; }
        renderAnomaly(await res.json());
      } catch (e) { setText('anom-state', 'retrying'); }
    }
    async function runAnomalyNow() {
      const btn = document.getElementById('anom-run');
      if (!btn || btn.disabled) return;
      const label = btn.textContent;
      btn.disabled = true; btn.textContent = 'Scanning…';
      try {
        const res = await fetch('/api/admin/anomaly/run', { method: 'POST', headers: Object.assign({ 'Content-Type': 'application/json' }, authHeaders()), body: '{}' });
        if (res.ok) renderAnomaly(await res.json());
        else setText('anom-error', 'scan failed: http ' + res.status);
      } catch (e) { setText('anom-error', 'scan failed: ' + e.message); }
      finally { btn.disabled = false; btn.textContent = label; }
    }
    const anomBtn = document.getElementById('anom-run');
    if (anomBtn) anomBtn.addEventListener('click', runAnomalyNow);
    loadAnomaly();
    window.hkLiveEvery(loadAnomaly, 5000);

    // ── Update log: every build seen, all three sites, date + time ────────
    const updLogSiteColor = { haksterai: '#00bfff', junkalot: '#00ff88', phantomide: '#a855f7' };
    function renderUpdateLog(d) {
      if (!d) return;
      const rows = d.rows || [];
      const sources = d.sources || [];
      const stateEl = document.getElementById('updlog-state');
      const ok = sources.filter((s) => s.state === 'ok').length;
      if (stateEl) {
        stateEl.textContent = ok + '/' + sources.length + ' sites';
        stateEl.style.color = ok === sources.length ? '#00ff88' : ok ? '#fbbf24' : '#f87171';
      }
      setText('updlog-meta', rows.length + ' entr' + (rows.length === 1 ? 'y' : 'ies') + ' · newest ' + (rows[0] ? String(rows[0].at).slice(0, 19).replace('T', ' ') + ' UTC' : '—') + ' · read-only · refreshed 5s');
      const chips = sources.map((s) => {
        const color = s.state === 'ok' ? '#00ff88' : s.state === 'empty' ? '#64748b' : '#f87171';
        return '<span class="text-[10px] rounded-full border px-2 py-0.5" style="border-color:' + color + '44;color:' + color + '">'
          + escHtml(s.site) + ' · ' + escHtml(s.state === 'absent' ? 'no log yet' : s.state) + (s.total != null && s.state === 'ok' ? ' · ' + s.total : '') + '</span>';
      }).join('');
      secAskSet('updlog-sources', chips || '<span class="text-[10px] text-[#475569]">no sources</span>');
      const list = rows.map((r) => {
        const color = updLogSiteColor[r.site] || '#94a3b8';
        return '<div class="rounded-lg border border-[#1e1e2e] bg-[#0d0d14] px-3 py-2">'
          + '<div class="flex items-center justify-between gap-2 text-[10px]">'
          + '<span class="font-bold" style="color:' + color + '">' + escHtml(r.site) + '</span>'
          + '<span class="text-[#64748b] whitespace-nowrap">' + escHtml(r.action) + '</span></div>'
          + '<div class="mt-0.5 text-[11px] text-[#cbd5e1]">' + escHtml(String(r.at).slice(0, 19).replace('T', ' ') + ' UTC') + (r.atLocal ? ' · ' + escHtml(r.atLocal) : '') + '</div>'
          + '<div class="text-[10px] text-[#64748b] truncate">build ' + escHtml(r.build || '—') + (r.from ? ' · from ' + escHtml(r.from) : '') + ' · ' + escHtml(r.actor || 'anonymous') + (r.path ? ' · ' + escHtml(r.path) : '') + '</div>'
          + '</div>';
      }).join('');
      secAskSet('updlog-rows', list || '<div class="text-[10px] text-[#475569]">No build sightings recorded yet.</div>');
      setText('updlog-error', d.error ? 'log: ' + d.error : '');
    }
    async function loadUpdateLog() {
      try {
        const res = await liveFetch('/api/admin/update-log', { headers: authHeaders() });
        if (!res.ok) { setText('updlog-state', 'http ' + res.status); return; }
        renderUpdateLog(await res.json());
      } catch (e) { setText('updlog-state', 'retrying'); }
    }
    loadUpdateLog();
    window.hkLiveEvery(loadUpdateLog, 5000);

    // ── Junkalot update progress: the pill's phase and %, same numbers ────
    // One read every 4s (the endpoint itself caches for 5s). The bar, the label
    // and the percentage come straight from the site, so this card and the pill
    // on junkalot.co always agree; only a silent site changes the story, and it
    // then says restarting or not answering rather than guessing an ETA.
    function renderJunkalotUpdate(d) {
      if (!d) return;
      const phase = String(d.phase || 'offline');
      const warn = phase === 'maintenance' || phase === 'offline';
      const progress = Math.max(0, Math.min(100, Number(d.progress) || 0));
      const colour = warn ? '#fbbf24' : '#00ff88';
      const bar = document.getElementById('jupd-bar');
      if (bar) {
        bar.style.width = progress + '%';
        bar.style.background = warn
          ? 'linear-gradient(90deg,#f59e0b,#fbbf24 55%,#fde68a)'
          : 'linear-gradient(90deg,#00d977,#00ff88 55%,#7dffc4)';
      }
      const stateEl = document.getElementById('jupd-state');
      if (stateEl) {
        stateEl.textContent = d.reachable ? phase : 'no answer';
        stateEl.style.color = colour;
      }
      const label = document.getElementById('jupd-label');
      if (label) {
        label.textContent = d.label || phase;
        label.style.color = colour;
      }
      setText('jupd-msg', d.message || '—');
      setText('jupd-pct', progress + '%');
      setText('jupd-meta',
        (d.build ? 'served ' + d.build : 'served —')
        + (d.target && d.target !== d.build ? ' · target ' + d.target : '')
        + (d.source ? ' · ' + d.source : '')
        + ' · checked ' + String(d.checkedAt || '').slice(11, 19) + ' UTC');
    }
    async function loadJunkalotUpdate() {
      try {
        const res = await liveFetch('/api/admin/junkalot-update', { headers: authHeaders() });
        if (!res.ok) { setText('jupd-state', 'http ' + res.status); return; }
        renderJunkalotUpdate(await res.json());
      } catch (e) { setText('jupd-state', 'retrying'); }
    }
    loadJunkalotUpdate();
    window.hkLiveEvery(loadJunkalotUpdate, 4000);

    // ── Fleet ops: every bot and agent row the server records ────────────
    // Read-only. The server merges its own delivery log with junkalot and
    // phantomide; each source reports its own state, so an unreachable site
    // is visible instead of quietly missing.
    function fleetRow(e) {
      const warn = /FAIL|failed|error|unreachable|absent|missing|http /i.test(String(e.action || "") + " " + String(e.detail || ""));
      const li = document.createElement("li");
      li.className = "text-[11px] leading-snug";
      const badge = document.createElement("span");
      badge.className = "font-semibold";
      badge.style.color = warn ? "#fbbf24" : "#7dd3fc";
      badge.textContent = e.agent || "agent";
      const body = document.createElement("span");
      body.className = "text-[#cbd5e1]";
      body.textContent = " — " + (e.action || "event") + (e.site ? " · " + e.site : "") + (e.build ? " · " + String(e.build).slice(0, 8) : "");
      const time = document.createElement("span");
      time.className = "text-[#475569]";
      time.textContent = " · " + String(e.at || "").slice(11, 19);
      li.append(badge, body, time);
      if (e.detail) {
        const d = document.createElement("div");
        d.className = "text-[10px] text-[#64748b] break-words";
        d.textContent = e.detail;
        li.append(d);
      }
      return li;
    }
    function renderFleet(d) {
      if (!d) return;
      const list = document.getElementById("fleet-list");
      if (!list) return;
      const events = Array.isArray(d.events) ? d.events : [];
      list.replaceChildren();
      if (!events.length) {
        const li = document.createElement("li");
        li.className = "text-[11px] text-[#64748b]";
        li.textContent = "No bot or agent events recorded yet.";
        list.append(li);
      }
      for (const e of events.slice(0, 12)) list.append(fleetRow(e));
      setText("fleet-sources", (d.sources || []).map((s) => s.site + " " + s.state).join(" · ") || "no sources");
      const written = d.snapshot ? Object.keys(d.snapshot).filter((k) => d.snapshot[k] === "ok") : [];
      setText("fleet-meta", "read " + String(d.at || "").slice(11, 19) + " UTC · " + events.length + " event(s) · snapshot " + (written.length ? "written to " + written.join(", ") : "not written"));
    }
    async function loadFleet() {
      try {
        const res = await liveFetch("/api/admin/fleet-log", { headers: authHeaders() });
        if (!res.ok) { setText("fleet-sources", "http " + res.status); return; }
        renderFleet(await res.json());
      } catch (e) { setText("fleet-sources", "retrying"); }
    }
    loadFleet();
    window.hkLiveEvery(loadFleet, 15000);

    // ── Hosting lock: carrier-style, from the real payoff ledger ─────────
    // Read-only unless the owner presses Arm. The lock never stops the
    // site; Cloudflare is the edge and arming needs the owner token.
    function money(n) {
      return "$" + (Number(n) || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    function renderLock(d) {
      const c = d && d.clients && d.clients[0];
      if (!c) { setText("lock-state", "no data"); return; }
      const locked = !!c.lock.active;
      const stateEl = document.getElementById("lock-state");
      if (stateEl) {
        stateEl.textContent = locked ? "locked" : "released";
        stateEl.style.color = locked ? "#fbbf24" : "#00ff88";
        stateEl.style.borderColor = locked ? "#f59e0b" : "#1e1e2e";
      }
      const p = c.payoff || {};
      const cf = c.lock.cloudflare || {};
      setText("lock-label", locked
        ? "🔒 " + c.hostname + " stays locked until the balance is paid in full"
        : "✅ " + c.hostname + " paid in full — lock released");
      setText("lock-meta", p.stale
        ? "stale — ledger unread: " + (p.error || "no answer") + " · last read " + String(p.updatedAt || "").slice(0, 19)
        : "paid " + money(p.confirmedPaid) + " of " + money(p.total) + " · " + money(p.remaining) + " remaining · "
          + (p.remainingPaymentMonths || 0) + " × " + money(p.monthlyRate) + " · payoff " + (p.estimatedPayoffMonth || "—")
          + " · ledger read " + String(d.at || "").slice(11, 19) + " UTC");
      setText("lock-edge", "Cloudflare edge: "
        + (cf.armed ? "ARMED " + String(cf.armedAt || "").slice(0, 10) : "staged — needs the owner Cloudflare token")
        + " · site keeps serving · no service, tunnel or DNS change");
      const btn = document.getElementById("lock-arm");
      if (btn) {
        btn.textContent = "Prepare Cloudflare lock";
        btn.dataset.armed = cf.armed ? "1" : "0";
      }
      renderLicence(c);
    }
    // Licence card: exactly the numbers Junkalot returned for this read. When
    // the ledger could not be read, every figure stays "—" and the card says so
    // — a total is never invented.
    function renderLicence(c) {
      const g = c && c.gate;
      const stale = !g || !g.totalsKnown;
      const stateEl = document.getElementById("licence-state");
      const labels = {
        'not-started': 'not started', 'current': 'open', 'grace': 'grace period',
        'locked': 'LOCKED', 'lien-sale': 'LIEN SALE', 'paid-off': 'paid in full', 'unknown': 'unknown',
      };
      if (stale) {
        setText("licence-total", "—");
        setText("licence-overdue", "—");
        if (stateEl) stateEl.textContent = "unread";
        setText("licence-due", "—");
        setText("licence-grace", "—");
        setText("licence-lien", "—");
        setText("licence-version", "");
        setText("licence-meta", "Ledger unread — no figure is shown rather than a stale or estimated one."
          + (c && c.gateStale && c.payoff && c.payoff.updatedAt ? " Last verified read " + String(c.payoff.updatedAt).slice(0, 19) + " UTC." : ""));
        return;
      }
      setText("licence-total", money(g.totalDue));
      setText("licence-overdue", money(g.overdueTotal));
      if (stateEl) {
        stateEl.textContent = labels[g.state] || g.state;
        stateEl.style.color = g.state === 'lien-sale' ? '#f87171' : g.state === 'locked' ? '#fbbf24' : g.state === 'grace' ? '#f59e0b' : '#00ff88';
      }
      setText("licence-due", g.dueAt ? String(g.dueAt).slice(0, 10) : "—");
      setText("licence-grace", g.graceEndsAt ? String(g.graceEndsAt).slice(0, 10) : "—");
      setText("licence-lien", g.lienSaleAt ? String(g.lienSaleAt).slice(0, 10) + (g.lienNoticeRecorded ? " · notice recorded" : "") : "—");
      // Clutter rule: this card shows four numbers and one line. Full detail
      // lives on the licence page (/admin/license/).

      setText("licence-version", "v" + (g.licenceVersion || "—"));
      setText("licence-meta", (g.note || "")
        + " Payments start " + String(g.paymentsStart || "").slice(0, 10)
        + " · " + g.graceDays + "-day grace, then this locks the client admin only"
        + (g.lienCureDeadlineAt ? " · cure deadline " + String(g.lienCureDeadlineAt).slice(0, 10) : "")
        + (g.lienMonths ? " · " + g.lienMonths + " unpaid months triggers the lien sale state" : "")
        + " · public site keeps serving · builder account never locked.");
    }
    async function loadLock() {
      try {
        const res = await liveFetch("/api/admin/hosting-locks", { headers: authHeaders() });
        if (!res.ok) { setText("lock-state", "http " + res.status); return; }
        renderLock(await res.json());
      } catch (e) { setText("lock-state", "retrying"); }
    }
    const armBtn = document.getElementById("lock-arm");
    if (armBtn) armBtn.addEventListener("click", async () => {
      const armed = armBtn.dataset.armed !== "1";
      armBtn.disabled = true;
      try {
        const res = await liveFetch("/api/admin/hosting-locks/arm", {
          method: "POST",
          headers: Object.assign({}, authHeaders(), { "Content-Type": "application/json" }),
          body: JSON.stringify({ id: "junkalot", armed }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) setText("lock-edge", "not armed — " + (data.error || "http " + res.status));
        loadLock();
      } catch (e) { setText("lock-edge", "not armed — request failed"); }
      armBtn.disabled = false;
    });
    loadLock();
    window.hkLiveEvery(loadLock, 60000);

    for (const id of ['codex', 'deepseek']) {
      const sendBtn = document.getElementById('secask-' + id + '-send');
      const box = document.getElementById('secask-' + id + '-input');
      if (sendBtn) sendBtn.addEventListener('click', () => askSecurityAgent(id));
      if (box) box.addEventListener('keydown', (ev) => {
        if (ev.key === 'Enter' && !ev.shiftKey) { ev.preventDefault(); askSecurityAgent(id); }
      });
    }
    loadSecurityAgents();
    window.hkLiveEvery(loadSecurityAgents);

    // ── Stripe webhook log card ────────────────────────────────────────────
    // Renders what the payment webhook actually did, newest first, with the
    // age counted in seconds since each event — the "since last update" column
    // — so a plan flip or a stuck delivery is visible at a glance.
    function fmtAgo(sec) {
      sec = Math.max(0, Math.round(Number(sec) || 0));
      if (sec < 60) return sec + 's ago';
      if (sec < 3600) return Math.floor(sec / 60) + 'm ' + (sec % 60) + 's ago';
      if (sec < 86400) return Math.floor(sec / 3600) + 'h ' + Math.floor((sec % 3600) / 60) + 'm ago';
      return Math.floor(sec / 86400) + 'd ' + Math.floor((sec % 86400) / 3600) + 'h ago';
    }
    const stripeOutcomeTone = {
      'plan-activated': '#00ff88', 'plan-restored': '#00ff88', 'renewal-paid': '#00ff88', 'plan-changed': '#00bfff',
      duplicate: '#ffd700', 'kept-plan': '#ffd700', downgraded: '#94a3b8',
      'payment-failed': '#ef4444', 'acknowledged-failure': '#ef4444',
    };
    function renderStripeWebhookLog(data) {
      const rowsBody = document.getElementById('stripehook-rows');
      const empty = document.getElementById('stripehook-empty');
      if (!rowsBody) return;
      const now = Number(data.now) || Math.floor(Date.now() / 1000);
      const events = Array.isArray(data.events) ? data.events : [];
      const totals = data.totals || {};
      setText('stripehook-summary', totals.total
        ? `${totals.total} events · ${totals.activated || 0} activated · ${totals.failures || 0} problems · last ${fmtAgo(now - (totals.lastAt || now))}`
        : 'watching for the first delivery…');
      if (empty) empty.classList.add('hidden');
      if (!events.length) {
        // One muted placeholder row instead of a second empty-state sentence.
        hkSetTable('stripehook-rows', '<tr><td colspan="7" class="py-2 text-[#64748b]">No deliveries logged yet — this log fills on the first Stripe event.</td></tr>', true);
        return;
      }
      const html = events.map((e) => {
        const at = new Date((Number(e.created_at) || now) * 1000);
        const tone = stripeOutcomeTone[e.outcome] || '#94a3b8';
        const amount = Number.isFinite(e.amount_cents) && e.amount_cents
          ? '$' + (Number(e.amount_cents) / 100).toFixed(2)
          : '—';
        return '<tr class="border-t border-[#1e1e2e]">'
          + '<td class="py-1 pr-2 font-mono text-[#94a3b8] whitespace-nowrap" style="font-variant-numeric:tabular-nums" title="' + escHtml(at.toISOString().replace('T', ' ').slice(0, 19) + ' UTC') + '">'
            + escHtml(fmtAgo(Number(e.secondsAgo) || (now - Number(e.created_at || now))))
            + '<span class="text-[#475569]"> · ' + escHtml(at.toISOString().slice(11, 19)) + ' UTC</span></td>'
          + '<td class="py-1 pr-2 font-mono text-[#cbd5e1] whitespace-nowrap">' + escHtml(e.event_type || '—') + '</td>'
          + '<td class="py-1 pr-2 font-semibold whitespace-nowrap" style="color:' + tone + '">' + escHtml(e.outcome || '—') + '</td>'
          + '<td class="py-1 pr-2 font-mono text-[#94a3b8] whitespace-nowrap" title="' + escHtml(e.user_id || '') + '">' + escHtml(e.user_id || '—') + '</td>'
          + '<td class="py-1 pr-2 text-[#e2e8f0] whitespace-nowrap">' + escHtml(e.plan || '—') + '</td>'
          + '<td class="py-1 pr-2 font-mono text-[#00ff88] whitespace-nowrap" style="font-variant-numeric:tabular-nums">' + escHtml(amount) + '</td>'
          + '<td class="py-1 text-[#94a3b8]" style="max-width:340px;white-space:normal">' + escHtml(e.message || '') + '</td>'
          + '</tr>';
      }).join('');
      hkSetTable('stripehook-rows', html, true);
    }
    async function loadStripeWebhookLog() {
      try {
        const res = await liveFetch('/api/admin/stripe-webhook-log?limit=40', { headers: authHeaders(), cache: 'no-store' });
        if (!res.ok) { hkCachePill('stripehook-cache', 'stale', 'http ' + res.status); return; }
        hkCacheSeen('stripehook-cache', res);
        renderStripeWebhookLog(await res.json());
      } catch {
        hkCachePill('stripehook-cache', 'stale', 'retrying');
      }
    }
    loadStripeWebhookLog();
    window.hkLiveEvery(loadStripeWebhookLog);

    // Live cards catch up the moment the tab is visible again — a hidden tab
    // throttles timers, so returning to it should not show a stale feed.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState !== 'visible') return;
      loadRecentUsers();
      loadActivityLog();
      loadServerStatus();
    });

    function connectDashboardLiveSocket() {
      try {
        const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
        const socket = new WebSocket(proto + '//' + location.host + '/ws');
        socket.addEventListener('open', () => {
          setText('status-badge', 'live');
        });
        socket.addEventListener('message', (event) => {
          let msg = null;
          try { msg = JSON.parse(event.data); } catch { return; }
          if (msg.type === 'notification' || msg.notificationType) queueDashboardRefresh(100);
        });
        socket.addEventListener('close', () => {
          setText('status-badge', 'reconnecting...');
          setTimeout(connectDashboardLiveSocket, 2000);
        });
      } catch {
        setTimeout(connectDashboardLiveSocket, 5000);
      }
    }
    connectDashboardLiveSocket();

    // ── Skills, Tools & Models ────────────────────────────────
    let stmTools = [];
    let stmSkills = [];
    let stmProviders = [];

    function switchStmTab(tab) {
      document.querySelectorAll('.stm-tab').forEach(btn => {
        const active = btn.dataset.tab === tab;
        btn.className = 'stm-tab text-xs px-3 py-1.5 rounded-lg transition-colors border ' + (active
          ? 'bg-[#7c3aed]/10 text-[#7c3aed] border-[#7c3aed]/30'
          : 'bg-[#111118] text-[#64748b] border-[#1e1e2e] hover:bg-[#1e1e2e]');
      });
      document.getElementById('stm-browse-panel').classList.toggle('hidden', tab !== 'browse');
      document.getElementById('stm-create-panel').classList.toggle('hidden', tab !== 'create');
    }
    window.switchStmTab = switchStmTab;

    function renderStmSkillsList(filter) {
      const q = (filter || '').toLowerCase();
      const list = document.getElementById('stm-skills-list');
      const filtered = stmSkills.filter(s => !q || s.name.toLowerCase().includes(q));
      setText('stm-skills-count', stmSkills.length);
      list.innerHTML = filtered.length ? filtered.slice(0, 200).map(s =>
        `<div class="text-xs bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg px-2.5 py-1.5 truncate" title="${escapeHtml(s.path || s.name)}">📄 ${escapeHtml(s.name)}</div>`
      ).join('') : '<div class="text-xs text-[#64748b] text-center py-4">No skills found</div>';
    }

    function renderStmToolsList(filter) {
      const q = (filter || '').toLowerCase();
      const list = document.getElementById('stm-tools-list');
      const filtered = stmTools.filter(t => !q || t.name.toLowerCase().includes(q));
      setText('stm-tools-count', stmTools.length);
      list.innerHTML = filtered.length ? filtered.slice(0, 200).map(t =>
        `<div class="text-xs bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg px-2.5 py-1.5 flex items-center justify-between gap-2">
          <span class="truncate font-mono">🔧 ${escapeHtml(t.name)}</span>
          <span class="text-[9px] text-[#4b5563] shrink-0">${escapeHtml(t.source || '')}</span>
        </div>`
      ).join('') : '<div class="text-xs text-[#64748b] text-center py-4">No tools found</div>';
    }

    async function loadStmModelsFor(providerId, listElId, selectElId) {
      const listEl = listElId ? document.getElementById(listElId) : null;
      const selectEl = selectElId ? document.getElementById(selectElId) : null;
      if (!providerId) {
        if (listEl) listEl.innerHTML = '<div class="text-xs text-[#64748b] text-center py-4">Pick a provider</div>';
        if (selectEl) selectEl.innerHTML = '<option value="">Select provider first...</option>';
        return;
      }
      try {
        const res = await liveFetch(`/api/providers/${encodeURIComponent(providerId)}/models`);
        const data = await res.json();
        const models = data.models || [];
        if (listEl) {
          listEl.innerHTML = models.length ? models.map(m => {
            const id = typeof m === 'string' ? m : (m.id || m.name || '');
            return `<div class="text-xs bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg px-2.5 py-1.5 truncate font-mono">🤖 ${escapeHtml(id)}</div>`;
          }).join('') : '<div class="text-xs text-[#64748b] text-center py-4">No models found</div>';
        }
        if (selectEl) {
          selectEl.innerHTML = models.length ? models.map(m => {
            const id = typeof m === 'string' ? m : (m.id || m.name || '');
            return `<option value="${escapeHtml(id)}">${escapeHtml(id)}</option>`;
          }).join('') : '<option value="">No models found</option>';
        }
      } catch {
        if (listEl) listEl.innerHTML = '<div class="text-xs text-[#ff6b6b] text-center py-4">Failed to load models</div>';
        if (selectEl) selectEl.innerHTML = '<option value="">Failed to load</option>';
      }
    }

    async function loadStmClusters() {
      const list = document.getElementById('stm-clusters-list');
      try {
        const res = await liveFetch('/api/memory?category=general&limit=200');
        const data = await res.json();
        const clusters = (data.memories || []).filter(m => (m.key || '').startsWith('cluster:')).map(m => {
          try { return { key: m.key, ...JSON.parse(m.value) }; } catch { return null; }
        }).filter(Boolean);
        list.innerHTML = clusters.length ? clusters.map(c => `
          <div class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg p-3">
            <div class="flex items-center justify-between mb-1 gap-2">
              <span class="text-sm font-medium truncate">${escapeHtml(c.name || c.key)}</span>
              <button data-key="${escapeHtml(c.key)}" class="stm-delete-cluster text-[#ef4444] hover:text-red-400 text-xs shrink-0">✕</button>
            </div>
            <div class="text-[10px] text-[#64748b] font-mono truncate">${escapeHtml(c.provider || '—')} / ${escapeHtml(c.model || '—')}</div>
            <div class="text-[10px] text-[#4b5563] mt-1">${(c.tools||[]).length} tools · ${(c.skills||[]).length} skills</div>
          </div>
        `).join('') : '<div class="text-xs text-[#64748b] text-center py-4 col-span-full">No clusters yet</div>';
        list.querySelectorAll('.stm-delete-cluster').forEach(btn => {
          btn.addEventListener('click', async () => {
            await liveFetch(`/api/memory/${encodeURIComponent(btn.dataset.key)}`, { method: 'DELETE' });
            loadStmClusters();
          });
        });
      } catch {
        list.innerHTML = '<div class="text-xs text-[#ff6b6b] text-center py-4 col-span-full">Failed to load clusters</div>';
      }
    }

    async function initSkillsToolsModels() {
      try {
        const [skillsRes, dashRes, provRes] = await Promise.all([
          liveFetch('/api/agent/skills'),
          liveFetch('/api/dashboard?live=1&compact=0'),
          liveFetch('/api/providers'),
        ]);
        stmSkills = (await skillsRes.json()).skills || [];
        stmTools = ((await dashRes.json()).agent || {}).tools || [];
        stmProviders = (await provRes.json()).providers || [];
      } catch (e) {
        console.error('Skills/Tools/Models init failed:', e);
      }
      renderStmSkillsList('');
      renderStmToolsList('');

      const provOptions = '<option value="">Select provider...</option>' + stmProviders.map(p => `<option value="${escapeHtml(p.id)}">${escapeHtml(p.name)}</option>`).join('');
      document.getElementById('stm-browse-provider').innerHTML = provOptions;
      document.getElementById('stm-create-provider').innerHTML = provOptions;

      document.getElementById('stm-create-tools').innerHTML = stmTools.map(t => `<option value="${escapeHtml(t.name)}">${escapeHtml(t.name)}</option>`).join('');
      document.getElementById('stm-create-skills').innerHTML = stmSkills.map(s => `<option value="${escapeHtml(s.name)}">${escapeHtml(s.name)}</option>`).join('');

      document.getElementById('stm-skills-filter').addEventListener('input', (e) => renderStmSkillsList(e.target.value));
      document.getElementById('stm-tools-filter').addEventListener('input', (e) => renderStmToolsList(e.target.value));
      document.getElementById('stm-browse-provider').addEventListener('change', (e) => loadStmModelsFor(e.target.value, 'stm-models-list', null));
      document.getElementById('stm-create-provider').addEventListener('change', (e) => loadStmModelsFor(e.target.value, null, 'stm-create-model'));

      document.getElementById('stm-save-cluster').addEventListener('click', async () => {
        const name = document.getElementById('stm-cluster-name').value.trim();
        const status = document.getElementById('stm-save-status');
        if (!name) { status.textContent = 'Name required'; status.className = 'ml-3 text-xs text-[#ff6b6b]'; return; }
        const provider = document.getElementById('stm-create-provider').value;
        const model = document.getElementById('stm-create-model').value;
        const notes = document.getElementById('stm-cluster-notes').value.trim();
        const tools = Array.from(document.getElementById('stm-create-tools').selectedOptions).map(o => o.value);
        const skills = Array.from(document.getElementById('stm-create-skills').selectedOptions).map(o => o.value);
        const key = 'cluster:' + name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        try {
          status.textContent = 'Saving...'; status.className = 'ml-3 text-xs text-[#ffd700]';
          const res = await liveFetch('/api/memory', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              category: 'general',
              key,
              value: JSON.stringify({ name, provider, model, tools, skills, notes }),
              source: 'dashboard',
            }),
          });
          if (!res.ok) throw new Error('save failed');
          status.textContent = 'Saved ✓'; status.className = 'ml-3 text-xs text-[#00ff88]';
          document.getElementById('stm-cluster-name').value = '';
          document.getElementById('stm-cluster-notes').value = '';
          loadStmClusters();
          setTimeout(() => { status.textContent = ''; }, 2500);
        } catch {
          status.textContent = 'Save failed'; status.className = 'ml-3 text-xs text-[#ff6b6b]';
        }
      });

      loadStmClusters();
    }
    initSkillsToolsModels();
  </script>
<!-- License Management Section -->
<div id="license-section" class="bg-[#111118] border border-[#1e1e2e] rounded-xl p-5 mt-6">
 <div class="flex items-center gap-3 mb-4">
 <div class="w-2 h-6 bg-[#22d3ee] rounded-full"></div>
 <h2 class="text-lg font-bold">🔑 License Management</h2>
 <span class="text-xs text-[#64748b] bg-[#0a0a0f] px-2 py-1 rounded-full border border-[#1e1e2e]" id="license-count-badge">Loading...</span>
 </div>

 <!-- Stats row -->
 <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
 <div class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg p-3 text-center">
 <div class="text-2xl font-bold text-[#22d3ee]" id="lic-total">—</div>
 <div class="text-xs text-[#64748b] mt-1">Total</div>
 </div>
 <div class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg p-3 text-center">
 <div class="text-2xl font-bold text-[#22d3ee]" id="lic-active">—</div>
 <div class="text-xs text-[#64748b] mt-1">Active</div>
 </div>
 <div class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg p-3 text-center">
 <div class="text-2xl font-bold text-[#a78bfa]" id="lic-pro">—</div>
 <div class="text-xs text-[#64748b] mt-1">Pro Plans</div>
 </div>
 <div class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg p-3 text-center">
 <div class="text-2xl font-bold text-[#fbbf24]" id="lic-revenue">—</div>
 <div class="text-xs text-[#64748b] mt-1">Est. Revenue</div>
 </div>
 </div>

 <!-- License table -->
 <div class="overflow-x-auto">
 <table class="w-full text-sm">
 <thead>
 <tr class="text-[#64748b] text-xs border-b border-[#1e1e2e]">
 <th class="text-left py-2 px-3">Key</th>
 <th class="text-left py-2 px-3">Email</th>
 <th class="text-left py-2 px-3">Plan</th>
 <th class="text-left py-2 px-3">Machines</th>
 <th class="text-left py-2 px-3">Status</th>
 <th class="text-left py-2 px-3">Created</th>
 <th class="text-left py-2 px-3">Actions</th>
 </tr>
 </thead>
 <tbody id="license-table-body">
 <tr><td colspan="7" class="text-center text-[#64748b] py-8">Loading licenses...</td></tr>
 </tbody>
 </table>
 </div>

 <!-- Manual key generation -->n <div class="mt-5 pt-5 border-t border-[#1e1e2e]">
 <h3 class="text-sm font-semibold text-[#e2e8f0] mb-3">Generate Manual License</h3>
 <div class="flex flex-col sm:flex-row gap-3">
 <input id="manual-email" type="email" placeholder="customer@email.com" class="flex-1 bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg px-3 py-2 text-sm text-[#e2e8f0] focus:border-[#22d3ee] outline-none" />
 <select id="manual-plan" class="bg-[#0a0a0f] border border-[#1e1e2e] rounded-lg px-3 py-2 text-sm text-[#e2e8f0] focus:border-[#22d3ee] outline-none">
 <option value="starter">Starter ($9.99)</option>
 <option value="pro">Pro ($29.99)</option>
 <option value="enterprise">Enterprise ($99.99)</option>
 </select>
 <button onclick="generateManualLicense()" class="bg-[#0891b2] text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-[#0e7490] transition-colors whitespace-nowrap">Generate Key</button>
 </div>
 <div id="manual-result" class="mt-3 hidden">
 <div class="bg-[#0a0a0f] border border-[#22d3ee]/30 rounded-lg p-3 flex items-center justify-between">
 <code id="manual-key" class="text-[#22d3ee] font-mono text-sm"></code>
 <button onclick="copyManualKey()" class="text-xs bg-[#1e1e2e] text-[#94a3b8] px-2 py-1 rounded hover:bg-[#22d3ee] hover:text-[#0a0a0f] transition-colors">Copy</button>
 </div>
 </div>
 </div>
</div>

<script is:inline data-cfasync="false">
async function loadLicenses() {
 try {
 const resp = await fetch('/api/admin/licenses');
 const data = await resp.json();
 if (!data.licenses) { document.getElementById('license-table-body').innerHTML = '<tr><td colspan="7" class="text-center text-[#64748b] py-8">No licenses yet</td></tr>'; return; }

 const stats = data.stats || {};
 document.getElementById('lic-total').textContent = stats.total || 0;
 document.getElementById('lic-active').textContent = stats.active || 0;
 document.getElementById('lic-pro').textContent = stats.pro || 0;
 document.getElementById('lic-revenue').textContent = '$' + (stats.revenue || 0).toFixed(2);
 document.getElementById('license-count-badge').textContent = (stats.total || 0) + ' total';

 const tbody = document.getElementById('license-table-body');
 tbody.innerHTML = data.licenses.map(l => `
 <tr class="border-b border-[#1e1e2e]/50 hover:bg-[#0a0a0f]/50">
 <td class="py-2 px-3 font-mono text-xs text-[#22d3ee]">${l.key}</td>
 <td class="py-2 px-3 text-[#94a3b8]">${l.email}</td>
 <td class="py-2 px-3"><span class="text-xs px-2 py-0.5 rounded-full ${l.plan === 'enterprise' ? 'bg-[#fbbf24]/10 text-[#fbbf24]' : l.plan === 'pro' ? 'bg-[#a78bfa]/10 text-[#a78bfa]' : 'bg-[#22d3ee]/10 text-[#22d3ee]'}">${l.plan}</span></td>
 <td class="py-2 px-3 text-[#94a3b8]">${l.machines_used || 0}/${l.max_machines}</td>
 <td class="py-2 px-3">${l.active ? '<span class="text-xs text-green-400">● Active</span>' : '<span class="text-xs text-red-400">● Inactive</span>'}</td>
 <td class="py-2 px-3 text-[#64748b] text-xs">${l.created_at || ''}</td>
 <td class="py-2 px-3">
 ${l.active ? `<button onclick="deactivateLicense('${l.key}')" class="text-xs text-red-400 hover:text-red-300">Deactivate</button>` : '<span class="text-xs text-[#64748b]">—</span>'}
 </td>
 </tr>
 `).join('');
 } catch (e) {
 document.getElementById('license-table-body').innerHTML = '<tr><td colspan="7" class="text-center text-red-400 py-8">Failed to load</td></tr>';
 }
}

async function deactivateLicense(key) {
 if (!confirm('Deactivate license ' + key + '?')) return;
 try {
 await fetch('/api/admin/licenses/deactivate', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ key }) });
 loadLicenses();
 } catch (e) { alert('Failed to deactivate'); }
}

async function generateManualLicense() {
 const email = document.getElementById('manual-email').value.trim();
 const plan = document.getElementById('manual-plan').value;
 if (!email) { alert('Enter an email'); return; }
 try {
 const resp = await fetch('/api/admin/licenses/create', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ email, plan }) });
 const data = await resp.json();
 if (data.key) {
 document.getElementById('manual-key').textContent = data.key;
 document.getElementById('manual-result').classList.remove('hidden');
 loadLicenses();
 } else { alert(data.error || 'Failed to generate'); }
 } catch (e) { alert('Error: ' + e.message); }
}

function copyManualKey() {
 const key = document.getElementById('manual-key').textContent;
 navigator.clipboard.writeText(key);
}

// Load on page load
loadLicenses();
window.hkLiveEvery ? window.hkLiveEvery(loadLicenses) : setInterval(loadLicenses, 30000);
</script>

</Layout>
