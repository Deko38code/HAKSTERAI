    // Keyed diff: existing rows are reused and only changed rows are rewritten,
    // so a live card renders in place and a scroll position survives refreshes.
    function hkRenderFeed(listEl, items, keyOf, htmlOf, emptyHtml) {
      const st = hkFeed(listEl);
      if (!items.length) {
        if (!st.nodes.size) listEl.innerHTML = emptyHtml;
        return 0;
      }
      [...listEl.children].forEach((ch) => { if (!ch.dataset || ch.dataset.hkKey === undefined) ch.remove(); });
      const seen = new Set();
      let added = 0;
      items.forEach((item, idx) => {
        const key = String(keyOf(item));
        if (seen.has(key)) return;
        seen.add(key);
        const html = htmlOf(item);
        let node = st.nodes.get(key);
        if (!node) {
          node = document.createElement('div');
          node.dataset.hkKey = key;
          st.nodes.set(key, node);
          added += 1;
        }
        if (node.dataset.hkHtml !== html) { node.innerHTML = html; node.dataset.hkHtml = html; }
        const ref = listEl.children[idx] || null;
        if (ref !== node) listEl.insertBefore(node, ref);
      });
      [...listEl.children].forEach((ch) => {
        const k = ch.dataset && ch.dataset.hkKey;
        if (k !== undefined && !seen.has(k)) { st.nodes.delete(k); ch.remove(); }
      });
      if (st.pinned) {
        listEl.scrollTo({ top: 0, behavior: added ? 'smooth' : 'auto' });
      } else if (added) {
        st.pending += added;
        hkFeedJump(listEl, st.pending);
      }
      return added;
    }
