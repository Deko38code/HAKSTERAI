    // Referral program overview
    function fmtNum(n) { return Number(n || 0).toLocaleString(); }
    function escHtml(s) { return String(s == null ? '' : s).replace(/[<>&"]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' })[c]); }
    async function loadReferralOverview() {
