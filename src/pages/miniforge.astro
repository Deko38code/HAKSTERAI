---
import UpdateWidget from '../components/UpdateWidget.astro';
// Chat is a full-screen mount; Miniforge owns the visible application header.
// This page is outside Layout.astro, so it stamps the same build id itself
// (astro.config.mjs injects one id per `astro build`) — that is what lets the
// shared update widget compare this tab with /api/version.
const haksterBuildId = typeof __HAKSTER_BUILD_ID__ !== 'undefined' ? __HAKSTER_BUILD_ID__ : '';
---
<!doctype html>
<html lang="en" data-hakster-build={haksterBuildId}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#10131c" />
    <meta name="description" content="HaksterAI-Bots — Chat, powered by Miniforge." />
    <meta name="haksterai-build" content={haksterBuildId} />
    <title>HaksterAI-Bots · Chat</title>
    <!-- HaksterAI's own logo on this page, as every other page gets from
         Layout.astro. The mount is a full-screen iframe that owns its own
         header/hero, so this page only supplies the browser chrome: icon,
         share card, canonical. The in-app hero logo is untouched. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/haksterai-logo.png" />
    <link rel="apple-touch-icon" href="/haksterai-logo.png" />
    <link rel="canonical" href="https://haksterai.com/miniforge" />
    <meta property="og:site_name" content="HaksterAI" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="HaksterAI-Bots · Chat" />
    <meta property="og:description" content="HaksterAI-Bots — chat with 10,000+ bots, powered by Miniforge." />
    <meta property="og:image" content="https://haksterai.com/haksterai-logo.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content="https://haksterai.com/haksterai-logo.png" />
    <style>
      /* The chat app owns the whole window: its own nav (logo, name, Discover,
         Create a bot, theme, Google) is the one header. The brand lockup lives
         inside that nav top-left, injected from this page's script, so there is
         no second bar above the frame (owner, 2026-11-22: "where discover
         create app etc is the logo and name should go … left top of it"). */
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; background: #10131c; }
      body > iframe { display: block; width: 100%; height: 100%; border: 0; background: #fff; }
    </style>
  </head>
  <body>
    <iframe title="HaksterAI-Bots Chat 2" src="/miniforge/app/" loading="eager" allow="clipboard-read; clipboard-write" referrerpolicy="same-origin"></iframe>
    <UpdateWidget />
    <script>
      const params = new URLSearchParams(location.search);
      const forwarded = new URLSearchParams();
      const ticket = params.get('hakster_sso');
      const googleError = params.get('google_error');
      if (ticket && /^[A-Za-z0-9_-]{32,100}$/.test(ticket)) forwarded.set('hakster_sso', ticket);
      if (googleError) forwarded.set('google_error', googleError.slice(0, 80));
      const botFrame = document.querySelector('iframe');
      const frameUrl = new URL('/miniforge/app/', location.origin);
      forwarded.forEach((value, key) => frameUrl.searchParams.set(key, value));
      // The /miniforge/app frame has its own origin storage. Hand off the
      // signed-in account key from this same-origin page before loading it.
      const apiKey = localStorage.getItem('hakster_google_token') || localStorage.getItem('hakster_api_key');
      const loadBots = (sessionKey) => {
        if (sessionKey && /^hkai_[A-Za-z0-9]+$/.test(sessionKey)) {
          frameUrl.searchParams.set('hakster_session', sessionKey);
          try {
            const user = JSON.parse(localStorage.getItem('hakster_google_user') || localStorage.getItem('hakster_user') || '{}');
            frameUrl.searchParams.set('hakster_user', JSON.stringify(user));
          } catch {}
        }
        botFrame.src = frameUrl.pathname + frameUrl.search;
      };
      if (apiKey) {
        loadBots(apiKey);
      } else {
        // If the account key was not saved by the current HaksterAI page,
        // render the regular signed-out Bots page and keep OAuth available.
        loadBots('');
      }
      if (forwarded.size) history.replaceState({}, '', location.pathname);

      // One header, not two (owner 2026-11-22: the extra bar above the frame is
      // "a split top tab you can remove"; and "where discover create app etc is
      // the logo and name should go … left top of it"). So the app's own nav is
      // the page's only header: its logo + HaksterAI-Bots name stay exactly
      // where they are, at the left of the Discover row, and gain the "a part of
      // Phantom-IDE" line underneath. Same-origin frame, so this is a DOM dress,
      // not an app change; every nav action stays where it was.
      //
      // The frame's own Phantom applet is hidden on this mount: it reports
      // miniforge's build, never the haksterai.com build this page serves from,
      // and a second green widget in the same corner is a dupe. This page's
      // update widget (above) is the one widget here.
      const dressFrameNav = () => {
        try {
          const doc = botFrame.contentDocument;
          if (!doc || doc.getElementById('mf-nav-brand-line')) return;
          const style = doc.createElement('style');
          style.id = 'mf-nav-brand-line';
          style.textContent = '#phantom-server-applet{display:none !important}'
            // Owner 2026-11-22: "better just make text bigger" — the brand name
            // reads from sofa distance and the Phantom-IDE line is legible, not
            // microprint. Both scale down before anything can leave the bar.
            + '.nav .nav-brand,.nav .nav-brand .hk-namewrap>span{font-size:1.6rem}'
            + '.nav .nav-brand .hk-namewrap{display:inline-flex;flex-direction:column;align-items:flex-start;line-height:1.05}'
            + '.nav .nav-brand .hk-namewrap>span{display:inline-block}'
            + '.nav .nav-brand .hk-sub{display:block;margin-top:4px;font:700 12px/1 Inter,system-ui,sans-serif;'
            + 'letter-spacing:.13em;text-transform:uppercase;color:#64748b;-webkit-text-fill-color:#64748b}'
            + '.nav .nav-brand .hk-sub b{font-weight:800;color:#00ff41;-webkit-text-fill-color:#00ff41}'
            + '@media(max-width:700px){.nav .nav-brand,.nav .nav-brand .hk-namewrap>span{font-size:1.15rem}'
            + '.nav .nav-brand .hk-sub{display:none}}'
            + '@media(max-width:400px){.nav .nav-brand .hk-namewrap{display:none}}';
          (doc.head || doc.documentElement).appendChild(style);

          const brand = doc.querySelector('.nav .nav-brand');
          const name = brand && brand.querySelector(':scope > span');
          if (brand && name && !brand.querySelector('.hk-sub')) {
            const wrap = doc.createElement('span');
            wrap.className = 'hk-namewrap';
            brand.insertBefore(wrap, name);
            wrap.appendChild(name);
            const sub = doc.createElement('small');
            sub.className = 'hk-sub';
            sub.innerHTML = 'a part of <b>Phantom-IDE</b>';
            wrap.appendChild(sub);
          }
        } catch (e) { /* frame not ready yet — the load listener retries */ }
      };
      botFrame.addEventListener('load', dressFrameNav);
      dressFrameNav();
    </script>
  </body>
</html>
