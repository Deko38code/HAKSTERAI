        window.haksterRunAutoChecks = async function() {
          if (!currentTarget) {
            addLine('⚠️ Set a target first.', '#ffd700');
            return;
          }
          const wanted = [
            'Nmap Quick Top-100',
            'SSL Cert Info',
            'Tech Fingerprint',
            'HTTP Headers',
            'Robots + Sitemap',
            'Nikto Web Scan',
            'HTTP Response Check',
            'Directory Check',
            'Advisory Search',
            'Header Hardening',
            'TLS Review',
            'Cookie Review',
          ];
          const buttons = [...document.querySelectorAll('.hack-tool-btn[data-kind="shell"]:not(.tool-unavailable)')];
          const selected = wanted
            .map(label => buttons.find(btn => getToolLabel(btn) === label))
            .filter(Boolean);
          if (!selected.length) {
            addLine('⛔ No installed real-command checks are available to automate.', '#ff6b6b');
            return;
          }
          const commands = selected.map(btn => (btn.dataset.command || '').replace(/\$\{TARGET\}/g, currentTarget || '')).filter(Boolean);
          const finalCmd = commands.map((cmd, idx) => `echo "\n[AUTO ${idx + 1}/${commands.length}] ${getToolLabel(selected[idx])}" ; ${cmd}`).join(' ; ');
          addLine('\n[AUTO] Running ' + commands.length + ' verified checks for ' + currentTarget, '#34d399');
          await runShellCommand(finalCmd);
        };

        async function runShellCommand(cmd) {
          if (cmd.includes('${TARGET}') && !currentTarget) {
            addLine('⚠️ Set a target first.', '#ffd700');
            return;
          }
          const finalCmd = cmd.replace(/\$\{TARGET\}/g, currentTarget || '');
          const confirmCommand = window.__haksterConfirmTerminalCommand;
          if (typeof confirmCommand === 'function') {
            const allowed = await confirmCommand(finalCmd);
            if (!allowed) {
              addLine('⛔ Command denied.', '#ff6b6b');
              return;
            }
          }
          addLine('\n[TERMINAL] $ ' + finalCmd, '#34d399');
          sendToTerminal(finalCmd, true);
        }

        document.querySelectorAll('.hack-tool-btn').forEach(btn => {
          // Restructure into card layout: [icon] label [▶]
          if (!btn.dataset.cardified && !btn.querySelector('.tool-icon')) {
            const text = btn.textContent.trim();
            const iconMatch = text.match(/^(\S+)\s+(.*)$/);
            const icon = iconMatch ? iconMatch[1] : '⚡';
            const label = iconMatch ? iconMatch[2] : text;
            btn.innerHTML = '<span class="tool-icon">' + icon + '</span><span class="tool-label">' + label + '</span>';
            btn.dataset.cardified = '1';
          }
