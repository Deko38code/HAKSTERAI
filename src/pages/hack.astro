          addLine('[LAB] Checkpoints: ' + Object.values(checkpoints).filter(c => c !== null).length + '/5 completed', '#ffd70080');
          addLine('', '');
          addLine('✅ Hack Lab ready. Use Auto Real Checks, sidebar commands, or type in the terminal.', '#c084fc');
          addLine('💡 Tip: set target → Auto Real Checks → save checkpoint → report.', '#64748b');
          addLine('', '');
        }

        // ── Uptime ─────────────────────────────────────────────────────
        setInterval(() => {
          const elapsed = Math.floor((Date.now() - startTime) / 1000);
          const h = String(Math.floor(elapsed / 3600)).padStart(2, '0');
          const m = String(Math.floor((elapsed % 3600) / 60)).padStart(2, '0');
          const s = String(elapsed % 60).padStart(2, '0');
          const uptimeEl = document.getElementById('sb-uptime');
          if (uptimeEl) uptimeEl.innerHTML = 'Uptime: <span>' + h + ':' + m + ':' + s + '</span>';
        }, 1000);

        // ── Dashboard/capabilities/memory ──────────────────────────────
        async function loadHackDashboard() {
          try {
            const res = await fetch(API + '/api/dashboard');
            const data = await res.json();
            const sbModel = document.getElementById('sb-model-info');
            if (data.crush && sbModel) {
              const m = data.crush.model || '—';
              const p = data.crush.provider || '—';
              sbModel.innerHTML = 'Model: <span>' + (m.length > 25 ? m.substring(0,23) + '…' : m) + '</span><br>Provider: <span>' + p + '</span>';
            }
          } catch {}
        }
        async function loadCapabilities() {
          try {
            const res = await fetch(API + '/api/agent/capabilities');
            const caps = await res.json();
            applyRealToolAvailability(caps);
          } catch {}
        }
        async function loadMemory() {
          try {
            const res = await fetch(API + '/api/memory?limit=5');
            await res.json();
          } catch {}
        }

        // Wait for terminal to register, then boot
        function waitForTerminal(cb, attempts) {
          attempts = attempts || 0;
          if (window.__crushTerminals && window.__crushTerminals['hack-main']) {
            cb();
          } else if (attempts < 60) {
            setTimeout(() => waitForTerminal(cb, attempts + 1), 50);
          }
        }

        updatePhaseUI();
        waitForTerminal(() => {
          bootSequence();
        });
        loadHackDashboard();
        loadCapabilities();
        loadMemory();

        // ── Google Sign-In for hack lab ──
        let hackGoogleToken = null;
        let hackGoogleUser = null;
        function getHackReferralCode() {
          return (localStorage.getItem('hakster_referral_code') || '').replace(/[^a-z0-9]/gi, '').toUpperCase().slice(0, 24);
        }
        const hackInitialReferralCode = new URLSearchParams(window.location.search).get('ref') || new URLSearchParams(window.location.search).get('referral');
        if (hackInitialReferralCode) localStorage.setItem('hakster_referral_code', hackInitialReferralCode.replace(/[^a-z0-9]/gi, '').toUpperCase().slice(0, 24));

        function loadHackGoogleIdentity() {
          // GSI library not needed for Desktop app OAuth — using redirect flow
          initHackGoogleButton();
        }

        async function initHackGoogleButton() {
          try {
            const res = await fetch(`${API}/api/auth/google/client-id`);
            const data = await res.json();
            if (!data.configured) return;

            const storedToken = localStorage.getItem('hakster_google_token');
            const storedUser = localStorage.getItem('hakster_google_user');
            if (storedToken && storedUser) {
              try {
                hackGoogleToken = storedToken;
                hackGoogleUser = JSON.parse(storedUser);
                showHackAccount(hackGoogleUser);
                return;
              } catch {}
            }

            // Desktop app OAuth client — use redirect flow exclusively, skip GSI renderButton
          } catch (e) { console.log('Hack Google Identity skipped:', e); }
        }

        async function handleHackCredential(response) {
          const credential = response.credential;
          if (!credential) return;
          const device = {
            deviceType: /Mobi|Android/i.test(navigator.userAgent) ? 'mobile' : 'desktop',
            osName: navigator.platform || 'unknown',
            browser: navigator.userAgent.match(/(Chrome|Firefox|Safari|Edge|Opera)\/?[\s\d.]+/i)?.[0]?.split('/')[0] || 'unknown',
            screenSize: `${screen.width}x${screen.height}`,
            language: navigator.language || '',
            timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || '',
          };
          try {
            const res = await fetch(`${API}/api/auth/google`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ credential, device, referralCode: getHackReferralCode() }),
            });
            const data = await res.json();
            if (data.ok) {
              hackGoogleToken = data.apiKey;
              hackGoogleUser = data.user;
              localStorage.setItem('hakster_google_token', hackGoogleToken);
              localStorage.setItem('hakster_google_user', JSON.stringify(data.user));
              localStorage.removeItem('hakster_referral_code');
              window.haksterSessionTouch?.();
              showHackAccount(data.user);
            }
          } catch (e) { console.error('Hack Google auth failed:', e); }
        }

        function showHackAccount(user) {
          const signin = document.getElementById('hack-google-signin');
          const info = document.getElementById('hack-account-info');
          const nameEl = document.getElementById('hack-account-name');
          const emailEl = document.getElementById('hack-account-email');
          const avatarEl = document.getElementById('hack-account-avatar');
          if (signin) signin.style.display = 'none';
          const fallback = document.getElementById('hack-google-fallback');
          if (fallback) fallback.style.display = 'none';
          if (info) { info.style.display = 'block'; info.classList.remove('hidden'); }
          if (nameEl) nameEl.textContent = user.username || user.email || 'User';
          if (emailEl) emailEl.textContent = user.email || '—';
          if (avatarEl && user.picture) avatarEl.src = user.picture;
        }

        // Fallback button uses redirect-based OAuth flow
        document.getElementById('hack-google-fallback')?.addEventListener('click', () => {
          const ref = getHackReferralCode();
          window.location.href = `${API}/api/auth/google/redirect${ref ? `?ref=${encodeURIComponent(ref)}` : ''}`;
        });

        // Check for OAuth callback result in URL
        function checkHackGoogleCallback() {
          const params = new URLSearchParams(window.location.search);
          const googleAuth = params.get('google_auth');
          const googleError = params.get('google_error');
          if (googleAuth) {
            let handled = false;
            try {
              const data = JSON.parse(decodeURIComponent(googleAuth));
              if (data.ok) {
                hackGoogleToken = data.apiKey;
                hackGoogleUser = data.user;
                localStorage.setItem('hakster_google_token', hackGoogleToken);
                localStorage.setItem('hakster_google_user', JSON.stringify(data.user));
                localStorage.setItem('hakster_user_data', JSON.stringify({ id: data.user.id || '', name: data.user.username || data.user.email || 'User', email: data.user.email || '', picture: data.user.picture || '' }));
                localStorage.removeItem('hakster_referral_code');
                window.haksterSessionTouch?.();
                showHackAccount(data.user);
                handled = true;
              } else {
                console.error('Google auth callback returned ok:false', data);
              }
            } catch (e) {
              console.error('Failed to parse google_auth payload — token was NOT stored:', e);
            }
            // Only strip the URL once the token was actually stored — see
            // build.astro's checkGoogleCallback for why stripping it
            // unconditionally caused Layout.astro's auth-gate to bounce
            // straight back to '/' whenever parsing failed.
            if (handled) {
              window.history.replaceState({}, '', window.location.pathname);
            }
          }
          if (googleError) {
            console.error('Google auth error:', googleError);
            window.history.replaceState({}, '', window.location.pathname);
          }
        }
        checkHackGoogleCallback();

        document.getElementById('hack-account-logout')?.addEventListener('click', () => {
          localStorage.removeItem('hakster_google_token');
          localStorage.removeItem('hakster_google_user');
          localStorage.removeItem('hakster_user_data');
          localStorage.removeItem('hakster_last_activity');
          if (window.google && window.google.accounts && window.google.accounts.id) {
            window.google.accounts.id.disableAutoSelect();
          }
          location.reload();
        });

        loadHackGoogleIdentity();

        // Fullscreen hack workspace
        const termRoot = document.getElementById('terminal-root');
        const termFullscreenBtn = document.getElementById('term-fullscreen-btn');
        function setTermFullscreenState(active) {
          if (!termFullscreenBtn) return;
          termFullscreenBtn.classList.toggle('active', active);
          termFullscreenBtn.setAttribute('aria-pressed', active ? 'true' : 'false');
          termFullscreenBtn.title = active ? 'Exit fullscreen' : 'Fullscreen';
          termFullscreenBtn.setAttribute('aria-label', termFullscreenBtn.title);
        }
        termFullscreenBtn?.addEventListener('click', async () => {
          try {
            if (document.fullscreenElement === termRoot) {
              await document.exitFullscreen();
            } else if (termRoot?.requestFullscreen) {
              if (document.fullscreenElement) await document.exitFullscreen();
              await termRoot.requestFullscreen();
            } else {
              termRoot?.classList.toggle('term-fullscreen-fallback');
              setTermFullscreenState(termRoot?.classList.contains('term-fullscreen-fallback'));
            }
          } catch {
            termRoot?.classList.toggle('term-fullscreen-fallback');
            setTermFullscreenState(termRoot?.classList.contains('term-fullscreen-fallback'));
          }
        });
        document.addEventListener('fullscreenchange', () => {
          if (!document.fullscreenElement) termRoot?.classList.remove('term-fullscreen-fallback');
          setTermFullscreenState(document.fullscreenElement === termRoot || Boolean(termRoot?.classList.contains('term-fullscreen-fallback')));
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && termRoot?.classList.contains('term-fullscreen-fallback')) {
            termRoot.classList.remove('term-fullscreen-fallback');
            setTermFullscreenState(false);
          }
        });

        setInterval(() => { loadHackDashboard(); loadCapabilities(); loadMemory(); }, 30000);
      })();
    </script>
  </body>
</html>
