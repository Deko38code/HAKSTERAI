        // ── Client Device Detection ──────────────────────────────────
        async function sendClientContext(sid) {
          try {
            const nav = navigator;
            const ctx = {
              session_id: sid,
              user_agent: nav.userAgent || '',
              platform: nav.platform || '',
              language: nav.language || '',
              timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || '',
              screen_width: screen.width || null,
              screen_height: screen.height || null,
              device_pixel_ratio: window.devicePixelRatio || null,
              online: nav.onLine,
              cores: nav.hardwareConcurrency || null,
              memory_gb: nav.deviceMemory || null,
              touch_support: ('ontouchstart' in window) || (nav.maxTouchPoints > 0),
            };
            await fetch(API + '/api/client-context', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(ctx),
            });
          } catch (e) { /* silent */ }
        }

        // ── Agent runner ─────────────────────────────────────────────
        async function ensureSession() {
          if (sessionId) return;
          try {
            const res = await fetch(API + '/api/sessions', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
            if (res.ok) {
              const s = await res.json();
              if (s && s.id) { sessionId = s.id; sendClientContext(sessionId); }
            }
          } catch {}
        }

        async function runAgentPrompt(promptText, options) {
          options = options || {};
          if (busy) {
            addLine('⚠️ Agent busy — wait for current task.', '#ffd700');
            return;
          }
          busy = true;
          addLine('\n[' + PHASE_LABELS[currentPhase] + '] ▶ ' + (options.label || 'Agent task'), PHASE_COLORS[currentPhase]);
          try {
            await ensureSession();
            const messagesWithSystem = [
              { role: 'system', content: getSystemPrompt() },
              ...conversationHistory.slice(-20),
              { role: 'user', content: promptText }
            ];
            const res = await fetch(API + '/api/agent/run', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ messages: messagesWithSystem, sessionId, provider: options.provider || 'ollama', model: options.model || undefined, stream: true, cwd: '/tmp' })
            });
            if (!res.ok) throw new Error(res.status + ' ' + res.statusText);
            addLine('\n' + termBold('AI RESPONSE') + ' ──────────────────', '#7c3aed');
            // ── Stream the SSE so you SEE the agent's output WHILE it works ──
            const reader = res.body.getReader();
            const decoder = new TextDecoder();
            let buf = '';
            let content = '';
            let liveLine = '';
            const flushLive = () => { if (liveLine) { addLine(liveLine, '#e2e8f0'); liveLine = ''; } };
            const phaseColors = { THINK: '#60a5fa', PLAN: '#fbbf24', ACT: '#34d399', OBSERVE: '#22d3ee', REFLECT: '#f472b6', CONSOLIDATE: '#a78bfa' };
            while (true) {
              const { done, value } = await reader.read();
              if (done) break;
              buf += decoder.decode(value, { stream: true });
              const lines = buf.split('\n');
              buf = lines.pop();
              for (const line of lines) {
                if (!line.startsWith('data: ')) continue;
                let evt; try { evt = JSON.parse(line.slice(6)); } catch (_) { continue; }
                if (evt.type === 'phase') {
                  flushLive();
                  const ph = evt.phase || '';
                  if (ph && ph !== 'COMPLETE') addLine('[' + ph + (evt.turn !== undefined ? ' turn ' + evt.turn : '') + ']', phaseColors[ph] || '#7c3aed');
                } else if (evt.type === 'delta' || evt.type === 'content') {
                  // append to the current streaming line (visible immediately)
                  content += evt.content || '';
                  liveLine += evt.content || '';
                  const t = getTerm(); if (t) { t.write(termColor(evt.content || '', '#e2e8f0')); }
                } else if (evt.type === 'tool_call_start' || evt.type === 'tool_use') {
                  flushLive();
                  addLine('  ↳ [tool: ' + (evt.tool_name || evt.tool || 'tool') + ']', '#34d399');
                } else if (evt.type === 'tool_call_result' || evt.type === 'tool_result') {
                  flushLive();
                  const r = String(evt.tool_result || evt.result || '').replace(/\n/g, ' ').slice(0, 120);
                  addLine('     ' + r, '#64748b');
                } else if (evt.type === 'thinking') {
                  flushLive();
                  addLine('  💭 ' + String(evt.content || '').slice(0, 160), '#64748b80');
                } else if (evt.type === 'error') {
                  flushLive();
                  addLine('[ERROR] ' + (evt.error || evt.message || ''), '#ff6b6b');
                } else if (evt.type === 'done') {
                  flushLive();
                }
              }
            }
            flushLive();
            if (!content) content = '(no response)';
            conversationHistory.push({ role: 'user', content: promptText });
            conversationHistory.push({ role: 'assistant', content: content });
            saveLabState();
          } catch (err) {
            addLine('[ERROR] ' + err.message, '#ff6b6b');
          } finally {
            busy = false;
          }
        }

        async function runFirecrawlPrompt(promptTemplate, value) {
          const prompt = promptTemplate.replace(/\$\{QUERY\}/g, value).replace(/\$\{URL\}/g, value);
          await runAgentPrompt(prompt, { label: 'Firecrawl' });
        }

