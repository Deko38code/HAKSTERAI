          risk: `echo '[REPORT] Risk severity matrix...' && echo -e "\nRisk Matrix:\nCritical: CVSS 9.0-10.0 | Immediate action\nHigh: CVSS 7.0-8.9 | Fix within 7 days\nMedium: CVSS 4.0-6.9 | Fix within 30 days\nLow: CVSS 0.1-3.9 | Fix in next release\n\nExploitability ratings:\nVery High: Public exploit / no auth\nHigh: Public exploit / auth required\nMedium: Custom exploit possible\nLow: Theoretical only\n"`,
          remediate: `echo '[REPORT] Remediation checklist...' && echo -e "1. Patch all software to latest stable versions\n2. Implement least-privilege access controls\n3. Sanitize all user inputs (prevent injection)\n4. Enable secure headers (CSP, HSTS, X-Frame-Options)\n5. Rotate exposed credentials and keys\n6. Remove default accounts and unused services\n7. Validate file uploads and redirects\n8. Add rate limiting and WAF rules\n9. Encrypt sensitive data at rest and in transit\n10. Re-run scan after remediation"`,
          fireSearch: { kind: 'firecrawl', prompt: 'Search the web for: ${QUERY}', command: `curl -s -X POST http://localhost:3579/api/agent/run -H 'Content-Type: application/json' -d '{"messages":[{"role":"system","content":"You are Firecrawl search. Search the web and return concise findings."},{"role":"user","content":"Search: \${QUERY}"}]}' | python3 -m json.tool` },
          fireScrape: { kind: 'firecrawl', prompt: 'Scrape the content of this URL: ${URL}', command: `curl -s http://localhost:3579/api/agent/run -H 'Content-Type: application/json' -d '{"messages":[{"role":"system","content":"You are Firecrawl scrape. Scrape and summarize the URL."},{"role":"user","content":"Scrape: \${URL}"}]}' | python3 -m json.tool` }
        };
        document.querySelectorAll('[data-cmd-id]').forEach(btn => {
          const spec = HACK_COMMANDS[btn.dataset.cmdId];
          if (!spec) return;
          if (typeof spec === 'string') {
            btn.dataset.command = spec;
          } else {
            btn.dataset.command = spec.command;
            btn.dataset.prompt = spec.prompt;
            btn.dataset.kind = spec.kind;
          }
        });

        const KNOWN_LOCAL_TOOLS = new Set([
          'nmap', 'nc', 'openssl', 'whatweb', 'curl', 'nikto', 'ffuf', 'gobuster', 'dirb',
          'dig', 'host', 'nslookup', 'smbclient', 'subfinder', 'theHarvester', 'whois',
          'nuclei', 'masscan', 'amass', 'httpx', 'katana', 'dalfox', 'sqlmap', 'dirsearch',
          'searchsploit', 'wget', 'python3', 'node', 'crontab', 'find', 'shred', 'sudo',
        ]);
        const SHELL_BUILTINS = new Set([
          'echo', 'printf', 'true', 'false', 'test', '[', '{', '}', 'cd', 'pwd', 'export',
          'set', 'unset', 'alias', 'unalias', 'type', 'command', 'sleep', 'mkdir', 'touch',
          'cat', 'head', 'tail', 'tee', 'xargs', 'grep', 'awk', 'sed', 'sort', 'uniq',
        ]);

        function firstCommandToken(segment) {
          let s = String(segment || '').trim();
          if (!s) return '';
          s = s.replace(/^\{?\s*/, '').replace(/^\(?\s*/, '');
          s = s.replace(/^env\s+/i, '');
          s = s.replace(/^[A-Z_][A-Z0-9_]*=(?:"[^"]*"|'[^']*'|\S+)\s+/gi, '');
          const token = (s.match(/^([./\w-]+)/) || [])[1] || '';
          if (!token) return '';
          const base = token.split('/').pop();
          if (base === 'sudo') {
            const rest = s.slice(token.length).trim();
            return firstCommandToken(rest);
          }
          return base;
        }

        function extractRequiredTool(command) {
          const raw = String(command || '');
          const cleaned = raw
            .replace(/"[^"]*"/g, '""')
            .replace(/'[^']*'/g, "''");
          const segments = cleaned.split(/&&|\|\||\||;|\n/);
          for (const segment of segments) {
            const token = firstCommandToken(segment);
            if (!token || SHELL_BUILTINS.has(token)) continue;
            if (KNOWN_LOCAL_TOOLS.has(token)) return token;
          }
          return '';
        }

        function setToolUnavailable(btn, reason, className) {
          btn.classList.add('tool-unavailable');
          if (className) btn.classList.add(className);
          btn.setAttribute('aria-disabled', 'true');
          btn.dataset.unavailableReason = reason;
          btn.title = reason;
        }

        function setToolAvailable(btn, tool, toolPath) {
          btn.classList.remove('tool-unavailable', 'tool-simulated');
          btn.removeAttribute('aria-disabled');
          delete btn.dataset.unavailableReason;
          btn.dataset.requiredTool = tool;
          btn.title = toolPath ? `${tool}: ${toolPath}` : tool;
        }

        function applyRealToolAvailability(caps) {
          const localTools = caps && caps.localTools ? caps.localTools : {};
          let runnable = 0;
          let disabled = 0;
          document.querySelectorAll('.hack-tool-btn[data-kind="shell"], .hack-tool-btn[data-kind="firecrawl"]').forEach(btn => {
            const cmd = btn.dataset.command || '';
            const tool = extractRequiredTool(cmd);
            if (!tool) {
              disabled++;
              setToolUnavailable(btn, 'Blocked: this is example output, not a real installed command.', 'tool-simulated');
              return;
            }
            const info = localTools[tool] || { installed: false, path: null };
            if (!info.installed) {
              disabled++;
              setToolUnavailable(btn, `Unavailable: ${tool} is not installed on this machine.`, '');
              return;
            }
            runnable++;
            setToolAvailable(btn, tool, info.path);
          });
          const status = document.getElementById('sb-status');
          if (status) status.innerHTML = '● <span>' + runnable + ' real commands · ' + disabled + ' unavailable</span>';
        }

        function getToolLabel(btn) {
          return (btn.querySelector('.tool-label')?.textContent || btn.textContent || '').trim();
        }

        window.haksterHackScrambler = function() {
          const terminal = getTerm();
          if (terminal && typeof terminal.scrambler === 'function') terminal.scrambler();
