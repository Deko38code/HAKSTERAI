---
// Install / CTA section
---

<section id="install" class="relative py-24 px-6">
  <!-- Section divider -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#7c3aed]/30 to-transparent"></div>

  <div class="mx-auto max-w-4xl">
    <!-- Header -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#1e1e2e] bg-[#111118] px-4 py-1.5 text-xs font-semibold text-[#7c3aed] tracking-widest uppercase mb-4">
        Install
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-[#e2e8f0] mb-4">
        Up in <span class="text-[#7c3aed]">30 seconds.</span>
      </h2>
      <p class="text-[#64748b] text-lg">
        One command to install. Zero config to get started.
      </p>
      <p class="mt-3 inline-flex flex-wrap items-center gap-2 text-sm">
        <span class="rounded-md border border-[#7c3aed]/40 bg-[#7c3aed]/10 px-2 py-0.5 text-xs font-bold tracking-widest text-[#7c3aed] uppercase">Pro</span>
        <span class="text-[#94a3b8]">Run HP-1000 on <span class="text-[#e2e8f0] font-semibold">your own machine</span> — full local file &amp; process access. Not a sandbox.</span>
      </p>
    </div>

    <!-- Install cards -->
    <div class="space-y-4 mb-12">

      <!-- 0. one-line install (curl) -->
      <div class="rounded-xl border border-[#7c3aed]/40 bg-[#111118] overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2 border-b border-[#1e1e2e] bg-[#0d0d14]">
          <span class="text-xs text-[#7c3aed] font-mono">fastest · one-line install</span> <span class="ml-1 rounded border border-[#7c3aed]/40 bg-[#7c3aed]/10 px-1.5 py-0.5 text-[10px] font-bold tracking-widest text-[#7c3aed] uppercase">Pro</span>
          <button class="copy-btn text-xs text-[#64748b] hover:text-[#a855f7] transition-colors cursor-pointer select-none" data-copy="curl -fsSL https://haksterai.com/install.sh | bash">copy</button>
        </div>
        <div class="flex items-center gap-3 px-6 py-5 font-mono text-sm overflow-x-auto">
          <span class="text-[#7c3aed] font-bold flex-shrink-0">$</span>
          <span class="text-[#e2e8f0] whitespace-nowrap">curl -fsSL https://haksterai.com/install.sh | bash</span>
        </div>
        <div class="px-6 pb-3 text-xs text-[#64748b]">Clones, installs deps, builds, starts the server under pm2, and puts <code class="text-[#a855f7]">haksterai</code> on your PATH. Then run <code class="text-[#a855f7]">haksterai chat</code>.</div>
      </div>

      <!-- npx (run without installing) -->
      <div class="rounded-xl border border-[#1e1e2e] bg-[#111118] overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2 border-b border-[#1e1e2e] bg-[#0d0d14]">
          <span class="text-xs text-[#64748b] font-mono">or · run once with npx</span> <span class="ml-1 rounded border border-[#7c3aed]/40 bg-[#7c3aed]/10 px-1.5 py-0.5 text-[10px] font-bold tracking-widest text-[#7c3aed] uppercase">Pro</span>
          <button class="copy-btn text-xs text-[#64748b] hover:text-[#a855f7] transition-colors cursor-pointer select-none" data-copy="npx github:Deko38code/haksterAi chat">copy</button>
        </div>
        <div class="flex items-center gap-3 px-6 py-5 font-mono text-sm overflow-x-auto">
          <span class="text-[#7c3aed] font-bold flex-shrink-0">$</span>
          <span class="text-[#e2e8f0] whitespace-nowrap">npx github:Deko38code/haksterAi chat</span>
        </div>
        <div class="px-6 pb-3 text-xs text-[#64748b]">No install — runs HP-1000 straight from GitHub. (Requires the repo to be public.)</div>
      </div>

      <!-- npm global install -->
      <div class="rounded-xl border border-[#1e1e2e] bg-[#111118] overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2 border-b border-[#1e1e2e] bg-[#0d0d14]">
          <span class="text-xs text-[#64748b] font-mono">or · global npm install</span> <span class="ml-1 rounded border border-[#7c3aed]/40 bg-[#7c3aed]/10 px-1.5 py-0.5 text-[10px] font-bold tracking-widest text-[#7c3aed] uppercase">Pro</span>
          <button class="copy-btn text-xs text-[#64748b] hover:text-[#a855f7] transition-colors cursor-pointer select-none" data-copy="npm install -g github:Deko38code/haksterAi">copy</button>
        </div>
        <div class="flex items-center gap-3 px-6 py-5 font-mono text-sm overflow-x-auto">
          <span class="text-[#7c3aed] font-bold flex-shrink-0">$</span>
          <span class="text-[#e2e8f0] whitespace-nowrap">npm install -g github:Deko38code/haksterAi</span>
        </div>
        <div class="px-6 pb-3 text-xs text-[#64748b]">Puts <code class="text-[#a855f7]">haksterai</code> on your PATH, then run <code class="text-[#a855f7]">haksterai chat</code>. (Requires the repo to be public.)</div>
      </div>

      <!-- 1. clone -->
      <div class="rounded-xl border border-[#1e1e2e] bg-[#111118] overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2 border-b border-[#1e1e2e] bg-[#0d0d14]">
          <span class="text-xs text-[#64748b] font-mono">1 · clone</span>
          <button class="copy-btn text-xs text-[#64748b] hover:text-[#a855f7] transition-colors cursor-pointer select-none" data-copy="git clone https://github.com/Deko38code/haksterAi.git && cd haksterAi">copy</button>
        </div>
        <div class="flex items-center gap-3 px-6 py-5 font-mono text-sm overflow-x-auto">
          <span class="text-[#7c3aed] font-bold flex-shrink-0">$</span>
          <span class="text-[#e2e8f0] whitespace-nowrap">git clone https://github.com/Deko38code/haksterAi.git && cd haksterAi</span>
        </div>
      </div>

      <!-- 2. install deps + build -->
      <div class="rounded-xl border border-[#1e1e2e] bg-[#111118] overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2 border-b border-[#1e1e2e] bg-[#0d0d14]">
          <span class="text-xs text-[#64748b] font-mono">2 · install + build</span>
          <button class="copy-btn text-xs text-[#64748b] hover:text-[#a855f7] transition-colors cursor-pointer select-none" data-copy="npm install && npm run build">copy</button>
        </div>
        <div class="flex items-center gap-3 px-6 py-5 font-mono text-sm overflow-x-auto">
          <span class="text-[#7c3aed] font-bold flex-shrink-0">$</span>
          <span class="text-[#e2e8f0] whitespace-nowrap">npm install && npm run build</span>
        </div>
      </div>

      <!-- 3. start the server (pm2) -->
      <div class="rounded-xl border border-[#1e1e2e] bg-[#111118] overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2 border-b border-[#1e1e2e] bg-[#0d0d14]">
          <span class="text-xs text-[#64748b] font-mono">3 · start server</span>
          <button class="copy-btn text-xs text-[#64748b] hover:text-[#a855f7] transition-colors cursor-pointer select-none" data-copy="pm2 start 'npm run server' --name haksterAi">copy</button>
        </div>
        <div class="flex items-center gap-3 px-6 py-5 font-mono text-sm overflow-x-auto">
          <span class="text-[#7c3aed] font-bold flex-shrink-0">$</span>
          <span class="text-[#e2e8f0] whitespace-nowrap">pm2 start 'npm run server' --name haksterAi</span>
        </div>
      </div>

      <!-- 4. init + run the CLI -->
      <div class="rounded-xl border border-[#1e1e2e] bg-[#111118] overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2 border-b border-[#1e1e2e] bg-[#0d0d14]">
          <span class="text-xs text-[#64748b] font-mono">4 · init + run</span>
          <button class="copy-btn text-xs text-[#64748b] hover:text-[#a855f7] transition-colors cursor-pointer select-none" data-copy="node cli/index.js init && node cli/index.js chat">copy</button>
        </div>
        <div class="flex items-center gap-3 px-6 py-5 font-mono text-sm overflow-x-auto">
          <span class="text-[#7c3aed] font-bold flex-shrink-0">$</span>
          <span class="text-[#e2e8f0] whitespace-nowrap">node cli/index.js init && node cli/index.js chat</span>
        </div>
      </div>

      <!-- global install (optional) -->
      <div class="rounded-xl border border-[#1e1e2e] bg-[#111118] overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2 border-b border-[#1e1e2e] bg-[#0d0d14]">
          <span class="text-xs text-[#64748b] font-mono">optional · global `haksterai`</span>
          <button class="copy-btn text-xs text-[#64748b] hover:text-[#a855f7] transition-colors cursor-pointer select-none" data-copy="npm install -g .">copy</button>
        </div>
        <div class="flex items-center gap-3 px-6 py-5 font-mono text-sm overflow-x-auto">
          <span class="text-[#7c3aed] font-bold flex-shrink-0">$</span>
          <span class="text-[#e2e8f0] whitespace-nowrap">npm install -g .  # puts `haksterai` on your PATH</span>
        </div>
      </div>

    </div>

    <!-- CTA banner -->
    <div class="relative rounded-2xl border border-[#7c3aed]/30 bg-gradient-to-br from-[#111118] to-[#0d0d14] p-8 md:p-12 text-center overflow-hidden">
      <div
        class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full opacity-10"
        style="background: radial-gradient(circle, #7c3aed 0%, transparent 70%);"
      ></div>
      <div class="relative z-10">
        <p class="text-xs font-semibold tracking-widest text-[#7c3aed] uppercase mb-3">Start now</p>
        <h3 class="text-3xl md:text-4xl font-bold text-[#e2e8f0] mb-4">
          Ready to build smarter?
        </h3>
        <p class="text-[#64748b] mb-8 max-w-md mx-auto">
          Join developers using haksterAi to build faster, ship cleaner, and stay in the zone.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="#install"
            class="inline-flex items-center gap-2 rounded-lg bg-[#7c3aed] px-6 py-3 text-base font-semibold text-white hover:bg-[#6d28d9] transition-all hover:shadow-lg hover:shadow-[#7c3aed]/30"
          >
            ↓ Download haksterAi
          </a>
          <a
            href="#docs"
            class="inline-flex items-center gap-2 rounded-lg border border-[#1e1e2e] bg-[#111118] px-6 py-3 text-base font-semibold text-[#e2e8f0] hover:border-[#7c3aed]/50 transition-all"
          >
            Browse docs →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // ── Copy to clipboard ───────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy;
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = '✓ copied!';
        btn.style.color = '#28c840';
        setTimeout(() => {
          btn.textContent = original;
          btn.style.color = '';
        }, 2000);
      } catch {
        // Fallback for browsers without clipboard API
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        const original = btn.textContent;
        btn.textContent = '✓ copied!';
        btn.style.color = '#28c840';
        setTimeout(() => {
          btn.textContent = original;
          btn.style.color = '';
        }, 2000);
      }
    });
  });
</script>
