---
const plans = [
  {
    name: 'Free',
    price: '$0',
    cadence: 'trial',
    tag: 'haksterai_free',
    planId: 'free',
    priceCatalogId: 'free',
    stripePriceId: null,
    tone: 'text-[#94a3b8]',
    border: 'border-[#1e1e2e]',
    button: 'border border-[#1e1e2e] bg-[#111118] text-[#e2e8f0] hover:border-[#7c3aed]/50',
    note: '10 free commands/questions',
    features: ['10 free commands or questions', 'Upgrade required after limit', 'Local models', 'Basic chat tools'],
  },
  {
    name: 'Starter',
    price: '$9.99',
    cadence: 'month',
    tag: 'haksterai_starter_monthly',
    planId: 'pro',
    priceCatalogId: 'starter_monthly',
    stripePriceId: import.meta.env.STRIPE_PRICE_STARTER_MONTHLY || process.env.STRIPE_PRICE_STARTER_MONTHLY || null,
    tone: 'text-[#22d3ee]',
    border: 'border-[#22d3ee]/35',
    button: 'bg-[#0891b2] text-white hover:bg-[#0e7490]',
    features: ['More monthly usage', 'Cloud reasoning models', 'Agent tools (shell, files, web)', 'Priority support'],
  },
  {
    name: 'Pro',
    price: '$29.99',
    cadence: 'month',
    tag: 'haksterai_pro_monthly',
    planId: 'pro',
    priceCatalogId: 'pro_monthly',
    stripePriceId: import.meta.env.STRIPE_PRICE_PRO_MONTHLY || process.env.STRIPE_PRICE_PRO_MONTHLY || null,
    tone: 'text-[#a78bfa]',
    border: 'border-[#a78bfa]/40',
    button: 'bg-[#7c3aed] text-white hover:bg-[#6d28d9]',
    features: ['Unlimited monthly usage', 'All cloud models (GPT-4, Claude, Gemini)', 'Full agent tool suite', '3 machines', 'Priority support'],
  },
  {
    name: 'Enterprise',
    price: '$99.99',
    cadence: 'month',
    tag: 'haksterai_enterprise_monthly',
    planId: 'enterprise',
    priceCatalogId: 'enterprise_monthly',
    stripePriceId: import.meta.env.STRIPE_PRICE_ENTERPRISE_MONTHLY || process.env.STRIPE_PRICE_ENTERPRISE_MONTHLY || null,
    tone: 'text-[#fbbf24]',
    border: 'border-[#fbbf24]/40',
    button: 'bg-[#d97706] text-white hover:bg-[#b45309]',
    features: ['Everything in Pro', '10 machines', 'Custom model routing', 'Dedicated support', 'SLA guarantee'],
  },
];
---

<section id="pricing" class="max-w-6xl mx-auto px-4 py-20">
  <div class="text-center mb-12">
    <h2 class="text-3xl font-bold text-white mb-2">Pricing</h2>
    <p class="text-[#94a3b8]">Choose your plan. Cancel anytime.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {plans.map((plan) => (
      <div class={`rounded-2xl border ${plan.border} bg-[#111118] p-6 flex flex-col`}>
        <div class="mb-4">
          <h3 class={`text-xl font-bold ${plan.tone}`}>{plan.name}</h3>
          <div class="flex items-baseline gap-1 mt-2">
            <span class="text-3xl font-bold text-white">{plan.price}</span>
            <span class="text-[#94a3b8] text-sm">/{plan.cadence}</span>
          </div>
          {plan.note && <p class="text-xs text-[#94a3b8] mt-1">{plan.note}</p>}
        </div>

        <ul class="space-y-2 mb-6 flex-1">
          {plan.features.map((f) => (
            <li class="flex items-start gap-2 text-sm text-[#cbd5e1]">
              <span class="text-[#22d3ee] mt-0.5">✓</span>
              <span>{f}</span>
            </li>
          ))}
        </ul>

        <button
          id={`btn-${plan.tag}`}
          class={`rounded-lg px-4 py-3 font-medium text-sm transition ${plan.button} disabled:opacity-50 disabled:cursor-not-allowed`}
          data-stripe-price={plan.stripePriceId || ''}
          data-plan-name={plan.name}
          onclick="handleBuy(this)"
        >
          {plan.name === 'Free' ? 'Get Started' : `Buy ${plan.name}`}
        </button>
      </div>
    ))}
  </div>
</section>

<script is:inline>
  async function handleBuy(btn) {
    const priceId = btn.dataset.stripePrice;
    const planName = btn.dataset.planName;

    if (!priceId || priceId === 'null' || priceId === '') {
      // Free plan — just redirect to install
      window.location.href = '/#install';
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Redirecting to checkout...';

    try {
      const resp = await fetch('/api/stripe/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ priceId }),
      });

      const data = await resp.json();

      if (data.url) {
        window.location.href = data.url;
      } else {
        btn.disabled = false;
        btn.textContent = `Buy ${planName}`;
        alert('Failed to start checkout: ' + (data.error || 'Unknown error'));
      }
    } catch (err) {
      btn.disabled = false;
      btn.textContent = `Buy ${planName}`;
      alert('Checkout error: ' + err.message);
    }
  }
</script>