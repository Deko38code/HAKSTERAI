---
const plans = [
  {
    name: 'Free',
    price: '$0',
    cadence: 'trial',
    tag: 'haksterai_free',
    planId: 'free',
    priceCatalogId: 'free',
    tone: 'text-[#94a3b8]',
    border: 'border-[#1e1e2e]',
    button: 'border border-[#1e1e2e] bg-[#111118] text-[#e2e8f0] hover:border-[#7c3aed]/50',
    note: '10 free commands/questions',
    features: ['10 free commands or questions', 'Upgrade required after limit', 'Local models', 'Basic chat tools'],
  },
  {
    name: 'Starter',
    price: '$9.99',
    cadence: 'month',
    tag: 'haksterai_starter_monthly',
    planId: 'pro',
    priceCatalogId: 'starter_monthly',
    tone: 'text-[#22d3ee]',
    border: 'border-[#22d3ee]/35',
    button: 'bg-[#0891b2] text-white hover:bg-[#0e7490]',
    features: ['More monthly usage', 'Cloud routing', 'Agent chat'],
  },
  {
    name: 'Pro',
    price: '$19.99',
    cadence: 'month',
    tag: 'haksterai_pro_monthly',
    planId: 'pro',
    priceCatalogId: 'pro_monthly',
    tone: 'text-[#a855f7]',
    border: 'border-[#7c3aed]/50',
    button: 'bg-[#7c3aed] text-white hover:bg-[#6d28d9]',
    featured: true,
    features: ['Unlimited app usage', 'Memory + history', 'Full agent tools'],
  },
  {
    name: 'Enterprise',
    price: '$100',
    cadence: 'month',
    tag: 'haksterai_enterprise_monthly',
    planId: 'enterprise',
    priceCatalogId: 'enterprise_monthly',
    tone: 'text-[#fbbf24]',
    border: 'border-[#fbbf24]/35',
    button: 'border border-[#fbbf24]/35 bg-[#111118] text-[#f8fafc] hover:border-[#fbbf24]/70',
    features: ['Team seats', 'Admin dashboard', 'Priority support'],
  },
];
---

<section id="pricing" class="relative py-20 px-6">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#7c3aed]/30 to-transparent"></div>

  <div class="mx-auto max-w-6xl">
    <div class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-[#1e1e2e] bg-[#111118] px-4 py-1.5 text-xs font-semibold text-[#7c3aed] tracking-widest uppercase">
          Pricing
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-[#e2e8f0] tracking-normal">
          Plans that scale with you.
        </h2>
        <p class="mt-3 max-w-2xl text-sm md:text-base text-[#64748b]">
          Start free with 10 questions. Upgrade anytime for unlimited access.
        </p>
      </div>
      <div id="stripe-status-badge" class="hidden rounded-lg border border-[#1e1e2e] bg-[#111118] px-4 py-3 text-xs text-[#94a3b8]">
        Secure payments powered by Stripe
      </div>
    </div>

    <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-4">
      {plans.map((plan) => (
        <div class={`relative rounded-xl border ${plan.border} bg-[#111118] p-4 ${plan.featured ? 'shadow-[0_0_32px_rgba(124,58,237,0.18)]' : ''}`}>
          {plan.featured && (
            <div class="absolute right-3 top-3 rounded-full bg-[#7c3aed]/20 px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.14em] text-[#c084fc]">
              Popular
            </div>
          )}
          <div class={`mb-2 text-xs font-bold uppercase tracking-[0.16em] ${plan.tone}`}>{plan.name}</div>
          <div class="mb-1 flex items-end gap-1">
            <span class="text-3xl font-bold text-[#f8fafc]">{plan.price}</span>
            <span class="pb-1 text-xs text-[#64748b]">/{plan.cadence}</span>
          </div>
          {plan.note && (
            <div class="mb-3 rounded-md border border-[#ef4444]/25 bg-[#ef4444]/10 px-2 py-1.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#fca5a5]">
              {plan.note} then upgrade
            </div>
          )}
          <div class="mb-4 rounded-md bg-[#0a0a0f] px-2 py-1 text-[10px] font-mono text-[#64748b]">{plan.tag}</div>
          <ul class="mb-5 space-y-2 text-xs text-[#94a3b8]">
            {plan.features.map((feature) => (
              <li class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-[#7c3aed]"></span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
          <button
            data-plan-id={plan.planId}
            data-price-catalog-id={plan.priceCatalogId}
            data-plan-name={plan.name}
            class={`stripe-checkout-btn inline-flex w-full items-center justify-center rounded-lg px-3 py-2 text-sm font-semibold transition-colors ${plan.button}`}
          >
            Choose {plan.name}
          </button>
        </div>
      ))}
    </div>
  </div>

  <script>
    (async () => {
      const API = window.location.origin;
      const buttons = document.querySelectorAll('.stripe-checkout-btn');
      if (!buttons.length) return;

      // Fetch pricing catalog to get Stripe price IDs
      let catalog = null;
      try {
        const res = await fetch(`${API}/api/pricing`);
        catalog = await res.json();
      } catch {}

      // Show Stripe badge if configured
      if (catalog?.stripe?.configured) {
        const badge = document.getElementById('stripe-status-badge');
        if (badge) badge.classList.remove('hidden');
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', async () => {
          const planId = btn.dataset.planId;
          const priceCatalogId = btn.dataset.priceCatalogId;
          const planName = btn.dataset.planName;

          // Free plan — just go to /build
          if (planId === 'free') {
            window.location.href = '/build';
            return;
          }

          // Find the stripePriceId from the catalog
          let stripePriceId = null;
          if (catalog?.plans) {
            for (const plan of catalog.plans) {
              if (plan.id === planId) {
                for (const price of plan.prices) {
                  if (price.id === priceCatalogId) {
                    stripePriceId = price.stripePriceId;
                    break;
                  }
                }
              }
            }
          }

          if (!stripePriceId) {
            btn.textContent = 'Not configured yet';
            btn.style.opacity = '0.5';
            setTimeout(() => { btn.textContent = `Choose ${planName}`; btn.style.opacity = ''; }, 2000);
            return;
          }

          // Get auth token
          const token = localStorage.getItem('hakster_google_token');
          if (!token) {
            // Redirect to sign in, then back to pricing
            window.location.href = '/?signin=1&redirect=' + encodeURIComponent(window.location.pathname + '#pricing');
            return;
          }

          // Create checkout session
          btn.textContent = 'Redirecting...';
          btn.style.opacity = '0.7';
          try {
            const res = await fetch(`${API}/api/stripe/checkout`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'x-api-key': token },
              body: JSON.stringify({ priceId: stripePriceId, planId }),
            });
            const data = await res.json();
            if (data.url) {
              window.location.href = data.url;
            } else {
              btn.textContent = data.error || 'Checkout failed';
              btn.style.opacity = '';
              setTimeout(() => { btn.textContent = `Choose ${planName}`; }, 3000);
            }
          } catch (err) {
            btn.textContent = 'Network error';
            btn.style.opacity = '';
            setTimeout(() => { btn.textContent = `Choose ${planName}`; }, 3000);
          }
        });
      });
    })();
  </script>
</section>