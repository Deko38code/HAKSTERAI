---
const links = [
  {
    category: 'Get Started',
    items: [
      { label: 'Installation', href: '#install', desc: 'Install haksterAi on your machine' },
      { label: 'Quick Start', href: '#', desc: 'Your first agentic session in 5 minutes' },
      { label: 'Configuration', href: '#', desc: 'Customize haksterAi to fit your workflow' },
    ],
  },
  {
    category: 'Core Features',
    items: [
      { label: 'Agentic Chat', href: '#', desc: 'AI-powered conversational coding' },
      { label: 'Specs & Tasks', href: '#', desc: 'Structured spec-driven development' },
      { label: 'Hooks', href: '#', desc: 'Automate with intelligent triggers' },
    ],
  },
  {
    category: 'Reference',
    items: [
      { label: 'CLI Reference', href: '#', desc: 'Full command and flag reference' },
      { label: 'MCP Protocol', href: '#', desc: 'Extend haksterAi with custom tools' },
      { label: 'Changelog', href: '#', desc: "What's new in each release" },
    ],
  },
];
---

<section id="docs" class="relative py-24 px-6">
  <!-- Section divider -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#7c3aed]/30 to-transparent"></div>

  <div class="mx-auto max-w-6xl">
    <!-- Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#1e1e2e] bg-[#111118] px-4 py-1.5 text-xs font-semibold text-[#7c3aed] tracking-widest uppercase mb-4">
        Docs
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-[#e2e8f0] mb-4">
        Everything documented.
      </h2>
      <p class="text-[#64748b] text-lg max-w-xl mx-auto">
        Comprehensive guides, API references, and examples to get you moving fast.
      </p>
    </div>

    <!-- Docs grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      {links.map((section) => (
        <div class="rounded-xl border border-[#1e1e2e] bg-[#111118] p-6">
          <h3 class="text-xs font-bold tracking-widest text-[#7c3aed] uppercase mb-4">{section.category}</h3>
          <ul class="space-y-3">
            {section.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group flex flex-col gap-0.5 rounded-lg p-2 -mx-2 hover:bg-[#1e1e2e] transition-colors"
                >
                  <span class="text-sm font-semibold text-[#e2e8f0] group-hover:text-[#a855f7] transition-colors flex items-center gap-1">
                    {item.label}
                    <span class="opacity-0 group-hover:opacity-100 transition-opacity text-[#7c3aed]">→</span>
                  </span>
                  <span class="text-xs text-[#64748b]">{item.desc}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Community row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <a
        href="https://github.com"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-3 rounded-xl border border-[#1e1e2e] bg-[#111118] p-5 hover:border-[#7c3aed]/40 transition-all"
      >
        <span class="text-2xl">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-[#64748b] group-hover:text-[#a855f7] transition-colors">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
        </span>
        <div>
          <p class="text-sm font-semibold text-[#e2e8f0]">GitHub</p>
          <p class="text-xs text-[#64748b]">Source & issues</p>
        </div>
      </a>

      <a
        href="https://discord.com"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-3 rounded-xl border border-[#1e1e2e] bg-[#111118] p-5 hover:border-[#7c3aed]/40 transition-all"
      >
        <span class="text-2xl text-[#64748b] group-hover:text-[#a855f7] transition-colors">💬</span>
        <div>
          <p class="text-sm font-semibold text-[#e2e8f0]">Discord</p>
          <p class="text-xs text-[#64748b]">Community chat</p>
        </div>
      </a>

      <a
        href="#"
        class="group flex items-center gap-3 rounded-xl border border-[#1e1e2e] bg-[#111118] p-5 hover:border-[#7c3aed]/40 transition-all"
      >
        <span class="text-2xl text-[#64748b] group-hover:text-[#a855f7] transition-colors">📝</span>
        <div>
          <p class="text-sm font-semibold text-[#e2e8f0]">Blog</p>
          <p class="text-xs text-[#64748b]">News & tutorials</p>
        </div>
      </a>

      <a
        href="#"
        class="group flex items-center gap-3 rounded-xl border border-[#1e1e2e] bg-[#111118] p-5 hover:border-[#7c3aed]/40 transition-all"
      >
        <span class="text-2xl text-[#64748b] group-hover:text-[#a855f7] transition-colors">🗺️</span>
        <div>
          <p class="text-sm font-semibold text-[#e2e8f0]">Roadmap</p>
          <p class="text-xs text-[#64748b]">What's coming next</p>
        </div>
      </a>
    </div>
  </div>
</section>
