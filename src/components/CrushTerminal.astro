    if (savedFontWeight === 'bold') { panes.forEach(p => { try { p.term.options.fontWeight = 'bold'; } catch {} }); if (boldOnBtn) boldOnBtn.style.borderColor = '#7c3aed'; if (boldOffBtn) boldOffBtn.style.borderColor = '#1e1e2e'; }
    else if (savedFontWeight === 'normal') { if (boldOffBtn) boldOffBtn.style.borderColor = '#7c3aed'; if (boldOnBtn) boldOnBtn.style.borderColor = '#1e1e2e'; }
  } catch {}

  // Fetch model info
  fetch('/api/dashboard').then(r => r.json()).then(d => { if (d.crush && modelBadge) { const model = d.crush.model || ''; modelBadge.textContent = model.length > 20 ? model.substring(0, 18) + '\u2026' : model; } }).catch(() => {});

  // Expose connectPane for external model switching
  function reconnectPane(pane) {
    if (!pane) return;
    pane.reconnAttempts = 0;
    pane.intentionalClose = true;
    // Clear any pending reconnect timer
    if (pane._rt) { clearTimeout(pane._rt); pane._rt = null; }
    if (pane.ws) {
      pane.ws.close();
    }
