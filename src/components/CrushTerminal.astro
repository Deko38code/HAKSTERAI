    setTimeout(() => {
      pane.intentionalClose = false;
      connectPane(pane);
    }, 500);
  }

  // ── External write API ──────────────────────────────────────────
  // Allows other components (e.g. Build page) to write CLI-formatted
  // text into the terminal pane in real-time.
  function termWrite(text) {
    const p = active || panes[0];
    if (p?.term) { p.term.write(text); }
  }
  function termWriteln(text) {
    const p = active || panes[0];
    if (p?.term) { p.term.writeln(text); }
  }
  function termClear() {
    const p = active || panes[0];
    if (p?.term) { p.term.clear(); p.term.write('\x1b[H'); }
  }
  function termScrollToBottom() {
    const p = active || panes[0];
    if (p?.term) { p.term.scrollToBottom(); }
  }
  function termSend(text, execute) {
    const p = active || panes[0];
    const data = String(text || '') + (execute === false ? '' : '\r');
    if (p?.ws?.readyState === WebSocket.OPEN) {
      p.ws.send(JSON.stringify({ type: 'input', data }));
      return true;
    }
    if (p?.term) p.term.writeln(String(text || ''));
    return false;
  }

  function triggerFastDecoder() {
    const p = active || panes[0];
    if (p?.term) p.term.writeln('[DECODER] ready');
  }
  function triggerScrambler() {
    const p = active || panes[0];
    if (p?.term) {
      p.term.writeln('[SCRAMBLER] decoder armed');
      p.term.writeln('[SCRAMBLER] cipher stream ready');
    }
  }
  function triggerCrackingCode() {
    const p = active || panes[0];
    if (p?.term) {
      p.term.writeln('[CRACKING CODE] scramble -> decode -> unlock');
    }
  }

  window.__crushTerminals = window.__crushTerminals || {};
  window.__crushTerminals[TID] = { panes, get active() { return active; }, split: splitPane, close: closePane, zoom: toggleZoom, reconnect: reconnectPane, write: termWrite, writeln: termWriteln, send: termSend, clear: termClear, scrollToBottom: termScrollToBottom, fastDecoder: triggerFastDecoder, scrambler: triggerScrambler, crackingCode: triggerCrackingCode };
})();
