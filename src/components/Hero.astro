---
// Hero section with hakster bubble + scramble-decode terminal
---

<section class="relative min-h-screen flex flex-col items-center justify-center px-6 pt-24 pb-16 overflow-hidden">

  <!-- Background grid -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background-image: linear-gradient(rgba(124,58,237,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(124,58,237,0.04) 1px, transparent 1px); background-size: 40px 40px;"
  ></div>

  <!-- Glow blob -->
  <div
    class="pointer-events-none absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full opacity-20"
    style="background: radial-gradient(circle, #7c3aed 0%, transparent 70%);"
  ></div>

  <!-- Content -->
  <div class="relative z-10 flex flex-col items-center text-center max-w-4xl mx-auto gap-8">

    <!-- Intro with logo backdrop -->
    <div class="relative flex flex-col items-center gap-8 px-2 py-8 md:px-8 md:py-12">
      <img
        src="/logo.png"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute left-1/2 top-0 -z-10 w-[min(92vw,680px)] -translate-x-1/2 opacity-30 blur-[1px] saturate-125"
      />
      <div class="pointer-events-none absolute left-1/2 top-6 -z-10 h-[min(72vw,520px)] w-[min(92vw,680px)] -translate-x-1/2 bg-gradient-to-b from-transparent via-[#06070d]/55 to-[#06070d]"></div>

      <!-- hakster bubble badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-[#7c3aed]/50 bg-[#080911]/70 px-5 py-2.5 backdrop-blur-md shadow-lg shadow-[#7c3aed]/10">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#a855f7] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[#7c3aed]"></span>
        </span>
        <span class="text-sm font-semibold tracking-widest text-[#a855f7] uppercase">hakster</span>
        <span class="text-xs text-[#64748b] border-l border-[#7c3aed]/30 pl-2">v1.0 · always running</span>
      </div>

      <!-- Heading -->
      <h1 class="text-5xl md:text-7xl font-bold leading-tight tracking-tight">
        <span class="text-[#f8fafc] drop-shadow-[0_2px_18px_rgba(0,0,0,0.85)]">The agent that</span><br />
        <span class="bg-gradient-to-r from-[#38bdf8] via-[#a855f7] to-[#c084fc] bg-clip-text text-transparent drop-shadow-[0_2px_18px_rgba(0,0,0,0.85)]">
          gets it done.
        </span>
      </h1>

      <!-- Subheading -->
      <p class="max-w-2xl text-lg md:text-xl text-[#cbd5e1] leading-relaxed drop-shadow-[0_2px_14px_rgba(0,0,0,0.9)]">
        haksterAi is always running — reasoning through problems, executing tasks end-to-end, and telling you when the job's done. The top-tier autonomous agent for your terminal.
      </p>
    </div>

    <!-- CTA buttons -->
    <div id="hero-cta-logged-out" class="flex flex-col sm:flex-row items-center gap-4">
      <button
        id="hero-google-signin"
        class="inline-flex items-center gap-2.5 rounded-lg bg-white px-6 py-3 text-base font-semibold text-gray-800 hover:bg-gray-100 transition-all hover:shadow-lg active:scale-95 cursor-pointer"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
        Sign in with Google
      </button>
      <button
        id="hero-telegram-signin"
        class="inline-flex items-center gap-2.5 rounded-lg bg-[#229ED9] px-6 py-3 text-base font-semibold text-white hover:bg-[#1c8ac2] transition-all hover:shadow-lg active:scale-95 cursor-pointer"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8-1.62 7.63c-.12.55-.44.68-.9.42l-2.48-1.83-1.2 1.15c-.13.13-.24.24-.5.24l.18-2.54 4.63-4.18c.2-.18-.04-.28-.32-.1l-5.72 3.6-2.46-.77c-.54-.17-.55-.54.11-.8l9.62-3.71c.45-.16.84.1.66.89z"/></svg>
        Log in with Telegram
      </button>
      <a
        href="#install"
        class="inline-flex items-center gap-2 rounded-lg bg-[#7c3aed] px-6 py-3 text-base font-semibold text-white hover:bg-[#6d28d9] transition-all hover:shadow-lg hover:shadow-[#7c3aed]/30 active:scale-95"
      >
        <span>↓</span> Get haksterAi
      </a>
      <a
        href="/terminal"
        class="hero-app-link inline-flex items-center gap-2 rounded-lg border border-[#7c3aed]/40 bg-[#111118] px-6 py-3 text-base font-semibold text-[#e2e8f0] hover:border-[#7c3aed]/70 hover:bg-[#1e1e2e] transition-all"
      >
        <span>⌨️</span> Terminal
      </a>
      <a
        href="#docs"
        class="inline-flex items-center gap-2 rounded-lg border border-[#1e1e2e] bg-[#111118] px-6 py-3 text-base font-semibold text-[#e2e8f0] hover:border-[#7c3aed]/50 hover:bg-[#1e1e2e] transition-all"
      >
        Read the docs →
      </a>
    </div>

    <!-- Logged-in CTA (hidden by default) -->
    <div id="hero-cta-logged-in" class="hidden flex-col sm:flex-row items-center gap-4">
      <a
        href="/build"
        class="hero-app-link inline-flex items-center gap-2 rounded-lg bg-[#7c3aed] px-6 py-3 text-base font-semibold text-white hover:bg-[#6d28d9] transition-all hover:shadow-lg hover:shadow-[#7c3aed]/30 active:scale-95"
      >
        <span>💬</span> Enter Chat
      </a>
      <a
        href="/terminal"
        class="hero-app-link inline-flex items-center gap-2 rounded-lg border border-[#1e1e2e] bg-[#111118] px-6 py-3 text-base font-semibold text-[#e2e8f0] hover:border-[#7c3aed]/50 hover:bg-[#1e1e2e] transition-all"
      >
        <span>⌨️</span> Open Terminal
      </a>
      <a
        href="#docs"
        class="inline-flex items-center gap-2 rounded-lg border border-[#1e1e2e] bg-[#111118] px-6 py-3 text-base font-semibold text-[#e2e8f0] hover:border-[#7c3aed]/50 hover:bg-[#1e1e2e] transition-all"
      >
        Read the docs →
      </a>
    </div>

    <!-- Terminal preview with scramble-decode effect -->
    <div class="w-full max-w-2xl rounded-xl border border-[#1e1e2e] bg-[#111118] overflow-hidden shadow-2xl shadow-black/50 mt-4">

      <!-- Terminal title bar -->
      <div class="flex items-center gap-2 px-4 py-3 border-b border-[#1e1e2e] bg-[#0d0d14]">
        <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
        <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
        <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
        <span class="ml-2 text-xs text-[#64748b] font-mono">terminal — haksterAi</span>
      </div>

      <!-- Terminal body -->
      <div class="p-6 font-mono text-sm text-left min-h-[200px]" id="hero-terminal">

        <!-- Command line -->
        <div class="flex items-center gap-2 mb-3">
          <span class="text-[#7c3aed] font-bold">❯</span>
          <span id="hero-cmd" class="text-[#e2e8f0]"></span>
          <span id="hero-cursor" class="inline-block w-2 h-4 bg-[#a855f7] animate-pulse ml-0.5"></span>
        </div>

        <!-- Scramble output area -->
        <div id="hero-output" class="pl-4 space-y-0.5"></div>

      </div>

    </div>

  </div>
</section>

<script is:inline src="https://telegram.org/js/telegram-widget.js?22"></script>

<script>
  // ── HAKSTER HERO — Big-Chunk Scramble & Decode Engine ────────────
  const SC = '\u2591\u2592\u2593\u2588\u2584\u2580\u25A0\u25A1\u25AA\u25AB\u29EB\u2BC3\u2BC2\u27D0\u27D1\uFF3A\uFF3B\uFF3C\uFF3D\uFF3E\uFF3F';
  const SC_CODE = '{}[]<>()=;:!@#$%^&*+-_|~`?/';

  function scramble(text, chaos) {
    chaos = chaos || 0.55;
    var pool = SC + SC_CODE;
    var out = '';
    for (var i = 0; i < text.length; i++) {
      var c = text[i];
      if (c === ' ' || c === '\n' || c === '\r' || c === '\t') { out += c; continue; }
      if (Math.random() < chaos) {
        out += pool[Math.floor(Math.random() * pool.length)];
      } else {
        out += c;
      }
    }
    return out;
  }

  function decodePass(original, pass, total) {
    var progress = pass / total;
    var chaos = 0.55 * Math.pow(1 - progress, 2);
    var waveFront = Math.floor(original.length * progress * 1.1);
    var pool = SC + SC_CODE;
    var out = '';
    for (var i = 0; i < original.length; i++) {
      var c = original[i];
      if (c === ' ' || c === '\n' || c === '\r' || c === '\t') { out += c; continue; }
      if (i < waveFront * 0.75) {
        out += c;
      } else if (Math.random() < chaos) {
        out += pool[Math.floor(Math.random() * pool.length)];
      } else {
        out += c;
      }
    }
    return out;
  }

  var SEQUENCES = [
    {
      cmd: 'hakster spec "add user auth with JWT"',
      reasoning: 'Analyzing codebase... found 3 entry points needing auth middleware',
      lines: [
        { text: '\u2713 Created src/auth/jwt.ts', color: '#28c840' },
        { text: '\u2713 Created src/auth/middleware.ts', color: '#28c840' },
        { text: '\u2713 Created src/routes/auth.ts', color: '#28c840' },
        { text: '\u2713 All tests passing (12/12)', color: '#a855f7' },
      ],
    },
    {
      cmd: 'hakster fix ./src/api/users.ts',
      reasoning: 'Scanning for errors... null dereference on line 47 \u2192 patching',
      lines: [
        { text: '\u2713 Fixed null dereference in getUser()', color: '#28c840' },
        { text: '\u2713 Added defensive checks (3 locations)', color: '#28c840' },
        { text: '\u2713 Tests: 8/8 passing', color: '#a855f7' },
      ],
    },
    {
      cmd: 'hakster test --coverage',
      reasoning: 'Running suite with coverage... analyzing gaps...',
      lines: [
        { text: '\u2713 47 tests passed, 0 failed', color: '#28c840' },
        { text: '\u2713 Coverage: 94.2% statements', color: '#00bfff' },
        { text: '\u2713 Coverage: 88.1% branches', color: '#00bfff' },
      ],
    },
    {
      cmd: 'hakster chat "optimize the database queries"',
      reasoning: 'Profiling slow queries... found N+1 in getUsers() \u2192 batching',
      lines: [
        { text: '\u2713 Replaced N+1 with batch query', color: '#28c840' },
        { text: '\u2713 Added composite index on (user_id, created_at)', color: '#28c840' },
        { text: '\u2713 Query time: 340ms \u2192 12ms', color: '#ffd700' },
      ],
    },
  ];

  var cmdEl = document.getElementById('hero-cmd');
  var cursorEl = document.getElementById('hero-cursor');
  var outputEl = document.getElementById('hero-output');
  var seqIdx = 0;
  var cancelled = false;

  function delay(ms) { return new Promise(function(r) { setTimeout(r, ms); }); }

  async function typeCmd(cmd) {
    cmdEl.textContent = '';
    for (var i = 0; i < cmd.length; i++) {
      if (cancelled) return;
      cmdEl.textContent = cmd.slice(0, i + 1);
      await delay(30);
    }
    await delay(250);
  }

  async function showReasoning(text) {
    if (!text) return;
    var div = document.createElement('div');
    div.className = 'mb-2';
    div.style.cssText = 'border-left:2px solid #7c3aed;padding-left:8px;margin-left:-8px;';
    var label = document.createElement('span');
    label.style.cssText = 'color:#a855f7;font-size:0.7rem;display:block;margin-bottom:2px;';
    label.textContent = '\uD83E\uDDB0 Reasoning';
    div.appendChild(label);
    var content = document.createElement('span');
    content.style.cssText = 'color:#c084fc;font-size:0.8rem;';
    content.textContent = scramble(text, 0.6);
    div.appendChild(content);
    outputEl.appendChild(div);
    await delay(50);
    content.textContent = decodePass(text, 1, 3);
    await delay(40);
    content.textContent = decodePass(text, 2, 3);
    await delay(35);
    content.textContent = text;
  }

  async function showOutputLine(line, color) {
    var div = document.createElement('div');
    div.style.cssText = 'color:' + color + ';min-height:1.4em;';
    div.textContent = scramble(line.text, 0.55);
    outputEl.appendChild(div);
    await delay(35);
    div.textContent = decodePass(line.text, 1, 2);
    await delay(30);
    div.textContent = line.text;
  }

  async function runSequence() {
    var seq = SEQUENCES[seqIdx];
    seqIdx = (seqIdx + 1) % SEQUENCES.length;
    await typeCmd(seq.cmd);
    await delay(150);
    cursorEl.style.display = 'none';
    await showReasoning(seq.reasoning);
    await delay(100);
    for (var i = 0; i < seq.lines.length; i++) {
      await showOutputLine(seq.lines[i], seq.lines[i].color);
      await delay(60);
    }
    await delay(2200);
    outputEl.style.transition = 'opacity 0.3s';
    outputEl.style.opacity = '0';
    cmdEl.style.transition = 'opacity 0.3s';
    cmdEl.style.opacity = '0';
    await delay(350);
    outputEl.innerHTML = '';
    outputEl.style.opacity = '1';
    cmdEl.textContent = '';
    cmdEl.style.opacity = '1';
    cursorEl.style.display = '';
    await delay(300);
  }

  async function loop() {
    while (!cancelled) { await runSequence(); }
  }

  setTimeout(loop, 800);
  document.addEventListener('astro:before-swap', function() { cancelled = true; });

  // ── Google Auth on landing page ──────────────────────────────
  const API = location.port === '4321' ? 'http://localhost:3579' : '';

  // Check for existing session
  (function() {
    const params = new URLSearchParams(window.location.search);
    const ref = params.get('ref') || params.get('referral');
    if (ref) localStorage.setItem('hakster_referral_code', ref.replace(/[^a-z0-9]/gi, '').toUpperCase().slice(0, 24));
    const token = localStorage.getItem('hakster_google_token');
    const user = localStorage.getItem('hakster_google_user');
    if (token && user) {
      const out = document.getElementById('hero-cta-logged-out');
      const inn = document.getElementById('hero-cta-logged-in');
      if (out) out.style.display = 'none';
      if (inn) { inn.classList.remove('hidden'); inn.classList.add('flex'); }
    }
  })();

  // Google Sign-In button → redirect-based OAuth
  document.getElementById('hero-google-signin')?.addEventListener('click', function() {
    const ref = localStorage.getItem('hakster_referral_code') || '';
    sessionStorage.removeItem('hakster_post_auth_redirect');
    window.location.href = `${API}/api/auth/google/redirect${ref ? `?ref=${encodeURIComponent(ref)}` : ''}`;
  });

  // Telegram Login Widget → same account system as Google/Mini App auth
  // (server-verifies the signed payload, see /api/auth/telegram/widget).
  // NOTE: requires the bot's domain to be set once via @BotFather:
  // send /setdomain to BotFather, pick @Haksterbotbot, enter haksterai.com.
  document.getElementById('hero-telegram-signin')?.addEventListener('click', function() {
    if (!(window as any).Telegram?.Login) {
      alert('Telegram login is still loading — try again in a second.');
      return;
    }
    (window as any).Telegram.Login.auth(
      { bot_id: '8950486437', request_access: true },
      async (tgUser: any) => {
        if (!tgUser) return; // user cancelled
        try {
          const res = await fetch(`${API}/api/auth/telegram/widget`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(tgUser),
          });
          const data = await res.json();
          if (!data.ok) { alert('Telegram login failed: ' + data.error); return; }
          localStorage.setItem('hakster_google_token', data.apiKey);
          localStorage.setItem('hakster_google_user', JSON.stringify(data.user));
          localStorage.setItem('hakster_user_data', JSON.stringify({ id: data.user.id || '', name: data.user.displayName || data.user.username || 'User', email: data.user.email || '', picture: data.user.picture || '' }));
          window.location.href = '/build';
        } catch (e) {
          alert('Telegram login error — see console.');
          console.error(e);
        }
      }
    );
  });

  // Hero app links redirect to Google sign-in if not logged in
  document.querySelectorAll('.hero-app-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      const token = localStorage.getItem('hakster_google_token');
      if (token) return;
      e.preventDefault();
      const href = link.getAttribute('href');
      sessionStorage.setItem('hakster_post_auth_redirect', href || '/dashboard');
      window.location.href = `${API}/api/auth/google/redirect`;
    });
  });

  // Handle OAuth callback if redirected back to landing page
  (function() {
    const params = new URLSearchParams(window.location.search);
    const googleAuth = params.get('google_auth');
    if (googleAuth) {
      try {
        const data = JSON.parse(decodeURIComponent(googleAuth));
        if (data.ok) {
          localStorage.setItem('hakster_google_token', data.apiKey);
          localStorage.setItem('hakster_google_user', JSON.stringify(data.user));
          const postAuthRedirect = sessionStorage.getItem('hakster_post_auth_redirect');
          if (postAuthRedirect) sessionStorage.removeItem('hakster_post_auth_redirect');
          window.location.href = postAuthRedirect || '/build';
          return;
        }
      } catch (e) {}
      // Clean URL
      window.history.replaceState({}, '', window.location.pathname);
    }
    const googleError = params.get('google_error');
    if (googleError) {
      console.error('Google auth error:', googleError);
      window.history.replaceState({}, '', window.location.pathname);
    }

    // Handle signin=1 redirect from pricing/build pages
    const signinRequested = params.get('signin');
    if (signinRequested === '1') {
      const redirect = params.get('redirect') || window.location.pathname;
      sessionStorage.setItem('hakster_post_auth_redirect', redirect);
      // Auto-trigger Google OAuth
      window.location.href = `${API}/api/auth/google/redirect`;
      return;
    }
  })();
</script>
