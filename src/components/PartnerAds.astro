<aside class="network-ads" aria-label="Shared sponsored ads popup">
  <div class="network-ads-heading">Sponsored ads · Phantom IDE + HaksterAI</div>
  <div class="ad-card" data-network-ad-card>
    <a class="creative" data-ad-link href="https://junkalot.co/portfolio" target="_blank" rel="noopener noreferrer sponsored">
      <img class="art" data-ad-image src="/ad-fallback-pool-cleanup.png" alt="Junkalot pool cleanup" fetchpriority="high">
      <div class="copy">
        <div class="eyebrow" data-ad-kind>JUNKALOT</div>
        <div class="title" data-ad-title>Before &amp; after: pool cleanup</div>
        <div class="support" data-ad-support>A real completed job in Contra Costa County. See more Junkalot work.</div>
        <div class="domain" data-ad-domain>junkalot.co</div>
        <span class="cta" data-ad-cta>SEE REAL JOBS →</span>
        <div class="dots" data-ad-dots aria-hidden="true"><i class="dot on"></i></div>
      </div>
    </a>
    <div class="social-actions">
      <a class="social-button" data-facebook href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fjunkalot.co%2Fportfolio" target="_blank" rel="noopener noreferrer">f&nbsp; Facebook</a>
      <button class="social-button" data-instagram type="button">◎&nbsp; Instagram</button>
    </div>
  </div>
</aside>

<script>
  const FEED_URL = 'https://rmt.haksterai.com/api/public/cards';
  const FALLBACK_AD = {
    id: 'network-fallback-junkalot', title: 'Junkalot · Pool Cleanup', kind: 'JUNKALOT',
    headline: 'Before & after: pool cleanup', support: 'A real completed job in Contra Costa County. See more Junkalot work.',
    image: '/ad-fallback-pool-cleanup.png',
    href: 'https://junkalot.co/portfolio', cta: 'SEE REAL JOBS'
  };
  const root = document.querySelector('[data-network-ad-card]');
  if (root) {
    const link = root.querySelector('[data-ad-link]');
    const image = root.querySelector('[data-ad-image]');
    const kind = root.querySelector('[data-ad-kind]');
    const title = root.querySelector('[data-ad-title]');
    const support = root.querySelector('[data-ad-support]');
    const domain = root.querySelector('[data-ad-domain]');
    const cta = root.querySelector('[data-ad-cta]');
    const dots = root.querySelector('[data-ad-dots]');
    const facebook = root.querySelector('[data-facebook]');
    const instagram = root.querySelector('[data-instagram]');
    let ads = [FALLBACK_AD];
    let index = 0;
    let rotationMs = 8000;

    const safeUrl = (value) => {
      try {
        const parsed = new URL(value);
        return /^https?:$/.test(parsed.protocol) ? parsed.href : '';
      } catch { return ''; }
    };
    const render = (nextIndex) => {
      if (!ads.length) return;
      const ad = ads[nextIndex % ads.length];
      const href = safeUrl(ad.href) || safeUrl(FALLBACK_AD.href);
      const imageUrl = ad.image === FALLBACK_AD.image ? FALLBACK_AD.image : safeUrl(ad.image) || FALLBACK_AD.image;
      const preloaded = new Image();
      preloaded.onload = () => {
        index = nextIndex % ads.length;
        link.href = href;
        image.src = imageUrl;
        image.alt = ad.title || 'Sponsored campaign';
        kind.textContent = ad.kind || 'SPONSORED';
        title.textContent = ad.headline || ad.title || 'Explore';
        support.textContent = ad.support || '';
        try { domain.textContent = ad.host || new URL(href).hostname.replace(/^www\./i, ''); }
        catch { domain.textContent = ''; }
        cta.textContent = `${ad.cta || 'LEARN MORE'} →`;
        facebook.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(href)}`;
        dots.replaceChildren(...ads.map((_, dotIndex) => {
          const dot = document.createElement('i');
          dot.className = `dot${dotIndex === index ? ' on' : ''}`;
          return dot;
        }));
        instagram.onclick = async () => {
          try {
            if (navigator.share) await navigator.share({ title: ad.title || 'Sponsored offer', text: ad.headline || '', url: href });
            else if (navigator.clipboard?.writeText) {
              await navigator.clipboard.writeText(href);
              instagram.textContent = 'Link copied';
              setTimeout(() => { instagram.textContent = '◎ Instagram'; }, 1800);
            }
          } catch {}
        };
      };
      preloaded.onerror = () => {
        if (ad.id !== FALLBACK_AD.id) renderFallback();
      };
      preloaded.src = imageUrl;
    };
    const renderFallback = () => {
      ads = [FALLBACK_AD];
      render(0);
    };

    const loadAds = async () => {
      try {
        const response = await fetch(FEED_URL, { cache: 'no-store', mode: 'cors' });
        if (!response.ok) throw new Error(`Ad feed returned ${response.status}`);
        const feed = await response.json();
        const activeAds = (feed.templates || []).filter(ad => ad.status === 'active' && safeUrl(ad.href));
        if (activeAds.length) {
          ads = activeAds;
          rotationMs = Math.max(4000, Number(feed.rotation_seconds || 8) * 1000);
          render(0);
        }
      } catch (error) {
        console.warn('[sponsored-ads] live feed unavailable; showing the built-in ad', error);
      }
    };

    setInterval(() => render((index + 1) % ads.length), rotationMs);
    setInterval(loadAds, 30000);
    loadAds();
  }
</script>

<style>
  .network-ads{display:block;position:fixed;right:14px;bottom:14px;z-index:70;width:min(420px,calc(100vw - 28px));max-height:min(62vh,560px);overflow:auto;overscroll-behavior:contain;margin:0;padding:clamp(12px,2vw,20px);border:1px solid #7c3aed88;border-radius:14px;background:#0a0a0ff5;box-shadow:0 18px 55px #000b}
  .network-ads-heading{padding:2px 4px 9px;color:#e9d5ff;font-size:12px;font-weight:800}
  .ad-card{display:flex;flex-direction:column;gap:8px;width:100%;min-height:0}
  .creative{min-width:0;display:flex;flex-direction:column;gap:12px;align-items:stretch;width:100%;padding:clamp(10px,2vw,16px);color:inherit;text-decoration:none;border:1px solid #a78bfa70;border-radius:12px;background:linear-gradient(130deg,#171327,#0d111a)}
  .art{display:block;width:100%;height:clamp(96px,16vh,150px);max-height:150px;object-fit:contain;border-radius:8px;background:#171b24}
  .copy{min-width:0;display:flex;flex-direction:column;gap:6px}
  .eyebrow{font-size:clamp(8px,2vw,10px);letter-spacing:.12em;color:#c4b5fd;font-weight:800;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .title{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-size:clamp(14px,4vw,21px);font-weight:900;margin:2px 0;line-height:1.12}
  .support{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-size:clamp(10px,2.6vw,12px);color:#c1c8d4;line-height:1.3}
  .domain{overflow:hidden;color:#e9d5ff;font-size:clamp(9px,2.2vw,11px);font-weight:700;line-height:1.2;text-overflow:ellipsis;white-space:nowrap}
  .cta{display:inline-block;align-self:flex-start;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:4px;border-radius:20px;background:#f5b325;color:#15171a;padding:6px 10px;font-size:9px;font-weight:900;letter-spacing:.05em}
  .dots{display:flex;gap:4px;margin-top:3px;overflow:hidden}
  .dot{flex:0 0 5px;width:5px;height:5px;background:#535866;border-radius:50%}
  .dot.on{background:#f5b325}
  .social-actions{display:flex;align-items:center;justify-content:flex-end;gap:6px;padding:2px}
  .social-button{display:inline-flex;align-items:center;justify-content:center;min-height:30px;padding:6px 12px;border:1px solid #ffffff2c;border-radius:999px;background:#12131c;color:#e9d5ff;font:700 11px/1 system-ui,sans-serif;text-decoration:none;cursor:pointer}
  .social-button:hover,.social-button:focus-visible{border-color:#c084fc;color:#fff;outline:2px solid #c084fc55;outline-offset:1px}
  @media(max-width:360px){.creative{gap:8px;padding:8px}.title{font-size:14px}.support{-webkit-line-clamp:2}.cta{font-size:8px;padding:5px 8px}.social-button{min-height:28px;padding:5px 9px;font-size:10px}}
</style>
