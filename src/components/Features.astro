---
const features = [
  {
    icon: '🤖',
    title: 'Autonomous Agent',
    description: 'Always on, always running. haksterAi tackles tasks end-to-end — from reasoning to execution — outperforming generic AI assistants on real coding work.',
  },
  {
    icon: '🧠',
    title: 'Live Reasoning Grid',
    description: 'Watch the agent think in real-time with step tracking, depth analysis, and structured insight panels. Full transparency into every decision.',
  },
  {
    icon: '⚡',
    title: 'Agentic Chat',
    description: 'Talk to your codebase. haksterAi understands context, reads files, writes code, and executes tasks autonomously — no hand-holding needed.',
  },
  {
    icon: '🔬',
    title: 'Spec-Driven Dev',
    description: 'Turn a prompt into structured requirements, architecture designs, and sequenced tasks — then let the agent execute them flawlessly.',
  },
  {
    icon: '🗂️',
    title: 'File Intelligence',
    description: 'haksterAi reads, writes, and refactors files across your entire project with full awareness of your codebase.',
  },
  {
    icon: '🔌',
    title: 'MCP Servers',
    description: 'Connect external tools, APIs, and data sources through the Model Context Protocol for unlimited extensibility.',
  },
  {
    icon: '🔁',
    title: 'Smart Hooks',
    description: 'Automate repetitive workflows with intelligent triggers. Run tests on save, lint on commit, deploy on push.',
  },
  {
    icon: '✅',
    title: 'Job-Done Alerts',
    description: 'Get clear completion banners with metrics — tool calls, thinking steps, tokens, and time elapsed. Plus browser notifications when tasks finish.',
  },
  {
    icon: '🔒',
    title: 'Privacy First',
    description: 'Your code stays yours. haksterAi runs locally with full control over what gets sent anywhere.',
  },
];
---

<section id="features" class="relative py-20 px-6">
  <!-- Section divider -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#7c3aed]/30 to-transparent"></div>

  <div class="mx-auto max-w-6xl">
    <!-- Header -->
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#1e1e2e] bg-[#111118] px-4 py-1.5 text-xs font-semibold text-[#7c3aed] tracking-widest uppercase mb-4">
        Features
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-[#e2e8f0] mb-3">
        The top-tier agent.<br />
        <span class="text-[#64748b]">Always running.</span>
      </h2>
      <p class="text-[#64748b] text-base max-w-xl mx-auto">
        haksterAi doesn't just chat — it reasons, plans, and executes. Real-time thinking grids, autonomous task completion, and job-done alerts built in.
      </p>
    </div>

    <!-- Feature grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
      {features.map((f) => (
        <div class="group relative rounded-lg border border-[#1e1e2e] bg-[#111118] p-4 hover:border-[#7c3aed]/40 hover:bg-[#14141f] transition-all duration-200">
          <!-- Hover glow -->
          <div class="pointer-events-none absolute inset-0 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200"
            style="background: radial-gradient(400px circle at 50% 50%, rgba(124,58,237,0.04), transparent);">
          </div>

          <div class="relative z-10 flex gap-3">
            <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg border border-[#1e1e2e] bg-[#0d0d14] text-lg">
              {f.icon}
            </div>
            <div class="min-w-0">
              <h3 class="mb-1 text-sm font-bold text-[#e2e8f0]">{f.title}</h3>
              <p class="text-xs text-[#64748b] leading-relaxed">{f.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
