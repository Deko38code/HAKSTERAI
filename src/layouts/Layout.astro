---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'haksterAi — Agentic CLI for Developers',
  description = 'haksterAi is an AI-powered CLI that turns your terminal into an agentic engineering powerhouse.'
} = Astro.props;

const showGlobalFullscreen = !['/build', '/build/'].includes(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/logo-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:image" content="/logo-512.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/xterm.css" />
  </head>
  <body>
    <!-- Navbar -->
    <header id="navbar" class="fixed top-0 left-0 right-0 z-50 border-b border-[#1e1e2e] bg-[#0a0a0f]/80 backdrop-blur-md transition-shadow duration-300">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <img src="/logo-192.png" alt="haksterAi" class="w-12 h-12 rounded-lg group-hover:scale-110 transition-transform" />
          <span class="text-[#e2e8f0] font-bold text-2xl md:text-3xl tracking-tight">hakster<span class="text-[#7c3aed]">Ai</span></span>
        </a>

        <!-- Desktop nav links -->
        <div class="hidden md:flex items-center gap-2 bg-[#111118]/80 border border-[#1e1e2e] rounded-full px-2 py-1.5 backdrop-blur-sm">
          <a href="/labs" class="nav-link requires-auth px-3 py-1.5 rounded-full text-sm font-semibold text-[#94a3b8] hover:text-[#a855f7] hover:bg-[#7c3aed]/10 transition-all flex items-center gap-1.5"><span>🧪</span> Labs</a>
          <a href="/hack" class="nav-link requires-auth px-3 py-1.5 rounded-full text-sm font-semibold text-[#94a3b8] hover:text-[#00ff88] hover:bg-[#00ff88]/10 transition-all flex items-center gap-1.5"><span>⚡</span> Hack Lab</a>
          <a href="/portal" class="nav-link requires-auth px-3 py-1.5 rounded-full text-sm font-semibold text-[#94a3b8] hover:text-[#f39c12] hover:bg-[#f39c12]/10 transition-all flex items-center gap-1.5"><span>🌐</span> Portal</a>
          <a href="/dashboard" data-admin-only="true" class="nav-link requires-auth px-3 py-1.5 rounded-full text-sm font-semibold text-[#94a3b8] hover:text-[#e2e8f0] hover:bg-[#7c3aed]/20 transition-all hidden items-center gap-1.5"><span>📊</span> Dashboard</a>
          <a href="/terminal" class="nav-link requires-auth px-3 py-1.5 rounded-full text-sm font-semibold text-[#94a3b8] hover:text-[#a855f7] hover:bg-[#7c3aed]/10 transition-all flex items-center gap-1.5"><span>⌨️</span> Terminal</a>
          <a href="/build" class="nav-link requires-auth px-3 py-1.5 rounded-full text-sm font-semibold text-[#94a3b8] hover:text-[#e2e8f0] hover:bg-[#7c3aed]/20 transition-all flex items-center gap-1.5"><span>💬</span> Chat</a>
        </div>

        <!-- Desktop CTA + user badge + GitHub -->
        <div class="hidden md:flex items-center gap-3">
          <div id="nav-user-badge" class="hidden items-center gap-2.5 px-3 py-1.5 rounded-lg border border-[#1e1e2e] bg-[#111118]">
            <div id="nav-user-avatar" class="w-7 h-7 rounded-full bg-[#7c3aed]/20 border border-[#7c3aed]/30 flex items-center justify-center text-xs font-bold text-[#a855f7]"></div>
            <span id="nav-user-name" class="text-sm text-[#e2e8f0] font-medium max-w-[100px] truncate"></span>
            <span id="nav-user-id" class="hidden rounded bg-[#7c3aed]/15 px-1.5 py-0.5 text-[10px] font-bold text-[#c084fc]"></span>
            <button id="nav-logout-btn" class="text-[#ef4444] hover:text-red-400 transition-colors text-xs" title="Sign out">⏻</button>
          </div>
          <div id="nav-signin-btn" class="hidden">
            <a href="/api/auth/google" class="inline-flex items-center gap-2 rounded-lg bg-[#7c3aed] px-4 py-2 text-sm font-semibold text-white hover:bg-[#6d28d9] transition-colors">
              <span>🔐</span> Sign In
            </a>
          </div>
          <a
            href="https://github.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#64748b] hover:text-[#e2e8f0] transition-colors"
            aria-label="GitHub"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>

        <!-- Mobile hamburger + quick logout -->
        <div class="md:hidden flex items-center gap-2">
          <button id="mobile-logout-btn" class="hidden flex items-center justify-center w-9 h-9 rounded-lg border border-[#ef4444]/30 bg-[#ef4444]/10 text-[#ef4444] transition-colors hover:bg-[#ef4444]/20" aria-label="Sign out" title="Sign out">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          </button>
          <button
            id="menu-btn"
            class="md:hidden flex flex-col justify-center items-center w-9 h-9 gap-1.5 rounded-lg border border-[#1e1e2e] bg-[#111118] hover:border-[#7c3aed]/50 transition-colors"
            aria-label="Toggle menu"
            aria-expanded="false"
          >
          <span id="bar1" class="block w-5 h-0.5 bg-[#e2e8f0] transition-all duration-300 origin-center"></span>
          <span id="bar2" class="block w-5 h-0.5 bg-[#e2e8f0] transition-all duration-300"></span>
          <span id="bar3" class="block w-5 h-0.5 bg-[#e2e8f0] transition-all duration-300 origin-center"></span>
          </button>
        </div>
      </nav>

      <!-- Mobile menu (hidden by default) -->
      <div
      id="mobile-menu"
      class="md:hidden hidden border-t border-[#1e1e2e] bg-[#0a0a0f]/95 backdrop-blur-md"
      >
      <div class="mx-auto max-w-6xl px-6 py-4 flex flex-col gap-4">
        <a href="/hack" class="mobile-nav-link requires-auth text-sm font-semibold text-[#00ff88] hover:text-[#a855f7] transition-colors py-2 border-b border-[#1e1e2e] flex items-center gap-2"><span>⚡</span> Hack Lab</a>
        <a href="/portal" class="mobile-nav-link requires-auth text-sm font-medium text-[#f39c12] hover:text-[#e2e8f0] transition-colors py-2 border-b border-[#1e1e2e] flex items-center gap-2"><span>🌐</span> Portal</a>
        <a href="/dashboard" data-admin-only="true" class="mobile-nav-link requires-auth text-sm font-medium text-[#64748b] hover:text-[#e2e8f0] transition-colors py-2 border-b border-[#1e1e2e] hidden items-center gap-2"><span>📊</span> Dashboard</a>
        <a href="/terminal" class="mobile-nav-link requires-auth text-sm font-medium text-[#64748b] hover:text-[#e2e8f0] transition-colors py-2 border-b border-[#1e1e2e] flex items-center gap-2"><span>⌨️</span> Terminal</a>
        <a href="/build" class="mobile-nav-link requires-auth text-sm font-medium text-[#64748b] hover:text-[#e2e8f0] transition-colors py-2 border-b border-[#1e1e2e] flex items-center gap-2"><span>💬</span> Chat</a>
        <!-- Mobile user badge + logout -->
        <div id="mobile-user-section" class="hidden pt-3">
          <div class="flex items-center gap-2.5 px-1 pb-3 border-b border-[#1e1e2e]">
            <div id="mobile-user-avatar" class="w-8 h-8 rounded-full bg-[#7c3aed]/20 border border-[#7c3aed]/30 flex items-center justify-center text-sm font-bold text-[#a855f7]"></div>
            <div class="flex-1 min-w-0">
              <div id="mobile-user-name" class="text-sm text-[#e2e8f0] font-medium truncate"></div>
              <div id="mobile-user-email" class="text-xs text-[#64748b] truncate"></div>
              <div id="mobile-user-id" class="text-[10px] font-bold text-[#a855f7] truncate"></div>
            </div>
          </div>
          <button id="mobile-menu-logout" class="w-full mt-3 flex items-center justify-center gap-2 rounded-lg border border-[#ef4444]/30 bg-[#ef4444]/10 hover:bg-[#ef4444]/20 text-[#ef4444] text-sm font-semibold py-2.5 transition">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            Sign Out
          </button>
        </div>
        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://github.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#64748b] hover:text-[#e2e8f0] transition-colors"
            aria-label="GitHub"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>
      </div>
    </header>

    {showGlobalFullscreen && (
      <button type="button" id="global-fullscreen-btn" class="global-fullscreen-btn" title="Fullscreen" aria-label="Fullscreen" aria-pressed="false">
        <svg class="fullscreen-enter" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 3H3v5m13-5h5v5M8 21H3v-5m18 0v5h-5"/>
        </svg>
        <svg class="fullscreen-exit" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v6H3m12-6v6h6M9 21v-6H3m12 6v-6h6"/>
        </svg>
      </button>
    )}

    <!-- Page content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#1e1e2e] bg-[#0a0a0f] py-12 mt-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="flex items-center gap-2">
            <img src="/logo-32.png" alt="haksterAi" class="w-6 h-6 rounded" />
            <span class="text-[#e2e8f0] font-bold">hakster<span class="text-[#7c3aed]">Ai</span></span>
          </div>
          <div class="flex items-center gap-6 text-sm text-[#64748b]">
            <a href="/hack" class="hover:text-[#00ff88] transition-colors text-[#00ff88] font-semibold">⚡ Hack Lab</a>
            <a href="/terminal" class="hover:text-[#a855f7] transition-colors">⌨️ Terminal</a>
            <a href="/portal" class="hover:text-[#e2e8f0] transition-colors">🌐 Portal</a>
            <a href="/build" class="hover:text-[#e2e8f0] transition-colors">💬 Chat</a>
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#e2e8f0] transition-colors">GitHub</a>
          </div>
          <p class="text-xs text-[#64748b]">
            © {new Date().getFullYear()} haksterAi. Built for the terminal.
          </p>
        </div>
      </div>
    </footer>

    <script is:inline src="/js/session-timeout.js"></script>

    <!-- Global JS: mobile menu + scroll shadow + smooth scroll + user badge + logout -->
    <script>
      // ── Auth gate: redirect to landing if not signed in ─────────
      (function() {
        const path = window.location.pathname;
        if (path === '/') return;
        // Admin pages are allowed to load so the owner can sign in / view them
        if (path.startsWith('/admin')) return;
        const token = localStorage.getItem('hakster_google_token');
        const authParam = new URLSearchParams(window.location.search).get('google_auth');
        if (!token && !authParam) {
          window.location.href = '/';
        }
        if (path === '/dashboard' || path === '/dashboard/') {
          if (!token) return;
          fetch('/api/auth/authorize-page?page=dashboard', { headers: { 'x-api-key': token } })
            .then(async (res) => {
              if (res.ok) return;
              let data = {};
              try { data = await res.json(); } catch {}
              window.location.href = data.redirect || '/portal';
            })
            .catch(() => { window.location.href = '/portal'; });
        }
      })();

      // ── Redirect protected nav links to Google sign-in if not logged in ─
      (function() {
        const API = window.location.port === '4321' ? 'http://localhost:3579' : '';
        document.querySelectorAll('.requires-auth').forEach((link) => {
          link.addEventListener('click', (e) => {
            const token = localStorage.getItem('hakster_google_token');
            if (token) return;
            e.preventDefault();
            const href = link.getAttribute('href');
            sessionStorage.setItem('hakster_post_auth_redirect', href || '/dashboard');
            window.location.href = `${API}/api/auth/google/redirect`;
          });
        });
      })();

      // ── Global logout function ──────────────────────────────────
      function globalLogout() {
        localStorage.removeItem('hakster_google_token');
        localStorage.removeItem('hakster_google_user');
        localStorage.removeItem('hakster_user_data');
        localStorage.removeItem('hakster_last_activity');
        window.location.href = '/';
      }
      window.globalLogout = globalLogout;

      // ── Show user badge + logout buttons if signed in ───────────
      (function() {
        const token = localStorage.getItem('hakster_google_token');
        const userData = localStorage.getItem('hakster_user_data');
        const googleUserData = localStorage.getItem('hakster_google_user');
        if (!token) return;

        // Parse stored user data (name, email, avatar)
        let user = {};
        try { user = JSON.parse(userData || '{}'); } catch {}
        let googleUser = {};
        try { googleUser = JSON.parse(googleUserData || '{}'); } catch {}
        user = { ...googleUser, ...user };

        function renderUserBadge(currentUser) {
          const userId = currentUser.id || currentUser.userId || currentUser.sub || '';
          const maskedUserId = userId && userId.length > 14 ? `${userId.slice(0, 8)}…${userId.slice(-4)}` : userId;
          const userName = currentUser.name || currentUser.username || currentUser.email || 'User';

          if (navBadge) {
            navBadge.classList.remove('hidden');
            navBadge.classList.add('flex');
            const nameEl = document.getElementById('nav-user-name');
            const idEl = document.getElementById('nav-user-id');
            const avatarEl = document.getElementById('nav-user-avatar');
            if (nameEl) nameEl.textContent = userName;
            if (idEl && userId) { idEl.textContent = `#${maskedUserId}`; idEl.title = `User ID #${userId}`; idEl.classList.remove('hidden'); }
            if (avatarEl) avatarEl.textContent = userName.charAt(0).toUpperCase();
          }

          if (mobileSection) {
            mobileSection.classList.remove('hidden');
            const nameEl = document.getElementById('mobile-user-name');
            const emailEl = document.getElementById('mobile-user-email');
            const idEl = document.getElementById('mobile-user-id');
            const avatarEl = document.getElementById('mobile-user-avatar');
            if (nameEl) nameEl.textContent = userName;
            if (emailEl) emailEl.textContent = currentUser.email || '';
            if (idEl) { idEl.textContent = userId ? `ID #${maskedUserId}` : ''; idEl.title = userId ? `User ID #${userId}` : ''; }
            if (avatarEl) avatarEl.textContent = userName.charAt(0).toUpperCase();
          }
        }

        // Desktop navbar badge
        const navBadge = document.getElementById('nav-user-badge');
        const navSignin = document.getElementById('nav-signin-btn');

        // Mobile quick logout button
        const mobileLogout = document.getElementById('mobile-logout-btn');

        // Mobile menu user section
        const mobileSection = document.getElementById('mobile-user-section');
        renderUserBadge(user);
        if (navSignin) navSignin.classList.add('hidden');
        if (mobileLogout) mobileLogout.classList.remove('hidden');

        fetch('/api/auth/me', { headers: { 'x-api-key': token } })
          .then((res) => res.ok ? res.json() : null)
          .then((data) => {
            if (!data?.user) return;
            const dbUser = {
              ...user,
              ...data.user,
              name: data.user.username || data.user.email || user.name || 'User',
            };
            localStorage.setItem('hakster_google_user', JSON.stringify({ ...googleUser, ...data.user }));
            localStorage.setItem('hakster_user_data', JSON.stringify({
              id: dbUser.id || '',
              name: dbUser.name,
              email: dbUser.email || '',
              picture: dbUser.picture || '',
            }));
            renderUserBadge(dbUser);
            document.querySelectorAll('[data-admin-only="true"]').forEach((el) => {
              el.classList.toggle('hidden', dbUser.role !== 'admin');
              el.classList.toggle('flex', dbUser.role === 'admin');
            });
          })
          .catch(() => {});

        // Wire up logout buttons
        document.getElementById('nav-logout-btn')?.addEventListener('click', globalLogout);
        document.getElementById('mobile-logout-btn')?.addEventListener('click', globalLogout);
        document.getElementById('mobile-menu-logout')?.addEventListener('click', globalLogout);
      })();

      // ── Mobile menu toggle ──────────────────────────────────────
      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const bar1 = document.getElementById('bar1');
      const bar2 = document.getElementById('bar2');
      const bar3 = document.getElementById('bar3');

      let menuOpen = false;

      menuBtn.addEventListener('click', () => {
        menuOpen = !menuOpen;
        menuBtn.setAttribute('aria-expanded', String(menuOpen));

        if (menuOpen) {
          mobileMenu.classList.remove('hidden');
          // Animate hamburger → X
          bar1.style.transform = 'translateY(8px) rotate(45deg)';
          bar2.style.opacity = '0';
          bar3.style.transform = 'translateY(-8px) rotate(-45deg)';
        } else {
          mobileMenu.classList.add('hidden');
          bar1.style.transform = '';
          bar2.style.opacity = '1';
          bar3.style.transform = '';
        }
      });

      // Close mobile menu when a nav link is clicked
      document.querySelectorAll('.mobile-nav-link').forEach((link) => {
        link.addEventListener('click', () => {
          menuOpen = false;
          mobileMenu.classList.add('hidden');
          menuBtn.setAttribute('aria-expanded', 'false');
          bar1.style.transform = '';
          bar2.style.opacity = '1';
          bar3.style.transform = '';
        });
      });

      // ── Scroll shadow on navbar ─────────────────────────────────
      const navbar = document.getElementById('navbar');

      window.addEventListener('scroll', () => {
        if (window.scrollY > 20) {
          navbar.style.boxShadow = '0 4px 24px 0 rgba(0,0,0,0.5)';
          navbar.style.borderBottomColor = 'rgba(124,58,237,0.2)';
        } else {
          navbar.style.boxShadow = '';
          navbar.style.borderBottomColor = '';
        }
      }, { passive: true });

      // ── Smooth scroll for all anchor links ─────────────────────
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (!href || href === '#') return;
          const target = document.querySelector(href);
          if (!target) return;
          e.preventDefault();
          const navH = navbar.offsetHeight;
          const top = (target).getBoundingClientRect().top + window.scrollY - navH - 16;
          window.scrollTo({ top, behavior: 'smooth' });
        });
      });

      // ── Global fullscreen button ────────────────────────────────
      const fullscreenBtn = document.getElementById('global-fullscreen-btn');
      function setGlobalFullscreenState(active) {
        if (!fullscreenBtn) return;
        fullscreenBtn.classList.toggle('active', active);
        fullscreenBtn.setAttribute('aria-pressed', active ? 'true' : 'false');
        fullscreenBtn.title = active ? 'Exit fullscreen' : 'Fullscreen';
        fullscreenBtn.setAttribute('aria-label', fullscreenBtn.title);
      }
      fullscreenBtn?.addEventListener('click', async () => {
        try {
          if (document.fullscreenElement) {
            await document.exitFullscreen();
          } else {
            await document.documentElement.requestFullscreen();
          }
        } catch {
          document.body.classList.toggle('global-fullscreen-fallback');
          setGlobalFullscreenState(document.body.classList.contains('global-fullscreen-fallback'));
        }
      });
      document.addEventListener('fullscreenchange', () => {
        if (!document.fullscreenElement) document.body.classList.remove('global-fullscreen-fallback');
        setGlobalFullscreenState(Boolean(document.fullscreenElement) || document.body.classList.contains('global-fullscreen-fallback'));
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && document.body.classList.contains('global-fullscreen-fallback')) {
          document.body.classList.remove('global-fullscreen-fallback');
          setGlobalFullscreenState(false);
        }
      });
    </script>
  </body>
</html>
