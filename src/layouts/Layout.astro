      </button>
      <button type="button" class="psa-tab psa-spin" id="psa-tab" data-active="0" data-failed="0" title="haksterai.com is up to date. Open the update status." aria-label="haksterai.com is up to date. Open the update status.">
        <span class="psa-ring" aria-hidden="true" id="psa-tab-ring"></span><span id="psa-tab-pct" aria-hidden="true" style="color:#64748b;font-size:10px">◂</span>
      </button>
