    <script is:inline data-cfasync="false">
      (() => {
        const root = document.getElementById('phantom-server-applet');
        if (!root) return;
        const el = (id) => document.getElementById(id);
        const iconEl = el('psa-icon');
        const titleEl = el('psa-title');
        const detailEl = el('psa-detail');
        const siteBuildEl = el('psa-site-build');
        const serverEl = el('psa-server');
        const pendingEl = el('psa-pending');
        const checkedEl = el('psa-checked');
        const actionsEl = el('psa-actions');
        const updateBtn = el('psa-update-now');
        const laterBtn = el('psa-later');
        const barEl = el('psa-bar');
        const chipTitleEl = el('psa-chip-title');
        const chipCodeEl = el('psa-chip-code');
        // Live build feed (spinner / progress / stability). Same measured data
        // the isolated preview streams — nothing here is simulated.
        const liveEl = el('psa-live');
        const stageEl = el('psa-stage');
        const clockEl = el('psa-clock');
        const elapsedEl = el('psa-elapsed');
        const etaEl = el('psa-eta');
        const updatesEl = el('psa-updates');
        const errorEl = el('psa-error');
        const stabEl = el('psa-stab');
        const stabStateEl = el('psa-stab-state');
        const stabDetailEl = el('psa-stab-detail');
        const tabPctEl = el('psa-tab-pct');
        const live = { job: null, stability: null, at: 0, connected: false, audited: {}, lastStage: '', lastState: '', closedBuild: '' };

        // Same timings junkalot.co runs, so both sites behave identically.
        const POLL_MS = 2000;          // visible-tab poll: a pushed build shows within ~2 s
        const OFFLINE_AFTER = 2;       // two misses (~4 s) means the site really is not answering
        const AUTO_SECS = 8;           // visible countdown before a ready update reloads the tab
        const DOCK_AFTER_MS = 10000;   // up-to-date card stays 10 s, then docks to a chip
        const HIDE_AFTER_MS = 20000;   // chip stays 20 s, then tucks into the edge tab
        const CLOSE_AFTER_UPDATE_MS = 5000; // junkalot's done-hide: a finished update closes its card in 5 s
        const LATER_MS = 30 * 60 * 1000;
        const LATER_KEY = 'phantom-applet-later';

        let state = 'checking';
        let misses = 0;
        let wasOffline = false;
        let lastCheck = 0;
        let countdown = 0;
        let countdownTimer = 0;
        let dockTimer = 0;
        let dockPending = false;   // a close is already scheduled; polls must not push it out
        let dockDelay = 0;         // how far away that pending close is, so a sooner one can replace it
        let hideTimer = 0;
        let readyBuild = '';
        let busy = false;
        let queuedShown = '';      // which queued server update already opened the card
        let pollTimer = 0;

        const pageBuildNow = () => document.documentElement.dataset.haksterBuild || '';
        const short = (v) => {
          const s = String(v || '');
          return s.length > 18 ? s.slice(0, 8) + '…' + s.slice(-6) : (s || '—');
        };
        const ago = (ts) => {
          const secs = Math.max(0, Math.round((Date.now() - ts) / 1000));
          if (secs < 60) return secs + 's ago';
          if (secs < 3600) return Math.round(secs / 60) + 'm ago';
          return Math.round(secs / 3600) + 'h ago';
        };

        const readLater = () => {
          try {
            const raw = JSON.parse(localStorage.getItem(LATER_KEY) || 'null');
            return raw && Number.isFinite(raw.until) && raw.until > Date.now() ? raw : null;
          } catch { return null; }
        };
        const setLater = (build) => {
          try { localStorage.setItem(LATER_KEY, JSON.stringify({ until: Date.now() + LATER_MS, build })); } catch {}
        };
        const clearLater = () => { try { localStorage.removeItem(LATER_KEY); } catch {} };

        // Publish how much room the applet takes from the bottom of the screen, so
        // other fixed panels (the sponsored ads card) can dock ABOVE it on phones
        // instead of being buried underneath it. Measured from the visible mode's
        // own box, so it follows the card -> chip -> tab transitions.
        const publishHeight = () => {
          try {
            const mode = root.dataset.mode || 'card';
            const visible = root.querySelector(mode === 'chip' ? '.psa-chip' : mode === 'tab' ? '.psa-tab' : '.psa-card');
            const rect = visible ? visible.getBoundingClientRect() : null;
            const gap = rect && rect.height ? Math.max(0, Math.round(window.innerHeight - rect.top)) : 0;
            document.documentElement.style.setProperty('--phantom-applet-h', gap + 'px');
          } catch {}
        };
        const setMode = (mode) => { root.dataset.mode = mode; publishHeight(); };
        const expand = () => {
          setMode('card');
          clearTimeout(dockTimer); clearTimeout(hideTimer); dockPending = false; dockDelay = 0;
          scheduleDock();
        };

        const paintState = (next) => {
          state = next;
          root.dataset.state = next;
          const icon = { checking: '●', live: '✓', restored: '✓', ready: '▲', applying: '⚙', offline: '⚠', building: '⚙', failed: '✗' }[next] || '●';
          const title = {
            checking: 'haksterai.com — checking',
            live: 'haksterai.com is up to date',
            restored: 'haksterai.com is answering again',
            ready: 'Update available',
            applying: 'Update applying on the server',
            offline: 'haksterai.com is not answering',
            building: 'Build running',
            failed: 'Build failed',
          }[next] || 'haksterai.com';
          if (iconEl) iconEl.textContent = icon;
          if (titleEl) titleEl.textContent = title;
          if (chipTitleEl) chipTitleEl.textContent = next === 'ready' ? 'Update ready' : 'Up to date';
          publishHeight();
        };

        const clearCountdown = () => { if (countdownTimer) { clearInterval(countdownTimer); countdownTimer = 0; } countdown = 0; };

        const scheduleDock = (delayMs) => {
          // The version poll runs every 2 s and asks for a short close after an
          // update finishes. Restarting the timer on every poll would push the
          // close out forever, so a pending close is never restarted by an equal
          // or longer one — only a sooner close may replace it (the 10 s close a
          // freshly opened card arms is cut to 5 s the moment the build is done).
          const wanted = Number.isFinite(delayMs) ? delayMs : DOCK_AFTER_MS;
          if (dockPending) {
            if (!Number.isFinite(delayMs)) return;
            const pending = dockDelay || DOCK_AFTER_MS;
            if (wanted >= pending) return;
          }
          clearTimeout(dockTimer); clearTimeout(hideTimer);
          dockPending = true;
          dockDelay = wanted;
          dockTimer = window.setTimeout(() => {
            dockPending = false;
            dockDelay = 0;
            if (root.dataset.mode !== 'card') return;
            // 'ready' is a build sitting on the server waiting for this tab;
            // like junkalot's toast it announces that and then docks to its chip.
            if (state !== 'live' && state !== 'restored' && state !== 'ready') return;
            // Never dock away while a build is actually running — the spinner
            // belongs on screen for the whole build, not after it.
            if (live.job && (live.job.state === 'RUNNING' || live.job.state === 'QUEUED')) return;
            setMode('chip');
            // Remember which build this close was for: its later frames must not
            // re-open the card, while a genuinely new build still can.
            live.closedBuild = (live.job && live.job.buildId) || live.closedBuild;
            audit('applet.collapse', { buildId: live.job && live.job.buildId });
            hideTimer = window.setTimeout(() => {
              if (root.dataset.mode === 'chip' && (state === 'live' || state === 'restored' || state === 'ready')) setMode('tab');
            }, HIDE_AFTER_MS);
          }, wanted);
        };

        const apiApply = async () => {
          if (busy) return;
          busy = true;
          clearCountdown();
          clearLater();
          if (updateBtn) { updateBtn.disabled = true; updateBtn.textContent = 'Updating…'; }
          if (detailEl) detailEl.textContent = 'Checking that the server is answering before this tab reloads…';
          let ok = true;
          try { ok = typeof window.haksterServerHealthy === 'function' ? await window.haksterServerHealthy() : true; } catch { ok = false; }
          if (ok) { location.reload(); return; }
          if (typeof window.haksterUpdateWhenReady === 'function') {
            if (detailEl) detailEl.textContent = 'The server is restarting — this tab reloads by itself as soon as the new build answers.';
            window.haksterUpdateWhenReady();
            return;
          }
          if (detailEl) detailEl.textContent = 'The server is restarting — reloading in a few seconds.';
          window.setTimeout(() => location.reload(), 4000);
        };

        // A ready build is announced, then applied after a visible countdown —
        // never a blind reload, so the tab cannot land in a restart.
        // A new page build needs no forced reload: the server, the API and the
        // applet are already on the new code, and reloading the tab is exactly
        // the screen flash the applet exists to avoid. Say the new build is
        // ready; Update now opens it, otherwise the next natural page load does.
        const armCountdown = (build) => {
          if (countdownTimer) return;
          if (detailEl) {
            detailEl.textContent = 'New page build ' + short(build) + ' is live — this tab is on ' + short(pageBuildNow())
              + '. Nothing was reloaded; Update now opens it, or it applies on your next page load.';
          }
        };

        // A queued update — server code on disk ahead of the running process, or
        // files waiting to be applied — opens the card by itself, the same way
        // junkalot's toast fires for a build that is ready on the server. This is
        // decided from the public /api/version answer, so it happens in every
        // browser on every machine, not only where the build was made.
        const announceQueued = (serverInfo = {}) => {
          const count = Number.isFinite(Number(serverInfo.pending)) ? Number(serverInfo.pending) : 0;
          paintState('ready');
          if (barEl) barEl.hidden = true;
          if (actionsEl) actionsEl.hidden = true;
          if (detailEl) detailEl.textContent = 'Update queued on the server — '
            + (count ? count + ' file' + (count === 1 ? '' : 's') : 'server changes')
            + ' waiting to be applied; it applies itself when the server is idle.';
          // Open once per queued update and STAY open while the update is
          // outstanding: the card only retracts after the work is done, exactly
          // as asked — progress on screen while it runs, back to the edge after.
          if (queuedShown !== 'queued') {
            queuedShown = 'queued';
            setMode('card');
            clearTimeout(dockTimer); clearTimeout(hideTimer);
            dockPending = false; dockDelay = 0;
          }
        };

        const check = async () => {
          try {
            const res = await fetch('/api/version?t=' + Date.now(), { cache: 'no-store', credentials: 'same-origin' });
            if (!res.ok) throw new Error('status ' + res.status);
            const data = await res.json();
            const server = (data && data.server) || {};
            lastCheck = Date.now();
            misses = 0;
            if (siteBuildEl) siteBuildEl.textContent = short(data && data.build);
            if (pendingEl) pendingEl.textContent = Number.isFinite(Number(server.pending)) ? Number(server.pending) + ' files' : '—';
            if (checkedEl) checkedEl.textContent = ago(lastCheck);
            if (chipCodeEl) chipCodeEl.textContent = short(data && data.build);

            const pageBuild = pageBuildNow();
            const newerBuild = !!(data && data.build && pageBuild && data.build !== pageBuild);
            // While a build owns the card, the version poll must not overwrite
            // the measured stage/percent with "up to date" — but it keeps the
            // build ids and checked timestamp fresh underneath.
            // A finished build must not keep the card open. livejob reports a
            // completed build as VERIFYING, so the moment the server answers
            // with the build this page is already on — and nothing newer is
            // waiting — the update is done and the card closes itself.
            const buildDone = !!(live.job && live.job.state === 'VERIFYING'
              && String(live.job.status || '') === 'completed'
              && !server.applying && !newerBuild);
            // An update is queued when the server has code or files waiting to
            // apply. It must announce itself, not sit silently behind the word
            // "stale" in a detail line.
            const queuedUpdate = !server.applying && !!(server.stale || Number(server.pending) > 0);
            // Was the card announcing a queued update a moment ago? Then the
            // update has just finished applying and this card retracts.
            const wasQueued = !!queuedShown;
            if (!queuedUpdate) queuedShown = '';
            // The live build feed can own the card and return from this poll
            // below. Still surface the applet if the version endpoint reports
            // that an update has started while the user has it tucked away.
            if (server.applying && root.dataset.mode !== 'card') {
              setMode('card');
              clearTimeout(dockTimer); clearTimeout(hideTimer);
              dockPending = false; dockDelay = 0;
            }
            if (liveOwns() && !buildDone) { if (checkedEl) checkedEl.textContent = ago(lastCheck); return; }
            if (server.error) {
              if (serverEl) serverEl.textContent = 'unavailable';
            } else {
              if (serverEl) serverEl.textContent = short(server.build) + (server.stale ? ' · behind disk' : ' · current');
            }

            if (server.applying) {
              clearCountdown();
              setMode('card');
              // The update is running: hold the card until it reports done.
              clearTimeout(dockTimer); clearTimeout(hideTimer); dockPending = false; dockDelay = 0;
              queuedShown = 'queued';
              paintState('applying');
              if (actionsEl) actionsEl.hidden = true;
              if (barEl) barEl.hidden = false;
              if (detailEl) detailEl.textContent = 'The server is applying a new build. This tab reloads when the new one is answering.';
            } else if (newerBuild) {
              // A ready build fires the card once; the 2 s poll must not keep
              // throwing it back open after it has docked for this same build.
              const nextReady = String(data.build);
              const newlyReady = nextReady !== readyBuild;
              readyBuild = nextReady;
              const postponed = readLater();
              if (postponed && postponed.build === readyBuild) {
                paintState('ready');
                if (barEl) barEl.hidden = true;
                if (actionsEl) actionsEl.hidden = false;
                if (detailEl) detailEl.textContent = 'New build ' + short(readyBuild) + ' is live — this tab is on ' + short(pageBuild) + '. Postponed — Update now applies it.';
              } else {
                paintState('ready');
                if (barEl) barEl.hidden = true;
                if (actionsEl) actionsEl.hidden = false;
                armCountdown(readyBuild);
              }
              if (newlyReady) {
                setMode('card');
                // Same lifecycle as junkalot's update toast: the card fires for
                // the new build, then gets out of the way instead of sitting over
                // the page forever. The chip that replaces it keeps "Update now"
                // one click away, and the next build opens the card again.
                clearTimeout(dockTimer); clearTimeout(hideTimer);
                dockPending = false; dockDelay = 0;
                scheduleDock();
              }
            } else {
              clearCountdown();
              readyBuild = '';
              if (barEl) barEl.hidden = true;
              if (actionsEl) actionsEl.hidden = true;
              if (wasOffline) {
                paintState('restored');
                if (detailEl) detailEl.textContent = 'haksterai.com is answering again — site build ' + short(data && data.build) + '.';
                wasOffline = false;
                window.setTimeout(() => { if (state === 'restored') { paintState('live'); scheduleDock(); } }, 6000);
                setMode('card');
              } else if (state !== 'live') {
                if (queuedUpdate && !buildDone) announceQueued(server);
                else {
                  const justFinished = buildDone || wasQueued;
                  paintState('live');
                  if (detailEl) detailEl.textContent = (justFinished ? 'Update complete — ' : '')
                    + 'haksterai.com is up to date — site build ' + short(data && data.build) + ', server current.';
                  scheduleDock(justFinished ? CLOSE_AFTER_UPDATE_MS : undefined);
                }
              } else {
                if (queuedUpdate && !buildDone) announceQueued(server);
                else {
                  const justFinished = buildDone || wasQueued;
                  if (detailEl) detailEl.textContent = (justFinished ? 'Update complete — ' : '')
                    + 'haksterai.com is up to date — site build ' + short(data && data.build) + ', server current.';
                  // Re-opened or already showing live while an update just
                  // finished: still close, on the same short timer.
                  if (justFinished && root.dataset.mode === 'card') scheduleDock(CLOSE_AFTER_UPDATE_MS);
                }
              }
            }
            if (!busy && updateBtn) { updateBtn.disabled = false; updateBtn.textContent = 'Update now'; }
          } catch {
            misses += 1;
            if (misses >= OFFLINE_AFTER) {
              wasOffline = true;
              clearCountdown();
              paintState('offline');
              setMode('card');
              clearTimeout(dockTimer); clearTimeout(hideTimer); dockPending = false; dockDelay = 0;
              if (barEl) barEl.hidden = true;
              if (actionsEl) actionsEl.hidden = true;
              if (serverEl) serverEl.textContent = 'no response';
              if (detailEl) detailEl.textContent = 'haksterai.com has not answered — the server is restarting, or the tunnel is not routing.';
            }
          }
          if (checkedEl && lastCheck) checkedEl.textContent = ago(lastCheck);
        };

        updateBtn?.addEventListener('click', (event) => { event.stopPropagation(); apiApply(); });
        laterBtn?.addEventListener('click', () => {
          clearCountdown();
          setLater(readyBuild);
          if (barEl) barEl.hidden = true;
          if (actionsEl) actionsEl.hidden = false;
          if (detailEl) detailEl.textContent = 'Postponed for 30 minutes — Update now applies it sooner.';
          scheduleDock();
        });
        el('psa-chip')?.addEventListener('click', expand);
        el('psa-tab')?.addEventListener('click', expand);

        const startPolling = () => {
          if (pollTimer) return;
          pollTimer = window.setInterval(() => {
            if (document.visibilityState !== 'visible') return;
            check();
          }, POLL_MS);
        };
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') check();
        });
        // Keep the published height honest as the card's text reflows or the
        // window changes size.
        window.addEventListener('resize', publishHeight);
        window.addEventListener('orientationchange', publishHeight);
        if (typeof ResizeObserver === 'function') {
          const cardBox = root.querySelector('.psa-card');
          if (cardBox) new ResizeObserver(publishHeight).observe(cardBox);
        }
        publishHeight();

        // Exposed after check() exists, for the headless runtime check and for a
        // manual re-check from the console. Read-only: it only re-runs the poll.
        // ── Live build feed ────────────────────────────────────────────────
        // Server-sent events carry the same measured snapshot the isolated
        // preview uses. Auth is header-only: EventSource cannot send headers,
        // so this uses fetch + a stream reader and never puts the key in a URL.
        // A build that stops reporting is aged out to DISCONNECTED/UNKNOWN —
        // there is no path here that shows success without a fresh frame.

        const audit = (event, extra) => {
          try {
            let key = '';
            try { key = localStorage.getItem('hakster_api_key') || ''; } catch {}
            if (!key) return; // public visitors cannot write the audit log
            const now = Date.now();
            const dedupe = event + '|' + ((extra && extra.buildId) || '');
            if (live.audited[dedupe] && now - live.audited[dedupe] < 3000) return;
            live.audited[dedupe] = now;
            fetch('/api/applet/event', {
              method: 'POST',
              cache: 'no-store',
              credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json', 'x-api-key': key },
              body: JSON.stringify(Object.assign({ event }, extra || {})),
              keepalive: true,
            }).catch(() => {});
          } catch {}
        };

        const liveOwns = () => {
          const j = live.job;
          if (!j) return false;
          if (j.state === 'RUNNING' || j.state === 'QUEUED') return true;
          if (j.state === 'VERIFYING' || j.state === 'FAILED' || j.state === 'UNKNOWN') {
            // Three minutes, not fifteen: livejob reports a COMPLETED build as
            // VERIFYING, so a long window left the card pinned open long after
            // the update had finished. Long enough to cover a restart + health
            // check, short enough that the card cannot outstay the update.
            return !!(j.startedAt && Date.now() - Date.parse(j.startedAt) < 3 * 60 * 1000);
          }
          return false;
        };
        const fmtSecs = (s) => {
          if (!Number.isFinite(s) || s < 0) return '—';
          const m = Math.floor(s / 60);
          const r = Math.round(s % 60);
          return m ? m + 'm ' + String(r).padStart(2, '0') + 's' : r + 's';
        };
        const utcClock = (iso) => {
          const t = Date.parse(iso || '');
          if (!Number.isFinite(t)) return '';
          const d = new Date(t);
          return String(d.getUTCHours()).padStart(2, '0') + ':' + String(d.getUTCMinutes()).padStart(2, '0')
            + ':' + String(d.getUTCSeconds()).padStart(2, '0');
        };
        const paintLive = (stateName, title, detail) => {
          paintState(stateName);
          if (titleEl) titleEl.textContent = title;
          if (detailEl) detailEl.textContent = detail;
        };
        const setSpinner = (mode, failed) => {
          [el('psa-chip'), el('psa-tab')].forEach((b) => {
            if (!b) return;
            b.dataset.active = mode ? '1' : '0';
            b.dataset.failed = failed ? '1' : '0';
          });
        };

        const renderLive = (snap) => {
          if (!snap || typeof snap !== 'object') return;
          const firstFrame = !live.at;
          live.at = Date.now();
          const job = snap.job || {};
          const prevState = live.job && live.job.state;
          live.job = job;

          const running = job.state === 'RUNNING' || job.state === 'QUEUED';
          const verifying = job.state === 'VERIFYING';
          // livejob reports a FINISHED build as VERIFYING. That frame should open
          // the card once — an update must still announce itself — but once the
          // applet has closed for that build it must not re-open it on the next
          // 5 s poll. Treating every such frame as work was what kept the card
          // open forever; ignoring them entirely meant an update could pass
          // without the applet ever showing. One open per build, then closed.
          const doneBuild = verifying && String(job.status || '') === 'completed';
          const alreadyClosed = doneBuild && !!job.buildId && live.closedBuild === job.buildId;
          const verifyingLive = verifying && !alreadyClosed;
          const failed = job.state === 'FAILED';
          const unknown = job.state === 'UNKNOWN';
          const work = running || verifyingLive || failed || unknown;

          setSpinner(running || verifyingLive, failed);
          if (tabPctEl) {
            tabPctEl.textContent = failed ? '✗' : Number.isFinite(job.percent) ? Math.round(job.percent) + '%' : '·';
            tabPctEl.style.color = failed ? '#f87171' : '#00ff41';
          }

          // Expand once work exists; a panel the user already opened is only
          // re-rendered, never reset — the state comes straight from the frame.
          if ((running || verifyingLive) && root.dataset.mode !== 'card') {
            expand();
            audit('applet.expand', { buildId: job.buildId, stage: job.stage && job.stage.id });
          }
          // A running build, or a health check that is genuinely still running,
          // keeps the card up. A FINISHED build is only announcing itself and
          // must be allowed to close on check()'s short timer — clearing its
          // pending dock here was what kept the card pinned after an update.
          if (running || (verifyingLive && !doneBuild)) { clearTimeout(dockTimer); clearTimeout(hideTimer); dockPending = false; dockDelay = 0; }

          if (liveEl) liveEl.hidden = !work;
          if (stageEl) stageEl.textContent = job.stage && job.stage.label ? job.stage.label : (unknown ? 'UNKNOWN' : (job.label || '—'));
          if (clockEl) clockEl.textContent = unknown ? 'UNKNOWN' : Number.isFinite(job.percent) ? Math.round(job.percent) + '%' : 'in progress';
          if (elapsedEl) elapsedEl.textContent = unknown ? 'elapsed UNKNOWN' : 'elapsed ' + fmtSecs(job.elapsedSec);
          if (etaEl) etaEl.textContent = Number.isFinite(job.etaSec) ? 'ETA ~' + fmtSecs(job.etaSec) : 'ETA unknown';
          if (updatesEl) {
            const rows = Array.isArray(job.updates) ? job.updates.slice(-6) : [];
            updatesEl.replaceChildren(...rows.map((u) => {
              const li = document.createElement('li');
              const t = document.createElement('span');
              t.className = 't';
              t.textContent = utcClock(u.at);
              const x = document.createElement('span');
              x.textContent = String(u.text || '');
              li.append(t, x);
              return li;
            }));
            updatesEl.hidden = rows.length === 0;
          }
          if (errorEl) {
            const tail = Array.isArray(job.errorTail) && job.errorTail.length ? job.errorTail.join('\n') : String(job.error || '');
            errorEl.textContent = failed ? tail.slice(-1200) : '';
            errorEl.hidden = !(failed && errorEl.textContent);
          }

          if (running) {
            paintLive('building',
              'Building — ' + (Number.isFinite(job.percent) ? Math.round(job.percent) + '%' : 'in progress'),
              (job.stage && job.stage.label ? job.stage.label + ' · ' : '')
                + 'elapsed ' + fmtSecs(job.elapsedSec) + ' · ' + (Number.isFinite(job.etaSec) ? 'ETA ~' + fmtSecs(job.etaSec) : 'ETA unknown'));
            if (prevState !== 'RUNNING' && prevState !== 'QUEUED') audit('spinner.activate', { buildId: job.buildId, stage: job.stage && job.stage.id, percent: job.percent });
            const stageId = job.stage && job.stage.id;
            if (stageId && stageId !== live.lastStage) {
              live.lastStage = stageId;
              if (prevState === 'RUNNING' || prevState === 'QUEUED') audit('job.stage', { buildId: job.buildId, stage: stageId, percent: job.percent });
            }
          } else if (verifyingLive) {
            paintLive('applying', 'Build complete — verifying health',
              (job.label || 'Health verification running') + ' · stability window is separate');
            if (prevState === 'RUNNING' || prevState === 'QUEUED') audit('job.complete', { buildId: job.buildId, percent: job.percent });
          } else if (failed) {
            paintLive('failed', 'Build failed', job.error || job.label || 'The build failed — log preserved below.');
            if (prevState !== 'FAILED') audit('job.failed', { buildId: job.buildId, stage: job.stage && job.stage.id });
          } else if (unknown) {
            paintLive('offline', 'Build telemetry lost — state UNKNOWN', job.label || 'No frame from the build for over 3 minutes.');
            if (prevState !== 'UNKNOWN') audit('telemetry.lost', { buildId: job.buildId });
          } else if (!firstFrame && live.connected === false) {
            // back from a disconnect with an idle job: say so, don't fake success
            paintLive('restored', 'Telemetry restored', 'Build ' + short(job.buildId || '') + ' state: ' + (job.state || 'IDLE'));
            scheduleDock();
          }

          // A finished build closes on the same 5 s clock junkalot's toast uses,
          // armed straight from the telemetry frame instead of waiting out the
          // version poll — the poll can add its full 2 s interval to the close.
          if (doneBuild && root.dataset.mode === 'card') scheduleDock(CLOSE_AFTER_UPDATE_MS);

          // Stability is its own countdown, after the build is done.
          const st = snap.stability;
          if (st && stabEl) {
            const state = String(st.state || 'UNKNOWN');
            const win = st.window || {};
            stabEl.hidden = false;
            stabEl.dataset.state = state;
            if (stabStateEl) stabStateEl.textContent = state === 'STABLE' ? '✓ STABLE' : state;
            let detail = '';
            if (state === 'VERIFYING' && Number.isFinite(win.remainingSec)) detail = '· ' + fmtSecs(win.remainingSec) + ' left of ' + fmtSecs(win.configuredSec) + ' window';
            else if (state === 'STABLE') detail = '· ' + fmtSecs(st.timestamps && st.timestamps.stableForSec) + ' stable';
            else detail = '· ' + String(st.reason || 'no reason reported');
            if (stabDetailEl) stabDetailEl.textContent = detail;
            if (state === 'STABLE' && live.lastState !== 'STABLE') {
              live.lastState = 'STABLE';
              audit('stability.verified', { buildId: job.buildId });
            }
          }

          if (firstFrame && (running || verifying)) audit('spinner.activate', { buildId: job.buildId, stage: job.stage && job.stage.id, percent: job.percent });
          live.connected = true;
        };

        let liveTimer = 0;
        const pollLive = async () => {
          try {
            let key = '';
            try { key = localStorage.getItem('hakster_api_key') || ''; } catch {}
            const res = await fetch('/api/applet/status?t=' + Date.now(), {
              headers: key ? { 'x-api-key': key } : {},
              cache: 'no-store',
              credentials: 'same-origin',
            });
            if (!res.ok) throw new Error('status ' + res.status);
            renderLive(await res.json());
          } catch {}
          scheduleLivePoll();
        };
        const scheduleLivePoll = () => {
          clearTimeout(liveTimer);
          liveTimer = window.setTimeout(pollLive, 5000);
        };
        const connectLive = async () => {
          let key = '';
          try { key = localStorage.getItem('hakster_api_key') || ''; } catch {}
          try {
            const res = await fetch('/api/applet/stream?t=' + Date.now(), {
              headers: key ? { 'x-api-key': key } : {},
              cache: 'no-store',
              credentials: 'same-origin',
            });
            if (!res.ok || !res.body || !res.body.getReader) throw new Error('stream ' + res.status);
            const reader = res.body.getReader();
            const decoder = new TextDecoder();
            let buf = '';
            for (;;) {
              const { value, done } = await reader.read();
              if (done) break;
              buf += decoder.decode(value, { stream: true });
              let cut = buf.indexOf('\n\n');
              while (cut >= 0) {
                const frame = buf.slice(0, cut);
                buf = buf.slice(cut + 2);
                const data = frame.split('\n').filter((l) => l.startsWith('data:')).map((l) => l.slice(5).trim()).join('');
                if (data) {
                  try {
                    const msg = JSON.parse(data);
                    if (msg && msg.type === 'snapshot') renderLive(msg);
                  } catch {}
                }
                cut = buf.indexOf('\n\n');
              }
            }
          } catch {}
          clearTimeout(liveTimer);
          pollLive();
        };

        // A frame older than 30 s means the telemetry path is gone. Everything
        // on screen becomes UNKNOWN — never the last percentage, never success.
        window.setInterval(() => {
          if (!live.at) return;
          if (Date.now() - live.at <= 30000) return;
          if (!live.connected) return;
          live.connected = false;
          setSpinner(false, true);
          if (tabPctEl) { tabPctEl.textContent = '?'; tabPctEl.style.color = '#f87171'; }
          if (liveEl) liveEl.hidden = false;
          if (stageEl) stageEl.textContent = 'UNKNOWN';
          if (clockEl) clockEl.textContent = 'UNKNOWN';
          if (elapsedEl) elapsedEl.textContent = 'elapsed UNKNOWN';
          if (etaEl) etaEl.textContent = 'ETA unknown';
          if (updatesEl) updatesEl.replaceChildren();
          if (errorEl) errorEl.hidden = true;
          if (stabEl) {
            stabEl.hidden = false;
            stabEl.dataset.state = 'UNKNOWN';
            if (stabStateEl) stabStateEl.textContent = 'UNKNOWN';
            if (stabDetailEl) stabDetailEl.textContent = '· no telemetry';
          }
          paintLive('offline', 'DISCONNECTED — state UNKNOWN',
            'No frame from the server for ' + Math.round((Date.now() - live.at) / 1000) + 's. Nothing here is being reported as success.');
          audit('telemetry.lost', { buildId: live.job && live.job.buildId });
        }, 1000);

        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') { pollLive(); }
        });
        el('psa-chip')?.addEventListener('click', () => audit('applet.expand', { buildId: live.job && live.job.buildId }));
        el('psa-tab')?.addEventListener('click', () => audit('applet.expand', { buildId: live.job && live.job.buildId }));

        window.__phantomApplet = {
          check, renderLive,
          // Read-only view of the applet's own timers. The headless checks read
          // this instead of guessing from the DOM alone; it changes nothing.
          snapshot: () => ({
            mode: root.dataset.mode, state, dockPending, dockDelay,
            hasDockTimer: Boolean(dockTimer), closedBuild: live.closedBuild,
            jobState: live.job ? live.job.state : null,
          }),
        };
        check();
        startPolling();
        connectLive();
      })();
    </script>

    <script is:inline data-cfasync="false">
      (() => {
        const problem = document.getElementById('haksterai-problem-toast');
        const message = document.getElementById('haksterai-problem-message');
        let lastProblem = '';
        const showProblem = (value) => {
          const text = String(value || 'An unexpected error occurred.').replace(/[\\r\\n\\t]+/g, ' ').slice(0, 900);
          if (!problem || !message || !text || text === lastProblem) return;
          lastProblem = text;
          message.textContent = text;
          problem.hidden = false;
        };
        window.addEventListener('error', (event) => showProblem(event.message || 'A page script failed to load.'));
        window.addEventListener('unhandledrejection', (event) => showProblem(event.reason?.message || event.reason || 'A background request failed.'));
        window.addEventListener('haksterai:problem', (event) => showProblem(event.detail?.message || event.detail));
        document.getElementById('haksterai-problem-close')?.addEventListener('click', () => { problem.hidden = true; });
        document.getElementById('haksterai-problem-copy')?.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(message.textContent || ''); } catch { showProblem('Clipboard access was blocked by this browser.'); }
        });
        document.getElementById('haksterai-problem-popout')?.addEventListener('click', () => {
          const win = window.open('', '_blank');
          if (!win) return showProblem('The browser blocked the pop-out window.');
          win.opener = null;
          const title = win.document.createElement('title'); title.textContent = 'HaksterAI problem details';
          const heading = win.document.createElement('h1'); heading.textContent = 'HaksterAI noticed a problem';
          const body = win.document.createElement('pre'); body.textContent = message.textContent || '';
          win.document.head.append(title); win.document.body.append(heading, body);
        });

        const update = document.getElementById('haksterai-update-toast');
        const updateDetail = document.getElementById('haksterai-update-detail');
        const currentBuild = document.documentElement.dataset.haksterBuild || '';
        const laterKey = 'haksterai-update-later-until';
        // How old the new build is, in plain words, from its build timestamp.
        const ago = (iso) => {
          const t = Date.parse(iso || '');
          if (!Number.isFinite(t)) return '';
          const secs = Math.max(0, Math.round((Date.now() - t) / 1000));
          if (secs < 60) return secs + 's ago';
          if (secs < 3600) return Math.round(secs / 60) + 'm ago';
          if (secs < 86400) return Math.round(secs / 3600) + 'h ago';
          return Math.round(secs / 86400) + 'd ago';
        };
        // Every update the widget surfaces is stamped and written to the server's
        // update log, so we can always see when each build went out and who saw it.
        const logUpdateSeen = (build, from) => {
          try {
            fetch('/api/version/seen', {
              method: 'POST',
              cache: 'no-store',
              credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ build, from, path: location.pathname, at: new Date().toISOString() }),
              keepalive: true,
            }).catch(() => {});
          } catch {}
        };
        // Runs for every signed-in user (owner and customers), every two minutes
        // while the tab is visible. Primary check: the tiny /api/version endpoint,
        // which reports the build id actually deployed. Fallback: re-fetch this
        // page and read its own build meta, for older servers without the endpoint.
        const remoteBuildId = async () => {
          try {
            const res = await fetch('/api/version?t=' + Date.now(), { cache: 'no-store', credentials: 'same-origin' });
            if (res.ok) {
              const data = await res.json();
              if (data && data.build) return String(data.build);
            }
          } catch { /* fall through to the page check */ }
          const url = new URL(location.pathname, location.origin);
          url.searchParams.set('_hakster_version_check', String(Date.now()));
          const response = await fetch(url, { cache: 'no-store', credentials: 'same-origin', headers: { 'x-hakster-version-check': '1' } });
          if (!response.ok) return '';
          const html = await response.text();
          const match = html.match(/<meta\s+name=["']haksterai-build["']\s+content=["']([^"']+)/i);
          return match ? match[1] : '';
        };
        let announcedBuild = '';
        const checkUpdate = async () => {
          if (!currentBuild || document.visibilityState !== 'visible') return;
          try {
            const latest = await remoteBuildId();
            if (!latest || latest === currentBuild) return;
            // The Phantom server applet in the bottom-right corner owns the update
            // UI on every page that carries it (the same widget as junkalot.co).
            // This top banner stays as the fallback for pages without the applet,
            // and the "seen" log keeps recording either way.
            if (document.getElementById('phantom-server-applet')) {
              if (update && !update.hidden) { update.hidden = true; cancelAutoApply(); }
              if (announcedBuild !== latest) {
                announcedBuild = latest;
                logUpdateSeen(latest, currentBuild);
              }
              return;
            }
            const deferredUntil = Number(localStorage.getItem(laterKey) || 0);
            if (updateDetail) {
              const built = Number.isFinite(Date.parse(latest)) ? new Date(latest).toISOString().replace('T', ' ').slice(0, 16) + ' UTC' : latest;
              updateDetail.textContent = 'New build ' + built + (ago(latest) ? ' · ' + ago(latest) : '') + '.';
            }
            if (Date.now() >= deferredUntil && update) {
              update.hidden = false;
              armAutoApply();
            }
            if (announcedBuild !== latest) {
              announcedBuild = latest;
              logUpdateSeen(latest, currentBuild);
            }
          } catch { /* Offline checks are quiet; retry on the next interval. */ }
        };
        // Update never reloads blind. A blind reload can land in the half-second a
        // deploy restarts the server, which shows a dead page instead of the site.
        // So: ask the server first, and if it is restarting, keep this page alive
        // and let hakster-resume.js reload the moment it answers again.
        const updateNow = document.getElementById('haksterai-update-now');
        const applyUpdate = async () => {
          cancelAutoApply();
          localStorage.removeItem(laterKey);
          if (updateNow?.dataset.busy) return;
          if (updateNow) {
            updateNow.dataset.busy = '1';
            updateNow.textContent = 'Updating…';
            updateNow.style.opacity = '0.8';
          }
          let ok = false;
          try { ok = typeof window.haksterServerHealthy === 'function' ? await window.haksterServerHealthy() : true; } catch { ok = false; }
          if (ok) { location.reload(); return; }
          // Server is mid-restart: hand off to the resume helper, which retries and
          // reloads automatically when the new build is serving.
          if (typeof window.haksterUpdateWhenReady === 'function') {
            window.haksterUpdateWhenReady();
            if (updateNow) updateNow.textContent = 'Waiting…';
            return;
          }
          window.setTimeout(() => location.reload(), 4000);
        };
        updateNow?.addEventListener('click', applyUpdate);

        // 2026-11-16 (owner): if the banner is shown and neither Update nor Later
        // is clicked within a minute, apply it automatically — deploys should
        // land on their own. Same safe path as the button; the countdown is
        // visible in the banner's detail line so it is never a surprise.
        const AUTO_APPLY_MS = 60000;
        let autoApplyTimer = 0;
        let autoApplyTick = 0;
        function cancelAutoApply() {
          if (autoApplyTimer) { clearTimeout(autoApplyTimer); autoApplyTimer = 0; }
          if (autoApplyTick) { clearInterval(autoApplyTick); autoApplyTick = 0; }
        }
        function armAutoApply() {
          if (autoApplyTimer || !update || update.hidden) return;
          // Owner decision (2026-11-18): no timed reload. A build that lands
          // while a tab is open must not flash the screen — the banner waits
          // for Update, and the next natural page load picks the build up.
          if (updateDetail) {
            updateDetail.textContent = (updateDetail.textContent || '').replace(/\s*·\s*applies automatically in \d+s$/, '')
              + ' · Update opens the new build; nothing reloads by itself.';
          }
        }
        document.getElementById('haksterai-update-later')?.addEventListener('click', () => {
          // "Later" is a deliberate choice, so it cancels the one-minute auto-apply
          // and defers the banner for 30 minutes.
          cancelAutoApply();
          localStorage.setItem(laterKey, String(Date.now() + 30 * 60 * 1000));
          if (update) update.hidden = true;
        });
        window.setTimeout(checkUpdate, 15000);
        window.setInterval(checkUpdate, 120000);
        // Coming back to the tab counts as a fresh moment to check — no waiting
        // for the next two-minute tick.
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') checkUpdate();
        });
      })();
    </script>


    <!-- Always-visible scrollbars. Firefox already draws real bars from the rules in
         global.css; Chrome/Chromium on Linux uses overlay scrollbars that ignore
         scrollbar styling, so this fills in a real bar on the page, the dashboard
         tab strip, tables, logs and every other scrollable box. Layout-safe. -->
    <script is:inline data-cfasync="false" src="/js/hakster-scrollbars.js" defer></script>

    <!-- Smooth updates + auto-resume for every user. If the server restarts or
         hiccups while a tab is open, the tab shows a small "reconnecting" line and
         picks itself back up on the same page instead of going dead; the Update
         button reloads only once the server is confirmed answering. -->
    <script is:inline data-cfasync="false" src="/js/hakster-resume.js" defer></script>

    <!-- Global JS: mobile menu + scroll shadow + smooth scroll + user badge + logout -->
    <script>
      // ── Auth gate: redirect to landing if not signed in ─────────
      (function() {
        const path = window.location.pathname;

        // ── Telegram: the bot's own sign-in counts as a site sign-in ──
        // Opened from a HaksterAI bot, Telegram signs the request (initData,
        // also carried in the URL hash). Trade it for the same apiKey every
        // page here reads, then reload so the gate below runs with a real
        // session. If this browser is already signed in, link the Telegram
        // account to that same user instead of creating a second account —
        // that is the owner case, where the site account predates the bot.
        const telegramSignInPending = (function telegramAuth() {
          let initData = '';
          try {
            const tg = window.Telegram && window.Telegram.WebApp;
            initData = (tg && tg.initData) || '';
          } catch (_) {}
          if (!initData) {
            const m = /(?:^#|&)tgWebAppData=([^&]+)/.exec(window.location.hash || '');
            if (m) { try { initData = decodeURIComponent(m[1]); } catch (_) {} }
          }
          if (!initData) return false;
          const existing = localStorage.getItem('hakster_google_token') || localStorage.getItem('hakster_api_key');
          if (existing) {
            if (localStorage.getItem('hakster_tg_linked_at')) return false;
            fetch('/api/auth/telegram/link', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'x-api-key': existing },
              body: JSON.stringify({ initData })
            }).then((res) => { if (res.ok) localStorage.setItem('hakster_tg_linked_at', String(Date.now())); }).catch(() => {});
            return false;
          }
          fetch('/api/auth/telegram/webapp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ initData })
          })
            .then((res) => (res.ok ? res.json() : null))
            .then((data) => {
              if (!data || !data.apiKey) throw new Error('no api key');
              localStorage.setItem('hakster_google_token', data.apiKey);
              localStorage.setItem('hakster_api_key', data.apiKey);
              localStorage.removeItem('hakster_signed_out_at');
              if (data.user) localStorage.setItem('hakster_user_data', JSON.stringify(data.user));
              window.location.reload();
            })
            .catch(() => {
              window.location.replace(`/?signin=1&redirect=${encodeURIComponent(path)}`);
            });
          return true;
        })();

        if (path === '/') return;
        // /admin pages stay visually concealed until the server verifies the owner.
        if (path === '/admin' || path.startsWith('/admin/')) return;
        // Public surfaces: pricing and passkey sign-in have to work while signed
        // out. Pricing is advertised to visitors who have no account yet, and the
        // passkey page is how a passwordless account signs back in.
        if (['/plans', '/plans/', '/passkey', '/passkey/'].includes(path)) return;
        const token = localStorage.getItem('hakster_google_token') || localStorage.getItem('hakster_api_key');
        const authParam = new URLSearchParams(window.location.search).get('google_auth');
        if (!token && !authParam) {
          // A Telegram sign-in started above is still resolving — let it finish
          // instead of bouncing to the landing page's sign-in prompt.
          if (telegramSignInPending) return;
          const returnTo = path === '/miniforge/' || path === '/miniforge' ? '/miniforge/' : path;
          window.location.replace(`/?signin=1&redirect=${encodeURIComponent(returnTo)}`);
          return;
        }
        if (path === '/dashboard' || path === '/dashboard/') {
          if (!token) return;
          fetch('/api/auth/authorize-page?page=dashboard', { headers: { 'x-api-key': token } })
            .then(async (res) => {
              if (res.ok) return;
              let data = {};
              try { data = await res.json(); } catch {}
              window.location.href = data.redirect || '/';
            })
            .catch(() => { window.location.href = '/'; });
        }
        // Owner-only pages: Terminal, Hack Lab, Command Center. Signed-in
        // non-owners land in the chat UI; anonymous users are already
        // redirected above.
        const ownerPaths = ['/terminal', '/hack', '/commands', '/cockpit', '/dashboard', '/labs', '/portal', '/hakterm'];
        const normPath = path.replace(/\/+$/, '') || '/';
        if (ownerPaths.includes(normPath)) {
          if (!token) return; // auth gate above handled it
          const apiBase = window.location.port === '4321' ? 'http://localhost:3579' : '';
          fetch(apiBase + '/api/auth/me', { headers: { 'x-api-key': token } })
            .then(async (res) => {
              if (!res.ok) { window.location.href = '/'; return; }
              const data = await res.json().catch(() => null);
              if (!data?.user?.is_owner) window.location.href = '/miniforge/';
            })
            .catch(() => { window.location.href = '/'; });
        }
      })();

      // ── Redirect protected nav links to Google sign-in if not logged in ─
      (function() {
        const API = window.location.port === '4321' ? 'http://localhost:3579' : '';
        document.querySelectorAll('.requires-auth').forEach((link) => {
          link.addEventListener('click', (e) => {
            // Either key name is a real session: Google/passkey/Telegram sign-in writes
            // hakster_google_token, checkout and pasted keys write hakster_api_key. Checking
            // only one of them asked signed-in users to sign in a second time.
            const token = localStorage.getItem('hakster_google_token') || localStorage.getItem('hakster_api_key');
            if (token) return;
            e.preventDefault();
            const href = link.getAttribute('href');
            sessionStorage.setItem('hakster_post_auth_redirect', href || '/dashboard');
            window.location.href = `${API}/api/auth/google/redirect`;
          });
        });
      })();

      // ── Session ─────────────────────────────────────────────────
      // Remember who is signed in across reloads and end the session after
      // five minutes without activity.
      const SESSION_IDLE_MS = 5 * 60 * 1000;
      const ACTIVITY_KEY = 'hakster_last_activity';
      const REMEMBER_KEY = 'hakster_remembered_user';
      // The admin PIN pad counts as the user being present: typing a PIN is activity, and
      // the idle clock must not sign an owner out while the pad is on screen.
      let bumpHaksterActivity = () => {};

      function isSignedIn() {
        return !!(localStorage.getItem('hakster_google_token') || localStorage.getItem('hakster_api_key'));
      }

      function rememberUser() {
        try {
          const u = JSON.parse(localStorage.getItem('hakster_google_user')
                    || localStorage.getItem('hakster_user_data') || '{}');
          if (u && (u.email || u.name || u.username)) {
            localStorage.setItem(REMEMBER_KEY, JSON.stringify({
              email: u.email || '', name: u.name || u.username || '',
              at: Date.now(),
            }));
          }
        } catch (_) {}
      }

      // ── Global logout function ──────────────────────────────────
      function globalLogout() {
        rememberUser();                     // keep the identity for next sign-in
        // Revoke the admin PIN session before navigating away. The storage event
        // also locks admin pages that are open in another tab.
        sessionStorage.removeItem('hakster_admin_pin_session');
        localStorage.setItem('hakster_signed_out_at', String(Date.now()));
        window.dispatchEvent(new Event('hakster:signout'));
        localStorage.removeItem('hakster_google_token');
        localStorage.removeItem('hakster_google_user');
        localStorage.removeItem('hakster_user_data');
        localStorage.removeItem('hakster_api_key');
        localStorage.removeItem('hakster_user');
        localStorage.removeItem('hakster_last_activity');
        window.location.href = '/';
      }
      window.globalLogout = globalLogout;

      // Lock an already-open admin page when this tab or another tab signs out.
      window.addEventListener('storage', (event) => {
        if (event.key === 'hakster_signed_out_at') {
          sessionStorage.removeItem('hakster_admin_pin_session');
          window.dispatchEvent(new Event('hakster:signout'));
        }
      });

      // Start the idle clock on load and refresh it on real activity.
      let localLastActivity = Number(localStorage.getItem(ACTIVITY_KEY)) || 0;
      if (isSignedIn() && !localLastActivity) {
        localLastActivity = Date.now();
        localStorage.setItem(ACTIVITY_KEY, String(localLastActivity));
      }
      (function idleWatch() {
        let lastWrite = 0;
        const enforceIdleTimeout = () => {
          if (!isSignedIn()) return;
          const gate = document.getElementById('admin-pin-gate');
          if (gate && gate.getAttribute('aria-hidden') === 'false') return;
          const sharedLastActivity = Number(localStorage.getItem(ACTIVITY_KEY)) || 0;
          const lastActivity = Math.max(localLastActivity, sharedLastActivity);
          if (lastActivity && Date.now() - lastActivity >= SESSION_IDLE_MS) globalLogout();
        };
        const bump = () => {
          if (!isSignedIn()) return;
          enforceIdleTimeout();
          if (!isSignedIn()) return;
          const now = Date.now();
          localLastActivity = now;
          if (now - lastWrite >= 15000) { // share activity across tabs, throttled
            lastWrite = now;
            localStorage.setItem(ACTIVITY_KEY, String(now));
          }
        };
        ['click', 'keydown', 'mousemove', 'scroll', 'touchstart']
          .forEach(ev => window.addEventListener(ev, bump, { passive: true }));
        bumpHaksterActivity = bump;
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') enforceIdleTimeout();
        });
        enforceIdleTimeout();
        setInterval(enforceIdleTimeout, 5000);
      })();

      // ── Show user badge + logout buttons if signed in ───────────
      (function() {
        const token = localStorage.getItem('hakster_google_token') || localStorage.getItem('hakster_api_key');
        const userData = localStorage.getItem('hakster_user_data');
        const googleUserData = localStorage.getItem('hakster_google_user');
        if (!token) return;

        // Parse stored user data (name, email, avatar)
        let user = {};
        try { user = JSON.parse(userData || '{}'); } catch {}
        let googleUser = {};
        try { googleUser = JSON.parse(googleUserData || '{}'); } catch {}
        user = { ...googleUser, ...user };

        function renderUserBadge(currentUser) {
          const userId = currentUser.id || currentUser.userId || currentUser.sub || '';
          const maskedUserId = userId && userId.length > 14 ? `${userId.slice(0, 8)}…${userId.slice(-4)}` : userId;
          const userName = currentUser.name || currentUser.username || currentUser.email || 'User';

          if (navBadge) {
