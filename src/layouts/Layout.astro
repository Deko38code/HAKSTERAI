    <aside id="haksterai-problem-toast" role="alert" aria-live="assertive" hidden style="position:fixed;right:18px;bottom:18px;z-index:2000;width:min(440px,calc(100vw - 36px));border:1px solid rgba(248,113,113,.45);border-radius:16px;background:#111118;color:#e2e8f0;box-shadow:0 12px 42px rgba(0,0,0,.55);padding:16px;font:14px/1.45 system-ui,sans-serif">
      <div style="display:flex;align-items:center;gap:8px;color:#fca5a5;font-weight:800"><span aria-hidden="true">⚠</span><span>HaksterAI noticed a problem</span><button id="haksterai-problem-close" type="button" aria-label="Dismiss problem" style="margin-left:auto;background:transparent;color:#94a3b8;border:0;font-size:20px;cursor:pointer">×</button></div>
      <p id="haksterai-problem-message" style="margin:10px 0;color:#cbd5e1;overflow-wrap:anywhere"></p>
      <div style="display:flex;gap:8px"><button id="haksterai-problem-copy" type="button" style="border:1px solid #334155;background:#1e293b;color:#e2e8f0;border-radius:9px;padding:7px 11px;cursor:pointer">Copy</button><button id="haksterai-problem-popout" type="button" style="border:1px solid #334155;background:#1e293b;color:#e2e8f0;border-radius:9px;padding:7px 11px;cursor:pointer">Pop out</button></div>
    </aside>
    <aside id="haksterai-update-toast" role="status" aria-live="polite" hidden style="position:fixed;top:14px;left:50%;transform:translateX(-50%);z-index:1999;width:min(560px,calc(100vw - 28px));border:1px solid rgba(124,58,237,.55);border-radius:14px;background:#111118;color:#e2e8f0;box-shadow:0 12px 42px rgba(0,0,0,.5);padding:12px 14px;font:14px/1.45 system-ui,sans-serif">
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap"><span style="flex:1;min-width:190px"><strong style="color:#c4b5fd">HaksterAI update ready</strong><br /><span id="haksterai-update-detail" style="color:#94a3b8;font-size:12px">A newer version is available.</span></span><button id="haksterai-update-now" type="button" style="border:0;background:#7c3aed;color:white;border-radius:9px;padding:8px 12px;font-weight:700;cursor:pointer">Update</button><button id="haksterai-update-later" type="button" style="border:1px solid #334155;background:#1e293b;color:#cbd5e1;border-radius:9px;padding:8px 12px;cursor:pointer">Later</button></div>
    </aside>

    <script is:inline data-cfasync="false">
      (() => {
        const problem = document.getElementById('haksterai-problem-toast');
        const message = document.getElementById('haksterai-problem-message');
        let lastProblem = '';
        const showProblem = (value) => {
          const text = String(value || 'An unexpected error occurred.').replace(/[\\r\\n\\t]+/g, ' ').slice(0, 900);
          if (!problem || !message || !text || text === lastProblem) return;
          lastProblem = text;
          message.textContent = text;
          problem.hidden = false;
        };
        window.addEventListener('error', (event) => showProblem(event.message || 'A page script failed to load.'));
        window.addEventListener('unhandledrejection', (event) => showProblem(event.reason?.message || event.reason || 'A background request failed.'));
        window.addEventListener('haksterai:problem', (event) => showProblem(event.detail?.message || event.detail));
        document.getElementById('haksterai-problem-close')?.addEventListener('click', () => { problem.hidden = true; });
        document.getElementById('haksterai-problem-copy')?.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(message.textContent || ''); } catch { showProblem('Clipboard access was blocked by this browser.'); }
        });
        document.getElementById('haksterai-problem-popout')?.addEventListener('click', () => {
          const win = window.open('', '_blank');
          if (!win) return showProblem('The browser blocked the pop-out window.');
          win.opener = null;
          const title = win.document.createElement('title'); title.textContent = 'HaksterAI problem details';
          const heading = win.document.createElement('h1'); heading.textContent = 'HaksterAI noticed a problem';
          const body = win.document.createElement('pre'); body.textContent = message.textContent || '';
          win.document.head.append(title); win.document.body.append(heading, body);
        });

        const update = document.getElementById('haksterai-update-toast');
        const updateDetail = document.getElementById('haksterai-update-detail');
        const currentBuild = document.documentElement.dataset.haksterBuild || '';
        const laterKey = 'haksterai-update-later-until';
        // How old the new build is, in plain words, from its build timestamp.
        const ago = (iso) => {
          const t = Date.parse(iso || '');
          if (!Number.isFinite(t)) return '';
          const secs = Math.max(0, Math.round((Date.now() - t) / 1000));
          if (secs < 60) return secs + 's ago';
          if (secs < 3600) return Math.round(secs / 60) + 'm ago';
          if (secs < 86400) return Math.round(secs / 3600) + 'h ago';
          return Math.round(secs / 86400) + 'd ago';
        };
        // Every update the widget surfaces is stamped and written to the server's
        // update log, so we can always see when each build went out and who saw it.
        const logUpdateSeen = (build, from) => {
          try {
            fetch('/api/version/seen', {
              method: 'POST',
              cache: 'no-store',
              credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ build, from, path: location.pathname, at: new Date().toISOString() }),
              keepalive: true,
            }).catch(() => {});
          } catch {}
        };
        // Runs for every signed-in user (owner and customers), every two minutes
        // while the tab is visible. Primary check: the tiny /api/version endpoint,
        // which reports the build id actually deployed. Fallback: re-fetch this
        // page and read its own build meta, for older servers without the endpoint.
        const remoteBuildId = async () => {
          try {
            const res = await fetch('/api/version?t=' + Date.now(), { cache: 'no-store', credentials: 'same-origin' });
            if (res.ok) {
              const data = await res.json();
              if (data && data.build) return String(data.build);
            }
          } catch { /* fall through to the page check */ }
          const url = new URL(location.pathname, location.origin);
          url.searchParams.set('_hakster_version_check', String(Date.now()));
          const response = await fetch(url, { cache: 'no-store', credentials: 'same-origin', headers: { 'x-hakster-version-check': '1' } });
          if (!response.ok) return '';
          const html = await response.text();
          const match = html.match(/<meta\s+name=["']haksterai-build["']\s+content=["']([^"']+)/i);
          return match ? match[1] : '';
        };
        let announcedBuild = '';
        const checkUpdate = async () => {
          if (!currentBuild || document.visibilityState !== 'visible') return;
          try {
            const latest = await remoteBuildId();
            if (!latest || latest === currentBuild) return;
            const deferredUntil = Number(localStorage.getItem(laterKey) || 0);
            if (updateDetail) {
              const built = Number.isFinite(Date.parse(latest)) ? new Date(latest).toISOString().replace('T', ' ').slice(0, 16) + ' UTC' : latest;
              updateDetail.textContent = 'New build ' + built + (ago(latest) ? ' · ' + ago(latest) : '') + '.';
            }
            if (Date.now() >= deferredUntil && update) {
              update.hidden = false;
              armAutoApply();
            }
            if (announcedBuild !== latest) {
              announcedBuild = latest;
              logUpdateSeen(latest, currentBuild);
            }
          } catch { /* Offline checks are quiet; retry on the next interval. */ }
        };
        // Update never reloads blind. A blind reload can land in the half-second a
        // deploy restarts the server, which shows a dead page instead of the site.
        // So: ask the server first, and if it is restarting, keep this page alive
        // and let hakster-resume.js reload the moment it answers again.
        const updateNow = document.getElementById('haksterai-update-now');
        const applyUpdate = async () => {
          cancelAutoApply();
          localStorage.removeItem(laterKey);
          if (updateNow?.dataset.busy) return;
          if (updateNow) {
            updateNow.dataset.busy = '1';
            updateNow.textContent = 'Updating…';
            updateNow.style.opacity = '0.8';
          }
          let ok = false;
          try { ok = typeof window.haksterServerHealthy === 'function' ? await window.haksterServerHealthy() : true; } catch { ok = false; }
          if (ok) { location.reload(); return; }
          // Server is mid-restart: hand off to the resume helper, which retries and
          // reloads automatically when the new build is serving.
          if (typeof window.haksterUpdateWhenReady === 'function') {
            window.haksterUpdateWhenReady();
            if (updateNow) updateNow.textContent = 'Waiting…';
            return;
          }
          window.setTimeout(() => location.reload(), 4000);
        };
        updateNow?.addEventListener('click', applyUpdate);

        // 2026-11-16 (owner): if the banner is shown and neither Update nor Later
        // is clicked within a minute, apply it automatically — deploys should
        // land on their own. Same safe path as the button; the countdown is
        // visible in the banner's detail line so it is never a surprise.
        const AUTO_APPLY_MS = 60000;
        let autoApplyTimer = 0;
        let autoApplyTick = 0;
        function cancelAutoApply() {
          if (autoApplyTimer) { clearTimeout(autoApplyTimer); autoApplyTimer = 0; }
          if (autoApplyTick) { clearInterval(autoApplyTick); autoApplyTick = 0; }
        }
        function armAutoApply() {
          if (autoApplyTimer || !update || update.hidden) return;
          const until = Date.now() + AUTO_APPLY_MS;
          const paint = () => {
            if (!updateDetail) return;
            // Strip a previous countdown before re-rendering, so a later check that
            // rewrites the detail line cannot leave a stale number behind.
            const base = (updateDetail.textContent || '').replace(/\s*·\s*applies automatically in \d+s$/, '');
            const secs = Math.max(0, Math.ceil((until - Date.now()) / 1000));
            updateDetail.textContent = base + ' · applies automatically in ' + secs + 's';
          };
          paint();
          autoApplyTick = window.setInterval(paint, 1000);
          autoApplyTimer = window.setTimeout(() => { applyUpdate(); }, AUTO_APPLY_MS);
        }
        document.getElementById('haksterai-update-later')?.addEventListener('click', () => {
          // "Later" is a deliberate choice, so it cancels the one-minute auto-apply
          // and defers the banner for 30 minutes.
          cancelAutoApply();
          localStorage.setItem(laterKey, String(Date.now() + 30 * 60 * 1000));
          if (update) update.hidden = true;
        });
        window.setTimeout(checkUpdate, 15000);
        window.setInterval(checkUpdate, 120000);
        // Coming back to the tab counts as a fresh moment to check — no waiting
        // for the next two-minute tick.
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') checkUpdate();
        });
      })();
    </script>

    <script is:inline data-cfasync="false" src="/js/session-timeout.js"></script>

    <!-- Always-visible scrollbars. Firefox already draws real bars from the rules in
         global.css; Chrome/Chromium on Linux uses overlay scrollbars that ignore
         scrollbar styling, so this fills in a real bar on the page, the dashboard
         tab strip, tables, logs and every other scrollable box. Layout-safe. -->
    <script is:inline data-cfasync="false" src="/js/hakster-scrollbars.js" defer></script>

    <!-- Smooth updates + auto-resume for every user. If the server restarts or
         hiccups while a tab is open, the tab shows a small "reconnecting" line and
         picks itself back up on the same page instead of going dead; the Update
         button reloads only once the server is confirmed answering. -->
    <script is:inline data-cfasync="false" src="/js/hakster-resume.js" defer></script>

    <!-- Global JS: mobile menu + scroll shadow + smooth scroll + user badge + logout -->
    <script>
      // ── Auth gate: redirect to landing if not signed in ─────────
      (function() {
        const path = window.location.pathname;

        // ── Telegram: the bot's own sign-in counts as a site sign-in ──
        // Opened from a HaksterAI bot, Telegram signs the request (initData,
        // also carried in the URL hash). Trade it for the same apiKey every
        // page here reads, then reload so the gate below runs with a real
        // session. If this browser is already signed in, link the Telegram
        // account to that same user instead of creating a second account —
        // that is the owner case, where the site account predates the bot.
        const telegramSignInPending = (function telegramAuth() {
          let initData = '';
          try {
            const tg = window.Telegram && window.Telegram.WebApp;
            initData = (tg && tg.initData) || '';
          } catch (_) {}
          if (!initData) {
            const m = /(?:^#|&)tgWebAppData=([^&]+)/.exec(window.location.hash || '');
            if (m) { try { initData = decodeURIComponent(m[1]); } catch (_) {} }
          }
          if (!initData) return false;
          const existing = localStorage.getItem('hakster_google_token') || localStorage.getItem('hakster_api_key');
          if (existing) {
            if (localStorage.getItem('hakster_tg_linked_at')) return false;
            fetch('/api/auth/telegram/link', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'x-api-key': existing },
              body: JSON.stringify({ initData })
            }).then((res) => { if (res.ok) localStorage.setItem('hakster_tg_linked_at', String(Date.now())); }).catch(() => {});
            return false;
          }
          fetch('/api/auth/telegram/webapp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ initData })
          })
            .then((res) => (res.ok ? res.json() : null))
            .then((data) => {
              if (!data || !data.apiKey) throw new Error('no api key');
              localStorage.setItem('hakster_google_token', data.apiKey);
              localStorage.setItem('hakster_api_key', data.apiKey);
              localStorage.removeItem('hakster_signed_out_at');
              if (data.user) localStorage.setItem('hakster_user_data', JSON.stringify(data.user));
              window.location.reload();
            })
            .catch(() => {
              window.location.replace(`/?signin=1&redirect=${encodeURIComponent(path)}`);
            });
          return true;
        })();

        if (path === '/') return;
        // /admin pages stay visually concealed until the server verifies the owner.
        if (path === '/admin' || path.startsWith('/admin/')) return;
        // Public surfaces: pricing and passkey sign-in have to work while signed
        // out. Pricing is advertised to visitors who have no account yet, and the
        // passkey page is how a passwordless account signs back in.
        if (['/plans', '/plans/', '/passkey', '/passkey/'].includes(path)) return;
        const token = localStorage.getItem('hakster_google_token') || localStorage.getItem('hakster_api_key');
        const authParam = new URLSearchParams(window.location.search).get('google_auth');
        if (!token && !authParam) {
          // A Telegram sign-in started above is still resolving — let it finish
          // instead of bouncing to the landing page's sign-in prompt.
          if (telegramSignInPending) return;
          const returnTo = path === '/miniforge/' || path === '/miniforge' ? '/miniforge/' : path;
          window.location.replace(`/?signin=1&redirect=${encodeURIComponent(returnTo)}`);
          return;
        }
        if (path === '/dashboard' || path === '/dashboard/') {
          if (!token) return;
          fetch('/api/auth/authorize-page?page=dashboard', { headers: { 'x-api-key': token } })
            .then(async (res) => {
              if (res.ok) return;
              let data = {};
              try { data = await res.json(); } catch {}
              window.location.href = data.redirect || '/';
            })
            .catch(() => { window.location.href = '/'; });
        }
        // Owner-only pages: Terminal, Hack Lab, Command Center. Signed-in
        // non-owners land in the chat UI; anonymous users are already
        // redirected above.
        const ownerPaths = ['/terminal', '/hack', '/commands', '/cockpit', '/dashboard', '/labs', '/portal', '/hakterm'];
        const normPath = path.replace(/\/+$/, '') || '/';
        if (ownerPaths.includes(normPath)) {
          if (!token) return; // auth gate above handled it
          const apiBase = window.location.port === '4321' ? 'http://localhost:3579' : '';
          fetch(apiBase + '/api/auth/me', { headers: { 'x-api-key': token } })
            .then(async (res) => {
              if (!res.ok) { window.location.href = '/'; return; }
              const data = await res.json().catch(() => null);
              if (!data?.user?.is_owner) window.location.href = '/miniforge/';
            })
            .catch(() => { window.location.href = '/'; });
        }
      })();

      // ── Redirect protected nav links to Google sign-in if not logged in ─
      (function() {
        const API = window.location.port === '4321' ? 'http://localhost:3579' : '';
        document.querySelectorAll('.requires-auth').forEach((link) => {
          link.addEventListener('click', (e) => {
            // Either key name is a real session: Google/passkey/Telegram sign-in writes
            // hakster_google_token, checkout and pasted keys write hakster_api_key. Checking
            // only one of them asked signed-in users to sign in a second time.
            const token = localStorage.getItem('hakster_google_token') || localStorage.getItem('hakster_api_key');
            if (token) return;
            e.preventDefault();
            const href = link.getAttribute('href');
            sessionStorage.setItem('hakster_post_auth_redirect', href || '/dashboard');
            window.location.href = `${API}/api/auth/google/redirect`;
          });
        });
      })();

      // ── Session ─────────────────────────────────────────────────
      // Remember who is signed in across reloads and end the session after
      // five minutes without activity.
      const SESSION_IDLE_MS = 5 * 60 * 1000;
      const ACTIVITY_KEY = 'hakster_last_activity';
      const REMEMBER_KEY = 'hakster_remembered_user';
      // The admin PIN pad counts as the user being present: typing a PIN is activity, and
      // the idle clock must not sign an owner out while the pad is on screen.
      let bumpHaksterActivity = () => {};

      function isSignedIn() {
        return !!(localStorage.getItem('hakster_google_token') || localStorage.getItem('hakster_api_key'));
      }

      function rememberUser() {
        try {
          const u = JSON.parse(localStorage.getItem('hakster_google_user')
                    || localStorage.getItem('hakster_user_data') || '{}');
          if (u && (u.email || u.name || u.username)) {
            localStorage.setItem(REMEMBER_KEY, JSON.stringify({
              email: u.email || '', name: u.name || u.username || '',
              at: Date.now(),
            }));
          }
        } catch (_) {}
      }

      // ── Global logout function ──────────────────────────────────
      function globalLogout() {
        rememberUser();                     // keep the identity for next sign-in
        // Revoke the admin PIN session before navigating away. The storage event
        // also locks admin pages that are open in another tab.
        sessionStorage.removeItem('hakster_admin_pin_session');
        localStorage.setItem('hakster_signed_out_at', String(Date.now()));
        window.dispatchEvent(new Event('hakster:signout'));
        localStorage.removeItem('hakster_google_token');
        localStorage.removeItem('hakster_google_user');
        localStorage.removeItem('hakster_user_data');
        localStorage.removeItem('hakster_api_key');
        localStorage.removeItem('hakster_user');
        localStorage.removeItem('hakster_last_activity');
        window.location.href = '/';
      }
      window.globalLogout = globalLogout;

      // Lock an already-open admin page when this tab or another tab signs out.
      window.addEventListener('storage', (event) => {
        if (event.key === 'hakster_signed_out_at') {
          sessionStorage.removeItem('hakster_admin_pin_session');
          window.dispatchEvent(new Event('hakster:signout'));
        }
      });

      // Start the idle clock on load and refresh it on real activity.
      let localLastActivity = Number(localStorage.getItem(ACTIVITY_KEY)) || 0;
      if (isSignedIn() && !localLastActivity) {
        localLastActivity = Date.now();
        localStorage.setItem(ACTIVITY_KEY, String(localLastActivity));
      }
      (function idleWatch() {
        let lastWrite = 0;
        const enforceIdleTimeout = () => {
          if (!isSignedIn()) return;
          const gate = document.getElementById('admin-pin-gate');
          if (gate && gate.getAttribute('aria-hidden') === 'false') return;
          const sharedLastActivity = Number(localStorage.getItem(ACTIVITY_KEY)) || 0;
          const lastActivity = Math.max(localLastActivity, sharedLastActivity);
          if (lastActivity && Date.now() - lastActivity >= SESSION_IDLE_MS) globalLogout();
        };
        const bump = () => {
          if (!isSignedIn()) return;
          enforceIdleTimeout();
          if (!isSignedIn()) return;
          const now = Date.now();
          localLastActivity = now;
          if (now - lastWrite >= 15000) { // share activity across tabs, throttled
            lastWrite = now;
            localStorage.setItem(ACTIVITY_KEY, String(now));
          }
        };
        ['click', 'keydown', 'mousemove', 'scroll', 'touchstart']
          .forEach(ev => window.addEventListener(ev, bump, { passive: true }));
        bumpHaksterActivity = bump;
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') enforceIdleTimeout();
        });
        enforceIdleTimeout();
        setInterval(enforceIdleTimeout, 5000);
      })();

      // ── Show user badge + logout buttons if signed in ───────────
      (function() {
        const token = localStorage.getItem('hakster_google_token') || localStorage.getItem('hakster_api_key');
        const userData = localStorage.getItem('hakster_user_data');
        const googleUserData = localStorage.getItem('hakster_google_user');
        if (!token) return;

        // Parse stored user data (name, email, avatar)
        let user = {};
        try { user = JSON.parse(userData || '{}'); } catch {}
        let googleUser = {};
        try { googleUser = JSON.parse(googleUserData || '{}'); } catch {}
        user = { ...googleUser, ...user };

        function renderUserBadge(currentUser) {
          const userId = currentUser.id || currentUser.userId || currentUser.sub || '';
          const maskedUserId = userId && userId.length > 14 ? `${userId.slice(0, 8)}…${userId.slice(-4)}` : userId;
          const userName = currentUser.name || currentUser.username || currentUser.email || 'User';

          if (navBadge) {
            navBadge.classList.remove('hidden');
            navBadge.classList.add('flex');
            const nameEl = document.getElementById('nav-user-name');
            const idEl = document.getElementById('nav-user-id');
            const avatarEl = document.getElementById('nav-user-avatar');
            if (nameEl) nameEl.textContent = userName;
            if (idEl && userId) { idEl.textContent = `#${maskedUserId}`; idEl.title = `User ID #${userId}`; idEl.classList.remove('hidden'); }
            if (avatarEl) avatarEl.textContent = userName.charAt(0).toUpperCase();
          }

          if (mobileSection) {
            mobileSection.classList.remove('hidden');
            const nameEl = document.getElementById('mobile-user-name');
            const emailEl = document.getElementById('mobile-user-email');
            const idEl = document.getElementById('mobile-user-id');
            const avatarEl = document.getElementById('mobile-user-avatar');
            if (nameEl) nameEl.textContent = userName;
            if (emailEl) emailEl.textContent = currentUser.email || '';
            if (idEl) { idEl.textContent = userId ? `ID #${maskedUserId}` : ''; idEl.title = userId ? `User ID #${userId}` : ''; }
            if (avatarEl) avatarEl.textContent = userName.charAt(0).toUpperCase();
          }
        }

        // Desktop navbar badge
        const navBadge = document.getElementById('nav-user-badge');
        const navSignin = document.getElementById('nav-signin-btn');

        // Mobile quick logout button
        const mobileLogout = document.getElementById('mobile-logout-btn');

        // Mobile menu user section
        const mobileSection = document.getElementById('mobile-user-section');
        renderUserBadge(user);
        if (navSignin) navSignin.classList.add('hidden');
        // Signed-in users manage passkeys at /passkey; the nav CTA is for signing in.
        document.getElementById('nav-passkey-btn')?.classList.add('hidden');
        if (mobileLogout) mobileLogout.classList.remove('hidden');

        fetch('/api/auth/me', { headers: { 'x-api-key': token } })
          .then((res) => res.ok ? res.json() : null)
          .then((data) => {
            if (!data?.user) return;
            const dbUser = {
              ...user,
              ...data.user,
              name: data.user.username || data.user.email || user.name || 'User',
            };
            localStorage.setItem('hakster_google_user', JSON.stringify({ ...googleUser, ...data.user }));
            localStorage.setItem('hakster_user_data', JSON.stringify({
              id: dbUser.id || '',
              name: dbUser.name,
              email: dbUser.email || '',
              picture: dbUser.picture || '',
            }));
            renderUserBadge(dbUser);
            document.querySelectorAll('[data-admin-only="true"]').forEach((el) => {
              el.classList.toggle('hidden', !dbUser.is_owner);
              el.classList.toggle('flex', Boolean(dbUser.is_owner));
            });
            document.querySelectorAll('[data-owner-only="true"]').forEach((el) => {
              const isOwner = Boolean(dbUser.is_owner);
              el.classList.toggle('hidden', !isOwner);
              el.classList.toggle('flex', isOwner);
            });
          })
          .catch(() => {});

        // Wire up logout buttons
        document.getElementById('nav-logout-btn')?.addEventListener('click', globalLogout);
        document.getElementById('mobile-logout-btn')?.addEventListener('click', globalLogout);
        document.getElementById('mobile-menu-logout')?.addEventListener('click', globalLogout);
      })();

      // ── Admin tools dropdown ─────────────────────────────────────
      const adminTools = document.getElementById('admin-tools');
      const adminToolsBtn = document.getElementById('admin-tools-btn');
      const adminToolsMenu = document.getElementById('admin-tools-menu');
      const mobileAdminTools = document.getElementById('mobile-admin-tools');
      const mobileAdminToolsBtn = document.getElementById('mobile-admin-tools-btn');
      const mobileAdminToolsMenu = document.getElementById('mobile-admin-tools-menu');
      const adminPinGate = document.getElementById('admin-pin-gate');
      const adminPinSubtitle = document.getElementById('admin-pin-subtitle');
      const adminPinError = document.getElementById('admin-pin-error');
      const adminPinDots = [...document.querySelectorAll('[data-admin-pin-dot]')];
      const ADMIN_GATE_PIN_KEY = 'hakster_admin_pin';
      const ADMIN_GATE_SESSION_KEY = 'hakster_admin_pin_session';
      // A page that bounced here for its PIN leaves the path it wants back. HakTerm sets
      // this too, and it doubles as "ask for a fresh PIN even if this tab is unlocked".
      const ADMIN_GATE_RETURN_KEY = 'hakster_admin_return';
      // One-shot permit HakTerm consumes on entry, so every open costs a fresh PIN.
      const ADMIN_GATE_HAKTERM_PASS_KEY = 'hakster_hakterm_pass';
      let adminGatePin = '';
      let adminGatePendingPin = '';
      let adminGateMode = 'unlock';
      let adminGateOnSuccess = null;
      function paintAdminGatePin() {
        adminPinDots.forEach((dot, index) => {
          dot.classList.toggle('bg-amber-300', index < adminGatePin.length);
          dot.classList.toggle('shadow-[0_0_10px_#fcd34d]', index < adminGatePin.length);
        });
      }
      function closeAdminPinGate() {
        adminPinGate?.setAttribute('aria-hidden', 'true');
        adminGatePin = '';
        paintAdminGatePin();
      }
      function openAdminPinGate(onSuccess) {
        // Already open: keep the entry in progress instead of resetting the pad.
        // A status re-check used to call this again and wipe a half-typed PIN.
        if (adminPinGate?.getAttribute('aria-hidden') === 'false') {
          if (onSuccess) adminGateOnSuccess = onSuccess;
          return;
        }
        // A page that bounced here for its PIN (HakTerm) wants a new PIN entry, not the
        // tab's stored unlock, so it must see the pad even when this tab is unlocked.
        let wantsFreshUnlock = false;
        try { wantsFreshUnlock = !!sessionStorage.getItem(ADMIN_GATE_RETURN_KEY); } catch {}
        if (!wantsFreshUnlock && sessionStorage.getItem(ADMIN_GATE_SESSION_KEY) === '1') return onSuccess();
        // A page with its own PIN pad owns the lock until it is unlocked.
        if (document.querySelector('[data-page-admin-pin="true"]')) return;
        adminGateOnSuccess = onSuccess;
        adminGatePin = '';
        adminGatePendingPin = '';
        try { bumpHaksterActivity(); } catch {}
        adminGateMode = localStorage.getItem(ADMIN_GATE_PIN_KEY) ? 'unlock' : 'setup_new';
        adminPinSubtitle.textContent = adminGateMode === 'setup_new' ? 'SET YOUR 6-DIGIT PIN' : 'ENTER PIN TO ACCESS ADMIN';
        adminPinError.textContent = '';
        paintAdminGatePin();
        adminPinGate?.setAttribute('aria-hidden', 'false');
      }
      window.openHaksterAdminPinGate = openAdminPinGate;
      // 2026-11-17 (owner): "the hakterm should be set already" — "the pin".
      // HakTerm opens only through a fresh PIN entry, every time. The link parks
      // its destination in ADMIN_GATE_RETURN_KEY, which is what makes
      // openAdminPinGate ignore this tab's stored unlock and show the pad; a
      // correct PIN then sets the one-shot HakTerm permit and goes straight
      // there. A page with its own pin pad (users/telegram) already holds the
      // lock, so there the link just navigates.
      document.querySelectorAll('#admin-tools-menu a[href^="/hakterm"], #mobile-admin-tools-menu a[href^="/hakterm"]').forEach((link) => {
        link.addEventListener('click', (event) => {
          if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button > 0) return;
          closeAdminTools();
          closeMobileAdminTools();
          if (document.querySelector('[data-page-admin-pin="true"]')) return;
          event.preventDefault();
          try { sessionStorage.setItem(ADMIN_GATE_RETURN_KEY, link.getAttribute('href') || '/hakterm/'); } catch {}
          openAdminPinGate();
        });
      });
      // ── Owner-session check for the PIN pad ─────────────────────
      // A correct PIN is a local lock only. The server must still say this browser holds an
      // owner session, so the pad verifies /api/auth/me itself. Without this, a PIN typed
      // after the key expired unlocked the page and the first data call then said "sign in",
      // which read as being asked to sign in twice.
      const ADMIN_GATE_VERIFIED_KEY = 'hakster_owner_verified_at';
      function adminGateApiBase() { return window.location.port === '4321' ? 'http://localhost:3579' : ''; }
      async function adminOwnerSession() {
        const candidates = [];
        try {
          const google = localStorage.getItem('hakster_google_token');
          const apiKey = localStorage.getItem('hakster_api_key');
          if (google) candidates.push(['hakster_google_token', google]);
          if (apiKey && apiKey !== google) candidates.push(['hakster_api_key', apiKey]);
        } catch {}
        if (!candidates.length) return { ok: false, reason: 'signin' };
        let offline = false;
        for (const [name, key] of candidates) {
          let response;
          try {
            response = await fetch(adminGateApiBase() + '/api/auth/me', { headers: { 'x-api-key': key }, cache: 'no-store' });
          } catch {
            offline = true;
            continue;
          }
          if (response.status === 401) {
            // This stored key is dead — drop just that one so the next sign-in starts clean.
            try { if (localStorage.getItem(name) === key) localStorage.removeItem(name); } catch {}
            continue;
          }
          if (!response.ok) return { ok: false, reason: 'offline' };
          const data = await response.json().catch(() => null);
          if (!data?.user) return { ok: false, reason: 'expired' };
          if (!data.user.is_owner) return { ok: false, reason: 'notowner' };
          try { sessionStorage.setItem(ADMIN_GATE_VERIFIED_KEY, String(Date.now())); } catch {}
          return { ok: true };
        }
        return { ok: false, reason: offline ? 'offline' : 'signin' };
      }
      function adminGateSendToSignIn() {
        const back = window.location.pathname + window.location.search;
        window.location.assign('/?signin=1&redirect=' + encodeURIComponent(back));
      }
      let adminGateVerifying = false;
      async function submitAdminGatePin() {
        if (adminGateVerifying) return;
        if (adminGatePin.length !== 6) return;
        if (adminGateMode === 'setup_new') {
          adminGatePendingPin = adminGatePin;
          adminGatePin = '';
          adminGateMode = 'setup_confirm';
          adminPinSubtitle.textContent = 'CONFIRM YOUR 6-DIGIT PIN';
          paintAdminGatePin();
          return;
        }
        if (adminGateMode === 'setup_confirm' && adminGatePin === adminGatePendingPin) {
          localStorage.setItem(ADMIN_GATE_PIN_KEY, adminGatePin);
        } else if (adminGateMode === 'setup_confirm') {
          adminPinError.textContent = 'PINs did not match. Start again.';
          adminGatePin = '';
          adminGatePendingPin = '';
          adminGateMode = 'setup_new';
          adminPinSubtitle.textContent = 'SET YOUR 6-DIGIT PIN';
          paintAdminGatePin();
          return;
        } else if (adminGatePin !== localStorage.getItem(ADMIN_GATE_PIN_KEY)) {
          adminPinError.textContent = 'Wrong PIN. Try again.';
          adminGatePin = '';
          paintAdminGatePin();
          return;
        }
        // PIN is correct — now confirm the owner session before unlocking anything.
        const subtitleBefore = adminPinSubtitle.textContent || '';
        adminGateVerifying = true;
        adminPinError.textContent = '';
        adminPinSubtitle.textContent = 'VERIFYING OWNER SESSION…';
        const session = await adminOwnerSession();
        adminGateVerifying = false;
        if (!session.ok) {
          adminGatePin = '';
          paintAdminGatePin();
          if (session.reason === 'notowner') {
            adminPinSubtitle.textContent = subtitleBefore;
            adminPinError.textContent = 'That account is not the owner account. Sign in as the owner.';
            return;
          }
          if (session.reason === 'offline') {
            adminPinSubtitle.textContent = subtitleBefore;
            adminPinError.textContent = 'Could not reach the server. Check the connection and try again.';
            return;
          }
          adminPinSubtitle.textContent = 'SIGN-IN REQUIRED';
          adminPinError.textContent = 'The owner session expired. Taking you to sign in…';
          window.setTimeout(adminGateSendToSignIn, 900);
          return;
        }
        sessionStorage.setItem(ADMIN_GATE_SESSION_KEY, '1');
        const callback = adminGateOnSuccess;
        adminGateOnSuccess = null;
        closeAdminPinGate();
        callback?.();
        window.dispatchEvent(new Event('hakster:admin-unlocked'));
        // A page that bounced here just for its PIN leaves the path it wanted back.
        // Hand control to it now that the tab is unlocked; same-origin paths only.
        let pendingReturn = '';
        try { pendingReturn = sessionStorage.getItem(ADMIN_GATE_RETURN_KEY) || ''; sessionStorage.removeItem(ADMIN_GATE_RETURN_KEY); } catch {}
        if (pendingReturn.startsWith('/') && !pendingReturn.startsWith('//')) {
          // HakTerm gets a one-shot permit: it opens once, and the next open asks again.
          // Both /hakterm/ and /terminal serve the terminal, so both get the permit.
          if (pendingReturn.startsWith('/hakterm') || pendingReturn === '/terminal' || pendingReturn.startsWith('/terminal?')) {
            try { sessionStorage.setItem(ADMIN_GATE_HAKTERM_PASS_KEY, '1'); } catch {}
          }
          window.location.assign(pendingReturn);
        }
      }
      window.addEventListener('hakster:signout', () => {
        sessionStorage.removeItem(ADMIN_GATE_SESSION_KEY);
        closeAdminTools();
        closeMobileAdminTools();
        if (adminPinGate) adminPinGate.setAttribute('aria-hidden', 'true');
      });
      function pressAdminGatePin(key) {
        adminPinError.textContent = '';
        if (key === 'clear') adminGatePin = '';
        else if (key === 'back') adminGatePin = adminGatePin.slice(0, -1);
        else if (/^\d$/.test(key) && adminGatePin.length < 6) adminGatePin += key;
        paintAdminGatePin();
        if (adminGatePin.length === 6) window.setTimeout(submitAdminGatePin, 120);
      }
      adminPinGate?.querySelectorAll('[data-admin-pin-key]').forEach((button) => {
        button.addEventListener('click', () => pressAdminGatePin(button.getAttribute('data-admin-pin-key') || ''));
      });
      // Cancelling the pad also drops a pending destination, so a cancelled
      // HakTerm open does not leave every later admin click asking for a fresh PIN.
      adminPinGate?.querySelector('[data-admin-pin-close]')?.addEventListener('click', () => {
        try { sessionStorage.removeItem(ADMIN_GATE_RETURN_KEY); } catch {}
        closeAdminPinGate();
      });
      document.addEventListener('keydown', (event) => {
        if (adminPinGate?.getAttribute('aria-hidden') === 'true') return;
        if (/^\d$/.test(event.key)) { event.preventDefault(); pressAdminGatePin(event.key); }
        else if (event.key === 'Backspace') { event.preventDefault(); pressAdminGatePin('back'); }
        else if (event.key === 'Delete') { event.preventDefault(); pressAdminGatePin('clear'); }
        else if (event.key === 'Escape') {
          if (adminPath) {
            document.documentElement.dataset.adminPage = 'locked';
            try { sessionStorage.removeItem(ADMIN_GATE_RETURN_KEY); } catch {}
            window.location.replace('/');
          } else {
            try { sessionStorage.removeItem(ADMIN_GATE_RETURN_KEY); } catch {}
            closeAdminPinGate();
          }
        }
      });

      // Verify account ownership before rendering any admin page. The PIN is a
      // second, local lock only; admin data endpoints enforce owner access too.
      // The same set the layout marks data-admin-page for: /admin/* and the dashboard,
      // so an admin tab opened directly always asks for the PIN first.
      const adminPathNorm = window.location.pathname.replace(/\/+$/, '');
      const adminPath = adminPathNorm === '/admin' || adminPathNorm.startsWith('/admin/') || adminPathNorm === '/dashboard';
      if (adminPath) {
        const adminRoot = document.documentElement;
        const apiBase = window.location.port === '4321' ? 'http://localhost:3579' : '';
        let adminCheckInFlight = false;
        const lockAdminPage = () => {
          sessionStorage.removeItem(ADMIN_GATE_SESSION_KEY);
          adminRoot.dataset.adminPage = 'locked';
        };
        const verifyAdminPage = async () => {
          if (adminCheckInFlight) return;
          adminCheckInFlight = true;
          try {
            const token = localStorage.getItem('hakster_google_token') || localStorage.getItem('hakster_api_key') || '';
            if (!token) throw new Error('Sign in required.');
            // The server gate page that delivered this document already verified the owner a
            // moment ago. Trust that for a short window so the pad opens instantly instead of
            // racing a second identical check; the 60-second re-check below still runs.
            let recentlyVerified = false;
            try {
              recentlyVerified = Date.now() - Number(sessionStorage.getItem(ADMIN_GATE_VERIFIED_KEY) || 0) < 90000;
            } catch {}
            let response = null;
            if (!recentlyVerified || adminRoot.dataset.adminPage === 'ready') {
              response = await fetch(apiBase + '/api/auth/me', {
                headers: { 'x-api-key': token },
                cache: 'no-store',
              });
            }
            if (response) {
              const data = response.ok ? await response.json().catch(() => null) : null;
              if (response.status === 401) throw new Error('auth-401');
              if (!response.ok) return; // server-side blip: keep the page, do not sign anyone out
              if (!data?.user?.is_owner) throw new Error('auth-notowner');
              try { sessionStorage.setItem(ADMIN_GATE_VERIFIED_KEY, String(Date.now())); } catch {}
            }
            if (adminRoot.dataset.adminPage === 'ready') return;
            // Some admin pages ship their own branded PIN pad. Only one pad may be live,
            // otherwise the second appears right after the first unlocks and both pads
            // receive the same key presses. Let the page's pad own the lock.
            if (document.querySelector('[data-page-admin-pin="true"]')) {
              adminRoot.dataset.adminPage = 'ready';
              return;
            }
            adminRoot.dataset.adminPage = 'pin';
            window.openHaksterAdminPinGate?.(() => {
              adminRoot.dataset.adminPage = 'ready';
            });
          } catch (error) {
            const reason = String((error && error.message) || '');
            // A dropped request is not a sign-out. Keep the page as it is and let the next
            // check decide, so a tunnel or network blip no longer bounces an owner to sign in.
            if (!/^auth-/.test(reason) && !/Sign in required/.test(reason)) return;
            lockAdminPage();
            sessionStorage.removeItem(ADMIN_GATE_SESSION_KEY);
            const stillSignedIn = !!(localStorage.getItem('hakster_google_token') || localStorage.getItem('hakster_api_key'));
            if (reason === 'auth-401' || reason === 'Sign in required.') {
              // The stored key is dead: ask for one sign-in and come straight back here.
              window.location.replace('/?signin=1&redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
              return;
            }
            window.location.replace(stillSignedIn ? '/miniforge/' : '/');
          } finally {
            adminCheckInFlight = false;
          }
        };
        window.addEventListener('hakster:signout', () => {
          lockAdminPage();
          window.location.replace('/');
        });
        verifyAdminPage();
        window.setInterval(() => {
          if (document.visibilityState === 'visible') verifyAdminPage();
        }, 60000);
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') verifyAdminPage();
        });
        adminPinGate?.querySelector('[data-admin-pin-close]')?.addEventListener('click', () => {
          lockAdminPage();
          window.location.replace('/');
        });
      }
      // 2026-11-17 (owner): "yes add it" — HakTerm bounces here with ?pin=1 to get
      // the PIN pad on a direct open. The destination travels in
      // ADMIN_GATE_RETURN_KEY, so a correct PIN sends the browser back there with
      // the one-shot HakTerm permit. Admin pages already open their own pad.
      if (!adminPath && new URLSearchParams(window.location.search).get('pin') === '1') {
        window.openHaksterAdminPinGate?.(() => {});
      }
      function toggleAdminMenu(menu, button) {
        const open = menu?.classList.contains('hidden');
        if (!open) {
          menu?.classList.add('hidden');
          button?.setAttribute('aria-expanded', 'false');
          return;
        }
        openAdminPinGate(() => {
          menu?.classList.remove('hidden');
          if (menu === mobileAdminToolsMenu) menu?.classList.add('flex');
          button?.setAttribute('aria-expanded', 'true');
        });
      }
      function closeAdminTools() {
        adminToolsMenu?.classList.add('hidden');
        adminToolsBtn?.setAttribute('aria-expanded', 'false');
      }
      function closeMobileAdminTools() {
        mobileAdminToolsMenu?.classList.add('hidden');
        mobileAdminToolsMenu?.classList.remove('flex');
        mobileAdminToolsBtn?.setAttribute('aria-expanded', 'false');
      }
      mobileAdminToolsBtn?.addEventListener('click', (event) => {
        event.stopPropagation();
        toggleAdminMenu(mobileAdminToolsMenu, mobileAdminToolsBtn);
      });
      mobileAdminToolsMenu?.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a')) closeMobileAdminTools();
      });
      document.addEventListener('click', (event) => {
        if (mobileAdminTools && !mobileAdminTools.contains(event.target)) closeMobileAdminTools();
      });
      adminToolsBtn?.addEventListener('click', (event) => {
        event.stopPropagation();
        toggleAdminMenu(adminToolsMenu, adminToolsBtn);
      });
      adminToolsMenu?.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a')) closeAdminTools();
      });
      document.addEventListener('click', (event) => {
        if (adminTools && !adminTools.contains(event.target)) closeAdminTools();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeAdminTools();
      });

      // ── Mobile menu toggle ──────────────────────────────────────
      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const bar1 = document.getElementById('bar1');
      const bar2 = document.getElementById('bar2');
      const bar3 = document.getElementById('bar3');

      let menuOpen = false;

      menuBtn.addEventListener('click', () => {
        menuOpen = !menuOpen;
        menuBtn.setAttribute('aria-expanded', String(menuOpen));

        if (menuOpen) {
          mobileMenu.classList.remove('hidden');
          // Animate hamburger → X
          bar1.style.transform = 'translateY(8px) rotate(45deg)';
          bar2.style.opacity = '0';
          bar3.style.transform = 'translateY(-8px) rotate(-45deg)';
        } else {
          mobileMenu.classList.add('hidden');
          bar1.style.transform = '';
          bar2.style.opacity = '1';
          bar3.style.transform = '';
        }
      });

      // Close mobile menu when a nav link is clicked
      document.querySelectorAll('.mobile-nav-link').forEach((link) => {
        link.addEventListener('click', () => {
          menuOpen = false;
          mobileMenu.classList.add('hidden');
          menuBtn.setAttribute('aria-expanded', 'false');
          bar1.style.transform = '';
          bar2.style.opacity = '1';
          bar3.style.transform = '';
        });
      });

      // ── Scroll shadow on navbar ─────────────────────────────────
      const navbar = document.getElementById('navbar');

      window.addEventListener('scroll', () => {
        if (window.scrollY > 20) {
          navbar.style.boxShadow = '0 4px 24px 0 rgba(0,0,0,0.5)';
          navbar.style.borderBottomColor = 'rgba(124,58,237,0.2)';
        } else {
          navbar.style.boxShadow = '';
          navbar.style.borderBottomColor = '';
        }
      }, { passive: true });

      // ── Smooth scroll for all anchor links ─────────────────────
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (!href || href === '#') return;
          const target = document.querySelector(href);
          if (!target) return;
          e.preventDefault();
          const navH = navbar.offsetHeight;
          const top = (target).getBoundingClientRect().top + window.scrollY - navH - 16;
          window.scrollTo({ top, behavior: 'smooth' });
        });
      });

      // ── Global fullscreen button ────────────────────────────────
      const fullscreenBtn = document.getElementById('global-fullscreen-btn');
      function setGlobalFullscreenState(active) {
        if (!fullscreenBtn) return;
        fullscreenBtn.classList.toggle('active', active);
        fullscreenBtn.setAttribute('aria-pressed', active ? 'true' : 'false');
        fullscreenBtn.title = active ? 'Exit fullscreen' : 'Fullscreen';
        fullscreenBtn.setAttribute('aria-label', fullscreenBtn.title);
      }
      fullscreenBtn?.addEventListener('click', async () => {
        try {
          if (document.fullscreenElement) {
            await document.exitFullscreen();
          } else {
            await document.documentElement.requestFullscreen();
          }
        } catch {
          document.body.classList.toggle('global-fullscreen-fallback');
          setGlobalFullscreenState(document.body.classList.contains('global-fullscreen-fallback'));
        }
      });
      document.addEventListener('fullscreenchange', () => {
        if (!document.fullscreenElement) document.body.classList.remove('global-fullscreen-fallback');
        setGlobalFullscreenState(Boolean(document.fullscreenElement) || document.body.classList.contains('global-fullscreen-fallback'));
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && document.body.classList.contains('global-fullscreen-fallback')) {
          document.body.classList.remove('global-fullscreen-fallback');
          setGlobalFullscreenState(false);
        }
      });
    </script>
    <script is:inline data-cfasync="false">
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(function () {});
      });
    }
  </script>
</body>
</html>
