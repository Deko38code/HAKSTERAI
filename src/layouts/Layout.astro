---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'haksterAi — Agentic CLI for Developers',
  description = 'haksterAi is an AI-powered CLI that turns your terminal into an agentic engineering powerhouse.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/logo-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:image" content="/logo-512.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/xterm.css" />
  </head>
  <body>
    <!-- Navbar -->
    <header id="navbar" class="fixed top-0 left-0 right-0 z-50 border-b border-[#1e1e2e] bg-[#0a0a0f]/80 backdrop-blur-md transition-shadow duration-300">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 group">
          <img src="/logo-192.png" alt="haksterAi" class="w-10 h-10 rounded-lg group-hover:scale-110 transition-transform" />
          <span class="text-[#e2e8f0] font-bold text-xl tracking-tight">hakster<span class="text-[#7c3aed]">Ai</span></span>
        </a>

        <!-- Desktop nav links -->
        <div class="hidden md:flex items-center gap-6">
          <a href="/labs" class="nav-link text-sm text-[#64748b] hover:text-[#a855f7] transition-colors flex items-center gap-1.5"><span>🧪</span> Labs</a>
          <a href="/hack" class="nav-link text-sm text-[#64748b] hover:text-[#00ff88] transition-colors flex items-center gap-1.5"><span>💀</span> Hack</a>
          <a href="/terminal" class="nav-link text-sm text-[#64748b] hover:text-[#e2e8f0] transition-colors flex items-center gap-1.5"><span>⌨️</span> Terminal</a>
          <a href="/dashboard" class="nav-link text-sm text-[#64748b] hover:text-[#e2e8f0] transition-colors flex items-center gap-1.5"><span>📊</span> Dashboard</a>
          <a href="/build" class="nav-link text-sm text-[#64748b] hover:text-[#e2e8f0] transition-colors flex items-center gap-1.5"><span>💬</span> Chat</a>
        </div>

        <!-- Desktop CTA + GitHub -->
        <div class="hidden md:flex items-center gap-3">
          <a
            href="/terminal"
            class="inline-flex items-center gap-2 rounded-lg bg-[#7c3aed] px-4 py-2 text-sm font-semibold text-white hover:bg-[#6d28d9] transition-colors"
          >
            <span>⌨️</span> Terminal
          </a>
          <a
            href="https://github.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#64748b] hover:text-[#e2e8f0] transition-colors"
            aria-label="GitHub"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>

        <!-- Mobile hamburger -->
        <button
          id="menu-btn"
          class="md:hidden flex flex-col justify-center items-center w-9 h-9 gap-1.5 rounded-lg border border-[#1e1e2e] bg-[#111118] hover:border-[#7c3aed]/50 transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <span id="bar1" class="block w-5 h-0.5 bg-[#e2e8f0] transition-all duration-300 origin-center"></span>
          <span id="bar2" class="block w-5 h-0.5 bg-[#e2e8f0] transition-all duration-300"></span>
          <span id="bar3" class="block w-5 h-0.5 bg-[#e2e8f0] transition-all duration-300 origin-center"></span>
        </button>
      </nav>

      <!-- Mobile menu (hidden by default) -->
      <div
      id="mobile-menu"
      class="md:hidden hidden border-t border-[#1e1e2e] bg-[#0a0a0f]/95 backdrop-blur-md"
      >
      <div class="mx-auto max-w-6xl px-6 py-4 flex flex-col gap-4">
        <a href="/hack" class="mobile-nav-link text-sm font-semibold text-[#00ff88] hover:text-[#a855f7] transition-colors py-2 border-b border-[#1e1e2e] flex items-center gap-2"><span>💀</span> Hack</a>
        <a href="/terminal" class="mobile-nav-link text-sm font-medium text-[#64748b] hover:text-[#e2e8f0] transition-colors py-2 border-b border-[#1e1e2e] flex items-center gap-2"><span>⌨️</span> Terminal</a>
        <a href="/dashboard" class="mobile-nav-link text-sm font-medium text-[#64748b] hover:text-[#e2e8f0] transition-colors py-2 border-b border-[#1e1e2e] flex items-center gap-2"><span>📊</span> Dashboard</a>
        <a href="/build" class="mobile-nav-link text-sm font-medium text-[#64748b] hover:text-[#e2e8f0] transition-colors py-2 border-b border-[#1e1e2e] flex items-center gap-2"><span>💬</span> Chat</a>
        <div class="flex items-center gap-3 pt-2">
          <a
            href="/terminal"
            class="mobile-nav-link flex-1 text-center rounded-lg bg-[#7c3aed] px-4 py-2 text-sm font-semibold text-white hover:bg-[#6d28d9] transition-colors"
          >
            ⌨️ Terminal
          </a>
          <a
            href="https://github.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#64748b] hover:text-[#e2e8f0] transition-colors"
            aria-label="GitHub"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>
      </div>
    </header>

    <!-- Page content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#1e1e2e] bg-[#0a0a0f] py-12 mt-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="flex items-center gap-2">
            <img src="/logo-32.png" alt="haksterAi" class="w-6 h-6 rounded" />
            <span class="text-[#e2e8f0] font-bold">hakster<span class="text-[#7c3aed]">Ai</span></span>
          </div>
          <div class="flex items-center gap-6 text-sm text-[#64748b]">
            <a href="/hack" class="hover:text-[#00ff88] transition-colors text-[#00ff88] font-semibold">💀 Hack</a>
            <a href="/terminal" class="hover:text-[#a855f7] transition-colors">⌨️ Terminal</a>
            <a href="/dashboard" class="hover:text-[#e2e8f0] transition-colors">📊 Dashboard</a>
            <a href="/build" class="hover:text-[#e2e8f0] transition-colors">💬 Chat</a>
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#e2e8f0] transition-colors">GitHub</a>
          </div>
          <p class="text-xs text-[#64748b]">
            © {new Date().getFullYear()} haksterAi. Built for the terminal.
          </p>
        </div>
      </div>
    </footer>

    <!-- Global JS: mobile menu + scroll shadow + smooth scroll -->
    <script>
      // ── Mobile menu toggle ──────────────────────────────────────
      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const bar1 = document.getElementById('bar1');
      const bar2 = document.getElementById('bar2');
      const bar3 = document.getElementById('bar3');

      let menuOpen = false;

      menuBtn.addEventListener('click', () => {
        menuOpen = !menuOpen;
        menuBtn.setAttribute('aria-expanded', String(menuOpen));

        if (menuOpen) {
          mobileMenu.classList.remove('hidden');
          // Animate hamburger → X
          bar1.style.transform = 'translateY(8px) rotate(45deg)';
          bar2.style.opacity = '0';
          bar3.style.transform = 'translateY(-8px) rotate(-45deg)';
        } else {
          mobileMenu.classList.add('hidden');
          bar1.style.transform = '';
          bar2.style.opacity = '1';
          bar3.style.transform = '';
        }
      });

      // Close mobile menu when a nav link is clicked
      document.querySelectorAll('.mobile-nav-link').forEach((link) => {
        link.addEventListener('click', () => {
          menuOpen = false;
          mobileMenu.classList.add('hidden');
          menuBtn.setAttribute('aria-expanded', 'false');
          bar1.style.transform = '';
          bar2.style.opacity = '1';
          bar3.style.transform = '';
        });
      });

      // ── Scroll shadow on navbar ─────────────────────────────────
      const navbar = document.getElementById('navbar');

      window.addEventListener('scroll', () => {
        if (window.scrollY > 20) {
          navbar.style.boxShadow = '0 4px 24px 0 rgba(0,0,0,0.5)';
          navbar.style.borderBottomColor = 'rgba(124,58,237,0.2)';
        } else {
          navbar.style.boxShadow = '';
          navbar.style.borderBottomColor = '';
        }
      }, { passive: true });

      // ── Smooth scroll for all anchor links ─────────────────────
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (!href || href === '#') return;
          const target = document.querySelector(href);
          if (!target) return;
          e.preventDefault();
          const navH = navbar.offsetHeight;
          const top = (target).getBoundingClientRect().top + window.scrollY - navH - 16;
          window.scrollTo({ top, behavior: 'smooth' });
        });
      });
    </script>
  </body>
</html>
