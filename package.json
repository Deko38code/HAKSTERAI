{
  "name": "haksterai",
  "type": "module",
  "version": "0.0.1",
  "description": "haksterAI web app and universal CLI agent shell",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "hakster": "./cli/index.js",
    "haksterai": "./cli/index.js"
  },
  "files": [
    "cli/index.js",
    "cli/logo.js",
    "cli/package.json",
    "cli/package-lock.json",
    "server/src/**/*.js",
    "server/package.json",
    "server/package-lock.json",
    "src/components/*.astro",
    "src/layouts/*.astro",
    "src/pages/**/*.astro",
    "src/styles/*.css",
    "public",
    "docs/agent",
    "AGENTS.md",
    "README.md",
    "astro.config.*",
    "tailwind.config.*",
    "package.json",
    "!**/node_modules/**",
    "!**/.env",
    "!**/.env.*",
    "!**/data/**",
    "!**/*.bak",
    "!**/*.bak.*",
    "!**/*.backup",
    "!**/*backup*"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "cli": "node haksterai-cli.cjs",
    "dashboard": "node tui-dashboard.cjs",
    "server": "cd server && node src/index.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "astro": "^7.0.5",
    "blessed": "^0.1.81",
    "commander": "^11.1.0",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^4.3.2"
  }
}
