{
  "name": "haksterai",
  "type": "module",
  "version": "0.1.0",
  "description": "haksterAi — pentester AI agent platform with web dashboard, CLI shell, MCP tool loop, and streaming chat",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "hakster": "./cli/index.js",
    "haksterai": "./cli/index.js"
  },
  "files": [
    "cli/index.js",
    "cli/logo.js",
    "cli/package.json",
    "cli/package-lock.json",
    "server/src/**/*.js",
    "server/package.json",
    "server/package-lock.json",
    "src/components/*.astro",
    "src/layouts/*.astro",
    "src/pages/**/*.astro",
    "src/styles/*.css",
    "public",
    "docs/agent",
    "AGENTS.md",
    "README.md",
    "astro.config.*",
    "tailwind.config.*",
    "package.json",
    "!**/node_modules/**",
    "!**/.env",
    "!**/.env.*",
    "!**/data/**",
    "!**/*.bak",
    "!**/*.bak.*",
    "!**/*.backup",
    "!**/*backup*"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "cli": "node cli/index.js",
    "dashboard": "node tui-dashboard.cjs",
    "server": "cd server && node src/index.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "node -e \"try{require('fs').chmodSync(require('path').join(__dirname,'cli','index.js'),0o755)}catch{}\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@tailwindcss/vite": "^4.3.2",
    "@trigger.dev/sdk": "^4.7.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.135",
    "astro": "^7.0.5",
    "blessed": "^0.1.81",
    "commander": "^11.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ink": "^5.2.1",
    "patchright": "^1.61.1",
    "puppeteer": "^25.3.0",
    "react": "^18.3.1",
    "stripe": "^22.3.2",
    "tailwindcss": "^4.3.2",
    "undici": "^7.28.0"
  },
  "keywords": [
    "hakster",
    "haksterai",
    "cli",
    "ai",
    "agent",
    "pentest",
    "pentesting",
    "mcp",
    "tool-loop",
    "streaming",
    "ollama",
    "security",
    "recon",
    "nmap",
    "terminal"
  ],
  "author": "Deko38code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deko38code/HAKSTERAI.git"
  },
  "bugs": {
    "url": "https://github.com/Deko38code/HAKSTERAI/issues"
  },
  "homepage": "https://github.com/Deko38code/HAKSTERAI#readme",
  "devDependencies": {
    "@trigger.dev/build": "^4.7.3",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3"
  }
}
