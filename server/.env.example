# haksterAi server config
PORT=3579

# AI Providers — fill in what you have
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Nous Research inference API (OpenAI-compatible)
NOUS_API_KEY=
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
NOUS_MODEL=nousresearch/hermes-4-70b

# Ollama (local) — default base URL
OLLAMA_BASE_URL=http://localhost:11434

# Hermes (OpenAI-compatible endpoint)
HERMES_BASE_URL=http://localhost:11434
HERMES_MODEL=nous-hermes-2-mistral-7b-dpo

# Default provider: ollama | anthropic | openai | hermes | codex | nous
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=glm-5.2:cloud

# File system root (which directory to expose to the file API)
# Defaults to current working directory
FS_ROOT=

# CORS allowed origins
CORS_ORIGINS=http://localhost:4321,http://localhost:3000

# Google OAuth
# If these are empty, the app will try to auto-load from GOOGLE_OAUTH_CLIENT_JSON.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_JSON=./google-oauth-client.json

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=
PRICE_STARTER_MONTHLY_CENTS=400
PRICE_PRO_MONTHLY_CENTS=1900
PRICE_PRO_YEARLY_CENTS=19000
PRICE_ENTERPRISE_MONTHLY_CENTS=9900
PRICE_ENTERPRISE_YEARLY_CENTS=99000

# Usage and referral tokens
USAGE_LIMIT_ENABLED=false
FREE_USAGE_LIMIT=5
USAGE_RESET_DAYS=30
REFERRAL_REWARD_TOKENS=10000
REFERRAL_SIGNUP_TOKENS=2500

# Firecrawl (web search/scrape/crawl) — add up to 12 keys for rotation
FIRECRAWL_API_KEY=
FIRECRAWL_API_KEY_1=
FIRECRAWL_API_KEY_2=
FIRECRAWL_API_KEY_3=
FIRECRAWL_API_KEY_4=
FIRECRAWL_API_KEY_5=
FIRECRAWL_API_KEY_6=
FIRECRAWL_API_KEY_7=
FIRECRAWL_API_KEY_8=
FIRECRAWL_API_KEY_9=
FIRECRAWL_API_KEY_10=
FIRECRAWL_API_KEY_11=
FIRECRAWL_API_KEY_12=

# Telegram bot fleet — each token is optional; missing bots are skipped
TELEGRAM_BOT_TOKEN_1=
TELEGRAM_BOT_TOKEN_2=
TELEGRAM_BOT_TOKEN_3=
TELEGRAM_BOT_TOKEN_4=
TELEGRAM_BOT_TOKEN_5=
TELEGRAM_BOT_TOKEN_6=
